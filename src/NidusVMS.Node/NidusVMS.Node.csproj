<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.46.0</Version>
    <!-- Recorder nodes are self-contained single-file per platform (see build-node.ps1),
         the same shape as dploid.Agent. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- StorageManager's pure eviction-decision helpers (internal static) are unit tested directly
         against real temp directories rather than only through the networked BackgroundService. -->
    <InternalsVisibleTo Include="NidusVMS.Tests" />
  </ItemGroup>

  <!-- Deliberately still no reference to NidusVMS.Infrastructure: the node never touches SQL Server
       directly, and gets ready-made RTSP URIs from GetConfigAsync rather than resolving them itself.
       NidusVMS.Onvif WAS excluded on the same "no ONVIF calls" principle until M8 pass 6 — ONVIF
       PullPoint event polling is a continuous, long-lived conversation with the camera the web tier
       can't pre-resolve into a one-shot value the way GetStreamUri already is, so it has to happen
       from wherever the RTSP connections already do: the node, on the camera's own LAN. -->
  <ItemGroup>
    <ProjectReference Include="..\NidusVMS.Core\NidusVMS.Core.csproj" />
    <ProjectReference Include="..\NidusVMS.Media\NidusVMS.Media.csproj" />
    <ProjectReference Include="..\NidusVMS.Onvif\NidusVMS.Onvif.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting itself comes transitively via the ASP.NET Core shared
         framework (Sdk.Web) — only the pieces that aren't already part of it need a reference. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
