<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    ONNX Runtime execution provider is chosen at RUNTIME now (see VisionBackendResolver), not by a
    build-time -p:Accel switch. This project references only the managed ONNX Runtime assembly (via
    the base CPU package, which also drops the CPU-only native onnxruntime.dll at the app root);
    LarisVMS.Vision.Service stages the CUDA and DirectML native builds into
    onnxruntime-backends\<name>\ and the resolver points the OS loader at whichever one matches the
    node's hardware, degrading CUDA -> DirectML -> CPU when a toolkit is missing.
  -->

  <ItemGroup>
    <!-- Never the reverse — LarisVMS.Node must not be pulled toward the GPU/ONNX Runtime native
         dependencies this library carries (see plan decision 3). Only LarisVMS.Vision.Service
         references this project. -->
    <ProjectReference Include="..\LarisVMS.Media\LarisVMS.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YoloDotNet" />
    <!-- Managed ONNX Runtime + the CPU native (onnxruntime.dll) at the app root. The GPU natives are
         staged into onnxruntime-backends\ by LarisVMS.Vision.Service's StageOnnxBackends target. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- ONNX IR types for OnnxPreprocessHead (pass 4a). Grpc.Tools is build-only (compiles the
         vendored onnx-ml.proto to C#); no gRPC runtime is pulled in. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- onnx-ml.proto is proto2 / LITE_RUNTIME (Apache-2.0, vendored from the onnx package).
         GrpcServices="None" => generate the message types only, no service stubs. -->
    <Protobuf Include="Onnx\onnx-ml.proto" ProtoRoot="Onnx" GrpcServices="None" CompileOutputs="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ByteTrack port (ByteKalmanFilter, STrack, TrackMatching) is internal on purpose: it's
         an implementation detail behind ByteTracker's public Update API, but its unit tests need
         to reach the pieces directly to verify them against reference values — same reasoning
         aitest's own Aitest.Vision.Tests project needed. -->
    <InternalsVisibleTo Include="LarisVMS.Tests" />
  </ItemGroup>

</Project>
