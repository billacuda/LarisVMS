<Project Sdk="Microsoft.NET.Sdk">

  <!-- Failover plan phase 2: the pieces shared between LarisVMS.Node's client HTTPS endpoint and the
       standalone LarisVMS.Proxy relay service — hot-reloadable cert handling and a WebSocket byte
       relay. No ffmpeg, no SQL, no Core reference: deliberately tiny so both hosts can take it on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LarisVMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
