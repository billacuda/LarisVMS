<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Published with -r win-x64. Restoring that target on every restore (the IDE's background
         one included) keeps a plain restore from dropping it mid-publish (NETSDK1047). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <Version>0.219.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- UpdaterLogic's pure argument-parsing/file-swap helpers are unit tested directly against a
         real temp directory, same reasoning as LarisVMS.Node's own InternalsVisibleTo. -->
    <InternalsVisibleTo Include="LarisVMS.Tests" />
  </ItemGroup>

</Project>
