@page
@model NidusVMS.Web.Pages.Setup.StorageModel
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Storage";
}
<h5 class="mb-3">3. Storage</h5>
<p class="text-muted small">
    Local disk path or UNC share recorder nodes write recordings to by default. Per-camera storage
    targets are configured later — see milestone M4.
</p>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Storage root path</label>
        <input asp-for="RootPath" class="form-control" placeholder="E:\Recordings or \\nas\nidusvms" />
    </div>
    <button type="submit" class="btn btn-primary">Continue</button>
</form>
