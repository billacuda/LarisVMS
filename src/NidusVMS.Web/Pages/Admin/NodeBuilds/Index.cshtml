@page
@model NidusVMS.Web.Pages.Admin.NodeBuilds.IndexModel
@{
    ViewData["Title"] = "Node Builds";
}
<h1>Recorder node builds</h1>
<p class="text-muted">
    Upload a new <code>NidusVMS.Node.exe</code> build here once, and every recorder node whose
    reported version is older than the newest upload for its platform downloads, verifies, and
    applies it on its own next heartbeat — no more manually re-running
    <code>build-node.ps1</code> / <code>install-node.ps1</code> on each recorder machine. Controlled
    globally by the <a asp-page="/Admin/Settings">node auto-update setting</a>.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="row g-3 mb-4" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label">Build file (NidusVMS.Node.exe)</label>
        <input asp-for="UploadFile" type="file" class="form-control" required />
    </div>
    <div class="col-6">
        <label class="form-label">Version</label>
        <input asp-for="Version" class="form-control" placeholder="e.g. 0.47.0" required />
    </div>
    <div class="col-6">
        <label class="form-label">Platform</label>
        <select asp-for="Platform" class="form-select">
            <option value="win-x64">win-x64</option>
        </select>
    </div>
    <div class="col-12">
        <label class="form-label">Notes (optional)</label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Upload</button>
    </div>
</form>

@if (Model.Builds.Count == 0)
{
    <p class="text-muted">No builds uploaded yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Platform</th>
                    <th>Uploaded</th>
                    <th data-sort-numeric>Size</th>
                    <th>SHA-256</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Builds)
                {
                    <tr>
                        <td>@b.Version</td>
                        <td>@b.Platform</td>
                        <td><span title="@b.UploadedAt.ToString("u")">@b.UploadedAt.ToString("g")</span></td>
                        <td>@ByteFormat.Format(b.SizeBytes)</td>
                        <td class="font-monospace small">@b.Sha256[..12]&hellip;</td>
                        <td>@b.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        The newest upload per platform (by upload time) is what a node's next heartbeat compares
        against — there's no separate "activate"/"promote" step.
    </p>
}
