@page
@model NidusVMS.Web.Pages.Cameras.IndexModel
@{
    ViewData["Title"] = "Cameras";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Cameras</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-page="Groups">Groups</a>
        <a class="btn btn-primary" asp-page="Discover">Discover</a>
        <a class="btn btn-primary" asp-page="Edit">Add manually</a>
    </div>
</div>

@if (Model.Cameras.Count == 0)
{
    <p class="text-muted">No cameras yet. Use <a asp-page="Discover">Discover</a> to scan the LAN, or add one manually.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Host</th>
                    <th>Group</th>
                    <th>Node</th>
                    <th>Manufacturer / Model</th>
                    <th>Profiles</th>
                    <th>Capabilities</th>
                    <th>Streams</th>
                    <th>Storage used</th>
                    <th>Retention</th>
                    <th>Last probed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cameras)
                {
                    <tr>
                        <td>
                            <a asp-page="Edit" asp-route-id="@c.Id">@c.Name</a>
                            @if (!c.IsEnabled)
                            {
                                <span class="badge text-bg-secondary ms-1">Disabled</span>
                            }
                        </td>
                        <td>@c.Host</td>
                        <td>@(c.Group?.Name ?? "—")</td>
                        <td>
                            @if (c.Node is { } node)
                            {
                                <a asp-page="/Admin/Nodes">@node.Name</a>
                            }
                            else
                            {
                                <span class="text-muted" title="No node assigned — this camera won't record">unassigned</span>
                            }
                        </td>
                        <td>@c.Manufacturer @c.Model</td>
                        <td>
                            @if (c.Capabilities is { } cap)
                            {
                                if (cap.ProfileS) { <span class="badge text-bg-primary me-1">S</span> }
                                if (cap.ProfileT) { <span class="badge text-bg-primary me-1">T</span> }
                                if (cap.ProfileG) { <span class="badge text-bg-primary me-1">G</span> }
                                if (cap.ProfileM) { <span class="badge text-bg-primary me-1">M</span> }
                            }
                            else
                            {
                                <span class="text-muted">not probed</span>
                            }
                        </td>
                        <td>
                            @if (c.Capabilities is { } cap2)
                            {
                                if (cap2.HasPtz) { <span class="badge text-bg-light border me-1" title="PTZ">PTZ</span> }
                                if (cap2.HasAudioOut) { <span class="badge text-bg-light border me-1" title="Two-way audio">Talk</span> }
                                if (cap2.HasAnalyticsMetadata) { <span class="badge text-bg-light border me-1" title="Analytics metadata">Meta</span> }
                                if (cap2.HasRelayOutputs || cap2.HasDigitalInputs) { <span class="badge text-bg-light border me-1" title="Relay / digital I/O">I/O</span> }
                            }
                        </td>
                        <td>@c.Streams.Count</td>
                        <td>
                            @ByteFormat.Format(Model.StorageUsedBytes.GetValueOrDefault(c.Id))
                            @if (c.QuotaBytes is { } quota)
                            {
                                <span class="text-muted">/ @ByteFormat.Format(quota)</span>
                            }
                        </td>
                        <td>@Model.EffectiveRetentionDays.GetValueOrDefault(c.Id, 30) day(s)</td>
                        <td>
                            @if (c.LastProbedAt is { } probed)
                            {
                                <span title="@probed.ToString("u")">@probed.ToString("g")</span>
                            }
                            else
                            {
                                <span class="text-muted">never</span>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Probe" asp-route-id="@c.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Re-probe</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
