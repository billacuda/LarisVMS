@page
@model NidusVMS.Web.Pages.Cameras.GroupsModel
@{
    ViewData["Title"] = "Camera groups";
}
<h1>Camera groups</h1>
<p class="text-muted">Sites / buildings / floors — used to organize cameras and to scope settings overrides.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<ul class="list-group mb-4" style="max-width: 480px;">
    @foreach (var g in Model.Groups)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span style="padding-left: @(Model.Depth(g) * 1.25)rem;">@g.Name</span>
            <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id" class="d-inline"
                  onclick="return confirm('Delete this group?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </li>
    }
</ul>

<form method="post" asp-page-handler="Create" class="row g-2" style="max-width: 480px;">
    <div class="col-12">
        <label class="form-label">New group name</label>
        <input asp-for="NewName" class="form-control" required />
    </div>
    <div class="col-12">
        <label class="form-label">Parent</label>
        <select asp-for="NewParentId" class="form-select">
            <option value="">(top level)</option>
            @foreach (var g in Model.Groups)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Add group</button>
    </div>
</form>
