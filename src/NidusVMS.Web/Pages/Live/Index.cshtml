@page
@using NidusVMS.Core.Enums
@model NidusVMS.Web.Pages.Live.IndexModel
@{
    ViewData["Title"] = "Live";
}
<h1>Live</h1>

@if (Model.Views.Count > 0)
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-sm-4">
            <select class="form-select" id="liveViewPicker" onchange="if (this.value) location.href = '/Views/Play/' + this.value;">
                <option value="">All cameras (below)</option>
                @foreach (var v in Model.Views)
                {
                    <option value="@v.Id">@v.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-8 text-muted small">
            Pick a saved view to watch its own layout live, with kiosk mode and (if it has a tour
            interval set) rotation through other views. This page's own grid below shows every
            camera flat, always available as a quick fallback.
        </div>
    </div>
}

@if (Model.Cameras.Count == 0)
{
    <p class="text-muted">No cameras are both enabled and assigned to a node yet.</p>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Cameras)
        {
            var mainStream = c.Streams.FirstOrDefault(s => s.Role == CameraStreamRole.Main);
            var hasAudio = mainStream?.HasAudio ?? false;
            <div class="col-12 col-md-6 col-lg-4" data-camera-tile="@c.Id" data-has-audio="@hasAudio.ToString().ToLowerInvariant()" data-codec="@mainStream?.Codec">
                <div class="card h-100">
                    <div class="ratio ratio-16x9 bg-dark">
                        @* No positioning classes here on purpose: this is a direct child of .ratio,
                           so Bootstrap's own ".ratio > *" rule already makes it position:absolute
                           and 100% width/height — adding position-relative (a `!important` utility
                           class) fights that rule instead of complementing it and broke the ratio box
                           entirely (cells rendered square, video never appeared). It still works as a
                           positioning context for the status child below, since position:absolute
                           (which it gets for free) is a valid containing block. *@
                        <div>
                            <video class="w-100 h-100" style="object-fit: contain;" muted playsinline></video>
                            <div class="position-absolute top-50 start-50 translate-middle text-white small text-center live-status px-2"></div>
                            <span class="badge bg-danger position-absolute top-0 start-0 m-1 live-motion-badge d-none"
                                  title="Motion detected">● Motion</span>
                            @* Exactly two buttons, shown on hover — deliberately not native <video controls>:
                               that includes a click-anywhere-on-the-video-to-pause behavior in most browsers,
                               which makes no sense for a continuous live feed (there's nothing to "resume" from
                               a pause on a live MSE stream) and was confirmed live as unwanted. *@
                            <div class="position-absolute bottom-0 end-0 m-1 btn-group btn-group-sm live-controls d-none">
                                <button type="button" class="btn btn-outline-light live-mute-toggle" style="padding:.1rem .35rem;" title="Mute">🔊</button>
                                <button type="button" class="btn btn-outline-light live-fullscreen-toggle" style="padding:.1rem .35rem;" title="Fullscreen">⛶</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body py-2">
                        <span>@c.Name</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-camera-tile]').forEach(function (tile) {
            var video = tile.querySelector('video');
            var status = tile.querySelector('.live-status');
            var controls = tile.querySelector('.live-controls');
            var muteBtn = tile.querySelector('.live-mute-toggle');
            var fullscreenBtn = tile.querySelector('.live-fullscreen-toggle');

            tile.addEventListener('mouseenter', function () { if (controls) controls.classList.remove('d-none'); });
            tile.addEventListener('mouseleave', function () { if (controls) controls.classList.add('d-none'); });

            function setMuteIcon() {
                if (!muteBtn) return;
                muteBtn.textContent = video.muted ? '🔇' : '🔊';
                muteBtn.title = video.muted ? 'Unmute' : 'Mute';
            }
            if (muteBtn) {
                muteBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    video.muted = !video.muted;
                    setMuteIcon();
                });
            }
            if (fullscreenBtn) {
                fullscreenBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (video.requestFullscreen) video.requestFullscreen().catch(function () {});
                });
            }

            // Starts muted regardless of any previous session's state — autoplay-with-sound is
            // blocked by browser policy anyway, and starting muted keeps behavior consistent across
            // tiles instead of depending on whichever camera happened to be unmuted last.
            video.muted = true;
            setMuteIcon();
            // No stop() is kept: every camera connects for as long as this page stays open, and
            // start()'s own auto-reconnect handles drops (network blips, wifi roaming) on its own —
            // there is currently no user action on this page that should end a session early.
            window.nidusvmsLiveView.start(tile.dataset.cameraTile, video, status, tile.dataset.codec, tile.dataset.hasAudio === 'true');
        });

        // M8, unverified against a real camera: the motion-detection pipeline itself has never been
        // watched trip against a real event, so treat this badge the same way for now — a visual
        // aid to check, not yet a proven signal.
        window.nidusvmsLiveView.startMotionIndicatorPolling(5000);
    </script>
}
