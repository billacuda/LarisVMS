<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\NidusVMS.Web.dll" stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout" hostingModel="InProcess">
        <environmentVariables>
          <!-- Development, not Production: NidusVMS is still pre-recording, milestone-by-milestone
               development (no real camera footage depends on this deploy yet), and Development
               mode surfaces the full exception + stack trace in the browser via ASP.NET Core's
               built-in developer exception page instead of the generic Error page, which is faster
               to debug against than pulling logs\stdout every time. MUST be switched back to
               Production before any milestone that records real footage or is reachable outside a
               trusted dev network — Development mode's error pages can leak internal details
               (connection strings, stack traces, file paths). -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
