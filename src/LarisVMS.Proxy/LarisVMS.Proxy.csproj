<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Failover plan phase 2: the standalone relay tier. A dumb TLS-terminating pass-through between
       browsers and recorder nodes for live/playback — no SQL, no ffmpeg, no camera credentials.
       Self-contained single-file per platform (see build-proxy.ps1), same shape as LarisVMS.Node. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.208.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LarisVMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LarisVMS.Core\LarisVMS.Core.csproj" />
    <ProjectReference Include="..\LarisVMS.Relay\LarisVMS.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
