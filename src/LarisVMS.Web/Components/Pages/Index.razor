@page "/"
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json
@using LarisVMS.Core
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IDashboardService DashboardService
@inject IDashboardWidgetService DashboardWidgets
@inject IAuthorizationService AuthorizationService
@inject ITimelineService TimelineService
@inject ICameraService CameraService
@inject ICameraAccessService CameraAccess

<PageTitle>Dashboard - @AppName</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="/lib/gridstack/dist/gridstack.min.css" />
</HeadContent>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0">Dashboard</h1>
    @* dashboard.js's poll() fills this in ("Updated h:mm:ss a") after every successful refresh —
       server-rendered blank so a JS-disabled/failed-to-load page doesn't show a stale claim. *@
    <span id="dashboardRefreshStatus" class="text-muted small"></span>
    @* Customizing needs the full 12-column grid: on a phone it collapses to one column, and a layout
       dragged around there would overwrite the desktop one. dashboard-widgets.js hides this bar
       whenever the grid isn't 12 columns wide. *@
    <div class="ms-auto d-flex gap-2" id="dashboardCustomizeBar">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="dashboardCustomize">Customize</button>
        <span class="d-none gap-2" id="dashboardEditControls">
            <button type="button" class="btn btn-sm btn-primary" id="dashboardAddWidget">Add widget</button>
            <button type="button" class="btn btn-sm btn-outline-danger" id="dashboardResetLayout">Reset layout</button>
            <button type="button" class="btn btn-sm btn-success" id="dashboardDone">Done</button>
        </span>
    </div>
</div>

<div class="alert alert-warning py-2 small d-none" id="dashboardLayoutStatus" role="status"></div>

@* dashboard-widgets.js builds the user's saved layout here. *@
<div class="grid-stack dashboard-grid" id="dashboardGrid"></div>

@* The original dashboard sections, server-rendered as before and kept up to date by dashboard.js.
   dashboard-widgets.js moves each one into its widget when that widget is on the user's layout;
   sections not on the layout stay here, hidden. *@
<div id="dashboardWidgetPool" class="d-none">
<div data-widget-body="summary">
<div class="row g-3" id="dashboardSummary">
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6" id="dashRecordingCount">@RecordingCount</div>
                <div class="text-muted small">Recording</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 @(NotReportingCount > 0 ? "text-danger" : "")" id="dashNotReportingCount">@NotReportingCount</div>
                <div class="text-muted small">Not reporting</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 text-muted" id="dashDisabledCount">@DisabledCount</div>
                <div class="text-muted small">Disabled</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 @(NodesOnlineCount < NodesTotalCount ? "text-danger" : "")" id="dashNodesOnline">@NodesOnlineCount / @NodesTotalCount</div>
                <div class="text-muted small">Nodes online</div>
            </div>
        </div>
    </div>
</div>

@* One card per node. dashboard.js renderNodes() re-renders this from /api/dashboard with the same
   markup — keep the two in step (this is only the pre-JS first paint). *@
</div>

<div data-widget-body="node-cards">
<div class="row g-3" id="dashboardNodes">
    @foreach (var n in Nodes)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">@n.NodeName</span>
                        <span class="badge @(n.Online ? "text-bg-success" : "text-bg-secondary")">@(n.Online ? "online" : "offline")</span>
                    </div>
                    @if (n.HostStatsFresh)
                    {
                        <div class="small mb-1">CPU <span class="float-end">@Percent(n.CpuPercent)</span></div>
                        <div class="progress mb-2" style="height: 6px;"><div class="progress-bar @BarClass(n.CpuPercent)" style="width: @BarWidth(n.CpuPercent)%"></div></div>
                        <div class="small mb-1">Memory <span class="float-end">@Gigabytes(n.MemoryUsedBytes) / @Gigabytes(n.MemoryTotalBytes) GB</span></div>
                        <div class="progress mb-2" style="height: 6px;"><div class="progress-bar @BarClass(MemoryPercent(n))" style="width: @BarWidth(MemoryPercent(n))%"></div></div>
                        <div class="small mb-1">Network <span class="float-end">↓ @Mbits(n.NetReceiveBytesPerSec) · ↑ @Mbits(n.NetSendBytesPerSec) Mbit/s</span></div>
                    }
                    else
                    {
                        <div class="small text-muted mb-1">No load figures from this node yet.</div>
                    }
                    <div class="small mb-1">Recording <span class="float-end">@n.TotalFps fps from @n.CamerasReporting camera(s)</span></div>
                    @if (n.ObjectDetectionEnabled && n.Events is not null)
                    {
                        <table class="table table-sm small mb-0 mt-2">
                            <thead><tr><th></th><th class="text-end">1 h</th><th class="text-end">24 h</th><th class="text-end">7 d</th><th class="text-end">30 d</th></tr></thead>
                            <tbody>
                                @foreach (var (label, counts) in CountRows(n))
                                {
                                    <tr>
                                        <td>@label</td>
                                        <td class="text-end">@counts.LastHour.ToString("N0")</td>
                                        <td class="text-end">@counts.Last24Hours.ToString("N0")</td>
                                        <td class="text-end">@counts.Last7Days.ToString("N0")</td>
                                        <td class="text-end">@counts.Last30Days.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
</div>
</div>

<div data-widget-body="camera-table">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    @* Persisted server-side (see user-preferences.js) so the choice survives a reload and follows the
       signed-in user across devices — same convention as the theme toggle. Kept as its own switch
       rather than folded into the generic column picker: showing a thumbnail is a heavier per-row
       network fetch, not just a display toggle on data already present. *@
    @* Hidden for now (THUMBNAILS_ENABLED in dashboard.js) — the switch and the thumbnail column are
       kept so the option can come back without rebuilding it. *@
    <div class="form-check form-switch mb-0 d-none">
        <input class="form-check-input" type="checkbox" role="switch" id="dashboardThumbToggle">
        <label class="form-check-label" for="dashboardThumbToggle">Show thumbnails</label>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label small mb-0" for="dashboardPageSize">Rows per page</label>
        <select id="dashboardPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="dashboardTable">
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="all">All</option>
        </select>
        <ColumnPicker TableId="dashboardTable" />
    </div>
</div>

<style>
    /* Column stays structurally present at all times (see the toggle's own comment above) — hiding
       it is purely visual. Both the header and every row's cell share this class. */
    #dashboardTable.hide-thumb-col .thumb-col { display: none; }
</style>

<p class="text-muted" id="dashboardEmptyMessage" style="@(Rows.Count == 0 ? "" : "display:none;")">
    No cameras yet — add one from <a href="/Cameras">Cameras</a>.
</p>

<div class="table-responsive" id="dashboardTableWrap" style="@(Rows.Count == 0 ? "display:none;" : "")">
    <table class="table table-hover align-middle hide-thumb-col" id="dashboardTable" data-sortable data-paginate data-column-picker>
        <thead>
            <tr>
                <th class="thumb-col" data-no-sort>Thumbnail</th>
                <th>Camera</th>
                <th data-col="node">Node</th>
                <th data-no-sort>Status</th>
                <th class="text-end" data-sort-numeric data-col="fps">FPS</th>
                <th class="text-end" data-sort-numeric data-col="bitrate">Bitrate</th>
                @* Sorted by sample rate, the only numeric part of the cell. *@
                <th data-sort-numeric data-col="audio">Audio</th>
                <th class="text-end" data-sort-numeric data-col="reconnects">Reconnects</th>
                <th data-sort-numeric data-col="lastreport">Last report</th>
            </tr>
        </thead>
        <tbody id="dashboardTableBody">
            @foreach (var r in Rows)
            {
                <tr data-camera-id="@r.CameraId">
                    <td class="thumb-col"></td>
                    <td><a href="/Cameras/Edit/@r.CameraId">@r.CameraName</a></td>
                    <td>
                        @if (!r.NodeAssigned)
                        {
                            <span class="text-muted">unassigned</span>
                        }
                        else
                        {
                            @r.NodeName
                            <span class="badge @(r.NodeOnline ? "text-bg-success" : "text-bg-secondary") ms-1">@(r.NodeOnline ? "online" : "offline")</span>
                        }
                    </td>
                    <td>
                        @if (!r.CameraEnabled)
                        {
                            <span class="badge text-bg-secondary">Disabled</span>
                        }
                        else if (!r.NodeAssigned)
                        {
                            <span class="badge text-bg-warning">No node</span>
                        }
                        else if (r.HealthFresh)
                        {
                            <span class="badge text-bg-success">Recording</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Not reporting</span>
                        }
                        @if (r.EngineBuildFailed == true)
                        {
                            <text> </text><span class="badge text-bg-danger" title="AI detection failed to start — check the vision log">AI detection failed</span>
                        }
                        else if (r.IsEngineBuilding == true)
                        {
                            <text> </text><span class="badge text-bg-info"><span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Starting AI detection&hellip;</span>
                        }
                    </td>
                    <td class="text-end" data-sort-value="@(r.HealthFresh ? r.Fps : null)">@(r.HealthFresh ? r.Fps?.ToString() ?? "—" : "—")</td>
                    <td class="text-end" data-sort-value="@(r.HealthFresh ? r.BitrateKbps : null)">@(r.HealthFresh && r.BitrateKbps is { } kbps ? $"{kbps:N0} kbps" : "—")</td>
                    <td data-sort-value="@r.AudioSampleRateHz">@AudioSummary(r.AudioCodec, r.AudioSampleRateHz)</td>
                    <td class="text-end" data-sort-value="@r.ReconnectCount">@(r.ReconnectCount?.ToString() ?? "—")</td>
                    @* ApplicationDbContext's UtcDateTimeConverter already guarantees Kind=Utc here. *@
                    <td class="small text-muted" data-sort-value="@(r.HealthReportedAt.HasValue ? new DateTimeOffset(r.HealthReportedAt.Value).ToUnixTimeMilliseconds() : 0)">
                        @if (r.HealthReportedAt is { } reported)
                        {
                            <span title="@reported.ToString("u")">@reported.ToLocalTime().ToString("g")</span>
                        }
                        else
                        {
                            <span>never</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div data-paginate-controls-for="dashboardTable" class="mt-2"></div>
</div>
</div>
</div>

@* Widget picker. *@
<div class="modal fade" id="dashboardAddModal" tabindex="-1" aria-labelledby="dashboardAddModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dashboardAddModalTitle">Add widgets</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dashboardAddList"></div>
        </div>
    </div>
</div>

@* Latest detections' type picker (its ⚙ button) — see dashboard-widgets.js. *@
<div class="modal fade" id="dashboardKindsModal" tabindex="-1" aria-labelledby="dashboardKindsTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dashboardKindsTitle">Show these detections</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dashboardKindsList"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary me-auto" id="dashboardKindsDefault">Defaults</button>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="dashboardKindsSave">Save</button>
            </div>
        </div>
    </div>
</div>

@* Full report behind a widget's title — see dashboard-report.js. *@
<div class="modal fade" id="dashboardReportModal" tabindex="-1" aria-labelledby="dashboardReportTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dashboardReportTitle">Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <input type="search" class="form-control form-control-sm" id="dashboardReportFilter"
                           placeholder="Filter by name, node or details" style="max-width: 280px;" aria-label="Filter" />
                    <select class="form-select form-select-sm w-auto" id="dashboardReportNode" aria-label="Node">
                        <option value="">All nodes</option>
                    </select>
                    <span class="small text-muted ms-auto" id="dashboardReportCount"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="dashboardReportCsv">Download CSV</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-2">
                        <thead id="dashboardReportHead">
                            <tr>
                                <th class="text-muted" style="width: 3rem;">#</th>
                                <th><button type="button" class="btn btn-link btn-sm p-0 text-reset fw-semibold text-decoration-none" data-report-sort="name">Name</button></th>
                                <th data-report-node-col><button type="button" class="btn btn-link btn-sm p-0 text-reset fw-semibold text-decoration-none" data-report-sort="node">Node</button></th>
                                <th>Details</th>
                                <th class="text-end"><button type="button" class="btn btn-link btn-sm p-0 text-reset fw-semibold text-decoration-none" data-report-sort="value" id="dashboardReportValueHeader">Value</button></th>
                            </tr>
                        </thead>
                        <tbody id="dashboardReportBody"></tbody>
                    </table>
                </div>
                <nav class="d-flex align-items-center gap-2" id="dashboardReportPager">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="dashboardReportPrev">&lsaquo; Previous</button>
                    <span class="small text-muted" id="dashboardReportPage"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="dashboardReportNext">Next &rsaquo;</button>
                </nav>
            </div>
        </div>
    </div>
</div>

@* Read by dashboard-widgets.js: the widgets this user may add, the default layout, and the nodes for
   the report popup's node filter. *@
<script type="application/json" id="dashboardConfig">@((MarkupString)ConfigJson)</script>

@* Renders after App.razor's global helper scripts (user-preferences.js etc.) via SectionOutlet,
   not inline here — dashboard.js depends on larisvmsPreferences already existing. GridStack and the
   widget scripts load before dashboard.js so the original sections are already in place in the grid
   when its first refresh runs. *@
<SectionContent SectionName="PageScripts">
    <script src="/lib/gridstack/dist/gridstack-all.js"></script>
    <script src="/js/dashboard-report.js"></script>
    <script src="/js/dashboard-widgets.js"></script>
    <script src="/js/dashboard.js"></script>
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }

    private List<LarisVMS.Core.Dtos.CameraHealthRow> Rows { get; set; } = [];
    private int RecordingCount { get; set; }
    private int NotReportingCount { get; set; }
    private int DisabledCount { get; set; }
    private int NodesOnlineCount { get; set; }
    private int NodesTotalCount { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());

        var health = await DashboardService.GetHealthAsync(user);
        Rows = health.Rows;
        RecordingCount = health.RecordingCount;
        NotReportingCount = health.NotReportingCount;
        DisabledCount = health.DisabledCount;
        NodesOnlineCount = health.NodesOnlineCount;
        NodesTotalCount = health.NodesTotalCount;
        Nodes = health.Nodes ?? [];

        var viewer = new DashboardViewer(user,
            CanViewAlerts: (await AuthorizationService.AuthorizeAsync(user, "Alerts.Edit")).Succeeded,
            CanOpenNodes: (await AuthorizationService.AuthorizeAsync(user, "Nodes.Edit")).Succeeded);
        // System.Text.Json's default encoder escapes <, > and &, so this is safe inside a <script> tag.
        ConfigJson = JsonSerializer.Serialize(new
        {
            available = DashboardWidgets.GetAvailable(viewer),
            defaultLayout = DashboardWidgetCatalog.DefaultLayout,
            nodes = Nodes.OrderBy(n => n.NodeName).Select(n => new { id = n.NodeId, name = n.NodeName }),
            detectionKinds = await DetectionKindOptionsAsync(),
            // For the Camera activity widget's camera picker — only cameras this user can review.
            activityCameras = await ActivityCamerasAsync(user),
        }, JsonSerializerOptions.Web);
    }

    private string ConfigJson { get; set; } = "{}";

    private async Task<List<object>> ActivityCamerasAsync(System.Security.Claims.ClaimsPrincipal user)
    {
        var accessible = await CameraAccess.GetAccessibleCameraIdsAsync(user, CameraAccessActions.Playback);
        return (await CameraService.ListAsync())
            .Where(c => accessible is null || accessible.Contains(c.Id))
            .OrderBy(c => c.Name)
            .Select(c => (object)new { id = c.Id, name = c.Name })
            .ToList();
    }

    /// <summary>The latest-detections widget's type choices: the same top-level types the Snapshots
    /// filter lists (camera classes, then AI categories not already covered by one), plus custom tags
    /// and plain motion. Plain motion is off by default.</summary>
    private async Task<List<object>> DetectionKindOptionsAsync()
    {
        var options = new List<object>();
        foreach (var kind in DetectionDisplay.AllKinds)
            options.Add(new { token = kind.ToString(), label = DetectionDisplay.Label(kind), emoji = DetectionDisplay.Emoji(kind), byDefault = true });
        var kindNames = DetectionDisplay.AllKinds.Select(k => k.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var categoryNames = (await TimelineService.GetDetectedObjectCategoriesAsync())
            .Select(category => category.Name)
            .Where(name => !kindNames.Contains(name));
        foreach (var name in categoryNames)
            options.Add(new { token = name, label = name, emoji = CocoCategoryMap.Emoji(name), byDefault = true });
        options.Add(new { token = LarisVMS.Infrastructure.Services.TimelineService.CustomTagKindToken, label = "Custom tags", emoji = "🏷️", byDefault = true });
        options.Add(new { token = DashboardWidgetCatalog.MotionKindToken, label = "Motion with nothing identified", emoji = EventColors.MotionEmoji, byDefault = false });
        return options;
    }

    private List<LarisVMS.Core.Dtos.NodeDashboardRow> Nodes { get; set; } = [];

    // Node card formatting — dashboard.js has matching helpers (percent, gigabytes, mbits, barClass)
    // and must produce the same text for the same values.
    private static string Percent(double? p) => p is { } v ? v.ToString("0", CultureInfo.InvariantCulture) + "%" : "—";
    private static string Gigabytes(long? bytes) => bytes is { } b ? (b / 1073741824.0).ToString("0.0", CultureInfo.InvariantCulture) : "—";
    private static string Mbits(long? bytesPerSec) => bytesPerSec is { } b ? (b * 8 / 1_000_000.0).ToString("0.0", CultureInfo.InvariantCulture) : "—";
    private static double? MemoryPercent(LarisVMS.Core.Dtos.NodeDashboardRow n) =>
        n.MemoryUsedBytes is { } used && n.MemoryTotalBytes is { } total && total > 0 ? 100.0 * used / total : null;
    private static string BarClass(double? p) => p switch { >= 90 => "bg-danger", >= 75 => "bg-warning", _ => "bg-success" };
    private static string BarWidth(double? p) => Math.Clamp(p ?? 0, 0, 100).ToString("0", CultureInfo.InvariantCulture);

    private static IEnumerable<(string Label, LarisVMS.Core.Dtos.WindowCounts Counts)> CountRows(LarisVMS.Core.Dtos.NodeDashboardRow n)
    {
        if (n.Events is { } e) yield return ("Events", e);
        if (n.Humans is { } h) yield return ("Humans", h);
        if (n.Vehicles is { } v) yield return ("Vehicles", v);
        if (n.Animals is { } a) yield return ("Animals", a);
    }

    // dashboard.js has to render the identical string for the same row (this markup is only the
    // pre-JS fallback — see dashboard.js's own header), so the two must agree exactly.
    private static string AudioSummary(string? codec, int? sampleRateHz)
    {
        if (string.IsNullOrWhiteSpace(codec)) return "—";
        if (sampleRateHz is not { } hz) return codec;
        return $"{codec} {(hz / 1000.0).ToString("0.#", CultureInfo.InvariantCulture)} kHz";
    }
}
