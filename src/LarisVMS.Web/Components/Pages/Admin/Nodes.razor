        DisableAiObjectDetection = form["DisableAiObjectDetection"].ToString() == "true";
        SnapshotField = FormStringOrNull(form["Snapshot"]);
        LocalModelNameOverrideField = FormStringOrNull(form["LocalModelNameOverride"]);
    }

