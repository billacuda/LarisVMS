        DFineWeightsOverrideField = FormStringOrNull(form["DFineWeightsOverride"]);
        YoloXSizeOverrideField = FormStringOrNull(form["YoloXSizeOverride"]);
        MaxFpsOverrideField = FormIntOrNull(form["MaxFpsOverride"]);
        AspectModeOverrideField = FormStringOrNull(form["AspectModeOverride"]);
        DFineTensorRtModeOverrideField = FormStringOrNull(form["DFineTensorRtModeOverride"]);
        BackendOverride = FormStringOrNull(form["BackendOverride"]);
        ExternalUrlOverride = FormStringOrNull(form["ExternalUrlOverride"]);
        ExternalModelOverride = FormStringOrNull(form["ExternalModelOverride"]);
        ExternalInputSizeOverride = FormIntOrNull(form["ExternalInputSizeOverride"]);
        ExternalApiKeyOverride = FormStringOrNull(form["ExternalApiKeyOverride"]);
        ArchiveRootPath = FormStringOrNull(form["ArchiveRootPath"]);
        ArchiveEnabledOverrideField = FormStringOrNull(form["ArchiveEnabledOverride"]);
        ArchiveRetentionDaysOverride = FormIntOrNull(form["ArchiveRetentionDaysOverride"]);
        DirectStreamingMode = FormStringOrNull(form["DirectStreamingMode"]);
        AllowInsecureClientEndpoint = FormStringOrNull(form["AllowInsecureClientEndpoint"]);
        ClientEndpointHost = FormStringOrNull(form["ClientEndpointHost"]);
        ClientCertPfxPath = FormStringOrNull(form["ClientCertPfxPath"]);
        ClientCertPfxPassword = FormStringOrNull(form["ClientCertPfxPassword"]);
        PrimaryProxyId = FormStringOrNull(form["PrimaryProxyId"]);
