@page "/Admin/Nodes"
@attribute [Authorize("Nodes.Edit")]
@using LarisVMS.Core
@using LarisVMS.Core.Entities
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using LarisVMS.Core.Security
@using LarisVMS.Web.Helpers
@using LarisVMS.Web.Services
@inject INodeService NodeService
@inject ICameraService CameraService
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IHttpClientFactory HttpFactory
@inject MediaRelayMetrics RelayMetrics
@inject IProxyService ProxyService
@inject NodeControlClient NodeControlClient
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager NavigationManager

<PageTitle>Nodes - @AppName</PageTitle>

<h1>Recorder nodes</h1>
<p class="text-muted">
    Recording runs in a separate Windows Service ("node") per the architecture plan, not inside this
    IIS-hosted app, so it survives app pool recycles and deploys. Install a node with
    <code>install-node.ps1</code> using the registration key from
    <a href="/Admin/Settings/Nodes">Admin &rarr; Settings &rarr; Nodes</a>. Once
    installed, a node updates itself once a build registered by <code>deploy.ps1</code> is approved
    on <a href="/Admin/NodeBuilds/Index">Admin &rarr; Node Builds</a> — no re-running the install
    script on every recorder machine.
</p>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(StatusIsError ? "alert-danger" : "alert-success")" role="status">@StatusMessage</div>
}

@if (NodeRows.Count == 0)
{
    <p class="text-muted">No nodes have registered yet.</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="nodesTable"
                   placeholder="Filter by name, IP, platform&hellip;" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="nodesPageSize">Rows per page</label>
            <select id="nodesPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="nodesTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
        </div>
    </div>

    @* One empty, properly-nested form per node row — HandleUpdateAsync's own fields all live in
       their natural <td> positions inside the table below and associate via the HTML5 form="..."
       attribute (cross-DOM association, not literal DOM nesting), the same proven pattern as
       Matrix.razor's per-role-column forms and Cameras/Index.razor's bulk-reassign form.
       A <form>/<EditForm> element can't validly wrap several <td> cells directly under a <tr>: a
       <form> start tag encountered while the HTML parser is "in table" gets inserted and then
       IMMEDIATELY popped off the stack of open elements per the HTML5 tree-construction algorithm —
       its own descendants (the row's inputs/selects) only ever associated with it through the
       legacy "form owner" fallback, never real DOM nesting. Plain browser forms tolerated that
       silently; Blazor's SSR form-postback tracking does not, and it corrupted every named-form
       postback on this page (not just update-node's own) until this was split out. *@
    @foreach (var n in NodeRows)
    {
        @* FormName must be unique per rendered form — Blazor throws "more than one named submit event
           with the name X" when a loop renders the same name twice. Because a unique name can't be
           referenced by [SupplyParameterFromForm(FormName = ...)] (that needs a compile-time
           constant), these handlers read their values off HttpContext.Request.Form instead; only the
           submitted row's own fields are in that collection, so no per-row prefixing is needed. *@
        <EditForm Model="this" FormName="@($"update-node-{n.Id}")" OnValidSubmit="HandleUpdateAsync" id="@($"update-form-{n.Id}")">
            @* Stale-save guard — see the Snapshot dictionary's own doc comment. Round-tripped
               verbatim; HandleUpdateAsync rejects the save outright if this node's config no longer
               matches what this hash was computed from. *@
            <input type="hidden" name="Id" value="@n.Id" />
            <input type="hidden" name="Snapshot" value="@Snapshot.GetValueOrDefault(n.Id)" />
        </EditForm>
    }

    <div class="table-responsive">
        <table class="table align-middle" id="nodesTable" data-sortable data-paginate>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>IP</th>
                    <th>Version</th>
                    <th>Platform</th>
                    <th data-no-sort>Encoders</th>
                    <th data-no-sort>AI accelerator</th>
                    <th data-no-sort>Detection model</th>
                    <th>Last seen</th>
                    <th data-sort-numeric>Cameras</th>
                    <th>Storage root</th>
                    <th data-sort-numeric>Storage usage</th>
                    <th data-sort-numeric>Retention (days)</th>
                    <th data-no-sort>Streaming &amp; failover</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in NodeRows)
                {
                    <tr>
                            <td style="min-width: 12rem;" data-sort-value="@n.Name">
                                <input name="Name" form="@($"update-form-{n.Id}")" class="form-control form-control-sm" value="@n.Name" required />
                            </td>
                            <td>
                                @{
                                    var stale = n.LastSeenAt is null || n.LastSeenAt < DateTime.UtcNow.AddMinutes(-2);
                                }
                                <span class="badge @(stale ? "text-bg-secondary" : "text-bg-success")">@n.Status</span>
                                @if (StaleCameraCountByNode.GetValueOrDefault(n.Id) is > 0 and var staleCount)
                                {
                                    var staleTooltip = string.Join("\n", StaleCamerasByNode[n.Id]
                                        .OrderBy(r => r.ClearsAtUtc)
                                        .Select(r => $"{r.CameraName} — falls off {r.ClearsAtUtc.ToLocalTime():g}"));
                                    <span class="ms-1" title="@staleTooltip">⚠️ @staleCount</span>
                                }
                                @if (n.StoragePressureActive)
                                {
                                    var since = n.StoragePressureSince?.ToLocalTime().ToString("g");
                                    <span class="ms-1 text-warning" title="This node's primary volume is over the storage watermark@(since is null ? "" : $" (since {since})") — its oldest footage is being archived early (or deleted, if archiving is unavailable) to keep the disk under the limit.">⚠️ storage full</span>
                                }
                                @if (string.IsNullOrWhiteSpace(n.StorageRootPath))
                                {
                                    <span class="ms-1 text-danger" title="This node has no storage path — it is recording nothing. Set a storage path below and save.">⚠️ no storage path — not recording</span>
                                }
                            </td>
                            <td class="font-monospace">@(n.LastIpAddress ?? "—")</td>
                            <td>@n.Version</td>
                            <td>@n.Platform</td>
                            <td>
                                @{
                                    var encoders = string.IsNullOrEmpty(n.DetectedEncodersJson)
                                        ? []
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(n.DetectedEncodersJson) ?? [];
                                }
                                @if (encoders.Count == 0)
                                {
                                    <span class="text-muted small" title="No successful ffmpeg -encoders probe reported yet — needs a heartbeat from a node running M17 or later.">none reported</span>
                                }
                                else
                                {
                                    foreach (var enc in encoders)
                                    {
                                        <span class="badge text-bg-secondary font-monospace">@enc</span>
                                    }
                                }
                            </td>
                            <td style="min-width: 9rem;">
                                <select name="AiAccelerator" form="@($"update-form-{n.Id}")" class="form-select form-select-sm" data-accel-select="@n.Id">
                                    <option value="" selected="@(n.AiAccelerator is null)">Auto</option>
                                    <option value="Nvidia" selected="@(n.AiAccelerator == AiAccelerator.Nvidia)">CUDA</option>
                                    <option value="TensorRt" selected="@(n.AiAccelerator == AiAccelerator.TensorRt)">TensorRT</option>
                                    <option value="Amd" selected="@(n.AiAccelerator == AiAccelerator.Amd)">DirectML</option>
                                    <option value="OpenVino" selected="@(n.AiAccelerator == AiAccelerator.OpenVino)">OpenVINO</option>
                                    <option value="Cpu" selected="@(n.AiAccelerator == AiAccelerator.Cpu)">CPU</option>
                                    <option value="MIGraphX" selected="@(n.AiAccelerator == AiAccelerator.MIGraphX)">MIGraphX (AMD) — future feature</option>
                                </select>
                                <div class="form-text text-warning" data-migraphx-notice="@n.Id" hidden="@(n.AiAccelerator != AiAccelerator.MIGraphX)">
                                    MIGraphX is not implemented yet — this node runs no AI-detection backend until a different choice is selected.
                                </div>
                                @{
                                    var detectedAccelerators = string.IsNullOrEmpty(n.DetectedAcceleratorsJson)
                                        ? []
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(n.DetectedAcceleratorsJson) ?? [];
                                }
                                <div class="mt-1">
                                    @if (detectedAccelerators.Count == 0)
                                    {
                                        <span class="text-muted small" title="No successful accelerator probe reported yet — needs a heartbeat from a node running this build or later.">none reported</span>
                                    }
                                    else
                                    {
                                        foreach (var accel in detectedAccelerators)
                                        {
                                            <span class="badge text-bg-secondary font-monospace">@accel</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td style="min-width: 9rem;">
                                <select name="ModelFamilyOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm">
                                    <option value="" selected="@(string.IsNullOrEmpty(ModelFamilyOverride.GetValueOrDefault(n.Id)))">
                                        (inherit — currently @EffectiveModelFamily.GetValueOrDefault(n.Id, "Auto"))
                                    </option>
                                    <option value="Auto" selected="@(ModelFamilyOverride.GetValueOrDefault(n.Id) == "Auto")">Auto (YOLOX)</option>
                                    <option value="YoloX" selected="@(ModelFamilyOverride.GetValueOrDefault(n.Id) == "YoloX")">YOLOX</option>
                                    <option value="DFine" selected="@(ModelFamilyOverride.GetValueOrDefault(n.Id) == "DFine")">D-FINE (experimental)</option>
                                    <option value="Custom" selected="@(ModelFamilyOverride.GetValueOrDefault(n.Id) == "Custom")">Custom (a model dropped into C:\ProgramData\LarisVMS\models)</option>
                                    <option value="RfDetr" disabled>RF-DETR (not yet available)</option>
                                </select>
                                @{ var savedLocalModel = LocalModelNameOverride.GetValueOrDefault(n.Id); }
                                <div class="input-group input-group-sm mt-1">
                                    <select name="LocalModelNameOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm" data-local-model-select="@n.Id"
                                            title="Detection.LocalModelName override — only used when the model family above resolves to Custom">
                                        <option value="" selected="@string.IsNullOrEmpty(savedLocalModel)">(inherit local model name)</option>
                                        @if (!string.IsNullOrEmpty(savedLocalModel))
                                        {
                                            <option value="@savedLocalModel" selected data-saved="true">@savedLocalModel (saved)</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-refresh-local-models="@n.Id">Refresh models</button>
                                </div>
                                <div class="form-text" data-local-models-status="@n.Id"></div>
                                @{ var yls = YoloXSizeOverride.GetValueOrDefault(n.Id); }
                                <select name="YoloXSizeOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1" title="YOLOX model size (only used when the family resolves to YOLOX)">
                                    <option value="" selected="@(string.IsNullOrEmpty(yls))">(inherit YOLOX size)</option>
                                    @foreach (var s in new[] { "Nano", "Tiny", "S", "M", "L", "X" })
                                    {
                                        <option value="@s" selected="@(yls == s)">YOLOX-@s</option>
                                    }
                                </select>
                                <input type="number" name="MaxFpsOverride" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1" min="0" max="60"
                                       placeholder="max fps (inherit)" title="Max detection frames/sec for this node — blank inherits the global setting"
                                       value="@(MaxFpsOverride.GetValueOrDefault(n.Id)?.ToString())" />
                                <select name="DFineWeightsOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1">
                                    <option value="" selected="@(string.IsNullOrEmpty(DFineWeightsOverride.GetValueOrDefault(n.Id)))">(inherit D-FINE weights)</option>
                                    <option value="Obj2Coco" selected="@(DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj2Coco")">Obj2Coco (small)</option>
                                    <option value="Obj2CocoMedium" selected="@(DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj2CocoMedium")">Obj2Coco (medium)</option>
                                    <option value="Obj365" selected="@(DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj365")">Obj365 (small)</option>
                                </select>
                                <select name="AspectModeOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1">
                                    <option value="" selected="@(string.IsNullOrEmpty(AspectModeOverride.GetValueOrDefault(n.Id)))">
                                        (inherit — currently @EffectiveAspectMode.GetValueOrDefault(n.Id, "Letterbox"))
                                    </option>
                                    <option value="Letterbox" selected="@(AspectModeOverride.GetValueOrDefault(n.Id) == "Letterbox")">Letterbox</option>
                                    <option value="Stretch" selected="@(AspectModeOverride.GetValueOrDefault(n.Id) == "Stretch")">Stretch</option>
                                    <option value="Slice" selected="@(AspectModeOverride.GetValueOrDefault(n.Id) == "Slice")">Slice (requires GPU preprocessing)</option>
                                </select>
                                <select name="DFineTensorRtModeOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1"
                                        title="How D-FINE uses TensorRT on this node — blank inherits the global setting">
                                    <option value="" selected="@(string.IsNullOrEmpty(DFineTensorRtModeOverride.GetValueOrDefault(n.Id)))">
                                        (inherit D-FINE TensorRT — currently @EffectiveDFineTensorRtMode.GetValueOrDefault(n.Id, "Off"))
                                    </option>
                                    <option value="Off" selected="@(DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "Off")">Off (plain CUDA)</option>
                                    <option value="FP32" selected="@(DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "FP32")">FP32</option>
                                    <option value="FP16" selected="@(DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "FP16")">FP16 (auto-falls back to FP32 on overflow)</option>
                                </select>
                                @{ var backendOv = DetectionBackendOverride.GetValueOrDefault(n.Id); }
                                <select name="BackendOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1"
                                        title="Which detection backend this node runs — blank inherits the global setting">
                                    <option value="" selected="@(string.IsNullOrEmpty(backendOv))">
                                        (inherit backend — currently @EffectiveDetectionBackend.GetValueOrDefault(n.Id, "BuiltIn"))
                                    </option>
                                    <option value="BuiltIn" selected="@(backendOv == "BuiltIn")">Built-in</option>
                                    <option value="ExternalHttp" selected="@(backendOv == "ExternalHttp")">External HTTP service</option>
                                </select>
                                <input name="ExternalUrlOverride" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1"
                                       value="@ExternalInferenceUrlOverride.GetValueOrDefault(n.Id)"
                                       placeholder="service URL override (inherit)"
                                       title="Only used when the backend above resolves to External HTTP. Blank inherits the global URL from Admin/Settings/Detection." />
                                <input name="ExternalModelOverride" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1"
                                       value="@ExternalInferenceModelOverride.GetValueOrDefault(n.Id)"
                                       placeholder="model override (inherit)"
                                       title="Only used when the backend above resolves to External HTTP. Blank inherits the global model." />
                                <input type="number" name="ExternalInputSizeOverride" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1" min="32" step="32"
                                       value="@(ExternalInferenceInputSizeOverride.GetValueOrDefault(n.Id)?.ToString())"
                                       placeholder="input size override (inherit)"
                                       title="The overridden model's square input size in pixels — must be a positive multiple of 32. Blank inherits the global value." />
                                <input name="ExternalApiKeyOverride" form="@($"update-form-{n.Id}")" type="password" autocomplete="new-password"
                                       class="form-control form-control-sm mt-1"
                                       placeholder="@(HasExternalInferenceApiKeyOverride.GetValueOrDefault(n.Id) ? "API key override (unchanged)" : "API key override (inherit)")"
                                       title="Only used when the backend above resolves to External HTTP. Blank leaves this alone — inherits the global key unless one was set here before. Write-only: never re-shown once saved." />
                            </td>
                            <td data-sort-value="@(n.LastSeenAt?.Ticks ?? 0)">
                                @if (n.LastSeenAt is { } seen)
                                {
                                    <span title="@seen.ToString("u")">@seen.ToLocalTime().ToString("g")</span>
                                }
                                else
                                {
                                    <span class="text-muted">never</span>
                                }
                                @if (n.ClockSkewSeconds is { } skew && Math.Abs(skew) > 60)
                                {
                                    <span class="ms-1" title="This node's own clock disagrees with the server's by about @Math.Round(skew) second(s) (measured @n.ClockSkewMeasuredAt?.ToLocalTime().ToString("g")) — check NTP/time sync on that machine.">⚠️ clock</span>
                                }
                            </td>
                            <td>@CameraCountByNode.GetValueOrDefault(n.Id, 0)</td>
                            <td style="min-width: 16rem;" data-sort-value="@n.StorageRootPath">
                                <input name="StorageRootPath" form="@($"update-form-{n.Id}")" class="form-control form-control-sm font-monospace"
                                       value="@n.StorageRootPath" placeholder="e.g. E:\LarisVMS\recordings" required
                                       title="Where this node records to. Required — a node with no storage path records nothing." />
                                <input name="ArchiveRootPath" form="@($"update-form-{n.Id}")" class="form-control form-control-sm font-monospace mt-1"
                                       value="@n.ArchiveRootPath" placeholder="archive volume (optional)"
                                       title="Optional secondary (SMB / USB) volume for aged-out footage. Must be a separate location from the recording path above." />
                            </td>
                            <td style="min-width: 12rem;" data-sort-value="@((n.StorageTotalBytes is { } t && n.StorageFreeBytes is { } f) ? t - f : -1)">
                                @if (n.StorageTotalBytes is { } total && n.StorageFreeBytes is { } free)
                                {
                                    var usedPercent = total > 0 ? 100.0 * (total - free) / total : 0;
                                    <div class="progress" style="height: 0.5rem;" title="@ByteFormat.Format(total - free) used of @ByteFormat.Format(total)">
                                        <div class="progress-bar @(usedPercent > 90 ? "bg-danger" : usedPercent > 75 ? "bg-warning" : "")"
                                             style="width: @usedPercent.ToString("0.#")%"></div>
                                    </div>
                                    <span class="small text-muted">
                                        @ByteFormat.Format(free) free
                                        @if (DaysRemaining.GetValueOrDefault(n.Id) is { } days)
                                        {
                                            <text>&middot; ~@days.ToString("0") day(s) left</text>
                                        }
                                        else
                                        {
                                            <text>&middot; <span title="Needs about a day of recording history to estimate">runway not yet estimated</span></text>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">no report yet</span>
                                }
                                @if (n.ArchiveTotalBytes is { } aTotal && n.ArchiveFreeBytes is { } aFree)
                                {
                                    var aUsedPercent = aTotal > 0 ? 100.0 * (aTotal - aFree) / aTotal : 0;
                                    <div class="progress mt-1" style="height: 0.5rem;" title="Archive volume: @ByteFormat.Format(aTotal - aFree) used of @ByteFormat.Format(aTotal)">
                                        <div class="progress-bar bg-secondary" style="width: @aUsedPercent.ToString("0.#")%"></div>
                                    </div>
                                    <span class="small text-muted">
                                        archive: @ByteFormat.Format(aFree) free
                                        @if (ArchiveDaysRemaining.GetValueOrDefault(n.Id) is { } aDays)
                                        {
                                            <text>&middot; ~@aDays.ToString("0") day(s) left</text>
                                        }
                                        else
                                        {
                                            <text>&middot; <span title="Needs about a day of archiving activity to estimate">runway not yet estimated</span></text>
                                        }
                                    </span>
                                }
                            </td>
                            <td style="min-width: 8rem;" data-sort-value="@EffectiveRetentionDays.GetValueOrDefault(n.Id, 30)">
                                <input name="RetentionDaysOverride" form="@($"update-form-{n.Id}")" type="number" min="0" class="form-control form-control-sm"
                                       value="@RetentionOverride.GetValueOrDefault(n.Id)"
                                       placeholder="(global: @EffectiveRetentionDays.GetValueOrDefault(n.Id, 30))" />
                                @{ var archEn = ArchiveEnabledOverride.GetValueOrDefault(n.Id, ""); }
                                <select name="ArchiveEnabledOverride" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1"
                                        title="Whether aged-out footage on this node is archived rather than deleted">
                                    <option value="" selected="@(archEn == "")">archive: inherit (@(EffectiveArchiveEnabled.GetValueOrDefault(n.Id) ? "on" : "off"))</option>
                                    <option value="True" selected="@(archEn == "True")">archive: on</option>
                                    <option value="False" selected="@(archEn == "False")">archive: off</option>
                                </select>
                                <input name="ArchiveRetentionDaysOverride" form="@($"update-form-{n.Id}")" type="number" min="0" class="form-control form-control-sm mt-1"
                                       value="@ArchiveRetentionOverride.GetValueOrDefault(n.Id)"
                                       placeholder="archive days (global: @EffectiveArchiveRetentionDays.GetValueOrDefault(n.Id, 0))"
                                       title="How long footage stays on the archive volume, from its original record date. 0 = keep forever." />
                            </td>
                            <td style="min-width: 13rem;">
                                @{
                                    var dsm = n.DirectStreamingMode ?? "";
                                    var ins = n.AllowInsecureClientEndpoint;
                                }
                                <select name="DirectStreamingMode" form="@($"update-form-{n.Id}")" class="form-select form-select-sm"
                                        title="Where this node's live/playback bytes flow">
                                    <option value="" selected="@(dsm == "")">inherit (@GlobalDirectStreaming)</option>
                                    <option value="Proxy" selected="@(dsm == "Proxy")">Proxy</option>
                                    <option value="Direct" selected="@(dsm == "Direct")">Direct</option>
                                </select>
                                <input name="ClientEndpointHost" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1"
                                       value="@n.ClientEndpointHost" placeholder="client endpoint FQDN" />
                                <input name="ClientCertPfxPath" form="@($"update-form-{n.Id}")" class="form-control form-control-sm mt-1"
                                       value="@n.ClientCertPfxPath" placeholder="cert .pfx path (optional)" />
                                <input name="ClientCertPfxPassword" form="@($"update-form-{n.Id}")" type="password" autocomplete="new-password"
                                       class="form-control form-control-sm mt-1" placeholder="pfx password (unchanged)" />
                                <select name="AllowInsecureClientEndpoint" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1"
                                        title="Allow a self-signed certificate on this node's client endpoint">
                                    <option value="" selected="@(ins is null)">insecure: inherit (@(GlobalAllowInsecureClientEndpoint ? "allow" : "block"))</option>
                                    <option value="true" selected="@(ins == true)">insecure: allow</option>
                                    <option value="false" selected="@(ins == false)">insecure: block</option>
                                </select>
                                @if (AvailableProxies.Count > 0)
                                {
                                    <select name="PrimaryProxyId" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1" title="Route this node's cameras through this media proxy">
                                        <option value="" selected="@(n.PrimaryProxyId is null)">no proxy (direct / central)</option>
                                        @foreach (var px in AvailableProxies)
                                        {
                                            <option value="@px.Id" selected="@(n.PrimaryProxyId == px.Id)">via @px.Name</option>
                                        }
                                    </select>
                                    <select name="BackupProxyId" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1" title="Used when the primary proxy is unhealthy">
                                        <option value="" selected="@(n.BackupProxyId is null)">no backup proxy</option>
                                        @foreach (var px in AvailableProxies)
                                        {
                                            <option value="@px.Id" selected="@(n.BackupProxyId == px.Id)">backup: @px.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" name="PrimaryProxyId" form="@($"update-form-{n.Id}")" value="@(n.PrimaryProxyId?.ToString() ?? "")" />
                                    <input type="hidden" name="BackupProxyId" form="@($"update-form-{n.Id}")" value="@(n.BackupProxyId?.ToString() ?? "")" />
                                }

                                @{
                                    var otherNodes = NodeRows.Where(x => x.Id != n.Id).ToList();
                                    var backup = n.BackupNodeId is { } bnid ? NodeRows.FirstOrDefault(x => x.Id == bnid) : null;
                                    string AccelLabel(Node x) =>
                                        x.AiAccelerator?.ToString()
                                        ?? (string.IsNullOrWhiteSpace(x.DetectedAcceleratorsJson) || x.DetectedAcceleratorsJson == "[]" ? "none/CPU" : x.DetectedAcceleratorsJson.Trim('[', ']', '"'));
                                    var hwMismatch = backup is not null && !string.Equals(AccelLabel(backup), AccelLabel(n), StringComparison.OrdinalIgnoreCase);
                                }
                                <select name="BackupNodeId" form="@($"update-form-{n.Id}")" class="form-select form-select-sm mt-1"
                                        title="Recording failover: this node's cameras move here for recording while it is down">
                                    <option value="" selected="@(n.BackupNodeId is null)">no backup node (recording stops if down)</option>
                                    @foreach (var bn in otherNodes)
                                    {
                                        <option value="@bn.Id" selected="@(n.BackupNodeId == bn.Id)">fails over to @bn.Name</option>
                                    }
                                </select>
                                <div class="form-check form-check-sm mt-1">
                                    <input class="form-check-input" type="checkbox" name="DisableAiObjectDetection" value="true" form="@($"update-form-{n.Id}")"
                                           id="recOnly_@n.Id" checked="@n.DisableAiObjectDetection" />
                                    <label class="form-check-label small" for="recOnly_@n.Id"
                                           title="Never run AI object detection on this node — it still records continuously and tags ONVIF events">
                                        recording only (AI detection off)
                                    </label>
                                </div>
                                @if (hwMismatch && backup is not null)
                                {
                                    <div class="small text-warning mt-1" title="During a failover, AI detection and hardware transcoding for this node's cameras may be slower or unavailable on the backup.">
                                        ⚠️ backup @backup.Name has different acceleration (@AccelLabel(n) vs @AccelLabel(backup))
                                    </div>
                                }
                                @if (backup is { DisableAiObjectDetection: true })
                                {
                                    <div class="small text-warning mt-1">⚠️ backup @backup.Name is recording-only — object detection pauses for this node's cameras during a failover</div>
                                }
                                @{
                                    var (fBadge, fText) = n.FailoverState switch
                                    {
                                        NodeFailoverState.FailedOverAway when n.FailoverReason == NodeFailoverReason.Maintenance
                                            => ("text-bg-warning", "in maintenance — cameras on backup"),
                                        NodeFailoverState.FailedOverAway
                                            => ("text-bg-danger", "failed over — cameras on backup"),
                                        NodeFailoverState.HostingFailover
                                            => ("text-bg-info", "hosting failover cameras"),
                                        _ => ("", ""),
                                    };
                                }
                                @if (fText.Length > 0)
                                {
                                    <div class="mt-1"><span class="badge @fBadge">@fText</span>
                                        @if (n.FailoverSinceUtc is { } fsince)
                                        {
                                            <span class="text-muted small" title="@fsince.ToString("u")"> since @fsince.ToLocalTime().ToString("g")</span>
                                        }
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    @if (n.ClientEndpointReportedPort is { } cePort)
                                    {
                                        <text>endpoint&nbsp;:@cePort</text>
                                        @if (n.ClientEndpointCertNotAfter is { } na)
                                        {
                                            <text> &middot; cert to @na.ToLocalTime().ToString("d")</text>
                                        }
                                        @if (n.ClientEndpointCertIsSelfSigned == true)
                                        {
                                            <span class="text-warning"> &middot; self-signed</span>
                                        }
                                    }
                                    else
                                    {
                                        <text>no client endpoint running</text>
                                    }
                                    @if (!string.IsNullOrEmpty(n.ClientEndpointLastError))
                                    {
                                        <div class="text-danger" title="@n.ClientEndpointLastError">⚠️ endpoint error</div>
                                    }
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="submit" form="@($"update-form-{n.Id}")" class="btn btn-sm btn-outline-primary"><span aria-hidden="true">💾</span> Save</button>
                            </td>
                        <td class="text-end text-nowrap">
                            @* Restarts the node's Windows Service only — never the machine it runs on.
                               Confirmed because recording on this node's cameras stops for the few
                               seconds it takes to come back. *@
                            <EditForm Model="this" FormName="@($"restart-node-{n.Id}")" OnValidSubmit="HandleRestartAsync" class="d-inline">
                                <input type="hidden" name="RestartId" value="@n.Id" />
                                @* onclick, not onsubmit on the EditForm — a bare on* attribute on a
                                   component matches its parameters case-insensitively, and EditForm
                                   already has its own OnSubmit/OnValidSubmit parameter, so onsubmit
                                   here would silently rebind that instead of passing through as a
                                   literal HTML attribute (RZ9986/CS1503 either way). onclick on the
                                   plain <button> element below has no such collision — same pattern
                                   already proven on Bookmarks/Groups/Cameras' own delete buttons. *@
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Restart this node's service (not the machine)"
                                        onclick="@ConfirmRestart(n.Name, CameraCountByNode.GetValueOrDefault(n.Id))"><span aria-hidden="true">🔄</span> Restart</button>
                            </EditForm>
                            @* Failover plan phase 5: clears a wedged rolling check-in nonce (a
                               heartbeat response the node never received). Harmless if the node is
                               healthy — it just re-syncs the nonce on its next cycle. *@
                            <EditForm Model="this" FormName="@($"reset-node-auth-{n.Id}")" OnValidSubmit="HandleResetAuthAsync" class="d-inline">
                                <input type="hidden" name="ResetAuthId" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Clear this node's rolling check-in nonce (recovery for a locked-out node)"
                                        onclick="@ConfirmResetAuth(n.Name)"><span aria-hidden="true">🔑</span> Reset auth</button>
                            </EditForm>
                            @* Failover plan phase 3: maintenance mode — fails this node's cameras over
                               to its backup and holds them there until turned off. *@
                            @{
                                var maintCams = CameraCountByNode.GetValueOrDefault(n.Id);
                                var maintBackup = n.BackupNodeId is { } mbid ? NodeRows.FirstOrDefault(x => x.Id == mbid)?.Name : null;
                            }
                            <EditForm Model="this" FormName="@($"set-node-maintenance-{n.Id}")" OnValidSubmit="HandleSetMaintenanceAsync" class="d-inline">
                                <input type="hidden" name="MaintenanceId" value="@n.Id" />
                                <input type="hidden" name="MaintenanceEnabled" value="@((!n.MaintenanceMode).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn btn-sm @(n.MaintenanceMode ? "btn-warning" : "btn-outline-warning")"
                                        title="@(n.MaintenanceMode ? "End maintenance mode" : "Fail this node's cameras over to its backup for maintenance")"
                                        onclick="@ConfirmMaintenance(n.MaintenanceMode, maintCams, maintBackup)">
                                    <span aria-hidden="true">🛠️</span> @(n.MaintenanceMode ? "End maintenance" : "Maintenance")
                                </button>
                            </EditForm>
                            <EditForm Model="this" FormName="@($"delete-node-{n.Id}")" OnValidSubmit="HandleDeleteAsync" class="d-inline">
                                <input type="hidden" name="DeleteId" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="@ConfirmDelete(n.Name)"><span aria-hidden="true">🗑️</span> Delete</button>
                            </EditForm>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="nodesTable" class="mt-2"></div>

    <div class="card mt-3" style="max-width: 640px;">
        <div class="card-body py-2">
            <h6 class="card-title mb-1">Streaming relay (since @RelayMetrics.SinceUtc.ToLocalTime().ToString("g"))</h6>
            <p class="card-text small text-muted mb-0">
                Live streams relayed through this server right now: <strong>@RelayMetrics.ActiveLiveRelays</strong>
                (@RelayMetrics.LiveRelaysStarted total) &middot;
                playback segments proxied: <strong>@RelayMetrics.PlaybackSegmentsProxied</strong>
                (@ByteFormat.Format(RelayMetrics.PlaybackBytesProxied)).
                With <a href="/Admin/Settings/LiveView">direct streaming</a> on, these trend toward zero.
            </p>
        </div>
    </div>

    <p class="text-muted small mt-3">
        Every node records to its own storage path (there is no global default) — usually set when the
        node is installed (<code>install-node.ps1 -StorageRoot …</code>), editable here. The archive
        volume is optional and must be a separate location. A node with no storage path records
        nothing until one is set.
        Blank retention inherits the <a href="/Admin/Settings/StorageAndRetention">global default</a>; a value here
        overrides it for every camera on this node unless that camera has its own override too. "Days
        left" is a rough estimate from this node's write rate over the last 24h, not disk health. The
        ⚠️ count next to a node's status is how many cameras have footage still sitting on this node
        after being reassigned elsewhere or removed — hover it for which cameras and when each one's
        leftover footage ages out of retention (which is what clears the warning on its own, with
        nothing to do here) — see <a href="/Cameras">Cameras</a> for which ones.
    </p>
}

<SectionContent SectionName="PageScripts">
    <script>
        // MIGraphX is a placeholder entry (AMD's next-gen accelerator, not implemented yet) — show/hide
        // the "future feature" notice live as the operator changes the selection, not just on page load.
        document.querySelectorAll('[data-accel-select]').forEach(function (select) {
            select.addEventListener('change', function () {
                var notice = document.querySelector('[data-migraphx-notice="' + select.getAttribute('data-accel-select') + '"]');
                if (notice) notice.hidden = select.value !== 'MIGraphX';
            });
        });

        // Model-agnostic ("Custom" family) local-model picker: "Refresh models" probes this node's own
        // /vision/models via the admin vision-models API and repopulates the <select> with what
        // LarisVMS.Vision.Models.ModelDiscovery found, showing a warning next to any model whose
        // metadata/sidecar didn't resolve rather than hiding it.
        document.querySelectorAll('[data-refresh-local-models]').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var id = btn.getAttribute('data-refresh-local-models');
                var status = document.querySelector('[data-local-models-status="' + id + '"]');
                var select = document.querySelector('[data-local-model-select="' + id + '"]');
                btn.disabled = true;
                status.textContent = 'Refreshing…';
                try {
                    var resp = await fetch('/api/admin/nodes/' + encodeURIComponent(id) + '/vision-models', { headers: { 'Accept': 'application/json' } });
                    if (!resp.ok) { status.textContent = 'Could not reach this node.'; return; }
                    var models = await resp.json();
                    var previousValue = select.value;

                    // Rebuild from scratch: keep "(inherit)", drop the old "(saved)" placeholder (the
                    // refreshed list supersedes it), add one <option> per discovered model.
                    select.innerHTML = '';
                    var inheritOpt = document.createElement('option');
                    inheritOpt.value = '';
                    inheritOpt.textContent = '(inherit local model name)';
                    select.appendChild(inheritOpt);

                    models.forEach(function (m) {
                        var opt = document.createElement('option');
                        opt.value = m.name;
                        var label = m.name + ' — ' + (m.decoder || 'unresolved');
                        if (m.inputSize) label += ' (' + m.inputSize + 'x' + m.inputSize + ')';
                        if (m.warnings && m.warnings.length > 0) label += ' \u26a0\ufe0f ' + m.warnings.join(' ');
                        opt.textContent = label;
                        select.appendChild(opt);
                    });

                    // Keep whatever was selected before the refresh if it's still there — or, if the
                    // refresh didn't find it (e.g. it was only ever a "(saved)" placeholder for a node
                    // that was offline), re-add it rather than silently losing the current selection.
                    if (previousValue && ![...select.options].some(function (o) { return o.value === previousValue; })) {
                        var keepOpt = document.createElement('option');
                        keepOpt.value = previousValue;
                        keepOpt.textContent = previousValue + ' (saved — not found on this refresh)';
                        select.appendChild(keepOpt);
                    }
                    select.value = previousValue;

                    status.textContent = models.length === 0
                        ? 'No models found on this node (or it is unreachable) — drop an .onnx file into C:\\ProgramData\\LarisVMS\\models.'
                        : models.length + ' model(s) found.';
                } catch (e) {
                    status.textContent = 'Could not reach this node.';
                } finally {
                    btn.disabled = false;
                }
            });
        });
    </script>
</SectionContent>

@code {
    /// <summary>One row of the warning-emoji tooltip's detail list — ClearsAtUtc is when this camera's
    /// *last* remaining stale segment on this node ages past retention (see StaleSegmentDetail's own
    /// doc comment for why it's the newest segment, not the oldest, that determines this), which is
    /// the same moment the camera drops out of the warning on its own.</summary>
    private sealed record StaleCameraRow(string CameraName, DateTime ClearsAtUtc);

    /// <summary>Everything HandleUpdateAsync's stale-save guard needs about one node, computed once per
    /// node concurrently in LoadAsync (see that method's own comment) and then folded into the flat
    /// per-node dictionaries below.</summary>
    private sealed record NodeSettingsSnapshot(
        Guid NodeId, int EffectiveRetentionDays, int? RetentionOverride,
        string ArchiveEnabledOverride, bool EffectiveArchiveEnabled, int? ArchiveRetentionOverride, int EffectiveArchiveRetentionDays,
        string ModelFamilyOverride, string DFineWeightsOverride, string YoloXSizeOverride, string LocalModelNameOverride,
        int? MaxFpsOverride, string EffectiveModelFamily, string AspectModeOverride, string EffectiveAspectMode,
        string DFineTensorRtModeOverride, string EffectiveDFineTensorRtMode,
        string DetectionBackendOverride, string EffectiveDetectionBackend, string ExternalInferenceUrlOverride,
        string ExternalInferenceModelOverride, int? ExternalInferenceInputSizeOverride, bool HasExternalInferenceApiKeyOverride,
        string Snapshot);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private System.Security.Claims.ClaimsPrincipal User =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());

    [SupplyParameterFromQuery(Name = "statusMessage")] private string? QueryStatusMessage { get; set; }
    [SupplyParameterFromQuery(Name = "statusIsError")] private bool QueryStatusIsError { get; set; }

    // ── Update form fields ──────────────────────────────────────────────────────────────────────
    // FormName is unique per row (@($"update-node-{n.Id}")) so Blazor doesn't reject the page with
    // "more than one named submit event with the name X" — but [SupplyParameterFromForm] requires a
    // compile-time constant FormName, so it can't bind to a per-row name. These are populated
    // manually from HttpContext.Request.Form inside HandleUpdateAsync instead (see
    // PopulateUpdateFieldsFromForm) — only the submitted row's own fields are in that collection, so
    // no per-row prefixing is needed on the read side.
    private Guid Id { get; set; }
    private string Name { get; set; } = "";
    private string? StorageRootPath { get; set; }
    private int? RetentionDaysOverride { get; set; }
    // Renamed from the HTML field's own name (AiAccelerator): a property literally named
    // AiAccelerator would shadow the LarisVMS.Core.Enums.AiAccelerator enum TYPE for every
    // unqualified reference in this class (Enum.TryParse<AiAccelerator>, AiAccelerator.Nvidia, etc.)
    // — same class of collision as the Groups/Plugins.razor component-name lesson, just against an
    // enum type instead of a static class.
    private string? AiAcceleratorOverride { get; set; }
    // "Field" suffix: the unsuffixed name is already the read-side dictionary alias property below
    // (e.g. ModelFamilyOverride), and this property can't share its name.
    private string? ModelFamilyOverrideField { get; set; }
    private string? DFineWeightsOverrideField { get; set; }
    private string? YoloXSizeOverrideField { get; set; }
    private int? MaxFpsOverrideField { get; set; }
    private string? AspectModeOverrideField { get; set; }
    private string? DFineTensorRtModeOverrideField { get; set; }
    private string? BackendOverride { get; set; }
    private string? ExternalUrlOverride { get; set; }
    private string? ExternalModelOverride { get; set; }
    private int? ExternalInputSizeOverride { get; set; }
    private string? ExternalApiKeyOverride { get; set; }
    private string? ArchiveRootPath { get; set; }
