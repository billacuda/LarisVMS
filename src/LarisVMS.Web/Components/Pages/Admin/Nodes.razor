@page "/Admin/Nodes"
@attribute [Authorize("Nodes.Edit")]
@using LarisVMS.Core
@using LarisVMS.Core.Entities
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using LarisVMS.Core.Security
@using LarisVMS.Web.Helpers
@using LarisVMS.Web.Services
@inject INodeService NodeService
@inject ICameraService CameraService
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IHttpClientFactory HttpFactory
@inject MediaRelayMetrics RelayMetrics
@inject NavigationManager NavigationManager

<PageTitle>Nodes - @AppName</PageTitle>

<h1>Recorder nodes</h1>
<p class="text-muted">
    Each node is a Windows service that records its cameras. Click a node to edit its settings.
    <a href="/Help/nodes">How nodes work</a>
</p>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(StatusIsError ? "alert-danger" : "alert-success")" role="status">@StatusMessage</div>
}

@if (NodeRows.Count == 0)
{
    <p class="text-muted">No nodes have registered yet. See <a href="/Help/installation">Installation</a>.</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="nodesTable"
                   placeholder="Filter by name, IP, version&hellip;" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="nodesPageSize">Rows per page</label>
            <select id="nodesPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="nodesTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" id="nodesTable" data-sortable data-paginate>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>IP</th>
                    <th>Version</th>
                    <th data-sort-numeric>Cameras</th>
                    <th data-sort-numeric style="min-width: 12rem;">Storage</th>
                    <th>Last seen</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in NodeRows)
                {
                    var online = n.LastSeenAt is { } ls && ls >= DateTime.UtcNow.AddMinutes(-2);
                    var cams = CameraCountByNode.GetValueOrDefault(n.Id);
                    var backupName = n.BackupNodeId is { } bid ? NodeRows.FirstOrDefault(x => x.Id == bid)?.Name : null;
                    <tr>
                        <td data-sort-value="@n.Name"><a href="/Admin/Nodes/@n.Id" class="fw-semibold">@n.Name</a></td>
                        <td>
                            <span class="badge @(online ? "text-bg-success" : "text-bg-secondary")">@(online ? "online" : "offline")</span>
                            @if (n.FailoverState == NodeFailoverState.FailedOverAway)
                            {
                                <span class="badge @(n.FailoverReason == NodeFailoverReason.Maintenance ? "text-bg-warning" : "text-bg-danger")">
                                    @(n.FailoverReason == NodeFailoverReason.Maintenance ? "maintenance" : "failed over")
                                </span>
                            }
                            else if (n.FailoverState == NodeFailoverState.HostingFailover)
                            {
                                <span class="badge text-bg-info">hosting failover</span>
                            }
                            @if (StaleCameraCountByNode.GetValueOrDefault(n.Id) is > 0 and var staleCount)
                            {
                                var staleTooltip = "Leftover footage from cameras moved off this node; clears on its own as it ages out:\n" + string.Join("\n", StaleCamerasByNode[n.Id]
                                    .OrderBy(r => r.ClearsAtUtc)
                                    .Select(r => $"{r.CameraName} — falls off {r.ClearsAtUtc.ToLocalTime():g}"));
                                <span class="ms-1" title="@staleTooltip">⚠️ @staleCount</span>
                            }
                            @if (string.IsNullOrWhiteSpace(n.StorageRootPath))
                            {
                                <span class="ms-1 text-danger" title="No storage path set — this node is not recording.">⚠️ no storage path</span>
                            }
                            else if (n.StoragePressureActive)
                            {
                                <span class="ms-1 text-warning" title="Over the storage watermark — oldest footage is being archived or deleted early.">⚠️ storage full</span>
                            }
                        </td>
                        <td class="font-monospace">@(n.LastIpAddress ?? "—")</td>
                        <td>@n.Version</td>
                        <td>@cams</td>
                        <td data-sort-value="@((n.StorageTotalBytes is { } t && n.StorageFreeBytes is { } f) ? t - f : -1)">
                            <NodeStorageBar Node="n" DaysRemaining="DaysRemainingMap.GetValueOrDefault(n.Id)" ArchiveDaysRemaining="ArchiveDaysRemainingMap.GetValueOrDefault(n.Id)" />
                        </td>
                        <td data-sort-value="@(n.LastSeenAt?.Ticks ?? 0)">
                            @if (n.LastSeenAt is { } seen)
                            {
                                <span title="@seen.ToString("u")">@seen.ToLocalTime().ToString("g")</span>
                            }
                            else
                            {
                                <span class="text-muted">never</span>
                            }
                            @if (n.ClockSkewSeconds is { } skew && Math.Abs(skew) > 60)
                            {
                                <span class="ms-1" title="Clock is off by about @Math.Round(skew) s — check time sync on this machine.">⚠️ clock</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/Admin/Nodes/@n.Id">Edit</a>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions" data-bs-popper-config='{"strategy":"fixed"}'>⋯</button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    @* Each action is its own named form; the node edit page posts to these
                                       same handlers (see NodeActionForm.razor). onclick, not onsubmit — an
                                       on* attribute on EditForm would rebind its own OnSubmit parameter. *@
                                    <EditForm Model="this" FormName="@($"restart-node-{n.Id}")" OnValidSubmit="HandleRestartAsync">
                                        <input type="hidden" name="RestartId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item" onclick="@NodeConfirm.Restart(n.Name, cams)">🔄 Restart service</button>
                                    </EditForm>
                                    <EditForm Model="this" FormName="@($"reset-node-auth-{n.Id}")" OnValidSubmit="HandleResetAuthAsync">
                                        <input type="hidden" name="ResetAuthId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item" onclick="@NodeConfirm.ResetAuth(n.Name)">🔑 Reset auth</button>
                                    </EditForm>
                                    <EditForm Model="this" FormName="@($"set-node-maintenance-{n.Id}")" OnValidSubmit="HandleSetMaintenanceAsync">
                                        <input type="hidden" name="MaintenanceId" value="@n.Id" />
                                        <input type="hidden" name="MaintenanceEnabled" value="@((!n.MaintenanceMode).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="dropdown-item" onclick="@NodeConfirm.Maintenance(n.MaintenanceMode, cams, backupName)">
                                            🛠️ @(n.MaintenanceMode ? "End maintenance" : "Maintenance")
                                        </button>
                                    </EditForm>
                                    <div class="dropdown-divider"></div>
                                    <EditForm Model="this" FormName="@($"delete-node-{n.Id}")" OnValidSubmit="HandleDeleteAsync">
                                        <input type="hidden" name="DeleteId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item text-danger" onclick="@NodeConfirm.Delete(n.Name)">🗑️ Delete</button>
                                    </EditForm>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="nodesTable" class="mt-2"></div>

    <p class="small text-muted mt-3">
        Streaming relay since @RelayMetrics.SinceUtc.ToLocalTime().ToString("g"):
        <strong>@RelayMetrics.ActiveLiveRelays</strong> live stream(s) now (@RelayMetrics.LiveRelaysStarted total) &middot;
        <strong>@RelayMetrics.PlaybackSegmentsProxied</strong> playback segment(s) (@ByteFormat.Format(RelayMetrics.PlaybackBytesProxied)).
        <a href="/Help/nodes#direct-streaming">Direct streaming</a> reduces these.
    </p>
}

@code {
    /// <summary>One row of the stale-camera warning's tooltip — ClearsAtUtc is when this camera's last
    /// remaining segment on this node ages past retention, which clears the warning on its own.</summary>
    private sealed record StaleCameraRow(string CameraName, DateTime ClearsAtUtc);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private System.Security.Claims.ClaimsPrincipal User =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());

    [SupplyParameterFromQuery(Name = "statusMessage")] private string? QueryStatusMessage { get; set; }
    [SupplyParameterFromQuery(Name = "statusIsError")] private bool QueryStatusIsError { get; set; }

    // FormName is unique per row, and [SupplyParameterFromForm] needs a compile-time constant name,
    // so the action handlers read their values off HttpContext.Request.Form instead.
    private Guid RestartId { get; set; }
    private Guid ResetAuthId { get; set; }
    private Guid MaintenanceId { get; set; }
    private bool MaintenanceEnabled { get; set; }
    private Guid DeleteId { get; set; }

    private static Guid FormGuid(Microsoft.Extensions.Primitives.StringValues v) => Guid.TryParse(v.ToString(), out var g) ? g : Guid.Empty;

    private List<Node> NodeRows { get; set; } = [];
    private Dictionary<Guid, int> CameraCountByNode { get; set; } = [];
    private Dictionary<Guid, double?> DaysRemainingMap { get; set; } = [];
    private Dictionary<Guid, double?> ArchiveDaysRemainingMap { get; set; } = [];
    private Dictionary<Guid, int> StaleCameraCountByNode { get; set; } = [];
    private Dictionary<Guid, List<StaleCameraRow>> StaleCamerasByNode { get; set; } = [];
    private string? StatusMessage;
    private bool StatusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (!string.IsNullOrEmpty(QueryStatusMessage))
        {
            StatusMessage = QueryStatusMessage;
            StatusIsError = QueryStatusIsError;
        }
    }

    private async Task LoadAsync()
    {
        NodeRows = await NodeService.ListAsync();
        var cameras = await CameraService.ListAsync();
        CameraCountByNode = cameras
            .Where(c => c.NodeId is not null)
            .GroupBy(c => c.NodeId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        var staleDetails = await CameraService.GetStaleSegmentDetailsAsync();
        StaleCameraCountByNode = staleDetails
            .GroupBy(d => d.NodeId)
            .ToDictionary(g => g.Key, g => g.Count());

        StaleCamerasByNode = [];
        foreach (var d in staleDetails)
        {
            var retentionDays = await Settings.GetAsync<int?>("Retention.Days", 30, cameraId: d.CameraId, nodeId: d.NodeId);
            var clearsAtUtc = d.NewestSegmentEndUtc.AddDays(retentionDays ?? 30);
            if (!StaleCamerasByNode.TryGetValue(d.NodeId, out var rows))
                StaleCamerasByNode[d.NodeId] = rows = [];
            rows.Add(new StaleCameraRow(d.CameraName, clearsAtUtc));
        }

        DaysRemainingMap = await NodeService.GetEstimatedDaysRemainingAsync();
        ArchiveDaysRemainingMap = await NodeService.GetArchiveEstimatedDaysRemainingAsync();
    }

    private void NavigateBare(string? message = null, bool isError = false)
    {
        var url = message is null
            ? "/Admin/Nodes"
            : $"/Admin/Nodes?statusMessage={Uri.EscapeDataString(message)}&statusIsError={isError}";
        NavigationManager.NavigateTo(url);
    }

    /// <summary>Restarts a node's own Windows Service — not the machine. Proxied through this tier the
    /// same way every other Web→Node call is (the browser never talks to a node directly), authorized
    /// by a short-lived token signed with that node's own MediaSigningKey.
    ///
    /// Recording on this node's cameras stops for the few seconds the service is down, which is why
    /// this is behind Nodes.Edit and audited like any other node change.</summary>
    private async Task HandleRestartAsync()
    {
        RestartId = FormGuid(HttpContext?.Request.Form["RestartId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == RestartId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        if (node is not { LastIpAddress: { } ip, LivePort: { } port, MediaSigningKey: { } key })
        {
            NavigateBare($"{node.Name} hasn't reported its address yet — it needs at least one heartbeat before it can be restarted from here.", isError: true);
            return;
        }

        var token = MediaToken.IssueForNodeControl("restart", key, TimeSpan.FromSeconds(30));
        var client = HttpFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(15);

        try
        {
            var response = await client.SendAsync(MediaTokenRequest.Create(HttpMethod.Post,
                $"http://{ip}:{port}/restart?token={Uri.EscapeDataString(token)}", token));

            if (response.IsSuccessStatusCode)
            {
                await LogAsync("Node.Restart", $"{node.Name} ({RestartId})");
                NavigateBare($"{node.Name} is restarting. It should reappear as online within a minute.");
            }
            else
            {
                var body = (await response.Content.ReadAsStringAsync()).Trim();
                NavigateBare($"{node.Name} refused the restart ({(int)response.StatusCode})" +
                    (string.IsNullOrEmpty(body) ? "." : $": {body}"), isError: true);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            NavigateBare($"Could not reach {node.Name}: {ex.Message}", isError: true);
        }
    }

    /// <summary>Failover plan phase 5a: recovery for a node locked out because its rolling check-in
    /// nonce got out of sync (a heartbeat response the node never received — it keeps resending the
    /// stale nonce, which the server now rejects 401). Clears the stored nonce so the node's next
    /// check-in is accepted as a not-yet-nonced one and re-syncs. A no-op risk on a healthy node.</summary>
    private async Task HandleResetAuthAsync()
    {
        ResetAuthId = FormGuid(HttpContext?.Request.Form["ResetAuthId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == ResetAuthId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        await NodeService.ResetAuthAsync(ResetAuthId, rotateSecretNow: false);
        await LogAsync("Node.ResetAuth", $"{node.Name} ({ResetAuthId}) — check-in nonce cleared");
        NavigateBare($"{node.Name}: check-in nonce cleared. If it was locked out, it should re-sync within a heartbeat cycle.");
    }

    /// <summary>Failover plan phase 3: toggle a node into/out of maintenance mode. On = its cameras fail
    /// over to its backup node on RecordingFailoverService's next tick (~15s) and stay there until
    /// turned off, regardless of the node's own health. Confirm dialog is client-side.</summary>
    private async Task HandleSetMaintenanceAsync()
    {
        var maintForm = HttpContext?.Request.Form;
        MaintenanceId = FormGuid(maintForm?["MaintenanceId"] ?? default);
        MaintenanceEnabled = maintForm?["MaintenanceEnabled"].ToString() == "true";
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == MaintenanceId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        await NodeService.SetMaintenanceAsync(MaintenanceId, MaintenanceEnabled, User.Identity?.Name);
        await LogAsync(MaintenanceEnabled ? "Node.MaintenanceEntered" : "Node.MaintenanceExited", $"{node.Name} ({MaintenanceId})");
        NavigateBare(MaintenanceEnabled
            ? $"{node.Name} is in maintenance — its cameras move to its backup node within ~15 seconds and stay there until you turn maintenance off."
            : $"{node.Name} left maintenance — its cameras return to it once it is a confirmed-healthy quorum (or immediately if it stayed healthy).");
    }

    private async Task HandleDeleteAsync()
    {
        DeleteId = FormGuid(HttpContext?.Request.Form["DeleteId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == DeleteId);
        await NodeService.DeleteAsync(DeleteId);
        await LogAsync("Node.Delete", $"{node?.Name ?? "?"} ({DeleteId})");
        NavigateBare();
    }

    private Task LogAsync(string action, string details) =>
        AuditService.LogAsync(action, User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            User.Identity?.Name, HttpContext?.Connection.RemoteIpAddress?.ToString(), details);
}
