@page "/Admin/Nodes"
@attribute [Authorize("Nodes.Edit")]
@using LarisVMS.Core
@using LarisVMS.Core.Entities
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using LarisVMS.Core.Security
@using LarisVMS.Web.Helpers
@using LarisVMS.Web.Services
@inject INodeService NodeService
@inject ICameraService CameraService
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IHttpClientFactory HttpFactory
@inject MediaRelayMetrics RelayMetrics
@inject NavigationManager NavigationManager
@inject IPermissionService PermissionService
@inject INodeBuildService NodeBuildService
@inject ISetupService SetupService
@inject LarisVMS.Relay.CertHolder Certificates

<PageTitle>Nodes - @AppName</PageTitle>

<h1>Nodes</h1>
<p class="text-muted">
    Each node is a Windows service that records its cameras. Click a node to edit its settings.
    <a href="/Help/nodes">How nodes work</a>
</p>
<nav class="d-flex flex-wrap gap-2 mb-3 small" aria-label="On this page">
    <a href="#nodes">Recorder nodes</a> &middot; <a href="#builds">Builds</a>
    @if (CanEditSettings) { <text>&middot; <a href="#settings">Updates and registration</a></text> }
</nav>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(StatusIsError ? "alert-danger" : "alert-success")" role="status">@StatusMessage</div>
}

@if (NodesBehindCertificateChange.Count > 0)
{
    <div class="alert alert-warning" role="status">
        The server's self-signed certificate changed on
        <time datetime="@CertificateChangedAt!.Value.ToUtcIso()" data-local="g">@CertificateChangedAt.Value.ToLocalTime().ToString("g")</time>.
        These nodes haven't checked in since and need to be re-registered (run the node installer again, or
        <code>LarisVMS.Node.exe --reset-server-pin</code> on the node):
        @string.Join(", ", NodesBehindCertificateChange)
    </div>
}

@if (MissingNodeStaleCameras.Count > 0)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="status">
        <span>
            Footage records for @string.Join(", ", MissingNodeStaleCameras) belong to a node that no longer exists,
            so nothing can confirm their deletion.
        </span>
        <EditForm Model="this" FormName="forget-missing-node-segments" OnValidSubmit="HandleForgetMissingNodeSegmentsAsync">
            <button type="submit" class="btn btn-sm btn-outline-danger"
                    data-confirm="Remove these footage records? Any files left on that node's storage are not touched.">
                Forget these records
            </button>
        </EditForm>
    </div>
}

<h2 class="h5" id="nodes">Recorder nodes</h2>
@if (NodeRows.Count == 0)
{
    <p class="text-muted">No nodes have registered yet. See <a href="/Help/installation">Installation</a>.</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="nodesTable"
                   placeholder="Filter by name, IP, version&hellip;" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="nodesPageSize">Rows per page</label>
            <select id="nodesPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="nodesTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" id="nodesTable" data-sortable data-paginate>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>IP</th>
                    <th>Version</th>
                    <th data-sort-numeric>Cameras</th>
                    <th data-sort-numeric style="min-width: 12rem;">Storage</th>
                    <th>Last seen</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in NodeRows)
                {
                    var online = n.LastSeenAt is { } ls && ls >= DateTime.UtcNow.AddMinutes(-2);
                    var cams = CameraCountByNode.GetValueOrDefault(n.Id);
                    var backupName = n.BackupNodeId is { } bid ? NodeRows.FirstOrDefault(x => x.Id == bid)?.Name : null;
                    <tr>
                        <td data-sort-value="@n.Name"><a href="/Admin/Nodes/@n.Id" class="fw-semibold">@n.Name</a></td>
                        <td>
                            <span class="badge @(online ? "text-bg-success" : "text-bg-secondary")">@(online ? "online" : "offline")</span>
                            @if (n.Status == NodeStatus.Pending)
                            {
                                <span class="badge text-bg-warning" title="Registered, but it records nothing until you approve it.">waiting for approval</span>
                            }
                            else if (n.Status == NodeStatus.Disabled)
                            {
                                <span class="badge text-bg-secondary">disabled</span>
                            }
                            @if (n.FailoverState == NodeFailoverState.FailedOverAway)
                            {
                                <span class="badge @(n.FailoverReason == NodeFailoverReason.Maintenance ? "text-bg-warning" : "text-bg-danger")">
                                    @(n.FailoverReason == NodeFailoverReason.Maintenance ? "maintenance" : "failed over")
                                </span>
                            }
                            else if (n.FailoverState == NodeFailoverState.HostingFailover)
                            {
                                <span class="badge text-bg-info">hosting failover</span>
                            }
                            @if (StaleCameraCountByNode.GetValueOrDefault(n.Id) is > 0 and var staleCount)
                            {
                                var staleRows = StaleCamerasByNode[n.Id];
                                var staleTooltip = "Leftover footage from cameras moved off this node; clears on its own as it ages out:\n" + string.Join("\n", staleRows
                                    .OrderByDescending(r => r.Overdue).ThenBy(r => r.CameraName)
                                    .Select(r => $"{r.CameraName} — {r.Status}"));
                                var staleTemplate = "Leftover footage from cameras moved off this node; clears on its own as it ages out:\n" + string.Join("\n", staleRows
                                    .OrderByDescending(r => r.Overdue).ThenBy(r => r.CameraName)
                                    .Select(r => $"{r.CameraName} — {r.StatusTemplate ?? r.Status}"));
                                <span class="ms-1 @(staleRows.Any(r => r.Overdue) ? "text-danger" : "")" title="@staleTooltip" data-local-title-template="@staleTemplate">⚠️ @staleCount</span>
                            }
                            @if (string.IsNullOrWhiteSpace(n.StorageRootPath))
                            {
                                <span class="ms-1 text-danger" title="No storage path set — this node is not recording.">⚠️ no storage path</span>
                            }
                            else if (n.StorageBlockedByEvidenceLocks)
                            {
                                <a class="ms-1 text-danger" href="/EvidenceLocks"
                                   title="Over the storage watermark, and the remaining footage is under evidence locks, which are never deleted. Recording stops if the disk fills: end or remove locks, export the footage elsewhere, or add storage.">⚠️ full of locked footage</a>
                            }
                            else if (n.StoragePressureActive)
                            {
                                <span class="ms-1 text-warning" title="Over the storage watermark — oldest footage is being archived or deleted early.">⚠️ storage full</span>
                            }
                            @if (VisionBackendOf(n) is { NeedsAttention: true } ai)
                            {
                                <a class="ms-1 text-danger" href="/Help/ai-detection#slow-backend"
                                   title="@($"AI detection is running on {ai.Provider} instead of {ai.Requested}. {string.Join(" ", ai.Notes)}")">⚠️ AI on @ai.Provider</a>
                            }
                        </td>
                        <td class="font-monospace">@(n.LastIpAddress ?? "—")</td>
                        <td>@n.Version</td>
                        <td>@cams</td>
                        <td data-sort-value="@((n.StorageTotalBytes is { } t && n.StorageFreeBytes is { } f) ? t - f : -1)">
                            <NodeStorageBar Node="n" DaysRemaining="DaysRemainingMap.GetValueOrDefault(n.Id)" ArchiveDaysRemaining="ArchiveDaysRemainingMap.GetValueOrDefault(n.Id)" />
                        </td>
                        <td data-sort-value="@(n.LastSeenAt?.Ticks ?? 0)">
                            @if (n.LastSeenAt is { } seen)
                            {
                                <time datetime="@seen.ToUtcIso()" data-local="g">@seen.ToLocalTime().ToString("g")</time>
                            }
                            else
                            {
                                <span class="text-muted">never</span>
                            }
                            @if (n.ClockSkewSeconds is { } skew && Math.Abs(skew) > 60)
                            {
                                <span class="ms-1" title="Clock is off by about @Math.Round(skew) s — check time sync on this machine.">⚠️ clock</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (n.Status == NodeStatus.Pending)
                            {
                                <EditForm Model="this" FormName="@($"approve-node-{n.Id}")" OnValidSubmit="HandleApproveAsync" class="d-inline">
                                    <input type="hidden" name="ApproveId" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-success"
                                            data-confirm="@NodeConfirm.Approve(n.Name)">Approve</button>
                                </EditForm>
                            }
                            <a class="btn btn-sm btn-outline-primary" href="/Admin/Nodes/@n.Id">Edit</a>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions" data-bs-popper-config='{"strategy":"fixed"}'>⋯</button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    @* Each action is its own named form; the node edit page posts to these
                                       same handlers (see NodeActionForm.razor). onclick, not onsubmit — an
                                       on* attribute on EditForm would rebind its own OnSubmit parameter. *@
                                    <EditForm Model="this" FormName="@($"restart-node-{n.Id}")" OnValidSubmit="HandleRestartAsync">
                                        <input type="hidden" name="RestartId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item" data-confirm="@NodeConfirm.Restart(n.Name, cams)">🔄 Restart service</button>
                                    </EditForm>
                                    <EditForm Model="this" FormName="@($"reset-node-auth-{n.Id}")" OnValidSubmit="HandleResetAuthAsync">
                                        <input type="hidden" name="ResetAuthId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item" data-confirm="@NodeConfirm.ResetAuth(n.Name)">🔑 Reset auth</button>
                                    </EditForm>
                                    <EditForm Model="this" FormName="@($"set-node-maintenance-{n.Id}")" OnValidSubmit="HandleSetMaintenanceAsync">
                                        <input type="hidden" name="MaintenanceId" value="@n.Id" />
                                        <input type="hidden" name="MaintenanceEnabled" value="@((!n.MaintenanceMode).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="dropdown-item" data-confirm="@NodeConfirm.Maintenance(n.MaintenanceMode, cams, backupName)">
                                            🛠️ @(n.MaintenanceMode ? "End maintenance" : "Maintenance")
                                        </button>
                                    </EditForm>
                                    <div class="dropdown-divider"></div>
                                    <EditForm Model="this" FormName="@($"delete-node-{n.Id}")" OnValidSubmit="HandleDeleteAsync">
                                        <input type="hidden" name="DeleteId" value="@n.Id" />
                                        <button type="submit" class="dropdown-item text-danger" data-confirm="@NodeConfirm.Delete(n.Name)">🗑️ Delete</button>
                                    </EditForm>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="nodesTable" class="mt-2"></div>

    <p class="small text-muted mt-3">
        Streaming relay since <time datetime="@RelayMetrics.SinceUtc.ToUtcIso()" data-local="g">@RelayMetrics.SinceUtc.ToLocalTime().ToString("g")</time>:
        <strong>@RelayMetrics.ActiveLiveRelays</strong> live stream(s) now (@RelayMetrics.LiveRelaysStarted total) &middot;
        <strong>@RelayMetrics.PlaybackSegmentsProxied</strong> playback segment(s) (@ByteFormat.Format(RelayMetrics.PlaybackBytesProxied)).
        <a href="/Help/nodes#direct-streaming">Direct streaming</a> reduces these.
    </p>
}

@* Rendered only once everything below is loaded: the panels must not mount (and so run) while this
   page's queries are still using the request's DbContext. *@
@if (Loaded)
{
    <NodeBuildsPanel Builds="Builds" />

    @if (CanEditSettings)
    {
        <NodeSettingsPanel InitialRegistrationKey="@RegistrationKey" InitialAutoUpdate="AutoUpdate" InitialReleaseCheck="ReleaseCheck" />
    }
}

@code {
    /// <summary>One row of the stale-camera warning's tooltip. Status says when this camera's last
    /// remaining segment on this node ages past retention, that it's kept indefinitely, or — once well
    /// past that — that the node hasn't confirmed deleting it yet.</summary>
    // Status is formatted in the server's time zone as the no-script fallback; StatusTemplate has the
    // same text with the time as {{UTC}} for local-time.js to show in the viewer's zone.
    private sealed record StaleCameraRow(string CameraName, string Status, bool Overdue, string? StatusTemplate = null);

    // Leftover footage is only called overdue this long after it should have gone: the server's
    // expired-segment list waits a day past retention (NodeService.ExpiredSegmentGrace) before
    // handing it to the node, plus slack for the node's 5-minute sweep and report.
    private static readonly TimeSpan StaleOverdueGrace = TimeSpan.FromDays(1) + TimeSpan.FromHours(1);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private System.Security.Claims.ClaimsPrincipal User =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());

    [SupplyParameterFromQuery(Name = "statusMessage")] private string? QueryStatusMessage { get; set; }
    [SupplyParameterFromQuery(Name = "statusIsError")] private bool QueryStatusIsError { get; set; }

    // FormName is unique per row, and [SupplyParameterFromForm] needs a compile-time constant name,
    // so the action handlers read their values off HttpContext.Request.Form instead.
    private Guid RestartId { get; set; }
    private Guid ResetAuthId { get; set; }
    private Guid ApproveId { get; set; }
    private Guid MaintenanceId { get; set; }
    private bool MaintenanceEnabled { get; set; }
    private Guid DeleteId { get; set; }

    private static Guid FormGuid(Microsoft.Extensions.Primitives.StringValues v) => Guid.TryParse(v.ToString(), out var g) ? g : Guid.Empty;

    private List<Node> NodeRows { get; set; } = [];
    private Dictionary<Guid, int> CameraCountByNode { get; set; } = [];
    private Dictionary<Guid, double?> DaysRemainingMap { get; set; } = [];
    private Dictionary<Guid, double?> ArchiveDaysRemainingMap { get; set; } = [];
    private Dictionary<Guid, int> StaleCameraCountByNode { get; set; } = [];
    private Dictionary<Guid, List<StaleCameraRow>> StaleCamerasByNode { get; set; } = [];
    private List<string> MissingNodeStaleCameras { get; set; } = [];
    private string? StatusMessage;
    private DateTime? CertificateChangedAt;
    private List<string> NodesBehindCertificateChange = [];
    private bool StatusIsError;
    // Updates and registration are settings (was Settings → Nodes), so they also need Settings.Edit.
    private bool CanEditSettings;
    private List<NodeBuildVersion> Builds = [];
    private string? RegistrationKey;
    private bool AutoUpdate;
    private bool ReleaseCheck;
    private bool Loaded;

    protected override async Task OnInitializedAsync()
    {
        CanEditSettings = (await PermissionService.GetGrantedAsync(User)).Has("Settings", "Edit");
        await LoadAsync();

        // Nodes that pinned a self-signed certificate the server has since replaced can't reach it.
        CertificateChangedAt = await ServerCertificateSettings.TrackAsync(Certificates, Settings, AuditService);
        if (CertificateChangedAt is { } changedAt && Certificates.IsSelfSigned)
            NodesBehindCertificateChange = NodeRows.Where(n => n.CreatedAt < changedAt && (n.LastSeenAt is null || n.LastSeenAt < changedAt))
                .Select(n => n.Name).ToList();

        // deploy.ps1 inserts Pending rows straight into the table, so tidy the queue on every visit.
        await NodeBuildService.SupersedeOutdatedPendingAsync();
        Builds = await NodeBuildService.ListAsync();
        if (CanEditSettings)
        {
            // Get-or-create rather than a bare read: a deployment whose setup predates the wizard's Node
            // step (or whose Settings row was deleted) would otherwise render an empty field.
            RegistrationKey = await SetupService.GetOrCreateNodeRegistrationKeyAsync();
            AutoUpdate = await Settings.GetAsync("NodeAutoUpdate.Enabled", true);
            ReleaseCheck = await Settings.GetAsync(ReleaseCheckService.EnabledKey, ReleaseCheckService.DefaultEnabled);
        }
        Loaded = true;

        if (!string.IsNullOrEmpty(QueryStatusMessage))
        {
            StatusMessage = QueryStatusMessage;
            StatusIsError = QueryStatusIsError;
        }
    }

    private async Task LoadAsync()
    {
        NodeRows = await NodeService.ListAsync();
        var cameras = await CameraService.ListAsync();
        CameraCountByNode = cameras
            .Where(c => c.NodeId is not null)
            .GroupBy(c => c.NodeId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        // Footage on the node that is recording the camera right now isn't stale, even when that's not
        // the camera's home node — a failover backup's own recordings were flagged before.
        var failoverStateOf = NodeRows.ToDictionary(n => n.Id, n => n.FailoverState);
        var defaultBackupOf = NodeRows.ToDictionary(n => n.Id, n => n.BackupNodeId);
        var cameraById = cameras.ToDictionary(c => c.Id);
        var nodeById = NodeRows.ToDictionary(n => n.Id);
        var staleDetails = (await CameraService.GetStaleSegmentDetailsAsync())
            .Where(d => !(cameraById.TryGetValue(d.CameraId, out var cam)
                && LarisVMS.Infrastructure.Services.RecordingNodeResolver.Resolve(
                    cam.NodeId, cam.BackupNodeIdOverride, failoverStateOf, defaultBackupOf) == d.NodeId))
            .ToList();

        MissingNodeStaleCameras = staleDetails.Where(d => !nodeById.ContainsKey(d.NodeId))
            .Select(d => d.CameraName).Distinct().OrderBy(n => n).ToList();
        staleDetails = staleDetails.Where(d => nodeById.ContainsKey(d.NodeId)).ToList();

        StaleCameraCountByNode = staleDetails
            .GroupBy(d => d.NodeId)
            .ToDictionary(g => g.Key, g => g.Count());

        StaleCamerasByNode = [];
        var nowUtc = DateTime.UtcNow;
        foreach (var d in staleDetails)
        {
            // The same retention the server's expired-segment list applies: archive-enabled footage
            // goes when it ages past the archive retention, everything else past Retention.Days. 0 or
            // less is keep forever, not "already expired".
            var retentionDays = await Settings.GetAsync<int?>("Retention.Days", 30, cameraId: d.CameraId, nodeId: d.NodeId);
            var archiveEnabled = await Settings.GetAsync("Archive.Enabled", false, cameraId: d.CameraId, nodeId: d.NodeId);
            var archiveRetentionDays = await Settings.GetAsync<int?>("Archive.RetentionDays", 0, cameraId: d.CameraId, nodeId: d.NodeId);
            var keepDays = archiveEnabled ? archiveRetentionDays : retentionDays;

            StaleCameraRow row;
            if (keepDays is not > 0)
            {
                row = new StaleCameraRow(d.CameraName,
                    archiveEnabled ? "kept indefinitely (archive retention is keep forever)" : "kept indefinitely (retention is keep forever)",
                    Overdue: false);
            }
            else
            {
                var clearsAtUtc = d.NewestSegmentEndUtc.AddDays(keepDays.Value);
                if (nowUtc < clearsAtUtc + StaleOverdueGrace)
                {
                    row = new StaleCameraRow(d.CameraName, $"falls off {clearsAtUtc.ToLocalTime():g}", Overdue: false,
                        StatusTemplate: $"falls off {{{{{clearsAtUtc.ToUtcIso()}}}}}");
                }
                else
                {
                    var node = nodeById[d.NodeId];
                    var online = node.LastSeenAt is { } seen && seen >= nowUtc.AddMinutes(-2);
                    var offline = online ? "" : " (node is offline)";
                    row = new StaleCameraRow(d.CameraName,
                        $"overdue since {clearsAtUtc.ToLocalTime():g}, waiting for this node to confirm deletion{offline}",
                        Overdue: true,
                        StatusTemplate: $"overdue since {{{{{clearsAtUtc.ToUtcIso()}}}}}, waiting for this node to confirm deletion{offline}");
                }
            }

            if (!StaleCamerasByNode.TryGetValue(d.NodeId, out var rows))
                StaleCamerasByNode[d.NodeId] = rows = [];
            rows.Add(row);
        }

        DaysRemainingMap = await NodeService.GetEstimatedDaysRemainingAsync();
        ArchiveDaysRemainingMap = await NodeService.GetArchiveEstimatedDaysRemainingAsync();
    }

    private void NavigateBare(string? message = null, bool isError = false)
    {
        var url = message is null
            ? "/Admin/Nodes"
            : $"/Admin/Nodes?statusMessage={Uri.EscapeDataString(message)}&statusIsError={isError}";
        NavigationManager.NavigateTo(url);
    }

    /// <summary>Restarts a node's own Windows Service — not the machine. Proxied through this tier the
    /// same way every other Web→Node call is (the browser never talks to a node directly), authorized
    /// by a short-lived token signed with that node's own MediaSigningKey.
    ///
    /// Recording on this node's cameras stops for the few seconds the service is down, which is why
    /// this is behind Nodes.Edit and audited like any other node change.</summary>
    private async Task HandleRestartAsync()
    {
        RestartId = FormGuid(HttpContext?.Request.Form["RestartId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == RestartId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        if (node is not { LastIpAddress: { } ip, LivePort: { } port, MediaSigningKey: { } key })
        {
            NavigateBare($"{node.Name} hasn't reported its address yet — it needs at least one heartbeat before it can be restarted from here.", isError: true);
            return;
        }

        var token = MediaToken.IssueForNodeControl("restart", key, TimeSpan.FromSeconds(30));
        var client = HttpFactory.CreateClient();
        client.Timeout = TimeSpan.FromSeconds(15);

        try
        {
            var response = await client.SendAsync(MediaTokenRequest.Create(HttpMethod.Post,
                $"http://{ip}:{port}/restart?token={Uri.EscapeDataString(token)}", token));

            if (response.IsSuccessStatusCode)
            {
                await LogAsync("Node.Restart", $"{node.Name} ({RestartId})");
                NavigateBare($"{node.Name} is restarting. It should reappear as online within a minute.");
            }
            else
            {
                var body = (await response.Content.ReadAsStringAsync()).Trim();
                NavigateBare($"{node.Name} refused the restart ({(int)response.StatusCode})" +
                    (string.IsNullOrEmpty(body) ? "." : $": {body}"), isError: true);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            NavigateBare($"Could not reach {node.Name}: {ex.Message}", isError: true);
        }
    }

    /// <summary>Removes footage records left on a node that has since been deleted — nothing can ever
    /// confirm their deletion otherwise. Records only; files are untouched. Audited.</summary>
    private async Task HandleForgetMissingNodeSegmentsAsync()
    {
        var removed = await CameraService.ForgetSegmentsOnMissingNodesAsync();
        await LogAsync("Segments.ForgetMissingNode", $"{removed} footage record(s) on deleted node(s) removed");
        NavigateBare($"Removed {removed} footage record(s) that belonged to a deleted node.");
    }

    /// <summary>Failover plan phase 5a: recovery for a node locked out because its rolling check-in
    /// nonce got out of sync (a heartbeat response the node never received — it keeps resending the
    /// stale nonce, which the server now rejects 401). Clears the stored nonce so the node's next
    /// check-in is accepted as a not-yet-nonced one and re-syncs. A no-op risk on a healthy node.</summary>
    /// <summary>A newly registered node waits as Pending — no cameras, no reports — until approved.</summary>
    private async Task HandleApproveAsync()
    {
        ApproveId = FormGuid(HttpContext?.Request.Form["ApproveId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == ApproveId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }
        if (!await NodeService.ApproveAsync(ApproveId)) { NavigateBare($"{node.Name} isn't waiting for approval.", isError: true); return; }

        await LogAsync("Node.Approved", $"{node.Name} ({ApproveId}) from {node.LastIpAddress ?? "an unknown address"}");
        NavigateBare($"{node.Name} approved. Assign cameras to it to start recording.");
    }

    private async Task HandleResetAuthAsync()
    {
        ResetAuthId = FormGuid(HttpContext?.Request.Form["ResetAuthId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == ResetAuthId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        await NodeService.ResetAuthAsync(ResetAuthId, rotateSecretNow: false);
        await LogAsync("Node.ResetAuth", $"{node.Name} ({ResetAuthId}) — check-in nonce cleared");
        NavigateBare($"{node.Name}: check-in nonce cleared. If it was locked out, it should re-sync within a heartbeat cycle.");
    }

    /// <summary>Failover plan phase 3: toggle a node into/out of maintenance mode. On = its cameras fail
    /// over to its backup node on RecordingFailoverService's next tick (~15s) and stay there until
    /// turned off, regardless of the node's own health. Confirm dialog is client-side.</summary>
    private async Task HandleSetMaintenanceAsync()
    {
        var maintForm = HttpContext?.Request.Form;
        MaintenanceId = FormGuid(maintForm?["MaintenanceId"] ?? default);
        MaintenanceEnabled = maintForm?["MaintenanceEnabled"].ToString() == "true";
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == MaintenanceId);
        if (node is null) { NavigateBare("That node no longer exists.", isError: true); return; }

        await NodeService.SetMaintenanceAsync(MaintenanceId, MaintenanceEnabled, User.Identity?.Name);
        await LogAsync(MaintenanceEnabled ? "Node.MaintenanceEntered" : "Node.MaintenanceExited", $"{node.Name} ({MaintenanceId})");
        NavigateBare(MaintenanceEnabled
            ? $"{node.Name} is in maintenance — its cameras move to its backup node within ~15 seconds and stay there until you turn maintenance off."
            : $"{node.Name} left maintenance — its cameras return to it once it is a confirmed-healthy quorum (or immediately if it stayed healthy).");
    }

    private async Task HandleDeleteAsync()
    {
        DeleteId = FormGuid(HttpContext?.Request.Form["DeleteId"] ?? default);
        var node = (await NodeService.ListAsync()).FirstOrDefault(n => n.Id == DeleteId);
        await NodeService.DeleteAsync(DeleteId);
        await LogAsync("Node.Delete", $"{node?.Name ?? "?"} ({DeleteId})");
        NavigateBare();
    }

    private Task LogAsync(string action, string details) =>
        AuditService.LogAsync(action, User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            User.Identity?.Name, HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

    private static LarisVMS.Core.Dtos.NodeVisionBackendDto? VisionBackendOf(LarisVMS.Core.Entities.Node node)
    {
        if (string.IsNullOrEmpty(node.VisionBackendJson)) return null;
        try { return System.Text.Json.JsonSerializer.Deserialize<LarisVMS.Core.Dtos.NodeVisionBackendDto>(node.VisionBackendJson); }
        catch (System.Text.Json.JsonException) { return null; }
    }
}
