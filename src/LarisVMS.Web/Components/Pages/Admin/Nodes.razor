    private static Guid FormGuid(Microsoft.Extensions.Primitives.StringValues v) => Guid.TryParse(v.ToString(), out var g) ? g : Guid.Empty;
    private static int? FormIntOrNull(Microsoft.Extensions.Primitives.StringValues v) => int.TryParse(v.ToString(), out var n) ? n : null;
    private static string? FormStringOrNull(Microsoft.Extensions.Primitives.StringValues v) => v.Count == 0 ? null : v.ToString();

    /// <summary>Populates every update-node field from the raw posted form — see the fields' own
    /// doc comment for why [SupplyParameterFromForm] can't be used here.</summary>
    private void PopulateUpdateFieldsFromForm()
    {
        var form = HttpContext?.Request.Form;
        if (form is null) return;

        Id = FormGuid(form["Id"]);
        Name = form["Name"].ToString();
        StorageRootPath = FormStringOrNull(form["StorageRootPath"]);
        RetentionDaysOverride = FormIntOrNull(form["RetentionDaysOverride"]);
        AiAcceleratorOverride = FormStringOrNull(form["AiAccelerator"]);
