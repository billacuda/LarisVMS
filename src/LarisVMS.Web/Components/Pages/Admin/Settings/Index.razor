@page "/Admin/Settings"
@attribute [Authorize]
@using System.Security.Claims
@using LarisVMS.Core.Interfaces
@inject IPermissionService PermissionService

<PageTitle>@L["nav.settings"] - @AppName</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="mb-0">@L["nav.settings"]</h1>
</div>

@if (Cards.Count == 0)
{
    <p class="text-muted">@L["settings.hub.empty"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var card in Cards)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a href="@card.Href" class="card h-100 text-decoration-none text-body">
                    <div class="card-body">
                        <div class="fs-4 mb-2" aria-hidden="true">@card.Icon</div>
                        <div class="card-title fw-bold mb-1">@card.Title</div>
                        <p class="card-text text-muted small mb-0">@card.Description</p>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private sealed record CardInfo(string Href, string Icon, string Title, string Description);

    private List<CardInfo> Cards { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new ClaimsPrincipal(new ClaimsIdentity());

        var nav = await PermissionService.GetGrantedAsync(user);
        var showSettings = nav.Has("Settings", "Edit");
        var all = new (string Href, string Icon, string Title, string Description, bool Visible)[]
        {
            ("/Admin/Proxies", "🔗", L["settings.hub.mediaProxies.title"], L["settings.hub.mediaProxies.description"], nav.Has("Nodes", "Edit")),
            ("/Admin/Settings/Cameras", "📹", L["settings.hub.cameraSettings.title"], L["settings.hub.cameraSettings.description"], showSettings),
            ("/Logs", "📜", L["settings.hub.logs.title"], L["settings.hub.logs.description"], nav.Has("Logs", "View") || nav.Has("SystemLogs", "View")),
            ("/Admin/Plugins", "🧩", L["settings.hub.plugins.title"], L["settings.hub.plugins.description"], nav.Has("Plugins", "View")),
            ("/Admin/Settings/Backups", "💾", L["settings.hub.backups.title"], L["settings.hub.backups.description"], nav.Has("Backups", "Edit")),
            ("/Admin/Settings/Branding", "🎨", L["settings.hub.branding.title"], L["settings.hub.branding.description"], showSettings),
            ("/Admin/Settings/Permissions/Users", "👤", L["settings.hub.users.title"], L["settings.hub.users.description"], nav.Has("Users", "Edit")),
            ("/Admin/Settings/Permissions/Roles", "🛡️", L["settings.hub.roles.title"], L["settings.hub.roles.description"], showSettings),
            ("/Admin/Settings/Permissions/Matrix", "🗂️", L["settings.hub.permissionsMatrix.title"], L["settings.hub.permissionsMatrix.description"], showSettings),
            ("/Admin/Settings/CameraAccess", "🗝️", L["settings.hub.cameraAccess.title"], L["settings.hub.cameraAccess.description"], showSettings),
            ("/Admin/Settings/Detection", "🤖", L["settings.hub.aiDetection.title"], L["settings.hub.aiDetection.description"], showSettings),
            ("/Admin/Settings/Email", "✉️", L["settings.hub.email.title"], L["settings.hub.email.description"], showSettings),
            ("/Admin/Settings/Events", "🏷️", L["settings.hub.events.title"], L["settings.hub.events.description"], showSettings),
            ("/Admin/Settings/Language", "🌐", L["settings.hub.language.title"], L["settings.hub.language.description"], showSettings),
            ("/Admin/Settings/LiveView", "🖥️", L["settings.hub.liveView.title"], L["settings.hub.liveView.description"], showSettings),
            ("/Admin/Settings/Notifications", "🔔", L["settings.hub.notifications.title"], L["settings.hub.notifications.description"], showSettings),
            ("/Admin/Settings/Logs", "📝", L["settings.hub.logging.title"], L["settings.hub.logging.description"], showSettings),
            ("/Admin/Settings/Recording", "🎥", L["settings.hub.recordingDefaults.title"], L["settings.hub.recordingDefaults.description"], showSettings),
            ("/Admin/Settings/ActiveDirectory", "🏢", L["settings.hub.activeDirectory.title"], L["settings.hub.activeDirectory.description"], showSettings),
            ("/Admin/Settings/Encryption", "🔐", L["settings.hub.encryptionAndSigning.title"], L["settings.hub.encryptionAndSigning.description"], showSettings),
            ("/Admin/Settings/Security", "🔒", L["settings.hub.security.title"], L["settings.hub.security.description"], showSettings),
            ("/Admin/Settings/StorageAndRetention", "🗄️", L["settings.hub.storageRetention.title"], L["settings.hub.storageRetention.description"], nav.Has("Retention", "Edit")),
            ("/Admin/Alerts", "⚠️", L["settings.hub.alerts.title"], L["settings.hub.alerts.description"], nav.Has("Alerts", "Edit")),
            ("/Admin/ApiKeys", "🔑", L["settings.hub.apiKeys.title"], L["settings.hub.apiKeys.description"], nav.Has("ApiKeys", "Edit")),
        };
        Cards = [.. all.Where(c => c.Visible).OrderBy(c => c.Title, StringComparer.Create(System.Globalization.CultureInfo.CurrentUICulture, ignoreCase: true)).Select(c => new CardInfo(c.Href, c.Icon, c.Title, c.Description))];
    }
}
