@page "/Admin/Settings/LiveView"
@attribute [Authorize("Settings.Edit")]
@using System.Security.Claims
@using LarisVMS.Core
@using LarisVMS.Core.Interfaces
@using LarisVMS.Web.Middleware
@inject ISettingsResolver Settings
@inject IAuditService AuditService

<PageTitle>@L["settings.liveView.liveViewSettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="LiveView" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<div class="lv-page-narrow">
<EditForm Model="this" FormName="liveview-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
    <SettingSection Title="@L["settings.liveView.liveView"]">
        <SettingField Label="@L["settings.liveView.adaptiveStreaming"]" Wide Hint="@L["settings.liveView.smallTilesUseTheSub"]">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="AdaptiveStreamingEnabled" class="form-check-input" id="adaptiveStreamingEnabled" />
                <label class="form-check-label" for="adaptiveStreamingEnabled">@L["common.enabled"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.liveView.pathLingerSeconds"]" For="pathLingerRange" Hint="@L["settings.liveView.howLongAnObjectTravel"]" HelpLink="/Help/live-and-playback#live-tiles">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="PathLingerSeconds" value="@PathLingerSeconds" min="0" max="@LarisVMS.Web.Pages.Views.PathLinger.Max" step="1" class="form-range" id="pathLingerRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="pathLingerReadout">@PathLingerSeconds</output>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.liveView.pathDissolveSeconds"]" For="pathDissolveRange" Hint="@L["settings.liveView.howLongThePathThen"]" HelpLink="/Help/live-and-playback#live-tiles">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="PathDissolveSeconds" value="@PathDissolveSeconds" min="@LarisVMS.Web.Pages.Views.PathDissolve.Min" max="@LarisVMS.Web.Pages.Views.PathDissolve.Max" step="1" class="form-range" id="pathDissolveRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="pathDissolveReadout">@PathDissolveSeconds</output>
            </div>
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.liveView.directToNodeStreaming"]" Subtitle="@L["settings.liveView.nodesCanOverrideTheMode"]">
        <SettingField For="field-directStreaming" Label="@L["settings.liveView.mode"]" Hint="@L["settings.liveView.directSendsVideoFromThe"]" HelpLink="/Help/nodes#direct-streaming">
            <select id="field-directStreaming" name="DirectStreaming" class="form-select">
                <option value="Proxy" selected="@(DirectStreaming == "Proxy")">@L["settings.liveView.proxyThroughThisServer"]</option>
                <option value="Direct" selected="@(DirectStreaming == "Direct")">@L["settings.liveView.directBrowserNode"]</option>
            </select>
        </SettingField>
        <SettingField For="field-publicOrigin" Label="@L["settings.liveView.publicOrigin"]" ShowWhen="DirectStreaming=Direct" Hint="@L["settings.liveView.optionalTheOnlyOriginNodes"]">
            <InputText id="field-publicOrigin" @bind-Value="PublicOrigin" class="form-control" placeholder="https://vms.example.com" />
        </SettingField>
        <SettingField Label="@L["settings.liveView.selfSignedCertificates"]" ShowWhen="DirectStreaming=Direct" Wide Hint="@L["settings.liveView.testingOnlyViewersSeeA"]">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="AllowInsecureClientEndpoint" class="form-check-input" id="allowInsecureClientEndpoint" />
                <label class="form-check-label text-danger" for="allowInsecureClientEndpoint">@L["settings.liveView.allowInsecureClientEndpoint"]</label>
            </div>
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.liveView.livePlaybackPort"]">
        <SettingField For="field-customPort" Label="@L["settings.liveView.customPort"]" Hint="@L["settings.liveView.movesLiveAndPlaybackTo"]" HelpLink="/Help/security#separate-port">
            <InputNumber id="field-customPort" @bind-Value="CustomPort" min="1" max="65535" class="form-control" placeholder="@L["settings.liveView.sameAsMainSite"]" />
        </SettingField>
    </SettingSection>
    <div class="lv-savebar">
        <button type="submit" class="btn btn-primary">@L["common.save"]</button>
    </div>
</EditForm>
</div>

<SectionContent SectionName="PageScripts">
    <script nonce="@Csp.Value">
        // Path linger and dissolve slider readouts.
        [['pathLingerRange', 'pathLingerReadout'], ['pathDissolveRange', 'pathDissolveReadout']].forEach(function (ids) {
            var range = document.getElementById(ids[0]);
            var readout = document.getElementById(ids[1]);
            if (!range || !readout) return;
            function sync() { readout.textContent = range.value; }
            range.addEventListener('input', sync);
            sync();
        });
    </script>
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "liveview-settings")] private bool AdaptiveStreamingEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private string? DirectStreaming { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private bool AllowInsecureClientEndpoint { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private string? PublicOrigin { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private int? CustomPort { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private int PathLingerSeconds { get; set; }
    [SupplyParameterFromForm(FormName = "liveview-settings")] private int PathDissolveSeconds { get; set; }

    private string? SavedMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Skip on a form POST: the submitted values are already bound, and reloading here would save
        // the old ones back (see Detection.razor's OnInitializedAsync).
        if (HttpContext?.Request.HasFormContentType == true) return;
        AdaptiveStreamingEnabled = await Settings.GetAsync("LiveView.AdaptiveStreamingEnabled", false);
        CustomPort = await Settings.GetAsync<int?>(PortSegmentationMiddleware.SettingKey, null);
        DirectStreaming = await Settings.GetAsync("LiveView.DirectStreaming", "Proxy");
        AllowInsecureClientEndpoint = await Settings.GetAsync("LiveView.AllowInsecureClientEndpoint", false);
        PublicOrigin = await Settings.GetAsync<string?>("LiveView.PublicOrigin", null);
        PathLingerSeconds = LarisVMS.Web.Pages.Views.PathLinger.Clamp(
            await Settings.GetAsync(LarisVMS.Web.Pages.Views.PathLinger.SettingKey, LarisVMS.Web.Pages.Views.PathLinger.Default));
        PathDissolveSeconds = LarisVMS.Web.Pages.Views.PathDissolve.Clamp(
            await Settings.GetAsync(LarisVMS.Web.Pages.Views.PathDissolve.SettingKey, LarisVMS.Web.Pages.Views.PathDissolve.Default));
    }

    private async Task HandleSaveAsync()
    {
        if (CustomPort is { } p && (p is < 1 or > 65535))
        {
            ErrorMessage = Loc.T("settings.liveView.theCustomPortMustBe");
            return;
        }
        DirectStreaming = string.Equals(DirectStreaming, "Direct", StringComparison.OrdinalIgnoreCase) ? "Direct" : "Proxy";
        PublicOrigin = string.IsNullOrWhiteSpace(PublicOrigin) ? null : PublicOrigin.Trim().TrimEnd('/');
        if (PublicOrigin is not null && !Uri.TryCreate(PublicOrigin, UriKind.Absolute, out _))
        {
            ErrorMessage = Loc.T("settings.liveView.publicOriginMustBeA");
            return;
        }

        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new ClaimsPrincipal(new ClaimsIdentity());
        var by = user.Identity?.Name;
        var oldValue = await Settings.GetAsync("LiveView.AdaptiveStreamingEnabled", false);
        var oldPort = await Settings.GetAsync<int?>(PortSegmentationMiddleware.SettingKey, null);
        var oldDirect = await Settings.GetAsync("LiveView.DirectStreaming", "Proxy");
        var oldInsecure = await Settings.GetAsync("LiveView.AllowInsecureClientEndpoint", false);
        var oldOrigin = await Settings.GetAsync<string?>("LiveView.PublicOrigin", null);
        var oldLinger = await Settings.GetAsync(LarisVMS.Web.Pages.Views.PathLinger.SettingKey, LarisVMS.Web.Pages.Views.PathLinger.Default);
        PathLingerSeconds = LarisVMS.Web.Pages.Views.PathLinger.Clamp(PathLingerSeconds);
        var oldDissolve = await Settings.GetAsync(LarisVMS.Web.Pages.Views.PathDissolve.SettingKey, LarisVMS.Web.Pages.Views.PathDissolve.Default);
        PathDissolveSeconds = LarisVMS.Web.Pages.Views.PathDissolve.Clamp(PathDissolveSeconds);

        await Settings.SetGlobalAsync("LiveView.AdaptiveStreamingEnabled", AdaptiveStreamingEnabled.ToString(), by);
        await Settings.SetGlobalAsync(PortSegmentationMiddleware.SettingKey, CustomPort?.ToString() ?? "", by);
        await Settings.SetGlobalAsync("LiveView.DirectStreaming", DirectStreaming, by);
        await Settings.SetGlobalAsync("LiveView.AllowInsecureClientEndpoint", AllowInsecureClientEndpoint.ToString(), by);
        await Settings.SetGlobalAsync("LiveView.PublicOrigin", PublicOrigin ?? "", by);
        await Settings.SetGlobalAsync(LarisVMS.Web.Pages.Views.PathLinger.SettingKey, PathLingerSeconds.ToString(), by);
        await Settings.SetGlobalAsync(LarisVMS.Web.Pages.Views.PathDissolve.SettingKey, PathDissolveSeconds.ToString(), by);

        var details = AuditDiff.Build(
            AuditDiff.Of("LiveView.AdaptiveStreamingEnabled", oldValue.ToString(), AdaptiveStreamingEnabled.ToString()),
            AuditDiff.Of("Live/playback custom port", oldPort?.ToString() ?? "(none)", CustomPort?.ToString() ?? "(none)"),
            AuditDiff.Of("Direct streaming", oldDirect, DirectStreaming),
            AuditDiff.Of("Allow insecure client endpoint", oldInsecure.ToString(), AllowInsecureClientEndpoint.ToString()),
            AuditDiff.Of("Public origin", oldOrigin ?? "(none)", PublicOrigin ?? "(none)"),
            AuditDiff.Of("Path linger (seconds)", oldLinger.ToString(), PathLingerSeconds.ToString()),
            AuditDiff.Of("Path dissolve (seconds)", oldDissolve.ToString(), PathDissolveSeconds.ToString()));

        await AuditService.LogAsync("Settings.Update",
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        SavedMessage = Loc.T("common.saved");
    }
}
