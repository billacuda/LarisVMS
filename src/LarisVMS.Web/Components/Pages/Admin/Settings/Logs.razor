@page "/Admin/Settings/Logs"
@attribute [Authorize("Settings.Edit")]
@using System.Security.Claims
@using LarisVMS.Core
@using LarisVMS.Core.Interfaces
@using LarisVMS.Core.Logging
@using LarisVMS.Web.Helpers
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IConfiguration Configuration
@inject LarisVMS.Infrastructure.Data.ApplicationDbContext Db
@inject IPermissionService PermissionService

<PageTitle>@L["settings.logs.logSettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Logs" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<div class="lv-page-narrow">
<EditForm Model="this" FormName="log-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
    <SettingSection Title="@L["settings.logs.logging"]">
        <SettingField For="field-logLevel" Label="@L["settings.logs.minimumLogLevel"]" Hint="@L["settings.logs.appliesToThisServerAnd"]">
            <select id="field-logLevel" name="LogLevel" class="form-select">
                @foreach (var level in LogLevelOptions)
                {
                    <option value="@level" selected="@(level == LogLevel)">@level</option>
                }
            </select>
        </SettingField>
        <SettingField For="field-logPath" Label="@L["settings.logs.systemLogPath"]"
                      Hint="@(ConfiguredLogPathOverride is null ? L["settings.logs.setLogsPathInAppsettings"].Value : L["settings.logs.setViaTheLogsPath"].Value)">
            <input id="field-logPath" class="form-control font-monospace" value="@LogPath" disabled />
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.logs.retention"]">
        <SettingField For="field-logRetentionDays" Label="@L["settings.logs.systemLogRetentionDays"]" Hint="@L["settings.logs.thisServerLogFiles0"]">
            <InputNumber id="field-logRetentionDays" @bind-Value="LogRetentionDays" min="0" class="form-control" />
        </SettingField>
        <SettingField For="field-auditLogRetentionDays" Label="@L["settings.logs.auditLogRetentionDays"]" Hint="@L["settings.logs.0KeepsForeverTheDefault"]">
            <InputNumber id="field-auditLogRetentionDays" @bind-Value="AuditLogRetentionDays" min="0" class="form-control" />
        </SettingField>
        <SettingField For="field-cameraEventRetentionDays" Label="@L["settings.logs.cameraEventLogRetentionDays"]" Hint="@L["settings.logs.theRawEventsCamerasSend"]">
            <InputNumber id="field-cameraEventRetentionDays" @bind-Value="CameraEventRetentionDays" min="0" class="form-control" />
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.logs.syslog"]">
        <p class="small text-muted">@L["settings.logs.syslogIntro"]</p>
        <SettingField For="field-syslogHost" Label="@L["settings.logs.syslogHost"]" Hint="@L["settings.logs.syslogHostHint"]">
            <InputText id="field-syslogHost" @bind-Value="SyslogHost" class="form-control font-monospace" autocomplete="off" />
        </SettingField>
        <SettingField For="field-syslogProtocol" Label="@L["settings.logs.syslogProtocol"]" Hint="@L["settings.logs.syslogProtocolHint"]">
            <select id="field-syslogProtocol" name="SyslogProtocol" class="form-select">
                <option value="udp" selected="@(SyslogProtocol == "udp")">UDP</option>
                <option value="tcp" selected="@(SyslogProtocol == "tcp")">TCP</option>
                <option value="tls" selected="@(SyslogProtocol == "tls")">TLS</option>
            </select>
        </SettingField>
        <SettingField For="field-syslogPort" Label="@L["settings.logs.syslogPort"]" Hint="@L["settings.logs.syslogPortHint"]">
            <InputNumber id="field-syslogPort" @bind-Value="SyslogPort" min="0" max="65535" class="form-control" />
        </SettingField>
        @if (!string.IsNullOrEmpty(SyslogHost))
        {
            <p class="small mb-0" role="status">
                @if (AuditSyslogForwarder.LastError is { } syslogError)
                {
                    <span class="text-danger">@L["settings.logs.syslogFailing", new { error = syslogError }]</span>
                }
                else if (AuditSyslogForwarder.LastSentUtc is { } sentUtc)
                {
                    @L["settings.logs.syslogLastSent"] <time datetime="@sentUtc.ToUtcIso()" data-local="g">@sentUtc.ToLocalTime().ToString("g")</time>
                }
                else
                {
                    @L["settings.logs.syslogNothingSentYet"]
                }
            </p>
        }
    </SettingSection>
    <div class="lv-savebar">
        <button type="submit" class="btn btn-primary">@L["common.save"]</button>
    </div>
</EditForm>
</div>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "log-settings")] private int LogRetentionDays { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private int AuditLogRetentionDays { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private int CameraEventRetentionDays { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private string? LogLevel { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private string? SyslogHost { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private string? SyslogProtocol { get; set; }
    [SupplyParameterFromForm(FormName = "log-settings")] private int SyslogPort { get; set; }

    private static string[] LogLevelOptions => LogLevels.Selectable;

    private string LogPath { get; set; } = string.Empty;
    private string? ConfiguredLogPathOverride { get; set; }

    private string? SavedMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        LogPath = LogPaths.AppLogsDirectory(Configuration);
        ConfiguredLogPathOverride = Configuration[LogPaths.ConfigKey];

        // Skip the form fields on a POST: the submitted values are already bound, and reloading here
        // would save the old ones back (see Detection.razor's OnInitializedAsync).
        if (HttpContext?.Request.HasFormContentType == true) return;
        LogRetentionDays = await Settings.GetAsync(LogsRetentionService.RetentionDaysKey, LogsRetentionService.DefaultRetentionDays);
        AuditLogRetentionDays = await Settings.GetAsync(AuditLogRetentionService.RetentionDaysKey, AuditLogRetentionService.DefaultRetentionDays);
        CameraEventRetentionDays = await Settings.GetAsync(MotionSpanRetentionService.CameraEventRetentionDaysKey, MotionSpanRetentionService.DefaultCameraEventRetentionDays);
        LogLevel = await Settings.GetAsync("Logging.Level", "Information");
        SyslogHost = await Settings.GetRawAsync(AuditSyslogForwarder.HostKey);
        SyslogProtocol = await Settings.GetAsync(AuditSyslogForwarder.ProtocolKey, "udp");
        SyslogPort = await Settings.GetAsync(AuditSyslogForwarder.PortKey, 0);
    }

    private async Task HandleSaveAsync()
    {
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new ClaimsPrincipal(new ClaimsIdentity());
        var by = user.Identity?.Name;

        var oldLogRetention = await Settings.GetAsync(LogsRetentionService.RetentionDaysKey, LogsRetentionService.DefaultRetentionDays);
        var oldAuditRetention = await Settings.GetAsync(AuditLogRetentionService.RetentionDaysKey, AuditLogRetentionService.DefaultRetentionDays);
        var oldLogLevel = await Settings.GetAsync("Logging.Level", "Information");
        var oldEventRetention = await Settings.GetAsync(MotionSpanRetentionService.CameraEventRetentionDaysKey, MotionSpanRetentionService.DefaultCameraEventRetentionDays);
        var oldSyslogHost = await Settings.GetRawAsync(AuditSyslogForwarder.HostKey) ?? "";
        var oldSyslogProtocol = await Settings.GetAsync(AuditSyslogForwarder.ProtocolKey, "udp");
        var oldSyslogPort = await Settings.GetAsync(AuditSyslogForwarder.PortKey, 0);

        var newSyslogHost = SyslogHost?.Trim() ?? "";
        var newSyslogProtocol = SyslogProtocol is not null && AuditSyslogForwarder.Protocols.Contains(SyslogProtocol) ? SyslogProtocol : "udp";
        if (newSyslogHost.Length > 0 && !AuditSyslogForwarder.IsValidHost(newSyslogHost))
        {
            ErrorMessage = Loc.T("settings.logs.syslogHostInvalid");
            return;
        }
        if (SyslogPort is < 0 or > 65535)
        {
            ErrorMessage = Loc.T("settings.logs.syslogPortInvalid");
            return;
        }
        // Where the off-server copy of the audit log goes is a Super Admin's call: anyone else with
        // Settings.Edit could otherwise stop it, or send it somewhere of their choosing.
        var syslogChanged = newSyslogHost != oldSyslogHost || newSyslogProtocol != oldSyslogProtocol || SyslogPort != oldSyslogPort;
        if (syslogChanged && !(await AdminScope.ForAsync(Db, PermissionService, user)).IsSuperAdmin)
        {
            ErrorMessage = Loc.T("settings.logs.syslogSuperAdminOnly");
            return;
        }

        var newLogRetention = Math.Max(0, LogRetentionDays);
        var newAuditRetention = Math.Max(0, AuditLogRetentionDays);
        var newLogLevel = LogLevel is not null && LogLevels.Selectable.Contains(LogLevel, StringComparer.OrdinalIgnoreCase) ? LogLevel : "Information";
        await Settings.SetGlobalAsync(LogsRetentionService.RetentionDaysKey, newLogRetention.ToString(), by);
        await Settings.SetGlobalAsync(AuditLogRetentionService.RetentionDaysKey, newAuditRetention.ToString(), by);
        await Settings.SetGlobalAsync("Logging.Level", newLogLevel, by);
        var newEventRetention = Math.Max(0, CameraEventRetentionDays);
        await Settings.SetGlobalAsync(MotionSpanRetentionService.CameraEventRetentionDaysKey, newEventRetention.ToString(), by);
        CameraEventRetentionDays = newEventRetention;
        LogRetentionDays = newLogRetention;
        AuditLogRetentionDays = newAuditRetention;
        LogLevel = newLogLevel;

        // Web tier follows immediately; nodes + their vision services pick it up on their next
        // reconcile (~30s) and apply it without a restart.
        WebLogLevel.Apply(newLogLevel);

        var details = AuditDiff.Build(
            AuditDiff.Of(LogsRetentionService.RetentionDaysKey, oldLogRetention.ToString(), newLogRetention.ToString()),
            AuditDiff.Of(AuditLogRetentionService.RetentionDaysKey, oldAuditRetention.ToString(), newAuditRetention.ToString()),
            AuditDiff.Of("Logging.Level", oldLogLevel, newLogLevel),
            AuditDiff.Of(MotionSpanRetentionService.CameraEventRetentionDaysKey, oldEventRetention.ToString(), newEventRetention.ToString()),
            AuditDiff.Of(AuditSyslogForwarder.HostKey, oldSyslogHost, newSyslogHost),
            AuditDiff.Of(AuditSyslogForwarder.ProtocolKey, oldSyslogProtocol, newSyslogProtocol),
            AuditDiff.Of(AuditSyslogForwarder.PortKey, oldSyslogPort.ToString(), SyslogPort.ToString()));

        await AuditService.LogAsync("Settings.Update",
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        // After the entry above, so a change to where the log goes (or turning it off) is itself sent
        // to the old destination before the forwarder moves on.
        await Settings.SetGlobalAsync(AuditSyslogForwarder.HostKey, newSyslogHost, by);
        await Settings.SetGlobalAsync(AuditSyslogForwarder.ProtocolKey, newSyslogProtocol, by);
        await Settings.SetGlobalAsync(AuditSyslogForwarder.PortKey, SyslogPort.ToString(), by);
        SyslogHost = newSyslogHost;
        SyslogProtocol = newSyslogProtocol;

        SavedMessage = Loc.T("common.saved");
        LogPath = LogPaths.AppLogsDirectory(Configuration);
        ConfiguredLogPathOverride = Configuration[LogPaths.ConfigKey];
    }
}
