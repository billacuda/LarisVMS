@page "/Admin/Settings/Notifications"
@attribute [Authorize("Settings.Edit")]
@using System.Security.Claims
@using LarisVMS.Core
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Notifications
@using LarisVMS.Infrastructure.Security
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IEmailService Email

<PageTitle>@L["settings.notifications.notificationSettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Notifications" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<div class="lv-page-narrow">
<p class="text-muted small">
    @L.Markup("settings.notifications.intro")
</p>

<EditForm Model="this" FormName="notification-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
    <SettingSection Title="@L["settings.notifications.notificationTypes"]" Subtitle="@L["settings.notifications.turnATypeOffTo"]">
        @foreach (var (type, label) in NotificationSettings.Types)
        {
            <SettingField Label="@label">
                <div class="form-check form-switch mt-1">
                    <input type="checkbox" class="form-check-input" id="@($"type-{type}")" name="@($"type-{type}")" value="true"
                           checked="@(TypeEnabled.GetValueOrDefault(type, true))" />
                    <label class="form-check-label" for="@($"type-{type}")">@L["settings.notifications.usersCanReceiveIt"]</label>
                </div>
            </SettingField>
        }
    </SettingSection>

    <SettingSection Title="@L["settings.notifications.browserDelivery"]" Subtitle="@L["settings.notifications.howNotificationsReachAUser"]">
        <SettingField Label="@L["settings.notifications.whileLarisvmsIsOpen"]" Wide Hint="@L["settings.notifications.fullyOnPremisesNotificationsGo"]">
            <div class="form-check form-switch mt-1">
                <input type="checkbox" class="form-check-input" id="onPrem" name="onPrem" value="true" checked="@OnPrem" />
                <label class="form-check-label" for="onPrem">@L["common.on"]</label>
            </div>
        </SettingField>

        <SettingField Label="@L["settings.notifications.webPush"]" Wide Hint="@L["settings.notifications.standardBrowserPushInChrome"]">
            <div class="form-check form-switch mt-1">
                <input type="checkbox" class="form-check-input" id="webPush" name="webPush" value="true" checked="@WebPush" />
                <label class="form-check-label" for="webPush">@L["common.on"]</label>
            </div>
            <div class="small mt-1">
                @if (HasVapidKeys)
                {
                    <span class="text-success">@L["settings.notifications.keysGenerated"]</span> <span class="text-muted">@L["settings.notifications.generatingNewKeysSignsEvery"]</span>
                }
                else
                {
                    <span class="text-warning-emphasis">@L["settings.notifications.noKeysYetGenerateThem"]</span>
                }
            </div>
        </SettingField>
        <SettingField For="field-subject" Label="@L["settings.notifications.contactForPushServices"]" Hint="@L["settings.notifications.anEmailAddressThePush"]">
            <input id="field-subject" type="email" class="form-control" name="subject" value="@Subject" placeholder="admin@example.com" />
        </SettingField>

        <SettingField Label="@L["settings.notifications.firebaseCloudMessaging"]" Wide Hint="@L["settings.notifications.sendThroughYourOwnFirebase"]">
            <div class="form-check form-switch mt-1">
                <input type="checkbox" class="form-check-input" id="fcm" name="fcm" value="true" checked="@Fcm" />
                <label class="form-check-label" for="fcm">@L["common.on"]</label>
            </div>
        </SettingField>
        <SettingField For="field-fcmWebConfig" Label="@L["settings.notifications.firebaseWebAppConfig"]" Wide Hint="@L["settings.notifications.fromFirebaseConsoleProjectSettings"]">
            <textarea id="field-fcmWebConfig" class="form-control font-monospace small" name="fcmWebConfig" rows="5" placeholder='{ "apiKey": "…", "projectId": "…", "messagingSenderId": "…", "appId": "…" }'>@FcmWebConfig</textarea>
        </SettingField>
        <SettingField For="field-fcmVapidKey" Label="@L["settings.notifications.firebaseWebPushCertificate"]" Hint="@L["settings.notifications.projectSettingsCloudMessagingWeb"]">
            <input id="field-fcmVapidKey" type="text" class="form-control font-monospace small" name="fcmVapidKey" value="@FcmVapidKey" />
        </SettingField>
        <SettingField For="field-fcmServiceAccount" Label="@L["settings.notifications.firebaseServiceAccount"]" Wide Hint="@L["settings.notifications.projectSettingsServiceAccountsGenerate"]">
            <textarea id="field-fcmServiceAccount" class="form-control font-monospace small" name="fcmServiceAccount" rows="4"
                      placeholder="@(HasFcmServiceAccount ? L["settings.notifications.unchangedPasteANewKey"].Value : "{ \"type\": \"service_account\", … }")"></textarea>
            @if (FcmAccountProblem is not null)
            {
                <div class="small text-danger mt-1">@FcmAccountProblem</div>
            }
        </SettingField>
    </SettingSection>

    <SettingSection Title="@L["settings.notifications.emailDelivery"]">
        <SettingField Label="@L["settings.notifications.emailNotifications"]" Wide Hint="@(EmailConfigured ? L["settings.notifications.sentToEachUserOwn"].Value : L["settings.notifications.setUpEmailUnderSettings"].Value)">
            <div class="form-check form-switch mt-1">
                <input type="checkbox" class="form-check-input" id="emailOn" name="emailOn" value="true" checked="@EmailOn" />
                <label class="form-check-label" for="emailOn">@L["settings.notifications.usersCanChooseEmail"]</label>
            </div>
        </SettingField>
    </SettingSection>

    <div class="lv-savebar">
        <button type="submit" class="btn btn-primary">@L["common.save"]</button>
        <button type="button" class="btn btn-outline-secondary" id="notifTestBtn">@L["settings.notifications.sendATestToMe"]</button>
        <span id="notifTestStatus" class="small" role="status" aria-live="polite"></span>
    </div>
</EditForm>

<EditForm Model="this" FormName="notification-vapid" OnSubmit="HandleGenerateKeysAsync" class="mt-2">
    <button type="submit" class="btn btn-sm btn-outline-secondary"
            data-confirm="@(HasVapidKeys ? L["settings.notifications.generateNewWebPushKeys"].Value : null)">
        @(HasVapidKeys ? L["settings.notifications.generateNewWebPushKeys2"].Value : L["settings.notifications.generateWebPushKeys"].Value)
    </button>
</EditForm>
</div>

<SectionContent SectionName="PageScripts">
    <script nonce="@Csp.Value">
        (function () {
            var btn = document.getElementById('notifTestBtn');
            var status = document.getElementById('notifTestStatus');
            if (!btn || !window.larisvmsNotifications) return;
            btn.addEventListener('click', function () {
                status.className = 'small text-muted';
                status.textContent = 'Sending…';
                window.larisvmsNotifications.sendTest().then(function (r) {
                    var parts = [];
                    if (r.openTabs) parts.push(r.openTabs + ' open tab' + (r.openTabs === 1 ? '' : 's'));
                    if (r.pushDevices) parts.push(r.pushDevices + ' device' + (r.pushDevices === 1 ? '' : 's'));
                    if (r.emailSent) parts.push('email');
                    status.className = 'small ' + (parts.length ? 'text-success' : 'text-warning-emphasis');
                    status.textContent = (parts.length ? 'Sent to ' + parts.join(', ') + '.' : 'Nothing to send to — turn notifications on under My notifications.')
                        + (r.problems && r.problems.length ? ' ' + r.problems.join(' ') : '');
                }).catch(function (e) { status.className = 'small text-danger'; status.textContent = e.message; });
            });
        })();
    </script>
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private Dictionary<AlertConditionType, bool> TypeEnabled { get; set; } = [];
    private bool OnPrem { get; set; }
    private bool WebPush { get; set; }
    private bool HasVapidKeys { get; set; }
    private string? Subject { get; set; }
    private bool Fcm { get; set; }
    private string? FcmWebConfig { get; set; }
    private string? FcmVapidKey { get; set; }
    private bool HasFcmServiceAccount { get; set; }
    private string? FcmAccountProblem { get; set; }
    private bool EmailOn { get; set; }
    private bool EmailConfigured { get; set; }

    private string? SavedMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        foreach (var (type, _) in NotificationSettings.Types)
            TypeEnabled[type] = await NotificationSettings.IsTypeEnabledAsync(Settings, type);
        OnPrem = await Settings.GetAsync(NotificationSettings.OnPremEnabled, true);
        WebPush = await Settings.GetAsync(NotificationSettings.WebPushEnabled, false);
        HasVapidKeys = !string.IsNullOrEmpty(await Settings.GetRawAsync(NotificationSettings.WebPushPublicKey));
        Subject = (await Settings.GetAsync(NotificationSettings.WebPushSubject, "")).Replace("mailto:", "");
        Fcm = await Settings.GetAsync(NotificationSettings.FcmEnabled, false);
        FcmWebConfig = await Settings.GetRawAsync(NotificationSettings.FcmWebConfig);
        FcmVapidKey = await Settings.GetRawAsync(NotificationSettings.FcmVapidKey);
        var account = SecretProtection.Unprotect(await Settings.GetRawAsync(NotificationSettings.FcmServiceAccount));
        HasFcmServiceAccount = !string.IsNullOrWhiteSpace(account);
        FcmAccountProblem = null;
        if (HasFcmServiceAccount)
        {
            try { FcmClient.ParseServiceAccount(account!); }
            catch (ArgumentException ex) { FcmAccountProblem = ex.Message; }
        }
        EmailOn = await Settings.GetAsync(NotificationSettings.EmailEnabled, true);
        EmailConfigured = await Email.IsConfiguredAsync();
    }

    private async Task<(ClaimsPrincipal User, string? By)> UserAsync()
    {
        var user = AuthenticationStateTask is not null ? (await AuthenticationStateTask).User : new ClaimsPrincipal(new ClaimsIdentity());
        return (user, user.Identity?.Name);
    }

    private async Task HandleSaveAsync()
    {
        var form = HttpContext!.Request.Form;
        bool On(string name) => form[name].ToString() == "true";
        var (user, by) = await UserAsync();
        var changes = new List<AuditDiff.Field>();

        // Validate the Firebase pieces before saving anything.
        var webConfig = form["fcmWebConfig"].ToString().Trim();
        if (webConfig.Length > 0)
        {
            try { using var _ = System.Text.Json.JsonDocument.Parse(webConfig); }
            catch (System.Text.Json.JsonException) { await LoadAsync(); ErrorMessage = Loc.T("settings.notifications.theFirebaseWebAppConfig"); return; }
        }
        var newAccount = form["fcmServiceAccount"].ToString().Trim();
        if (newAccount.Length > 0)
        {
            try { FcmClient.ParseServiceAccount(newAccount); }
            catch (ArgumentException ex) { await LoadAsync(); ErrorMessage = ex.Message; return; }
        }
        var webPushOn = On("webPush");
        if (webPushOn && string.IsNullOrEmpty(await Settings.GetRawAsync(NotificationSettings.WebPushPublicKey)))
        {
            await LoadAsync();
            ErrorMessage = Loc.T("settings.notifications.generateWebPushKeysBefore");
            return;
        }

        foreach (var (type, label) in NotificationSettings.Types)
            changes.Add(await SetBoolAsync(NotificationSettings.TypeEnabledKey(type), $"Notification type: {label}", On($"type-{type}"), true, by));
        changes.Add(await SetBoolAsync(NotificationSettings.OnPremEnabled, "Notifications while open", On("onPrem"), true, by));
        changes.Add(await SetBoolAsync(NotificationSettings.WebPushEnabled, "Web Push", webPushOn, false, by));
        changes.Add(await SetBoolAsync(NotificationSettings.FcmEnabled, "Firebase Cloud Messaging", On("fcm"), false, by));
        changes.Add(await SetBoolAsync(NotificationSettings.EmailEnabled, "Email notifications", On("emailOn"), true, by));

        var subject = form["subject"].ToString().Trim();
        changes.Add(await SetTextAsync(NotificationSettings.WebPushSubject, "Push contact", subject.Length == 0 ? "" : "mailto:" + subject, by));
        changes.Add(await SetTextAsync(NotificationSettings.FcmWebConfig, "Firebase web app config", webConfig, by));
        changes.Add(await SetTextAsync(NotificationSettings.FcmVapidKey, "Firebase web push certificate", form["fcmVapidKey"].ToString().Trim(), by));
        if (newAccount.Length > 0)
        {
            await Settings.SetGlobalAsync(NotificationSettings.FcmServiceAccount, SecretProtection.Protect(newAccount)!, by);
            changes.Add(AuditDiff.SecretChanged("Firebase service account", true));
        }

        var details = AuditDiff.Build(changes.ToArray());
        if (!string.IsNullOrEmpty(details))
            await AuditService.LogAsync("Settings.Update", user.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
                HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        await LoadAsync();
        SavedMessage = Loc.T("common.saved");
    }

    private async Task HandleGenerateKeysAsync()
    {
        var (user, by) = await UserAsync();
        var keys = WebPushProtocol.GenerateVapidKeys();
        await Settings.SetGlobalAsync(NotificationSettings.WebPushPublicKey, keys.PublicKey, by);
        await Settings.SetGlobalAsync(NotificationSettings.WebPushPrivateKey, SecretProtection.Protect(keys.PrivateKey)!, by);
        await AuditService.LogAsync("Settings.Update", user.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), "Generated new Web Push (VAPID) keys.");
        await LoadAsync();
        SavedMessage = Loc.T("settings.notifications.newWebPushKeysGenerated");
    }

    // Each returns the audit field; AuditDiff.Build leaves out the ones that didn't change.
    private async Task<AuditDiff.Field> SetBoolAsync(string key, string label, bool value, bool defaultValue, string? by)
    {
        var old = await Settings.GetAsync(key, defaultValue);
        if (old != value) await Settings.SetGlobalAsync(key, value.ToString(), by);
        return AuditDiff.Of(label, old.ToString(), value.ToString());
    }

    private async Task<AuditDiff.Field> SetTextAsync(string key, string label, string value, string? by)
    {
        var old = await Settings.GetRawAsync(key) ?? "";
        if (old != value) await Settings.SetGlobalAsync(key, value, by);
        return AuditDiff.Of(label, old, value);
    }
}
