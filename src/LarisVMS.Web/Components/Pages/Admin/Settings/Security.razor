@page "/Admin/Settings/Security"
@attribute [Authorize("Settings.Edit")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication.OpenIdConnect
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using LarisVMS.Core
@using LarisVMS.Core.Entities
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Data
@using LarisVMS.Web.Auth
@using LarisVMS.Web.Middleware
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject ApplicationDbContext Db
@inject IOptionsMonitorCache<OpenIdConnectOptions> OidcOptionsCache
@inject IAuditService AuditService
@inject WebServerProtocols ServerProtocols
@inject ClientEndpointCspCache CspCache
@inject LarisVMS.Web.Security.CspReports CspReports

<PageTitle>@L["settings.security.securitySettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Security" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<div class="lv-page-narrow">
<EditForm Model="this" FormName="security-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
    <SettingSection Title="@L["settings.security.ipAllowLists"]" Subtitle="@L["settings.security.oneIpOrCidrPer"]">
        <SettingField For="field-managementAllowList" Label="@L["settings.security.managementApi"]" Hint="@L["settings.security.adminPagesAndTheRest"]" HelpLink="/Help/security#allow-lists">
            <InputTextArea id="field-managementAllowList" @bind-Value="ManagementAllowList" class="form-control font-monospace" rows="5"
                           placeholder="10.0.0.0/24&#10;192.168.1.50&#10;# office VPN"></InputTextArea>
        </SettingField>
        <SettingField For="field-liveViewAllowList" Label="@L["settings.security.liveViewPlayback"]" Hint="@L["settings.security.liveVideoPlaybackThumbnailsExports"]">
            <InputTextArea id="field-liveViewAllowList" @bind-Value="LiveViewAllowList" class="form-control font-monospace" rows="5"
                           placeholder="10.0.0.0/24"></InputTextArea>
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.security.entraIdSignIn"]" Subtitle="@L["settings.security.addsSignInWithMicrosoft"]">
        <SettingField Label="@L["common.status"]" Wide Hint="@($"Redirect URI: https://{HttpContext?.Request.Host}/signin-oidc")" HelpLink="/Help/users#entra">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="EntraEnabled" class="form-check-input" id="entraEnabled" />
                <label class="form-check-label" for="entraEnabled">@L["common.enabled"]</label>
            </div>
        </SettingField>
        <SettingField For="field-entraTenantId" Label="@L["settings.security.tenantId"]" ShowWhen="EntraEnabled=true">
            <InputText id="field-entraTenantId" @bind-Value="EntraTenantId" class="form-control font-monospace" placeholder="00000000-0000-0000-0000-000000000000" />
        </SettingField>
        <SettingField For="field-entraClientId" Label="@L["settings.security.clientId"]" ShowWhen="EntraEnabled=true">
            <InputText id="field-entraClientId" @bind-Value="EntraClientId" class="form-control font-monospace" placeholder="00000000-0000-0000-0000-000000000000" />
        </SettingField>
        <SettingField For="field-entraClientSecret" Label="@L["settings.security.clientSecret"]" ShowWhen="EntraEnabled=true" Hint="@L["settings.security.leaveBlankToKeepThe"]">
            <InputText id="field-entraClientSecret" @bind-Value="EntraClientSecret" type="password" class="form-control" autocomplete="off"
                       placeholder="@(HasStoredEntraClientSecret ? L["cameras.edit.unchanged"].Value : "")" />
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.security.webServer"]">
        <SettingField Label="HTTP/3" Wide Hint="@L["settings.security.fasterConnectionsForBrowsersThat"]" HelpLink="/Help/security#http3">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="Http3Enabled" class="form-check-input" id="http3Enabled" disabled="@(!ServerProtocols.Http3Supported)" />
                <label class="form-check-label" for="http3Enabled">@L["common.enabled"]</label>
            </div>
            <div class="small text-muted">
                @if (!ServerProtocols.Http3Supported)
                {
                    <span>@L["settings.security.notSupportedOnThisVersion"]</span>
                }
                else
                {
                    <span>@(ServerProtocols.Http3Active ? L["settings.security.runningNowOn"] : L["settings.security.runningNowOff"])</span>
                    @if (Http3Enabled != ServerProtocols.Http3Active)
                    {
                        <span> @L["settings.security.restartTheServiceToApply"]</span>
                    }
                }
            </div>
        </SettingField>
        <SettingField Label="@L["settings.security.strictScriptPolicy"]" Wide Hint="@L["settings.security.browsersRunOnlyThisSite"]" HelpLink="/Help/security#strict-script-policy">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="StrictScripts" class="form-check-input" id="strictScripts" />
                <label class="form-check-label" for="strictScripts">@L["settings.security.enforce"]</label>
            </div>
            @if (!StrictScripts)
            {
                <div class="small text-warning-emphasis">@L["settings.security.strictRecommended"]</div>
            }
            <div class="small text-muted">
                @if (CspReports.Total == 0)
                {
                    <span>@L["settings.security.noReportsSinceTheService"]</span>
                }
                else
                {
                    <span>@(CspReports.Total > RecentReports.Count ? L.Plural("settings.security.cspReportsLatest", CspReports.Total, new { latest = RecentReports.Count }) : L.Plural("settings.security.cspReports", CspReports.Total))</span>
                }
            </div>
            @if (RecentReports.Count > 0)
            {
                <div class="table-responsive mt-1" style="max-height: 16rem;">
                    <table class="table table-sm small mb-0">
                        <thead><tr><th>@L["settings.security.when"]</th><th>@L["settings.security.directive"]</th><th>@L["settings.security.blocked"]</th><th>@L["settings.security.where"]</th></tr></thead>
                        <tbody>
                            @foreach (var r in RecentReports)
                            {
                                <tr>
                                    <td class="text-nowrap"><time datetime="@r.AtUtc.ToUtcIso()" data-local="G">@r.AtUtc.ToLocalTime().ToString("G")</time></td>
                                    <td>@r.Directive</td>
                                    <td class="text-break">@r.Blocked</td>
                                    <td class="text-break">@r.Source</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </SettingField>
    </SettingSection>
    <SettingSection Title="@L["settings.security.extraProtection"]" Subtitle="@L["settings.security.extraProtectionSubtitle"]">
        <SettingField Label="@L["settings.security.requireTwoFactor"]" Wide Hint="@L["settings.security.requireTwoFactorHint"]" HelpLink="/Help/users#two-factor-sign-in">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="RequireTwoFactor" class="form-check-input" id="requireTwoFactor" />
                <label class="form-check-label" for="requireTwoFactor">@L["settings.security.require"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.security.confirmPasswordForAdmin"]" Wide Hint="@L["settings.security.confirmPasswordForAdminHint"]" HelpLink="/Help/users#sessions">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="ConfirmPasswordForAdmin" class="form-check-input" id="confirmPasswordForAdmin" />
                <label class="form-check-label" for="confirmPasswordForAdmin">@L["settings.security.askAgain"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.security.temporaryAdminPasswords"]" Wide Hint="@L["settings.security.temporaryAdminPasswordsHint"]" HelpLink="/Help/users#passwords">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="TemporaryAdminPasswords" class="form-check-input" id="temporaryAdminPasswords" />
                <label class="form-check-label" for="temporaryAdminPasswords">@L["settings.security.checkMustChangeByDefault"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.security.pinCameraCertificates"]" Wide Hint="@L["settings.security.pinCameraCertificatesHint"]" HelpLink="/Help/security#camera-certificates">
            <div class="form-check form-switch mt-1">
                <InputCheckbox @bind-Value="PinCameraCertificates" class="form-check-input" id="pinCameraCertificates" />
                <label class="form-check-label" for="pinCameraCertificates">@L["settings.security.rememberEachCamerasCertificate"]</label>
            </div>
        </SettingField>
    </SettingSection>
    <div class="lv-savebar">
        <button type="submit" class="btn btn-primary">@L["common.save"]</button>
    </div>
</EditForm>

@if (CameraPins.Count > 0)
{
    <h2 class="h6 mt-4">@L["settings.security.rememberedCameraCertificates"]</h2>
    <div class="table-responsive">
        <table class="table table-sm small">
            <thead><tr><th>@L["settings.security.cameraAddress"]</th><th>@L["settings.security.certificateSha256"]</th><th>@L["settings.security.firstSeen"]</th><th><span class="visually-hidden">@L["common.actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var pin in CameraPins)
                {
                    <tr>
                        <td class="font-monospace">@pin.Host</td>
                        <td class="font-monospace text-break">@pin.Thumbprint</td>
                        <td class="text-nowrap">@pin.FirstSeenUtc.ToTimeTag("g")</td>
                        <td class="text-end">
                            <form method="post" @formname="@($"forget-pin-{pin.Host}")" @onsubmit="() => HandleForgetPinAsync(pin.Host)">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-confirm="@L["settings.security.forgetCertificateConfirm", new { host = pin.Host }]">@L["settings.security.forget"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "security-settings")] private string? ManagementAllowList { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private string? LiveViewAllowList { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool EntraEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private string? EntraTenantId { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private string? EntraClientId { get; set; }
    // Blank on save means "leave unchanged" — same convention EmailSettings' own secret fields use,
    // since the real value is never round-tripped back to the browser.
    [SupplyParameterFromForm(FormName = "security-settings")] private string? EntraClientSecret { get; set; }
    private bool HasStoredEntraClientSecret { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool Http3Enabled { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool StrictScripts { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool RequireTwoFactor { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool PinCameraCertificates { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool ConfirmPasswordForAdmin { get; set; }
    [SupplyParameterFromForm(FormName = "security-settings")] private bool TemporaryAdminPasswords { get; set; }

    private List<LarisVMS.Core.Entities.CameraCertificatePin> CameraPins = [];

    private IReadOnlyList<LarisVMS.Web.Security.CspReports.Entry> RecentReports = [];

    private string? SavedMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var entra = await Db.EntraSsoSettings.AsNoTracking().FirstOrDefaultAsync();
        HasStoredEntraClientSecret = !string.IsNullOrEmpty(entra?.ClientSecret);
        RecentReports = CspReports.Recent();
        CameraPins = await Db.CameraCertificatePins.AsNoTracking().OrderBy(p => p.Host).ToListAsync();

        // Skip the form fields on a POST: the submitted values are already bound, and reloading here
        // would save the old ones back (see Detection.razor's OnInitializedAsync).
        if (HttpContext?.Request.HasFormContentType == true) return;
        ManagementAllowList = await Settings.GetRawAsync(IpAllowListMiddleware.ManagementSettingKey) ?? string.Empty;
        LiveViewAllowList = await Settings.GetRawAsync(IpAllowListMiddleware.LiveViewSettingKey) ?? string.Empty;
        EntraEnabled = entra?.IsEnabled ?? false;
        EntraTenantId = entra?.TenantId;
        EntraClientId = entra?.ClientId;
        Http3Enabled = await Settings.GetAsync(WebServerProtocols.Http3SettingKey, true);
        StrictScripts = await Settings.GetAsync(LarisVMS.Web.Security.CspNonce.StrictSettingKey, true);
        RequireTwoFactor = await Settings.GetAsync(TwoFactorSignIn.RequireSettingKey, false);
        PinCameraCertificates = await Settings.GetAsync(LarisVMS.Core.Security.CameraPinningSettings.EnabledKey, false);
        ConfirmPasswordForAdmin = await Settings.GetAsync(StepUpPolicy.SettingKey, false);
        TemporaryAdminPasswords = await Settings.GetAsync(PasswordChangeRequirement.TemporaryAdminPasswordsKey, false);
    }

    private async Task HandleForgetPinAsync(string host)
    {
        var user = AuthenticationStateTask is not null ? (await AuthenticationStateTask).User : new ClaimsPrincipal(new ClaimsIdentity());
        var pin = await Db.CameraCertificatePins.FindAsync(host);
        if (pin is null) return;
        Db.CameraCertificatePins.Remove(pin);
        await Db.SaveChangesAsync();
        CameraCertificatePinService.RequestReload();
        await AuditService.LogAsync("Camera.CertificateForgotten", user.FindFirst(ClaimTypes.NameIdentifier)?.Value, user.Identity?.Name,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), $"{host} ({pin.Thumbprint})");
        CameraPins = await Db.CameraCertificatePins.AsNoTracking().OrderBy(p => p.Host).ToListAsync();
        SavedMessage = Loc.T("settings.security.certificateForgotten", new { host });
    }

    private async Task HandleSaveAsync()
    {
        // An empty textarea posts nothing, which binds null.
        ManagementAllowList ??= string.Empty;
        LiveViewAllowList ??= string.Empty;
        var management = IpAllowListPolicy.Parse(ManagementAllowList);
        var liveView = IpAllowListPolicy.Parse(LiveViewAllowList);
        var invalid = management.InvalidLines.Concat(liveView.InvalidLines).ToList();
        if (invalid.Count > 0)
        {
            ErrorMessage = Loc.T("settings.security.notAValidIpOr", new { entries = string.Join(", ", invalid) });
            return;
        }

        // This page is itself management traffic — refuse a management-list save that would lock out
        // the very request making it, rather than the documented-but-unhelpful "no built-in recovery"
        // outcome. Only the management list can do this to this page; the live/playback list has no
        // bearing on reaching Admin > Settings at all.
        var remoteIp = HttpContext?.Connection.RemoteIpAddress;
        if (!IpAllowListPolicy.IsAllowed(remoteIp, management.Networks))
        {
            ErrorMessage = Loc.T("settings.security.notSavedTheManagementApi", new { remoteIp });
            return;
        }

        var entra = await Db.EntraSsoSettings.FirstOrDefaultAsync();
        var hadStoredSecret = !string.IsNullOrEmpty(entra?.ClientSecret);
        if (EntraEnabled && (string.IsNullOrWhiteSpace(EntraTenantId) || string.IsNullOrWhiteSpace(EntraClientId)
            || (!hadStoredSecret && string.IsNullOrWhiteSpace(EntraClientSecret))))
        {
            ErrorMessage = Loc.T("settings.security.enterATenantIdClient");
            HasStoredEntraClientSecret = hadStoredSecret;
            return;
        }
        // Sign-in has to be limited to your own directory: the multi-tenant endpoints would accept
        // accounts from any Microsoft tenant.
        if (EntraEnabled && EntraTenantId!.Trim().ToLowerInvariant() is "common" or "organizations" or "consumers")
        {
            ErrorMessage = Loc.T("settings.security.enterYourOwnDirectoryTenant");
            HasStoredEntraClientSecret = hadStoredSecret;
            return;
        }

        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new ClaimsPrincipal(new ClaimsIdentity());
        var by = user.Identity?.Name;
        var oldManagement = await Settings.GetRawAsync(IpAllowListMiddleware.ManagementSettingKey) ?? string.Empty;
        var oldLiveView = await Settings.GetRawAsync(IpAllowListMiddleware.LiveViewSettingKey) ?? string.Empty;
        var oldEntraEnabled = entra?.IsEnabled ?? false;
        var oldHttp3 = await Settings.GetAsync(WebServerProtocols.Http3SettingKey, true);
        var oldStrict = await Settings.GetAsync(LarisVMS.Web.Security.CspNonce.StrictSettingKey, true);
        var oldRequireTwoFactor = await Settings.GetAsync(TwoFactorSignIn.RequireSettingKey, false);
        var oldPinCameras = await Settings.GetAsync(LarisVMS.Core.Security.CameraPinningSettings.EnabledKey, false);
        var oldConfirmPassword = await Settings.GetAsync(StepUpPolicy.SettingKey, false);
        var oldTemporaryPasswords = await Settings.GetAsync(PasswordChangeRequirement.TemporaryAdminPasswordsKey, false);
        // A disabled switch posts nothing; keep the saved value rather than turning it off.
        if (!ServerProtocols.Http3Supported) Http3Enabled = oldHttp3;

        await Settings.SetGlobalAsync(IpAllowListMiddleware.ManagementSettingKey, ManagementAllowList, by);
        await Settings.SetGlobalAsync(IpAllowListMiddleware.LiveViewSettingKey, LiveViewAllowList, by);
        await Settings.SetGlobalAsync(WebServerProtocols.Http3SettingKey, Http3Enabled.ToString(), by);
        await Settings.SetGlobalAsync(LarisVMS.Web.Security.CspNonce.StrictSettingKey, StrictScripts.ToString(), by);
        await Settings.SetGlobalAsync(TwoFactorSignIn.RequireSettingKey, RequireTwoFactor.ToString(), by);
        await Settings.SetGlobalAsync(LarisVMS.Core.Security.CameraPinningSettings.EnabledKey, PinCameraCertificates.ToString(), by);
        await Settings.SetGlobalAsync(StepUpPolicy.SettingKey, ConfirmPasswordForAdmin.ToString(), by);
        await Settings.SetGlobalAsync(PasswordChangeRequirement.TemporaryAdminPasswordsKey, TemporaryAdminPasswords.ToString(), by);
        CameraCertificatePinService.RequestReload();
        CspCache.Invalidate();

        var isNewEntraRow = entra is null;
        entra ??= new EntraSsoSettings { Id = Guid.NewGuid() };
        entra.IsEnabled = EntraEnabled;
        entra.TenantId = string.IsNullOrWhiteSpace(EntraTenantId) ? null : EntraTenantId.Trim();
        entra.ClientId = string.IsNullOrWhiteSpace(EntraClientId) ? null : EntraClientId.Trim();
        if (!string.IsNullOrWhiteSpace(EntraClientSecret)) entra.ClientSecret = EntraClientSecret;
        entra.LastModifiedAt = DateTime.UtcNow;
        entra.LastModifiedBy = by;
        if (isNewEntraRow) Db.EntraSsoSettings.Add(entra);
        await Db.SaveChangesAsync();

        // Forces EntraOidcOptionsConfigurator to re-run on the next sign-in challenge instead of
        // reusing whatever it resolved (and IOptionsMonitorCache cached) last time — see its own doc
        // comment for why this is what makes a saved change take effect with no app restart needed.
        OidcOptionsCache.TryRemove(EntraOidcOptionsConfigurator.SchemeName);

        var details = AuditDiff.Build(
            AuditDiff.Of("Management/API allow list", oldManagement, ManagementAllowList),
            AuditDiff.Of("Live View/playback allow list", oldLiveView, LiveViewAllowList),
            AuditDiff.Of("Entra sign-in enabled", oldEntraEnabled.ToString(), EntraEnabled.ToString()),
            AuditDiff.Of("HTTP/3 enabled", oldHttp3.ToString(), Http3Enabled.ToString()),
            AuditDiff.Of("Strict script policy", oldStrict.ToString(), StrictScripts.ToString()),
            AuditDiff.Of("Require two-factor sign-in", oldRequireTwoFactor.ToString(), RequireTwoFactor.ToString()),
            AuditDiff.Of("Camera certificate pinning", oldPinCameras.ToString(), PinCameraCertificates.ToString()),
            AuditDiff.Of("Confirm password for admin pages", oldConfirmPassword.ToString(), ConfirmPasswordForAdmin.ToString()),
            AuditDiff.Of("Temporary admin-set passwords", oldTemporaryPasswords.ToString(), TemporaryAdminPasswords.ToString()),
            AuditDiff.SecretChanged("Entra client secret", !string.IsNullOrWhiteSpace(EntraClientSecret)));

        await AuditService.LogAsync("Settings.Update",
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        // Never echoed back — same "blank means unchanged, the real value never round-trips to the
        // browser" convention EmailSettings' own secret fields use.
        EntraClientSecret = null;
        HasStoredEntraClientSecret = !string.IsNullOrEmpty(entra.ClientSecret);

        SavedMessage = Loc.T("common.saved");
    }
}
