    private static readonly (string Category, string Text)[] MovingCategoryChoices =
    [
        (LarisVMS.Core.CocoCategoryMap.Human, "People"),
        (LarisVMS.Core.CocoCategoryMap.Vehicle, "Vehicles"),
        (LarisVMS.Core.CocoCategoryMap.Animal, "Animals"),
