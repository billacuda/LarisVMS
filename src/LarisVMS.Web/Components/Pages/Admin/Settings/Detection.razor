    private string OtherObjectsSummary
    {
        get
        {
            var chosen = LarisVMS.Core.CocoCategoryMap.OtherObjectLabels.Where(MovingObjectsSet.Contains).ToList();
            return chosen.Count switch
            {
                0 => Loc.T("settings.detection.otherObjectsNone"),
                1 => Loc.T("settings.detection.otherObjectsOne", new { first = chosen[0] }),
                _ => Loc.T("settings.detection.otherObjectsMore", new { first = chosen[0], more = chosen.Count - 1 }),
            };
        }
    }

    /// <summary>Names in the setting that are neither a category nor in the offered list — a custom
    /// model's own object names.</summary>
    private string MovingObjectExtras => string.Join(", ", MovingObjectsSet
        .Where(v => MovingCategoryChoices.All(c => !string.Equals(c.Category, v, StringComparison.OrdinalIgnoreCase))
            && !LarisVMS.Core.CocoCategoryMap.OtherObjectLabels.Contains(v, StringComparer.OrdinalIgnoreCase)));

    /// <summary>The submitted choices as the stored Detection.MovingObjects value: the ticked
    /// categories and offered objects, then the typed names (trimmed, at most 30, no commas inside).</summary>
    private static string MovingObjectsFromForm(Microsoft.AspNetCore.Http.IFormCollection form)
    {
        var categories = form["MovingCategory"].Where(v => MovingCategoryChoices.Any(c => c.Category == v));
        var offered = form["MovingObjectLabel"].Where(v => v is not null && LarisVMS.Core.CocoCategoryMap.OtherObjectLabels.Contains(v));
        var typed = form["MovingObjectExtra"].ToString()
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(v => v.Length <= 40);
        return string.Join(",", categories.Concat(offered).Concat(typed)
            .Distinct(StringComparer.OrdinalIgnoreCase).Take(60));
    }
