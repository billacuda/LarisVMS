@page "/Admin/Settings/Detection"
@attribute [Authorize("Settings.Edit")]
@using LarisVMS.Core
@using LarisVMS.Core.Dtos
@using LarisVMS.Core.Interfaces
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject ExternalInferenceProbe ExternalProbe
@inject INodeService NodeService
@inject NodeControlClient NodeControlClient

<PageTitle>AI detection settings - @AppName</PageTitle>

<h1>Settings</h1>
<SettingsTabs ActiveKey="Detection" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert @(StatusIsError ? "alert-danger" : "alert-success")">@SavedMessage</div>
}

<EditForm Model="this" FormName="detection-settings" OnSubmit="HandleSubmitAsync" class="row g-3" style="max-width: 560px;">
    <div class="col-6">
        <label class="form-label">
            Confidence threshold
            <button type="button" class="help-icon" data-help-target="confidenceHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="d-flex align-items-center gap-2">
            <input type="range" name="Confidence" value="@Confidence" min="0" max="1" step="0.05" class="form-range" id="confidenceRange" />
            <output class="text-muted small" style="min-width: 2.5em;" id="confidenceReadout">@Math.Round(Confidence * 100)</output>
        </div>
        <div class="help-text-source" id="confidenceHelp">
            Minimum score a detection needs to be reported at all. Lower catches more real objects but
            also more false positives; higher misses fainter/partial detections. A per-camera override
            is available on that camera's own Edit page.
        </div>
    </div>
    <div class="col-6">
        <label class="form-label">
            IoU threshold
            <button type="button" class="help-icon" data-help-target="iouHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="d-flex align-items-center gap-2">
            <input type="range" name="Iou" value="@Iou" min="0" max="1" step="0.05" class="form-range" id="iouRange" />
            <output class="text-muted small" style="min-width: 2.5em;" id="iouReadout">@Math.Round(Iou * 100)</output>
        </div>
        <div class="help-text-source" id="iouHelp">
            Overlap threshold used to merge duplicate boxes for the same object. A per-camera override
            is available on that camera's own Edit page.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Detection model
            <button type="button" class="help-icon" data-help-target="modelFamilyHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        @* Plain <select>, not InputSelect: InputSelect renders the current value as a value="..."
           attribute on the <select> tag itself and relies on an interactive Blazor circuit's JS
           interop to apply it to the live DOM element after render. This page has no interactive
           render mode (Static SSR), so that step never runs — the raw HTML never gets a "selected"
           option, and the browser silently falls back to the first one regardless of the real saved
           value. A plain <select name="..."> with selected="@(...)" on each <option> is valid HTML
           that works with zero JS involved, matching every other converted page's select handling
           (Nodes.razor, Cameras/Index.razor, ...). *@
        <select name="ModelFamily" class="form-select">
            <option value="Auto" selected="@(ModelFamily == "Auto")">Auto (YOLOX)</option>
            <option value="YoloX" selected="@(ModelFamily == "YoloX")">YOLOX</option>
            <option value="DFine" selected="@(ModelFamily == "DFine")">D-FINE (experimental)</option>
            <option value="Custom" selected="@(ModelFamily == "Custom")">Custom (a model dropped into C:\ProgramData\LarisVMS\models)</option>
            <option value="RfDetr" disabled>RF-DETR (not yet available)</option>
        </select>
        <div class="help-text-source" id="modelFamilyHelp">
            Which detection model architecture runs inference. Auto resolves to YOLOX on every
            accelerator — it needs no letterboxing, runs well on low-power and non-Nvidia GPUs, and
            uses an Nvidia GPU fully where present. <strong>D-FINE is experimental</strong> — it works,
            but results can be unpredictable, and objects that straddle two tiles under the Slice
            aspect-fitting option are currently missed or duplicated. Prefer YOLOX unless you are
            specifically evaluating D-FINE. This is a per-node setting, not per-camera: one detection
            process serves every camera on a node from one loaded model — a per-node override is on
            that node's own page (<a href="/Admin/Nodes">manage nodes</a>). YOLOX models are not
            bundled — a node fetches the chosen size from this server on first use.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            YOLOX model size
            <button type="button" class="help-icon" data-help-target="yoloXSizeHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="YoloXSize" class="form-select">
            <option value="Nano" selected="@(YoloXSize == "Nano")">Nano — smallest / fastest (416 input)</option>
            <option value="Tiny" selected="@(YoloXSize == "Tiny")">Tiny (416 input)</option>
            <option value="S" selected="@(YoloXSize == "S")">S — balanced (default, 640 input)</option>
            <option value="M" selected="@(YoloXSize == "M")">M (640 input)</option>
            <option value="L" selected="@(YoloXSize == "L")">L (640 input)</option>
            <option value="X" selected="@(YoloXSize == "X")">X — largest / most accurate (640 input)</option>
        </select>
        <div class="help-text-source" id="yoloXSizeHelp">
            Only meaningful when the model above resolves to YOLOX. Match it to the node's hardware —
            Nano/Tiny for a low-power box, L/X for a strong GPU. Per-node overridable on
            <a href="/Admin/Nodes">manage nodes</a>. Changing it restarts each camera's detection
            pipeline and fetches the new model.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            D-FINE weights
            <button type="button" class="help-icon" data-help-target="dfineWeightsHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="DFineWeights" class="form-select">
            <option value="Obj2Coco" selected="@(DFineWeights == "Obj2Coco")">Obj2Coco (small) — 80 COCO classes (default)</option>
            <option value="Obj2CocoMedium" selected="@(DFineWeights == "Obj2CocoMedium")">Obj2Coco (medium) — same 80 classes, heavier/more accurate</option>
            <option value="Obj365" selected="@(DFineWeights == "Obj365")">Obj365 (small) — 365 Objects365 classes (richer vocabulary)</option>
        </select>
        <div class="help-text-source" id="dfineWeightsHelp">
            Only meaningful when the detection model above is set to D-FINE. Obj365 recognizes a
            much wider range of specific object types at the cost of a larger, more specific
            vocabulary — see the Snapshots page's own filter tree once it's in use. The medium
            Obj2Coco model keeps the same 80-class vocabulary but uses a larger backbone: more
            accurate, noticeably more work per frame — best paired with a capable GPU and a lower
            detection frame-rate cap. Changing this restarts each camera's detection pipeline.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            Local model name
            <button type="button" class="help-icon" data-help-target="localModelNameHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="input-group">
            <select name="LocalModelName" class="form-select" id="localModelNameSelect">
                <option value="" selected="@string.IsNullOrEmpty(LocalModelName)">(none selected)</option>
                @{
                    var localOptions = AvailableLocalModels.ToList();
                    if (localOptions.All(m => m.Name != LocalModelName) && !string.IsNullOrEmpty(LocalModelName))
                    {
                        <option value="@LocalModelName" selected>@LocalModelName (saved — Refresh models to check it's still available)</option>
                    }
                }
                @foreach (var m in localOptions)
                {
                    <option value="@m.Name" selected="@(m.Name == LocalModelName)">
                        @m.Name — @(m.Decoder ?? "unresolved")@(m.InputSize is { } s ? $" ({s}x{s})" : "")@(m.Warnings.Count > 0 ? " ⚠️ metadata incomplete" : "") · on: @string.Join(", ", m.AvailableOnNodes)
                    </option>
                }
            </select>
            <button type="submit" name="Action" value="RefreshLocalModels" class="btn btn-outline-secondary">Refresh models</button>
        </div>
        @if (AvailableLocalModels.Any(m => m.Warnings.Count > 0))
        {
            <div class="form-text">
                @foreach (var m in AvailableLocalModels.Where(m => m.Warnings.Count > 0))
                {
                    <div class="text-warning">⚠️ <strong>@m.Name</strong>: @string.Join(" ", m.Warnings)</div>
                }
            </div>
        }
        <div class="help-text-source" id="localModelNameHelp">
            Only meaningful when the detection model above is set to Custom. Names a model dropped
            into <code>C:\ProgramData\LarisVMS\models</code> on a node — its decoder and input size
            are read from the model's own metadata, or from a same-named <code>.json</code> sidecar
            when that's missing or incomplete. "Refresh models" asks every online node what it found;
            a model listed with a warning is still usable to select but won't actually run detection
            until the warning is resolved (usually by adding a sidecar). A global default here isn't
            necessarily present on every node — check the "on:" list. Per-node override on
            <a href="/Admin/Nodes">manage nodes</a>.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            D-FINE TensorRT
            <button type="button" class="help-icon" data-help-target="dfineTensorRtHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="DFineTensorRtMode" class="form-select">
            <option value="Off" selected="@(DFineTensorRtMode == "Off")">Off — plain CUDA (default)</option>
            <option value="FP32" selected="@(DFineTensorRtMode == "FP32")">FP32 — TensorRT, graph fusion + kernel selection</option>
            <option value="FP16" selected="@(DFineTensorRtMode == "FP16")">FP16 — TensorRT, half-precision (fastest, auto-falls back to FP32)</option>
        </select>
        <div class="help-text-source" id="dfineTensorRtHelp">
            Only applies when the detection model is D-FINE <em>and</em> the node has TensorRT enabled
            (the machine-local <code>Vision:EnableTensorRt</code> setting) with the TensorRT 10.x SDK
            installed — it does nothing on a node without those. <strong>FP32</strong> runs D-FINE
            through TensorRT for graph fusion and kernel selection with no FP16 math — a safe speedup
            over plain CUDA. <strong>FP16</strong> runs the same plain model at half precision for the
            fastest inference, with D-FINE's LayerNorm subgraphs kept in FP32 to protect against the
            transformer-activation overflow FP16 can otherwise cause. If a camera's engine still
            overflows anyway, the Vision Service detects it automatically (a frame decoding to zero
            detections with non-finite raw output) and rebuilds that camera's engine at FP32 in the
            background — no admin action needed, though that camera reports no detections for the
            short rebuild window. This is a per-node setting; changing it recompiles the TensorRT
            engine, which takes several minutes on the first start per camera resolution. A per-node
            override is on <a href="/Admin/Nodes">manage nodes</a>.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            Aspect fitting
            <button type="button" class="help-icon" data-help-target="aspectModeHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="AspectMode" class="form-select">
            <option value="Letterbox" selected="@(AspectMode == "Letterbox")">Letterbox — preserve aspect ratio, pad with black bars (default)</option>
            <option value="Stretch" selected="@(AspectMode == "Stretch")">Stretch — squash to fill the model's square input</option>
            <option value="Slice" selected="@(AspectMode == "Slice")">Slice — cut into overlapping squares, run each at full resolution</option>
        </select>
        <div class="help-text-source" id="aspectModeHelp">
            How a camera's own real aspect ratio fits into the detection model's square input.
            Letterbox keeps the model seeing correct proportions for a portrait or panoramic
            camera, at the cost of some black bar padding; Stretch distorts a non-square camera's
            geometry to fill the square exactly (this app's behavior before this setting existed).
            Slice scales the short edge to the model's own input size and cuts the long edge into
            2 or more overlapping squares, each detected at full resolution and merged back into
            one result — the best option for catching small or distant objects on a wide or tall
            camera, at the cost of roughly N&times; the inference work (a 16:9 camera runs 2
            detections per frame instead of 1). Requires GPU frame preprocessing — there is no CPU
            fallback for slicing, so it forces that setting on for any camera using it regardless of
            the toggle below. Lower the max detection frame rate if this pushes drop% up on the
            cadence log. This is a per-node setting, not per-camera — a per-node override is
            available on that node's own page (<a href="/Admin/Nodes">manage nodes</a>).
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Detection stream
            <button type="button" class="help-icon" data-help-target="streamRoleHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="StreamRole" class="form-select">
            <option value="Sub" selected="@(StreamRole == "Sub")">Sub</option>
            <option value="Main" selected="@(StreamRole == "Main")">Main</option>
        </select>
        <div class="help-text-source" id="streamRoleHelp">
            Which of a camera's streams AI detection actually watches — Sub (lower resolution, lighter
            load) by default. A per-camera override is available on that camera's own Edit page.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Camera orientation
            <button type="button" class="help-icon" data-help-target="orientationHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="Orientation" class="form-select">
            <option value="Auto" selected="@(Orientation == "Auto")">Auto</option>
            <option value="Landscape" selected="@(Orientation == "Landscape")">Landscape</option>
            <option value="Portrait" selected="@(Orientation == "Portrait")">Portrait</option>
        </select>
        <div class="help-text-source" id="orientationHelp">
            Auto trusts the resolution a camera reports for its detection stream. Some corridor-mounted
            cameras advertise a landscape stream (704x480) while actually sending portrait video
            (480x704) — detection then runs on a squashed frame and snapshot crops come out
            horizontally stretched. Setting Portrait corrects the shape before the frame reaches the
            model. Almost always a per-camera setting rather than a deployment default; the override
            is on that camera's own Edit page.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Idle timeout (seconds)
            <button type="button" class="help-icon" data-help-target="idleTimeoutHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <InputNumber @bind-Value="IdleTimeoutSeconds" min="0" class="form-control" required />
        <div class="help-text-source" id="idleTimeoutHelp">
            How long a detected object can go unseen (or sit idle) before its snapshot is finalized and
            a later re-detection starts a new one. Too short fragments one continuous sighting into
            several snapshots; too long delays finalizing a snapshot after the object is actually gone.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Max detection frame rate
            <button type="button" class="help-icon" data-help-target="maxFpsHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <InputNumber @bind-Value="MaxFps" min="0" max="60" class="form-control" required />
        <div class="help-text-source" id="maxFpsHelp">
            The ceiling on how many frames per second per camera reach the detection model. The
            recorder still decodes each camera's Sub stream in real time — this just drops the surplus
            before inference so the GPU idles between frames instead of running flat out (which is
            what causes thermal throttling on a busy node). It has no effect on a camera whose Sub
            stream is already at or below this rate. 0 disables the cap. 10 is plenty for object
            tracking; raise it only if fast motion is being missed. Per-node overridable on
            <a href="/Admin/Nodes">manage nodes</a>.
        </div>
    </div>

    <div class="col-12 form-check">
        <InputCheckbox @bind-Value="ReportIdleDetections" class="form-check-input" id="reportIdleDetections" />
        <label class="form-check-label" for="reportIdleDetections">
            Report idle (stationary) objects
            <button type="button" class="help-icon" data-help-target="reportIdleHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="help-text-source" id="reportIdleHelp">
            Off by default — a track that stops moving no longer keeps its snapshot open, so a parked
            vehicle or a person standing still doesn't get reported at all once it settles. Turn this on
            to also report objects that are present but not moving.
        </div>
    </div>

    <div class="col-12 form-check">
        <InputCheckbox @bind-Value="SnapshotMotionAccuracy" class="form-check-input" id="snapshotMotionAccuracy" />
        <label class="form-check-label" for="snapshotMotionAccuracy">
            Snapshot motion accuracy
            <button type="button" class="help-icon" data-help-target="snapshotMotionAccuracyHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="help-text-source" id="snapshotMotionAccuracyHelp">
            On by default. Once a moving object leaves the scene its snapshot is finalized within a few
            seconds (see the grace period below) instead of staying open long enough for a later,
            unrelated object of the same type to be folded into it. Turn it off to compare against the
            previous behaviour. Global; changing it restarts each camera's detection pipeline.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Departure grace (seconds)
            <button type="button" class="help-icon" data-help-target="departureGraceHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="d-flex align-items-center gap-2">
            <input type="range" name="DepartureGraceSeconds" value="@DepartureGraceSeconds" min="1" max="10" step="1" class="form-range" id="departureGraceRange" />
            <output class="text-muted small" style="min-width: 2.5em;" id="departureGraceReadout">@DepartureGraceSeconds</output>
        </div>
        <div class="help-text-source" id="departureGraceHelp">
            How long after an object was last seen moving before its snapshot is finalized as
            "departed". Only applies while "Snapshot motion accuracy" above is on. Shorter finalizes
            sooner but risks splitting one object that briefly pauses into two snapshots; longer holds
            the snapshot open for a later same-type object to merge in. Was a fixed 5 seconds.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Snapshot crop margin (%)
            <button type="button" class="help-icon" data-help-target="snapshotMarginHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="d-flex align-items-center gap-2">
            <input type="range" name="SnapshotMarginPercent" value="@SnapshotMarginPercent" min="0" max="100" step="1" class="form-range" id="snapshotMarginRange" />
            <output class="text-muted small" style="min-width: 2.5em;" id="snapshotMarginReadout">@SnapshotMarginPercent</output>
        </div>
        <div class="help-text-source" id="snapshotMarginHelp">
            How much extra room the live snapshot crop keeps around a detected object, as a percentage
            of the object's own box size — 0 crops exactly to the reported box, higher shows more of
            the surrounding scene so it's clear where the object is relative to what's around it.
            Applies the same way regardless of detection backend (built-in or an external service).
            Was a fixed 12%. Restarts each camera's detection pipeline. Does not affect the separate
            still-frame crop taken from recorded video for the snapshot gallery, which keeps its own
            larger margin (it also has to absorb some timing drift between the live and recorded
            streams, not just leave room to look at).
        </div>
    </div>

    <div class="col-12 form-check">
        <InputCheckbox @bind-Value="RejectMotionJitter" class="form-check-input" id="rejectMotionJitter" />
        <label class="form-check-label" for="rejectMotionJitter">
            Reject stationary-object jitter
            <button type="button" class="help-icon" data-help-target="rejectMotionJitterHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="help-text-source" id="rejectMotionJitterHelp">
            Off by default, and experimental. Smooths the movement check so a distant parked vehicle
            whose detection box wobbles frame-to-frame doesn't register as "moving" and stop producing
            stray snapshots. On a noisier model (e.g. YOLOX-M) it has also been observed to hold
            genuinely slow-moving objects as idle, so it is opt-in — this is the deployment-wide
            default; set it per camera on a camera's own Edit page for the ones that actually have a
            parked vehicle in view. Restarts each camera's detection pipeline.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Jitter threshold (pixels)
            <button type="button" class="help-icon" data-help-target="motionJitterPixelsHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="d-flex align-items-center gap-2">
            <input type="range" name="MotionJitterPixels" value="@MotionJitterPixels" min="1" max="15" step="1" class="form-range" id="motionJitterPixelsRange" />
            <output class="text-muted small" style="min-width: 2.5em;" id="motionJitterPixelsReadout">@MotionJitterPixels</output>
        </div>
        <div class="help-text-source" id="motionJitterPixelsHelp">
            Minimum real pixel travel of a detection box's centre before it counts as moving. Only
            applies where "Reject stationary-object jitter" is on. Higher rejects more box wobble but
            also ignores slower genuine movement; 3 is the previous built-in value. Per-camera
            overridable on a camera's own Edit page.
        </div>
    </div>

    <div class="col-12 form-check">
        <InputCheckbox @bind-Value="GpuPreprocessing" class="form-check-input" id="gpuPreprocessing" />
        <label class="form-check-label" for="gpuPreprocessing">
            GPU frame preprocessing
            <button type="button" class="help-icon" data-help-target="gpuPreprocessingHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <div class="help-text-source" id="gpuPreprocessingHelp">
            Off by default. Moves the per-frame colour conversion and normalization that detection
            does before every inference off the CPU and onto the accelerator (it becomes part of the
            model graph, so it runs on NVIDIA, AMD or Intel hardware the same way). Meant to lower CPU
            load on nodes running several cameras. This is a per-node setting; toggling it restarts
            each camera's detection pipeline. Forced on automatically for a camera using the Slice
            aspect fitting option above, regardless of this toggle — there is no CPU fallback for
            frame slicing.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Detection backend
            <button type="button" class="help-icon" data-help-target="backendHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <select name="Backend" class="form-select" id="backendSelect">
            <option value="BuiltIn" selected="@(Backend == "BuiltIn")">Built-in — bundled model on the node's own accelerator (default)</option>
            <option value="ExternalHttp" selected="@(Backend == "ExternalHttp")">External HTTP service — send frames to your own inference server</option>
        </select>
        <div class="help-text-source" id="backendHelp">
            Built-in runs one of the bundled models (YOLOX / D-FINE) on each node's GPU. The external
            option runs no model on the node at all: every frame is scaled to the model's input size,
            JPEG-encoded, and POSTed to an inference server you run, which replies with JSON boxes.
            Use it for models LarisVMS doesn't bundle. Everything downstream — tracking, snapshots,
            timeline, live overlay — is identical. This is the one detection path that needs no GPU on
            the node. Per-node setting; changing it restarts each camera's detection pipeline.
        </div>
    </div>

    <fieldset class="col-12 border rounded p-3" id="externalBackendFields" style="@(Backend == "ExternalHttp" ? "" : "display:none;")">
        <legend class="fs-6 text-muted">External inference service</legend>

        <div class="mb-3">
            <label class="form-label">Service URL</label>
            <div class="input-group">
                <InputText type="url" @bind-Value="ExternalUrl" class="form-control" placeholder="http://192.168.1.50:8080" />
                <button type="submit" name="Action" value="TestConnection" class="btn btn-outline-secondary">
                    Test connection
                </button>
            </div>
            <div class="form-text">Include the port. The service must expose <code>POST /v1/detect</code>, <code>GET /v1/models</code> and <code>GET /healthz</code>.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">API key</label>
            <InputText type="password" @bind-Value="ExternalApiKey" autocomplete="new-password" class="form-control"
                   placeholder="@(HasStoredExternalApiKey ? "•••••••• (unchanged — leave blank to keep it)" : "leave blank if the service needs no auth")" />
            <div class="form-text">
                Sent as <code>Authorization: Bearer &lt;key&gt;</code> on every request, including "Test connection".
                A service bound to loopback only (the common case) needs none; SideGlance and most others require
                one once reachable over the LAN. Never re-shown once saved — type a new value to replace it.
            </div>
        </div>

        @if (ProbeHealth is { } h)
        {
            <div class="small text-muted mb-2">
                Service: <strong>@(h.Status ?? "?")</strong>
                @if (!string.IsNullOrEmpty(h.Version)) { <text>· v@(h.Version)</text> }
                @if (!string.IsNullOrEmpty(h.Backend)) { <text>· backend @(h.Backend)</text> }
                @if (h.ModelsReady is { } ready) { <text>· @ready model(s) ready</text> }
                @if (h.ModelsFailed is { } failed and > 0) { <text>· @failed failed</text> }
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Model</label>
            <select name="ExternalModel" class="form-select" id="externalModelSelect">
                @{
                    var options = AvailableModels.ToList();
                    if (options.Count == 0 && !string.IsNullOrEmpty(ExternalModel))
                    {
                        <option value="@ExternalModel" data-input-size="@ExternalInputSize" selected>@ExternalModel (saved — Test connection to refresh)</option>
                    }
                }
                @foreach (var m in options)
                {
                    <option value="@m.Name" data-input-size="@m.InputSize"
                        data-input-modes="@string.Join(',', m.InputModes ?? [])" selected="@(m.Name == ExternalModel)">
                        @m.Name — @(m.InputSize)px input@(m.ClassCount is { } cc ? $", {cc} classes" : "")@(string.IsNullOrEmpty(m.Decoder) ? "" : $" ({m.Decoder})")@(string.Equals(m.Status, "ready", StringComparison.OrdinalIgnoreCase) ? "" : $" [{m.Status}]")
                    </option>
                }
            </select>
            <input type="hidden" name="ExternalInputSize" value="@ExternalInputSize" id="externalInputSize" />
            <div class="form-text">
                @if (AvailableModels.Count == 0)
                {
                    <text>Click <strong>Test connection</strong> to load the model list from the service.</text>
                }
                else
                {
                    <text>The model's input size sizes the frames LarisVMS sends. Slice aspect-fitting is delegated to the service.</text>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Transport</label>
            <select name="ExternalTransport" class="form-select" id="externalTransportSelect">
                <option value="Auto" selected="@(ExternalTransport == "Auto")">Auto (JPEG for now)</option>
                <option value="Jpeg" selected="@(ExternalTransport == "Jpeg")">JPEG — works with any service</option>
                <option value="PixelsYuv420" selected="@(ExternalTransport == "PixelsYuv420")">Raw YUV 4:2:0 — no JPEG codec, ~10x the bandwidth</option>
                <option value="PixelsBgra" selected="@(ExternalTransport == "PixelsBgra")">Raw BGRA — no JPEG codec, ~4x the bandwidth</option>
            </select>
            <div class="form-text" id="externalTransportHint">
                Skips the JPEG encode/decode round trip on a loopback or LAN service that supports it —
                use <strong>Test connection</strong> to check what the selected model actually
                advertises before picking a raw mode; an unsupported choice degrades to errors on
                every frame, not a graceful fallback.
            </div>
        </div>
    </fieldset>

    <div class="col-12">
        <button type="submit" name="Action" value="Save" class="btn btn-primary"><span aria-hidden="true">💾</span> Save</button>
    </div>
</EditForm>

<SectionContent SectionName="PageScripts">
    <script>
        // Confidence/IoU slider readouts, wired explicitly by id — see slider inputs above.
        (function () {
            function wireSlider(rangeId, readoutId, transform) {
                var range = document.getElementById(rangeId);
                var readout = document.getElementById(readoutId);
                if (!range || !readout) return;
                function sync() { readout.textContent = transform(range.value); }
                range.addEventListener('input', sync);
                sync(); // in case the slider's own value differs from what was rendered server-side
            }
            var asPercent = function (v) { return Math.round(v * 100); };
            var asInt = function (v) { return Math.round(v); };
            wireSlider('confidenceRange', 'confidenceReadout', asPercent);
            wireSlider('iouRange', 'iouReadout', asPercent);
            wireSlider('departureGraceRange', 'departureGraceReadout', asInt);
            wireSlider('snapshotMarginRange', 'snapshotMarginReadout', asInt);
            wireSlider('motionJitterPixelsRange', 'motionJitterPixelsReadout', asInt);
        })();

        // External-backend section: show its fields only when that backend is selected, and keep the
        // hidden input-size field in sync with the picked model (each <option> carries its own size,
        // discovered by "Test connection") so Save always stores the size that matches the model.
        (function () {
            var backend = document.getElementById('backendSelect');
            var fields = document.getElementById('externalBackendFields');
            var model = document.getElementById('externalModelSelect');
            var size = document.getElementById('externalInputSize');
            if (backend && fields) {
                backend.addEventListener('change', function () {
                    fields.style.display = backend.value === 'ExternalHttp' ? '' : 'none';
                });
            }
            function syncSize() {
                if (!model || !size) return;
                var opt = model.options[model.selectedIndex];
                var v = opt && opt.getAttribute('data-input-size');
                if (v) size.value = v;
            }
            if (model) { model.addEventListener('change', syncSize); syncSize(); }

            // Warns (without blocking Save — the operator may be configuring ahead of a service
            // upgrade) when the selected transport isn't in the selected model's own advertised
            // input_modes. A model with no input_modes at all (older/non-advertising service, or
            // nothing probed yet) shows no warning either way — "unknown" isn't "unsupported".
            var transport = document.getElementById('externalTransportSelect');
            var hint = document.getElementById('externalTransportHint');
            var defaultHint = hint ? hint.textContent.trim() : '';
            var wireName = { PixelsYuv420: 'pixels_yuv420sp', PixelsBgra: 'pixels_bgra32' };
            function syncTransportHint() {
                if (!transport || !hint || !model) return;
                var needed = wireName[transport.value];
                if (!needed) { hint.textContent = defaultHint; hint.classList.remove('text-warning'); return; }
                var opt = model.options[model.selectedIndex];
                var modes = (opt && opt.getAttribute('data-input-modes')) || '';
                if (!modes) { hint.textContent = defaultHint; hint.classList.remove('text-warning'); return; }
                var supported = modes.split(',').indexOf(needed) !== -1;
                if (supported) {
                    hint.textContent = 'The selected model advertises ' + needed + ' — this transport should work.';
                    hint.classList.remove('text-warning');
                } else {
                    hint.textContent = 'The selected model did NOT advertise ' + needed + ' on the last Test connection — this will fail on every frame until the service supports it.';
                    hint.classList.add('text-warning');
                }
            }
            if (transport) { transport.addEventListener('change', syncTransportHint); }
            if (model) { model.addEventListener('change', syncTransportHint); }
            syncTransportHint();
        })();
    </script>
</SectionContent>

@code {
    /// <summary>One local (descriptor-driven or catalog) model name, merged across however many
    /// online nodes HandleRefreshLocalModelsAsync found it on — a global default isn't necessarily
    /// present on every machine, so the picklist shows that rather than silently picking whichever
    /// node answered first.</summary>
    private sealed record MergedLocalModel(string Name, string? Decoder, int? InputSize, IReadOnlyList<string> Warnings,
        IReadOnlyList<string> AvailableOnNodes);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private System.Security.Claims.ClaimsPrincipal User =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
    private string? CurrentUserId => User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    [SupplyParameterFromForm(FormName = "detection-settings")] private double Confidence { get; set; } = 0.35;
    [SupplyParameterFromForm(FormName = "detection-settings")] private double Iou { get; set; } = 0.5;
    [SupplyParameterFromForm(FormName = "detection-settings")] private string StreamRole { get; set; } = "Sub";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string Orientation { get; set; } = "Auto";
    [SupplyParameterFromForm(FormName = "detection-settings")] private bool ReportIdleDetections { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private int IdleTimeoutSeconds { get; set; } = 10;
    [SupplyParameterFromForm(FormName = "detection-settings")] private bool SnapshotMotionAccuracy { get; set; } = true;
    [SupplyParameterFromForm(FormName = "detection-settings")] private bool RejectMotionJitter { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private int MotionJitterPixels { get; set; } = 3;
    [SupplyParameterFromForm(FormName = "detection-settings")] private int DepartureGraceSeconds { get; set; } = 5;
    [SupplyParameterFromForm(FormName = "detection-settings")] private int SnapshotMarginPercent { get; set; } = 12;
    [SupplyParameterFromForm(FormName = "detection-settings")] private int MaxFps { get; set; } = 10;
    [SupplyParameterFromForm(FormName = "detection-settings")] private string ModelFamily { get; set; } = "Auto";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string DFineWeights { get; set; } = "Obj2Coco";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string DFineTensorRtMode { get; set; } = "Off";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string YoloXSize { get; set; } = "S";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string LocalModelName { get; set; } = "";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string AspectMode { get; set; } = "Letterbox";
    [SupplyParameterFromForm(FormName = "detection-settings")] private bool GpuPreprocessing { get; set; }

    [SupplyParameterFromForm(FormName = "detection-settings")] private string Backend { get; set; } = "BuiltIn";
    [SupplyParameterFromForm(FormName = "detection-settings")] private string? ExternalUrl { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private string? ExternalModel { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private int ExternalInputSize { get; set; } = 640;
    [SupplyParameterFromForm(FormName = "detection-settings")] private string? ExternalApiKey { get; set; }
    private bool HasStoredExternalApiKey { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private string ExternalTransport { get; set; } = "Auto";

    // Native HTML substitute for Razor Pages' asp-page-handler multi-handler buttons — see Email.razor's
    // own copy of this comment for why a plain @onclick on type="button" doesn't work under Static SSR.
    [SupplyParameterFromForm(FormName = "detection-settings")] private string? Action { get; set; }

    private IReadOnlyList<ExternalModelInfo> AvailableModels { get; set; } = [];
    private ExternalHealthResponse? ProbeHealth { get; set; }
    private IReadOnlyList<MergedLocalModel> AvailableLocalModels { get; set; } = [];

    private string? SavedMessage;
    private bool StatusIsError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Confidence = await Settings.GetAsync("Detection.Confidence", 0.35);
        Iou = await Settings.GetAsync("Detection.Iou", 0.5);
        StreamRole = await Settings.GetAsync("AiDetection.StreamRole", "Sub");
        Orientation = await Settings.GetAsync("AiDetection.Orientation", "Auto");
        ReportIdleDetections = await Settings.GetAsync("Detection.ReportIdleDetections", false);
        IdleTimeoutSeconds = await Settings.GetAsync("Detection.IdleTimeoutSeconds", 10);
        SnapshotMotionAccuracy = await Settings.GetAsync("Detection.SnapshotMotionAccuracy", true);
        RejectMotionJitter = await Settings.GetAsync("Detection.RejectMotionJitter", false);
        MotionJitterPixels = await Settings.GetAsync("Detection.MotionJitterPixels", 3);
        DepartureGraceSeconds = await Settings.GetAsync("Detection.DepartureGraceSeconds", 5);
        SnapshotMarginPercent = await Settings.GetAsync("Detection.SnapshotMarginPercent", 12);
        MaxFps = await Settings.GetAsync("Detection.MaxFps", 10);
        ModelFamily = await Settings.GetAsync("Detection.ModelFamily", "Auto");
        DFineWeights = await Settings.GetAsync("Detection.DFineWeights", "Obj2Coco");
        DFineTensorRtMode = await Settings.GetAsync("Detection.DFineTensorRtMode", "Off");
        YoloXSize = await Settings.GetAsync("Detection.YoloXSize", "S");
        LocalModelName = await Settings.GetAsync("Detection.LocalModelName", "");
        AspectMode = await Settings.GetAsync("Detection.AspectMode", "Letterbox");
        GpuPreprocessing = await Settings.GetAsync("Detection.GpuPreprocessing", false);
        Backend = await Settings.GetAsync("Detection.Backend", "BuiltIn");
        ExternalUrl = await Settings.GetAsync("Detection.ExternalInferenceUrl", "");
        ExternalModel = await Settings.GetAsync("Detection.ExternalInferenceModel", "");
        ExternalInputSize = await Settings.GetAsync("Detection.ExternalInferenceInputSize", 640);
        HasStoredExternalApiKey = !string.IsNullOrEmpty(await Settings.GetAsync("Detection.ExternalInferenceApiKey", ""));
        ExternalTransport = await Settings.GetAsync("Detection.ExternalInferenceTransport", "Auto");
    }

    private async Task HandleSubmitAsync()
    {
        switch (Action)
        {
            case "RefreshLocalModels": await HandleRefreshLocalModelsAsync(); break;
            case "TestConnection": await HandleTestConnectionAsync(); break;
            default: await HandleSaveAsync(); break;
        }
    }

    private async Task HandleSaveAsync()
    {
        var by = User.Identity?.Name;

        var oldConfidence = await Settings.GetAsync("Detection.Confidence", 0.35);
        var oldIou = await Settings.GetAsync("Detection.Iou", 0.5);
        var oldStreamRole = await Settings.GetAsync("AiDetection.StreamRole", "Sub");
        var oldOrientation = await Settings.GetAsync("AiDetection.Orientation", "Auto");
        var oldReportIdleDetections = await Settings.GetAsync("Detection.ReportIdleDetections", false);
        var oldIdleTimeoutSeconds = await Settings.GetAsync("Detection.IdleTimeoutSeconds", 10);
        var oldSnapshotMotionAccuracy = await Settings.GetAsync("Detection.SnapshotMotionAccuracy", true);
        var oldRejectMotionJitter = await Settings.GetAsync("Detection.RejectMotionJitter", false);
        var oldMotionJitterPixels = await Settings.GetAsync("Detection.MotionJitterPixels", 3);
        var oldDepartureGraceSeconds = await Settings.GetAsync("Detection.DepartureGraceSeconds", 5);
        var oldSnapshotMarginPercent = await Settings.GetAsync("Detection.SnapshotMarginPercent", 12);
        var oldMaxFps = await Settings.GetAsync("Detection.MaxFps", 10);
        var oldModelFamily = await Settings.GetAsync("Detection.ModelFamily", "Auto");
        var oldDFineWeights = await Settings.GetAsync("Detection.DFineWeights", "Obj2Coco");
        var oldDFineTensorRtMode = await Settings.GetAsync("Detection.DFineTensorRtMode", "Off");
        var oldYoloXSize = await Settings.GetAsync("Detection.YoloXSize", "S");
        var oldLocalModelName = await Settings.GetAsync("Detection.LocalModelName", "");
        var oldAspectMode = await Settings.GetAsync("Detection.AspectMode", "Letterbox");
        var oldGpuPreprocessing = await Settings.GetAsync("Detection.GpuPreprocessing", false);
        var oldBackend = await Settings.GetAsync("Detection.Backend", "BuiltIn");
        var oldExternalUrl = await Settings.GetAsync("Detection.ExternalInferenceUrl", "");
        var oldExternalModel = await Settings.GetAsync("Detection.ExternalInferenceModel", "");
        var oldExternalInputSize = await Settings.GetAsync("Detection.ExternalInferenceInputSize", 640);
        var hadStoredApiKey = !string.IsNullOrEmpty(await Settings.GetAsync("Detection.ExternalInferenceApiKey", ""));
        var oldExternalTransport = await Settings.GetAsync("Detection.ExternalInferenceTransport", "Auto");

        // Confidence/IoU are genuinely 0-1 fractions everywhere downstream (YOLO-family thresholds) —
        // clamped here so a stray out-of-range value typed into the form can't reach NodeService/the
        // Vision Service pipeline unchecked.
        Confidence = Math.Clamp(Confidence, 0, 1);
        Iou = Math.Clamp(Iou, 0, 1);
        IdleTimeoutSeconds = Math.Max(0, IdleTimeoutSeconds);
        MotionJitterPixels = Math.Clamp(MotionJitterPixels, 1, 15);
        DepartureGraceSeconds = Math.Clamp(DepartureGraceSeconds, 1, 10);
        SnapshotMarginPercent = Math.Clamp(SnapshotMarginPercent, 0, 100);
        MaxFps = Math.Clamp(MaxFps, 0, 60);
        // Only three values are meaningful downstream (CameraDetectionPipeline's switch); anything
        // else lands on "Off" there anyway, so normalize a stray form value rather than store it.
        DFineTensorRtMode = DFineTensorRtMode?.Trim().ToUpperInvariant() switch
        {
            "FP32" => "FP32",
            "FP16" => "FP16",
            _ => "Off",
        };
        Backend = string.Equals(Backend, "ExternalHttp", StringComparison.OrdinalIgnoreCase) ? "ExternalHttp" : "BuiltIn";
        ExternalUrl = NormalizeExternalUrl(ExternalUrl);
        ExternalModel = ExternalModel?.Trim() ?? "";
        // A positive multiple of 32 (InferenceProfile's own requirement); anything else falls back to
        // the D-FINE/YOLOX default rather than being stored.
        ExternalInputSize = ExternalInputSize > 0 && ExternalInputSize % 32 == 0 ? ExternalInputSize : 640;
        // Only four values are meaningful downstream (ExternalInferenceTransportExtensions.Parse);
        // normalize a stray form value to "Auto" rather than store garbage.
        ExternalTransport = ExternalTransport?.Trim() switch
        {
            "Jpeg" => "Jpeg",
            "PixelsYuv420" => "PixelsYuv420",
            "PixelsBgra" => "PixelsBgra",
            _ => "Auto",
        };

        // A configured external backend needs a URL and a model to be usable — reject the save rather
        // than let NodeService silently keep the built-in engine because the fields are half-filled.
        if (Backend == "ExternalHttp" && (string.IsNullOrEmpty(ExternalUrl) || string.IsNullOrEmpty(ExternalModel)))
        {
            var editedUrl = ExternalUrl;
            var editedModel = ExternalModel;
            var editedSize = ExternalInputSize;
            var editedApiKey = ExternalApiKey;
            var editedTransport = ExternalTransport;
            await LoadAsync();
            // Re-apply the just-submitted values so the form keeps the operator's edits.
            Backend = "ExternalHttp";
            ExternalUrl = editedUrl;
            ExternalModel = editedModel;
            ExternalInputSize = editedSize;
            ExternalApiKey = editedApiKey;
            ExternalTransport = editedTransport;
            SavedMessage = "Enter the external service URL and pick a model (use \"Test connection\" to discover them) before selecting the external backend.";
            StatusIsError = true;
            return;
        }

        await Settings.SetGlobalAsync("Detection.Confidence", Confidence.ToString("0.####"), by);
        await Settings.SetGlobalAsync("Detection.Iou", Iou.ToString("0.####"), by);
        await Settings.SetGlobalAsync("AiDetection.StreamRole", StreamRole, by);
        await Settings.SetGlobalAsync("AiDetection.Orientation", Orientation, by);
        await Settings.SetGlobalAsync("Detection.ReportIdleDetections", ReportIdleDetections.ToString(), by);
        await Settings.SetGlobalAsync("Detection.IdleTimeoutSeconds", IdleTimeoutSeconds.ToString(), by);
        await Settings.SetGlobalAsync("Detection.SnapshotMotionAccuracy", SnapshotMotionAccuracy.ToString(), by);
        await Settings.SetGlobalAsync("Detection.RejectMotionJitter", RejectMotionJitter.ToString(), by);
        await Settings.SetGlobalAsync("Detection.MotionJitterPixels", MotionJitterPixels.ToString(), by);
        await Settings.SetGlobalAsync("Detection.DepartureGraceSeconds", DepartureGraceSeconds.ToString(), by);
        await Settings.SetGlobalAsync("Detection.SnapshotMarginPercent", SnapshotMarginPercent.ToString(), by);
        await Settings.SetGlobalAsync("Detection.MaxFps", MaxFps.ToString(), by);
        // RfDetr still renders disabled (no decoder); ModelFamily is "Auto", "DFine" or "YoloX" here.
        await Settings.SetGlobalAsync("Detection.ModelFamily", ModelFamily, by);
        await Settings.SetGlobalAsync("Detection.DFineWeights", DFineWeights, by);
        await Settings.SetGlobalAsync("Detection.DFineTensorRtMode", DFineTensorRtMode, by);
        await Settings.SetGlobalAsync("Detection.YoloXSize", YoloXSize, by);
        await Settings.SetGlobalAsync("Detection.LocalModelName", LocalModelName ?? "", by);
        await Settings.SetGlobalAsync("Detection.AspectMode", AspectMode, by);
        await Settings.SetGlobalAsync("Detection.GpuPreprocessing", GpuPreprocessing.ToString(), by);
        await Settings.SetGlobalAsync("Detection.Backend", Backend, by);
        await Settings.SetGlobalAsync("Detection.ExternalInferenceUrl", ExternalUrl ?? "", by);
        await Settings.SetGlobalAsync("Detection.ExternalInferenceModel", ExternalModel ?? "", by);
        await Settings.SetGlobalAsync("Detection.ExternalInferenceInputSize", ExternalInputSize.ToString(), by);
        await Settings.SetGlobalAsync("Detection.ExternalInferenceTransport", ExternalTransport, by);
        // Blank means "unchanged" — the form never re-displays a stored key, so a blank submission
        // only happens when the operator genuinely left it alone (same convention as Email's
        // SmtpPassword/GraphClientSecret). There is no "clear" affordance here, same as those fields.
        var apiKeyChanged = !string.IsNullOrWhiteSpace(ExternalApiKey);
        if (apiKeyChanged)
            await Settings.SetGlobalAsync("Detection.ExternalInferenceApiKey", ExternalApiKey!.Trim(), by);

        var details = AuditDiff.Build(
            AuditDiff.Of("Detection.Confidence", oldConfidence.ToString("0.####"), Confidence.ToString("0.####")),
            AuditDiff.Of("Detection.Iou", oldIou.ToString("0.####"), Iou.ToString("0.####")),
            AuditDiff.Of("AiDetection.StreamRole", oldStreamRole, StreamRole),
            AuditDiff.Of("AiDetection.Orientation", oldOrientation, Orientation),
            AuditDiff.Of("Detection.ReportIdleDetections", oldReportIdleDetections.ToString(), ReportIdleDetections.ToString()),
            AuditDiff.Of("Detection.IdleTimeoutSeconds", oldIdleTimeoutSeconds.ToString(), IdleTimeoutSeconds.ToString()),
            AuditDiff.Of("Detection.SnapshotMotionAccuracy", oldSnapshotMotionAccuracy.ToString(), SnapshotMotionAccuracy.ToString()),
            AuditDiff.Of("Detection.RejectMotionJitter", oldRejectMotionJitter.ToString(), RejectMotionJitter.ToString()),
            AuditDiff.Of("Detection.MotionJitterPixels", oldMotionJitterPixels.ToString(), MotionJitterPixels.ToString()),
            AuditDiff.Of("Detection.DepartureGraceSeconds", oldDepartureGraceSeconds.ToString(), DepartureGraceSeconds.ToString()),
            AuditDiff.Of("Detection.SnapshotMarginPercent", oldSnapshotMarginPercent.ToString(), SnapshotMarginPercent.ToString()),
            AuditDiff.Of("Detection.MaxFps", oldMaxFps.ToString(), MaxFps.ToString()),
            AuditDiff.Of("Detection.ModelFamily", oldModelFamily, ModelFamily),
            AuditDiff.Of("Detection.DFineWeights", oldDFineWeights, DFineWeights),
            AuditDiff.Of("Detection.DFineTensorRtMode", oldDFineTensorRtMode, DFineTensorRtMode),
            AuditDiff.Of("Detection.YoloXSize", oldYoloXSize, YoloXSize),
            AuditDiff.Of("Detection.LocalModelName", oldLocalModelName, LocalModelName),
            AuditDiff.Of("Detection.AspectMode", oldAspectMode, AspectMode),
            AuditDiff.Of("Detection.GpuPreprocessing", oldGpuPreprocessing.ToString(), GpuPreprocessing.ToString()),
            AuditDiff.Of("Detection.Backend", oldBackend, Backend),
            AuditDiff.Of("Detection.ExternalInferenceUrl", oldExternalUrl, ExternalUrl ?? ""),
            AuditDiff.Of("Detection.ExternalInferenceModel", oldExternalModel, ExternalModel ?? ""),
            AuditDiff.Of("Detection.ExternalInferenceInputSize", oldExternalInputSize.ToString(), ExternalInputSize.ToString()),
            AuditDiff.Of("Detection.ExternalInferenceTransport", oldExternalTransport, ExternalTransport),
            AuditDiff.SecretChanged("Detection.ExternalInferenceApiKey", apiKeyChanged));

        await AuditService.LogAsync("Settings.Update",
            CurrentUserId, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        // So the form's "unchanged" placeholder reflects a key just saved this request.
        HasStoredExternalApiKey = hadStoredApiKey || apiKeyChanged;
        ExternalApiKey = null;
        SavedMessage = "Saved.";
        StatusIsError = false;

        // A global default affects every node, so trigger all of them — fire-and-forget, exactly like
        // the per-node override save on Admin/Nodes: this should take effect promptly rather than
        // waiting out each node's own 30s reconcile poll, but a slow/unreachable node must never hold
        // up this page's own response, and that 30s poll remains the correctness backstop regardless.
        foreach (var node in await NodeService.ListAsync())
            _ = NodeControlClient.TriggerReconcileAsync(node);
    }

    /// <summary>"Refresh models" for the model-agnostic (Custom) family — fans out to every node's own
    /// GET /vision/models (via NodeControlClient, in parallel) and merges the results by name, since a
    /// global default isn't necessarily present on every machine. Mirrors HandleTestConnectionAsync's
    /// "load the saved page, then restore the operator's in-progress edit" shape.</summary>
    private async Task HandleRefreshLocalModelsAsync()
    {
        var editedLocalModelName = LocalModelName;
        await LoadAsync();
        LocalModelName = editedLocalModelName;

        var nodes = await NodeService.ListAsync();
        var perNode = await Task.WhenAll(nodes.Select(async n => (Node: n, Models: await NodeControlClient.GetVisionModelsAsync(n))));

        var merged = new Dictionary<string, MergedLocalModel>(StringComparer.OrdinalIgnoreCase);
        foreach (var (node, models) in perNode)
        {
            foreach (var m in models)
            {
                if (merged.TryGetValue(m.Name, out var existing))
                {
                    merged[m.Name] = existing with { AvailableOnNodes = [.. existing.AvailableOnNodes, node.Name] };
                }
                else
                {
                    merged[m.Name] = new MergedLocalModel(m.Name, m.Decoder, m.InputSize, m.Warnings, [node.Name]);
                }
            }
        }

        AvailableLocalModels = [.. merged.Values.OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)];
        SavedMessage = AvailableLocalModels.Count == 0
            ? "No models found on any online node — drop an .onnx file into C:\\ProgramData\\LarisVMS\\models on a node, then refresh again."
            : $"Found {AvailableLocalModels.Count} model(s) across {perNode.Count(p => p.Models.Count > 0)} node(s).";
        StatusIsError = AvailableLocalModels.Count == 0;
    }

    /// <summary>"Test connection" — probes the entered (unsaved) service for /healthz + /v1/models so
    /// the operator can confirm it is reachable and pick a model. Mirrors Email's test-send and
    /// Cameras' probe: try/catch into a message + audit entry, never throws.</summary>
    private async Task HandleTestConnectionAsync()
    {
        var by = User.Identity?.Name;

        // The external fields are model-bound from the form; everything else on the page should show
        // its saved value, so load those and then restore the operator's in-progress external edits.
        var editedUrl = NormalizeExternalUrl(ExternalUrl);
        var editedModel = ExternalModel?.Trim() ?? "";
        // Blank means "use the already-saved key" — same "unchanged" convention the field uses on
        // Save, so testing right after typing a new key (not yet saved) still authenticates with it.
        var editedApiKey = string.IsNullOrWhiteSpace(ExternalApiKey) ? null : ExternalApiKey.Trim();
        await LoadAsync();
        Backend = "ExternalHttp";
        ExternalUrl = editedUrl;
        ExternalModel = editedModel;
        var url = editedUrl;
        var apiKey = editedApiKey ?? await Settings.GetAsync("Detection.ExternalInferenceApiKey", "");

        if (string.IsNullOrEmpty(url))
        {
            SavedMessage = "Enter the external service URL first (including its port, e.g. http://192.168.1.50:8080).";
            StatusIsError = true;
            return;
        }

        var result = await ExternalProbe.ProbeAsync(url, apiKey, default);
        ProbeHealth = result.Health;

        if (result.Error is not null)
        {
            await AuditService.LogAsync("Settings.DetectionExternalTestFailed", CurrentUserId, by,
                HttpContext?.Connection.RemoteIpAddress?.ToString(), $"{url}: {result.Error}");
            SavedMessage = result.Error;
            StatusIsError = true;
            return;
        }

        AvailableModels = result.Models ?? [];
        // Keep the previously-chosen model selected if the service still offers it; otherwise take
        // the first one so the picklist and the hidden input-size field are never left inconsistent.
        if (AvailableModels.All(m => !string.Equals(m.Name, ExternalModel, StringComparison.Ordinal)))
            ExternalModel = AvailableModels[0].Name;
        ExternalInputSize = AvailableModels.First(m => m.Name == ExternalModel).InputSize;

        await AuditService.LogAsync("Settings.DetectionExternalTestSucceeded", CurrentUserId, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(),
            $"{url}: {AvailableModels.Count} model(s) — {string.Join(", ", AvailableModels.Select(m => m.Name))}");
        SavedMessage = $"Connected. {AvailableModels.Count} model(s) available — pick one and Save.";
        StatusIsError = false;
    }

    /// <summary>Trim, drop a trailing slash, and require an absolute http(s) URL — the same shape
    /// LiveView's PublicOrigin validation uses. Returns "" for blank or invalid input; the caller
    /// decides whether that is an error in context.</summary>
    private static string NormalizeExternalUrl(string? raw)
    {
        var trimmed = raw?.Trim().TrimEnd('/');
        if (string.IsNullOrEmpty(trimmed)) return "";
        return Uri.TryCreate(trimmed, UriKind.Absolute, out var u) && u.Scheme is "http" or "https" ? trimmed : "";
    }
}
