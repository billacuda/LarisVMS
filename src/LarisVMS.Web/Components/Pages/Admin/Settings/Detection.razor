@page "/Admin/Settings/Detection"
@attribute [Authorize("Settings.Edit")]
@using LarisVMS.Core
@using LarisVMS.Core.Dtos
@using LarisVMS.Core.Interfaces
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject ExternalInferenceProbe ExternalProbe
@inject INodeService NodeService
@inject NodeControlClient NodeControlClient

<PageTitle>@L["settings.detection.aiDetectionSettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Detection" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert @(StatusIsError ? "alert-danger" : "alert-success")" role="alert">@SavedMessage</div>
}

<p class="text-muted small">@L["settings.detection.defaultsForEveryNodeAnd"] <a href="/Help/ai-detection">@L["settings.detection.howAiDetectionWorks"]</a></p>

<div class="lv-page-narrow">
<EditForm Model="this" FormName="detection-settings" OnSubmit="HandleSubmitAsync" data-dirty-guard>
    <SettingSection Title="@L["settings.detection.backend"]">
        <SettingField Label="@L["settings.detection.detectionBackend"]" For="backendSelect" Hint="@L["settings.detection.builtInRunsAModel"]" HelpLink="/Help/ai-detection#external-backend">
            <select name="Backend" class="form-select" id="backendSelect">
                <option value="BuiltIn" selected="@(Backend == "BuiltIn")">@L["settings.detection.builtIn"]</option>
                <option value="ExternalHttp" selected="@(Backend == "ExternalHttp")">@L["settings.detection.externalHttpService"]</option>
            </select>
        </SettingField>
        <SettingField For="field-externalUrl" Label="@L["settings.detection.serviceUrl"]" ShowWhen="Backend=ExternalHttp" Hint="@L["settings.detection.includeThePort"]">
            <div class="input-group">
                <InputText id="field-externalUrl" type="url" @bind-Value="ExternalUrl" class="form-control" placeholder="http://192.168.1.50:8080" />
                <button type="submit" name="Action" value="TestConnection" class="btn btn-outline-secondary">@L["common.test"]</button>
            </div>
            @if (ProbeHealth is { } h)
            {
                <div class="lv-hint">
                    Service: <strong>@(h.Status ?? "?")</strong>
                    @if (!string.IsNullOrEmpty(h.Version)) { <text>· v@(h.Version)</text> }
                    @if (!string.IsNullOrEmpty(h.Backend)) { <text>· @(h.Backend)</text> }
                    @if (h.ModelsReady is { } ready) { <text>· @L.Plural("settings.detection.modelsReady", ready)</text> }
                    @if (h.ModelsFailed is { } failed and > 0) { <text>· @failed failed</text> }
                </div>
            }
        </SettingField>
        <SettingField For="field-externalApiKey" Label="@L["settings.detection.apiKey"]" ShowWhen="Backend=ExternalHttp" Hint="@L["settings.detection.sentAsABearerToken"]">
            <InputText id="field-externalApiKey" type="password" @bind-Value="ExternalApiKey" autocomplete="new-password" class="form-control"
                       placeholder="@(HasStoredExternalApiKey ? L["cameras.edit.unchanged"].Value : "none")" />
        </SettingField>
        <SettingField For="externalModelSelect" Label="@L["common.model"]" ShowWhen="Backend=ExternalHttp"
                      Hint="@(AvailableModels.Count == 0 ? L["settings.detection.clickTestToLoadThe"].Value : L["settings.detection.itsInputSizeSetsThe"].Value)">
            <select name="ExternalModel" class="form-select" id="externalModelSelect">
                @{
                    var options = AvailableModels.ToList();
                    if (options.Count == 0 && !string.IsNullOrEmpty(ExternalModel))
                    {
                        <option value="@ExternalModel" data-input-size="@ExternalInputSize" selected>@ExternalModel (saved)</option>
                    }
                }
                @foreach (var m in options)
                {
                    <option value="@m.Name" data-input-size="@m.InputSize"
                        data-input-modes="@string.Join(',', m.InputModes ?? [])" selected="@(m.Name == ExternalModel)">
                        @m.Name — @(m.InputSize)px@(m.ClassCount is { } cc ? $", {cc} classes" : "")@(string.IsNullOrEmpty(m.Decoder) ? "" : $" ({m.Decoder})")@(string.Equals(m.Status, "ready", StringComparison.OrdinalIgnoreCase) ? "" : $" [{m.Status}]")
                    </option>
                }
            </select>
            <input type="hidden" name="ExternalInputSize" value="@ExternalInputSize" id="externalInputSize" />
        </SettingField>
        <SettingField For="externalTransportSelect" Label="@L["settings.detection.transport"]" ShowWhen="Backend=ExternalHttp">
            <select name="ExternalTransport" class="form-select" id="externalTransportSelect">
                <option value="Auto" selected="@(ExternalTransport == "Auto")">@L["settings.detection.autoJpeg"]</option>
                <option value="Jpeg" selected="@(ExternalTransport == "Jpeg")">@L["settings.detection.jpeg"]</option>
                <option value="PixelsYuv420" selected="@(ExternalTransport == "PixelsYuv420")">@L["settings.detection.rawYuv420"]</option>
                <option value="PixelsBgra" selected="@(ExternalTransport == "PixelsBgra")">@L["settings.detection.rawBgra"]</option>
            </select>
            <div class="lv-hint" id="externalTransportHint">@L["settings.detection.rawModesSkipJpegBut"]</div>
        </SettingField>
    </SettingSection>

    <div data-show-when="Backend=BuiltIn">
        <SettingSection Title="@L["common.model"]" Subtitle="@L["settings.detection.runsOncePerNodeAnd"]">
            <SettingField For="field-modelFamily" Label="@L["settings.detection.detectionModel"]" Hint="@L["settings.detection.autoUsesYoloxDFine"]" HelpLink="/Help/ai-detection#model-families">
                @* Plain <select> with selected="" per option, not InputSelect — under Static SSR
                   InputSelect never marks the saved option as selected. *@
                <select name="ModelFamily" id="field-modelFamily" class="form-select">
                    <option value="Auto" selected="@(ModelFamily == "Auto")">@L["settings.detection.autoYolox"]</option>
                    <option value="YoloX" selected="@(ModelFamily == "YoloX")">@L["settings.detection.yolox"]</option>
                    <option value="DFine" selected="@(ModelFamily == "DFine")">@L["settings.detection.dFineExperimental"]</option>
                    <option value="Custom" selected="@(ModelFamily == "Custom")">@L["settings.detection.customModel"]</option>
                    <option value="RfDetr" disabled>@L["settings.detection.rfDetrNotYetAvailable"]</option>
                </select>
            </SettingField>
            <SettingField For="field-yoloXSize" Label="@L["settings.detection.yoloxSize"]" ShowWhen="ModelFamily=Auto,YoloX" Hint="@L["settings.detection.nanoTinyForLowPower"]">
                <select id="field-yoloXSize" name="YoloXSize" class="form-select">
                    <option value="Nano" selected="@(YoloXSize == "Nano")">@L["settings.detection.nanoFastest"]</option>
                    <option value="Tiny" selected="@(YoloXSize == "Tiny")">@L["settings.detection.tiny"]</option>
                    <option value="S" selected="@(YoloXSize == "S")">@L["settings.detection.sBalancedDefault"]</option>
                    <option value="M" selected="@(YoloXSize == "M")">M</option>
                    <option value="L" selected="@(YoloXSize == "L")">L</option>
                    <option value="X" selected="@(YoloXSize == "X")">@L["settings.detection.xMostAccurate"]</option>
                </select>
            </SettingField>
            <SettingField For="field-dFineWeights" Label="@L["settings.detection.dFineWeights"]" ShowWhen="ModelFamily=DFine" Hint="@L["settings.detection.obj365Knows365ObjectTypes"]">
                <select id="field-dFineWeights" name="DFineWeights" class="form-select">
                    <option value="Obj2Coco" selected="@(DFineWeights == "Obj2Coco")">@L["settings.detection.obj2cocoSmallDefault"]</option>
                    <option value="Obj2CocoMedium" selected="@(DFineWeights == "Obj2CocoMedium")">@L["settings.detection.obj2cocoMedium"]</option>
                    <option value="Obj365" selected="@(DFineWeights == "Obj365")">@L["settings.detection.obj365Small"]</option>
                </select>
            </SettingField>
            <SettingField For="field-dFineTensorRtMode" Label="@L["settings.detection.dFineTensorrt"]" ShowWhen="ModelFamily=DFine" Hint="@L["settings.detection.needsTensorrtEnabledOnThe"]" HelpLink="/Help/ai-detection#tensorrt">
                <select id="field-dFineTensorRtMode" name="DFineTensorRtMode" class="form-select">
                    <option value="Off" selected="@(DFineTensorRtMode == "Off")">@L["settings.detection.offPlainCudaDefault"]</option>
                    <option value="FP32" selected="@(DFineTensorRtMode == "FP32")">FP32</option>
                    <option value="FP16" selected="@(DFineTensorRtMode == "FP16")">@L["settings.detection.fp16FallsBackToFp32"]</option>
                </select>
            </SettingField>
            <SettingField For="localModelNameSelect" Label="@L["settings.detection.customModel"]" ShowWhen="ModelFamily=Custom" Wide Hint="@L["settings.detection.modelsDroppedIntoCProgramdata"]" HelpLink="/Help/ai-detection#custom-models">
                <div class="input-group">
                    <select name="LocalModelName" class="form-select" id="localModelNameSelect">
                        <option value="" selected="@string.IsNullOrEmpty(LocalModelName)">@L["settings.detection.noneSelected"]</option>
                        @{
                            var localOptions = AvailableLocalModels.ToList();
                            if (localOptions.All(m => m.Name != LocalModelName) && !string.IsNullOrEmpty(LocalModelName))
                            {
                                <option value="@LocalModelName" selected>@LocalModelName (saved)</option>
                            }
                        }
                        @foreach (var m in localOptions)
                        {
                            <option value="@m.Name" selected="@(m.Name == LocalModelName)">
                                @m.Name — @(m.Decoder ?? "unresolved")@(m.InputSize is { } s ? $" ({s}x{s})" : "")@(m.Warnings.Count > 0 ? " ⚠️" : "") · on: @string.Join(", ", m.AvailableOnNodes)
                            </option>
                        }
                    </select>
                    <button type="submit" name="Action" value="RefreshLocalModels" class="btn btn-outline-secondary">@L["common.refresh"]</button>
                </div>
                @foreach (var m in AvailableLocalModels.Where(m => m.Warnings.Count > 0))
                {
                    <div class="lv-hint text-warning">⚠️ <strong>@m.Name</strong>: @string.Join(" ", m.Warnings)</div>
                }
            </SettingField>
        </SettingSection>
        <SettingSection Title="@L["settings.detection.detectionInput"]" Subtitle="@L["settings.detection.detectionInputSubtitle"]">
            <SettingField For="field-aspectMode" Label="@L["settings.detection.aspectFitting"]" Hint="@L["settings.detection.sliceFindsSmallObjectsOn"]" HelpLink="/Help/ai-detection#aspect-fitting">
                <select id="field-aspectMode" name="AspectMode" class="form-select">
                    <option value="Letterbox" selected="@(AspectMode == "Letterbox")">@L["settings.detection.letterboxDefault"]</option>
                    <option value="Stretch" selected="@(AspectMode == "Stretch")">@L["settings.detection.stretch"]</option>
                    <option value="Slice" selected="@(AspectMode == "Slice")">@L["settings.detection.slice"]</option>
                </select>
            </SettingField>
            <SettingField Label="@L["settings.detection.gpuFramePreprocessing"]" Hint="@L["settings.detection.movesFrameConversionToThe"]">
                <div class="form-check mt-1">
                    <InputCheckbox @bind-Value="GpuPreprocessing" class="form-check-input" id="gpuPreprocessing" />
                    <label class="form-check-label" for="gpuPreprocessing">@L["common.enabled"]</label>
                </div>
            </SettingField>
        </SettingSection>
    </div>

    <SettingSection Title="@L["settings.detection.detection"]" Subtitle="@L["settings.detection.camerasCanOverrideTheseOn"]">
        <SettingField Label="@L["settings.detection.confidenceThreshold"]" For="confidenceRange" Hint="@L["settings.detection.lowerCatchesMoreWithMore"]">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="Confidence" value="@Confidence" min="0" max="1" step="0.05" class="form-range" id="confidenceRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="confidenceReadout">@Math.Round(Confidence * 100)</output>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.iouThreshold"]" For="iouRange" Hint="@L["settings.detection.overlapForMergingDuplicateBoxes"]">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="Iou" value="@Iou" min="0" max="1" step="0.05" class="form-range" id="iouRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="iouReadout">@Math.Round(Iou * 100)</output>
            </div>
        </SettingField>
        <SettingField For="field-streamRole" Label="@L["settings.detection.detectionStream"]" Hint="@L["settings.detection.subIsLighterMainSees"]">
            <select id="field-streamRole" name="StreamRole" class="form-select">
                <option value="Sub" selected="@(StreamRole == "Sub")">@L["settings.detection.sub"]</option>
                <option value="Main" selected="@(StreamRole == "Main")">@L["settings.detection.main"]</option>
            </select>
        </SettingField>
        <SettingField For="field-orientation" Label="@L["settings.detection.cameraOrientation"]" Hint="@L["settings.detection.usuallySetPerCameraPortrait"]">
            <select id="field-orientation" name="Orientation" class="form-select">
                <option value="Auto" selected="@(Orientation == "Auto")">@L["settings.detection.auto"]</option>
                <option value="Landscape" selected="@(Orientation == "Landscape")">@L["settings.detection.landscape"]</option>
                <option value="Portrait" selected="@(Orientation == "Portrait")">@L["settings.detection.portrait"]</option>
            </select>
        </SettingField>
        <SettingField For="field-maxFps" Label="@L["settings.detection.maxDetectionFrameRate"]" Hint="@L["settings.detection.perCamera57Is"]">
            <InputNumber id="field-maxFps" @bind-Value="MaxFps" min="0" max="60" class="form-control" required />
        </SettingField>
    </SettingSection>

    <SettingSection Title="@L["settings.detection.trackingSnapshots"]">
        <SettingField For="field-idleTimeoutSeconds" Label="@L["settings.detection.idleTimeoutSeconds"]" Hint="@L["settings.detection.howLongAnObjectCan"]">
            <InputNumber id="field-idleTimeoutSeconds" @bind-Value="IdleTimeoutSeconds" min="0" class="form-control" required />
        </SettingField>
        <SettingField Label="@L["settings.detection.snapshotCropMargin"]" For="snapshotMarginRange" Hint="@L["settings.detection.extraRoomAroundTheObject"]">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="SnapshotMarginPercent" value="@SnapshotMarginPercent" min="0" max="100" step="1" class="form-range" id="snapshotMarginRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="snapshotMarginReadout">@SnapshotMarginPercent</output>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.idleObjects"]" Hint="@L["settings.detection.alsoReportObjectsThatAre"]">
            <div class="form-check mt-1">
                <InputCheckbox @bind-Value="ReportIdleDetections" class="form-check-input" id="reportIdleDetections" />
                <label class="form-check-label" for="reportIdleDetections">@L["settings.detection.reportIdleObjects"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.snapshotMotionAccuracy"]" Hint="@L["settings.detection.closesASnapshotSoonAfter"]" HelpLink="/Help/ai-detection#snapshots">
            <div class="form-check mt-1">
                <InputCheckbox @bind-Value="SnapshotMotionAccuracy" class="form-check-input" id="snapshotMotionAccuracy" />
                <label class="form-check-label" for="snapshotMotionAccuracy">@L["common.enabled"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.departureGraceSeconds"]" For="departureGraceRange" ShowWhen="SnapshotMotionAccuracy=true" Hint="@L["settings.detection.waitAfterAnObjectWas"]">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="DepartureGraceSeconds" value="@DepartureGraceSeconds" min="1" max="10" step="1" class="form-range" id="departureGraceRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="departureGraceReadout">@DepartureGraceSeconds</output>
            </div>
        </SettingField>
        <SettingField For="field-movementMode" Label="@L["settings.detection.movementDetection"]" Hint="@L["settings.detection.howAnObjectIsJudged"]" HelpLink="/Help/ai-detection#movement">
            <select id="field-movementMode" name="MovementMode" class="form-select">
                <option value="Standard" selected="@(MovementMode == "Standard")">@L["settings.detection.standard"]</option>
                <option value="Legacy" selected="@(MovementMode == "Legacy")">@L["settings.detection.legacy"]</option>
            </select>
        </SettingField>
        <SettingField For="field-movementSensitivity" Label="@L["settings.detection.movementSensitivity"]" ShowWhen="MovementMode=Standard" Hint="@L["settings.detection.higherPicksUpMovementSooner"]">
            <select id="field-movementSensitivity" name="MovementSensitivity" class="form-select">
                <option value="Low" selected="@(MovementSensitivity == "Low")">@L["settings.detection.low"]</option>
                <option value="Normal" selected="@(MovementSensitivity == "Normal")">@L["settings.detection.normal"]</option>
                <option value="High" selected="@(MovementSensitivity == "High")">@L["settings.detection.high"]</option>
            </select>
        </SettingField>
        <SettingField Label="@L["settings.detection.movingObjects"]" Wide Hint="@L["settings.detection.onlyTheseCanCountAs"]" HelpLink="/Help/ai-detection#moving-objects">
            <div class="d-flex flex-wrap gap-3 mt-1">
                @foreach (var (category, text) in MovingCategoryChoices)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="MovingCategory" value="@category" id="moving-@category"
                               checked="@MovingObjectsSet.Contains(category)" />
                        <label class="form-check-label" for="moving-@category">@text</label>
                    </div>
                }
            </div>
            <details class="position-relative column-picker mt-2" style="max-width: 22rem;">
                <summary class="form-select form-select-sm text-start text-truncate">@OtherObjectsSummary</summary>
                <div class="column-picker-menu" style="inset-inline-start: 0; inset-inline-end: auto; min-width: 16rem;">
                    @foreach (var label in LarisVMS.Core.CocoCategoryMap.OtherObjectLabels)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="MovingObjectLabel" value="@label" id="moving-label-@label.Replace(' ', '-')"
                                   checked="@MovingObjectsSet.Contains(label)" />
                            <label class="form-check-label small" for="moving-label-@label.Replace(' ', '-')">@label</label>
                        </div>
                    }
                </div>
            </details>
            <input type="text" name="MovingObjectExtra" class="form-control form-control-sm mt-2" style="max-width: 22rem;" maxlength="300"
                   value="@MovingObjectExtras" placeholder="@L["settings.detection.moreObjectNamesCommaSeparated"]" aria-label="@L["settings.detection.moreObjectNames"]" />
        </SettingField>
        <SettingField Label="@L["settings.detection.ignoredObjects"]" Wide Hint="@L["settings.detection.ignoredObjectsHint"]" HelpLink="/Help/ai-detection#ignored-objects">
            <IgnoredObjectsPicker Value="@IgnoredObjects" />
        </SettingField>
        <SettingField Label="@L["settings.detection.stationaryObjectJitter"]" ShowWhen="MovementMode=Legacy" Hint="@L["settings.detection.stopsParkedCarsBoxWobble"]" HelpLink="/Help/ai-detection#jitter">
            <div class="form-check mt-1">
                <InputCheckbox @bind-Value="RejectMotionJitter" class="form-check-input" id="rejectMotionJitter" />
                <label class="form-check-label" for="rejectMotionJitter">@L["settings.detection.rejectJitter"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.jitterThresholdPixels"]" For="motionJitterPixelsRange" Hint="@L["settings.detection.theSmallestBoxMovementThat"]">
            <div class="d-flex align-items-center gap-2">
                <input type="range" name="MotionJitterPixels" value="@MotionJitterPixels" min="1" max="15" step="1" class="form-range" id="motionJitterPixelsRange" />
                <output class="text-muted small" style="min-width: 2.5em;" id="motionJitterPixelsReadout">@MotionJitterPixels</output>
            </div>
        </SettingField>
    </SettingSection>

    <SettingSection Title="@L["settings.detection.objectDetails"]">
        <SettingField Label="@L["settings.detection.objectColors"]" Hint="@L["settings.detection.namesEachObjectColorAnd"]" HelpLink="/Help/ai-detection#object-colors">
            <div class="form-check mt-1">
                <InputCheckbox @bind-Value="ColorClassification" class="form-check-input" id="colorClassification" />
                <label class="form-check-label" for="colorClassification">@L["settings.detection.classifyColors"]</label>
            </div>
        </SettingField>
        <SettingField Label="@L["settings.detection.speedUnits"]" For="speedUnitsSelect" Hint="@L["settings.detection.howSpeedTrapReadingsAre"]" HelpLink="/Help/ai-detection#speed-traps">
            <select name="SpeedUnits" id="speedUnitsSelect" class="form-select">
                <option value="@SpeedUnits.Kmh" selected="@(SpeedUnit == SpeedUnits.Kmh)">km/h</option>
                <option value="@SpeedUnits.Mph" selected="@(SpeedUnit == SpeedUnits.Mph)">@L["settings.detection.mph"]</option>
            </select>
        </SettingField>
    </SettingSection>

    <div class="lv-savebar">
        <button type="submit" name="Action" value="Save" class="btn btn-primary">@L["common.save"]</button>
    </div>
</EditForm>
</div>

<SectionContent SectionName="PageScripts">
    <script nonce="@Csp.Value">
        // Confidence/IoU slider readouts, wired explicitly by id — see slider inputs above.
        (function () {
            function wireSlider(rangeId, readoutId, transform) {
                var range = document.getElementById(rangeId);
                var readout = document.getElementById(readoutId);
                if (!range || !readout) return;
                function sync() { readout.textContent = transform(range.value); }
                range.addEventListener('input', sync);
                sync(); // in case the slider's own value differs from what was rendered server-side
            }
            var asPercent = function (v) { return Math.round(v * 100); };
            var asInt = function (v) { return Math.round(v); };
            wireSlider('confidenceRange', 'confidenceReadout', asPercent);
            wireSlider('iouRange', 'iouReadout', asPercent);
            wireSlider('departureGraceRange', 'departureGraceReadout', asInt);
            wireSlider('snapshotMarginRange', 'snapshotMarginReadout', asInt);
            wireSlider('motionJitterPixelsRange', 'motionJitterPixelsReadout', asInt);
        })();

        // External backend: keep the hidden input-size field in sync with the picked model (each
        // <option> carries its own size, discovered by "Test") so Save always stores the matching size.
        // Showing/hiding the external fields is conditional-fields.js (data-show-when).
        (function () {
            var model = document.getElementById('externalModelSelect');
            var size = document.getElementById('externalInputSize');
            function syncSize() {
                if (!model || !size) return;
                var opt = model.options[model.selectedIndex];
                var v = opt && opt.getAttribute('data-input-size');
                if (v) size.value = v;
            }
            if (model) { model.addEventListener('change', syncSize); syncSize(); }

            // Warns (without blocking Save — the operator may be configuring ahead of a service
            // upgrade) when the selected transport isn't in the selected model's own advertised
            // input_modes. A model with no input_modes at all (older/non-advertising service, or
            // nothing probed yet) shows no warning either way — "unknown" isn't "unsupported".
            var transport = document.getElementById('externalTransportSelect');
            var hint = document.getElementById('externalTransportHint');
            var defaultHint = hint ? hint.textContent.trim() : '';
            var wireName = { PixelsYuv420: 'pixels_yuv420sp', PixelsBgra: 'pixels_bgra32' };
            function syncTransportHint() {
                if (!transport || !hint || !model) return;
                var needed = wireName[transport.value];
                if (!needed) { hint.textContent = defaultHint; hint.classList.remove('text-warning'); return; }
                var opt = model.options[model.selectedIndex];
                var modes = (opt && opt.getAttribute('data-input-modes')) || '';
                if (!modes) { hint.textContent = defaultHint; hint.classList.remove('text-warning'); return; }
                var supported = modes.split(',').indexOf(needed) !== -1;
                if (supported) {
                    hint.textContent = 'The selected model advertises ' + needed + ' — this transport should work.';
                    hint.classList.remove('text-warning');
                } else {
                    hint.textContent = 'The selected model did NOT advertise ' + needed + ' on the last Test connection — this will fail on every frame until the service supports it.';
                    hint.classList.add('text-warning');
                }
            }
            if (transport) { transport.addEventListener('change', syncTransportHint); }
            if (model) { model.addEventListener('change', syncTransportHint); }
            syncTransportHint();
        })();
    </script>
</SectionContent>

@code {
    /// <summary>One local (descriptor-driven or catalog) model name, merged across however many
    /// online nodes HandleRefreshLocalModelsAsync found it on — a global default isn't necessarily
    /// present on every machine, so the picklist shows that rather than silently picking whichever
    /// node answered first.</summary>
    private sealed record MergedLocalModel(string Name, string? Decoder, int? InputSize, IReadOnlyList<string> Warnings,
        IReadOnlyList<string> AvailableOnNodes);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private System.Security.Claims.ClaimsPrincipal User =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
    private string? CurrentUserId => User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    [SupplyParameterFromForm(FormName = "detection-settings")] private double Confidence { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private double Iou { get; set; }
    [SupplyParameterFromForm(FormName = "detection-settings")] private string? StreamRole { get; set; }
