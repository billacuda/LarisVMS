@page "/Admin/Settings/Permissions/Users"
@attribute [Authorize("Users.Edit")]
@using System.Security.Claims
@using LarisVMS.Core
@using LarisVMS.Core.Auth
@using LarisVMS.Core.Entities
@using LarisVMS.Core.Enums
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.ActiveDirectory
@using LarisVMS.Infrastructure.Data
@using LarisVMS.Infrastructure.Services
@using LarisVMS.Web.Services
@using LarisVMS.Web.Auth
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManagerService
@inject IAuthorizationService AuthorizationService
@inject IAuditService AuditService
@inject UserDisableService UserDisabler
@inject UserSessionService Sessions
@inject LarisVMS.Core.Interfaces.ISettingsResolver SettingsResolver
@inject LarisVMS.Core.Interfaces.IPermissionService PermissionService

<PageTitle>@L["settings.permissions.users.permissionsUsers"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Permissions" />
<PermissionsTabs ActiveKey="Users" />

<p class="text-muted small">
    @L["settings.permissions.users.accountsCanOnlyBeCreated"] <a href="/Help/users">@L["common.learnMore"]</a>
</p>

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<div class="card mb-3">
    <div class="card-header fw-semibold">@L["common.users"]</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["common.user"]</th>
                    <th>@L["settings.permissions.users.displayName"]</th>
                    <th>@L["common.roles"]</th>
                    <th>@L["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in UserRows)
                {
                    <tr>
                        <td>
                            @u.Email
                            @if (u.EntraLink == "linked")
                            {
                                <span class="badge text-bg-primary ms-1" title="@L["settings.permissions.users.canSignInWithMicrosoft"]">@L["settings.permissions.users.microsoft"]</span>
                            }
                            else if (u.EntraLink == "pending")
                            {
                                <span class="badge text-bg-light text-dark border ms-1" title="@L["settings.permissions.users.linkedToAMicrosoftAccount"]">@L["settings.permissions.users.microsoftPending"]</span>
                            }
                            @if (u.TwoFactor)
                            {
                                <span class="badge text-bg-success ms-1" title="@L["settings.permissions.users.twoFactorOn"]">@L["settings.permissions.users.twoFactor"]</span>
                            }
                            @if (u.IsDirectoryManaged)
                            {
                                <span class="badge text-bg-info ms-1" title="@L["settings.permissions.users.signsInWithActiveDirectory"]">@L["settings.permissions.users.ad"]</span>
                                @if (!string.IsNullOrEmpty(u.AdEmail))
                                {
                                    <div class="small text-muted">@u.AdEmail</div>
                                }
                            }
                        </td>
                        <td>@u.DisplayName</td>
                        <td>
                            @if (u.IsDirectoryManaged)
                            {
                                <span>@(u.RoleNames.Count > 0 ? string.Join(", ", u.RoleNames) : "(none)")</span>
                                <div class="small text-muted">@L["settings.permissions.users.managedByAdGroupSync"] <a href="/Admin/Settings/ActiveDirectory">@L["settings.permissions.users.groupLinks"]</a></div>
                            }
                            else
                            {
                            @* FormName unique per row/expiry — Blazor throws "more than one named
                               submit event with the name X" when a loop reuses a shared FormName. *@
                            <EditForm Model="this" FormName="@($"save-user-roles-{u.Id}")" OnValidSubmit="HandleSaveRolesAsync" class="d-flex flex-wrap gap-2 align-items-center">
                                <input type="hidden" name="SaveRolesUserId" value="@u.Id" />
                                @foreach (var role in RoleRows)
                                {
                                    <div class="form-check form-check-inline m-0">
                                        <input class="form-check-input" type="checkbox" name="SaveRoleIds" value="@role.Id"
                                               id="role-@u.Id-@role.Id" checked="@u.RoleNames.Contains(role.Name)" />
                                        <label class="form-check-label small" for="role-@u.Id-@role.Id">@role.Name</label>
                                    </div>
                                }
                                <button type="submit" class="btn btn-sm btn-outline-primary">@L["common.save"]</button>
                            </EditForm>
                            }
                            @if (u.ActiveExpiries.Count > 0)
                            {
                                <div class="mt-1">
                                    @foreach (var expiry in u.ActiveExpiries)
                                    {
                                        <div class="small text-muted">
                                            @L.Markup("settings.permissions.users.roleExpires", new { role = expiry.RoleName, time = expiry.ExpiresAtUtc.ToTimeTag() })
                                            <EditForm Model="this" FormName="@($"extend-expiry-{expiry.Id}")" OnValidSubmit="HandleExtendExpiryAsync" class="d-inline">
                                                <input type="hidden" name="ExpiryId" value="@expiry.Id" />
                                                <button type="submit" class="btn btn-sm btn-link p-0 align-baseline">@L["settings.permissions.users.extend"]</button>
                                            </EditForm>
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (u.IsEnabled)
                            {
                                <span class="badge text-bg-success">@L["common.enabled"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@L["common.disabled"]</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <EditForm Model="this" FormName="@($"toggle-user-enabled-{u.Id}")" OnValidSubmit="HandleToggleEnabledAsync" class="d-inline">
                                <input type="hidden" name="ToggleEnabledUserId" value="@u.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        data-confirm="@($"{(u.IsEnabled ? "Disable" : "Enable")} \"{u.Email}\"?")">
                                    @(u.IsEnabled ? L["common.disable"].Value : L["common.enable"].Value)
                                </button>
                            </EditForm>
                            @if (!u.IsDirectoryManaged)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#reset-@u.Id">
                                    @L["settings.permissions.users.resetPassword"]
                                </button>
                            }
                            @if (u.Id != CurrentUserId)
                            {
                                <EditForm Model="this" FormName="@($"end-sessions-{u.Id}")" OnValidSubmit="HandleEndSessionsAsync" class="d-inline">
                                    <input type="hidden" name="EndSessionsUserId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            data-confirm="@L["settings.permissions.users.signOutEverywhereConfirm", new { email = u.Email }]">
                                        @L["settings.permissions.users.signOutEverywhere"]
                                    </button>
                                </EditForm>
                            }
                            @if (u.TwoFactor)
                            {
                                <EditForm Model="this" FormName="@($"reset-two-factor-{u.Id}")" OnValidSubmit="HandleResetTwoFactorAsync" class="d-inline">
                                    <input type="hidden" name="ResetTwoFactorUserId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            data-confirm="@L["settings.permissions.users.resetTwoFactorConfirm", new { email = u.Email }]">
                                        @L["settings.permissions.users.resetTwoFactor"]
                                    </button>
                                </EditForm>
                            }
                            @if (EntraEnabled && !u.IsDirectoryManaged)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#entra-@u.Id">
                                    @L["settings.permissions.users.microsoftSignIn"]
                                </button>
                            }
                        </td>
                    </tr>
                    @if (EntraEnabled && !u.IsDirectoryManaged)
                    {
                        <tr class="collapse" id="entra-@u.Id">
                            <td colspan="5" class="bg-body-secondary">
                                <EditForm Model="this" FormName="@($"entra-link-{u.Id}")" OnValidSubmit="HandleSetEntraLinkAsync" class="row g-2 align-items-end py-2">
                                    <input type="hidden" name="EntraLinkUserId" value="@u.Id" />
                                    <div class="col-sm-5">
                                        <label class="form-label small mb-1" for="entra-@u.Id">@L["settings.permissions.users.entraObjectIdFor", new { email = u.Email }]</label>
                                        <input type="text" name="EntraObjectId" id="entra-@u.Id" class="form-control form-control-sm font-monospace"
                                               placeholder="00000000-0000-0000-0000-000000000000" />
                                        <div class="form-text">@L["settings.permissions.users.fromTheUserPageIn"]</div>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-sm btn-primary">@L["common.save"]</button>
                                    </div>
                                </EditForm>
                            </td>
                        </tr>
                    }
                    @if (!u.IsDirectoryManaged)
                    {
                        <tr class="collapse" id="reset-@u.Id">
                            <td colspan="5" class="bg-body-secondary">
                                <EditForm Model="this" FormName="@($"reset-user-password-{u.Id}")" OnValidSubmit="HandleResetPasswordAsync" class="row g-2 align-items-end py-2">
                                    <input type="hidden" name="ResetPasswordUserId" value="@u.Id" />
                                    <div class="col-sm-4">
                                        <label class="form-label small mb-1" for="reset-@u.Id">@L["settings.permissions.users.newPasswordFor", new { email = u.Email }]</label>
                                        <input type="password" name="NewPasswordForReset" id="reset-@u.Id" class="form-control form-control-sm" required minlength="12" autocomplete="new-password" />
                                    </div>
                                    <div class="col-auto form-check mb-1">
                                        <input class="form-check-input" type="checkbox" name="RequirePasswordChange" value="true" id="reset-change-@u.Id" checked="@TemporaryPasswords" />
                                        <label class="form-check-label small" for="reset-change-@u.Id">@L["settings.permissions.users.mustChangePassword"]</label>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-sm btn-primary">@L["settings.permissions.users.setPassword"]</button>
                                    </div>
                                </EditForm>
                            </td>
                        </tr>
                    }
                }
                @if (UserRows.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">@L["settings.permissions.users.noUsersYet"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">@L["settings.permissions.users.addAUser"]</div>
    <div class="card-body">
        <EditForm Model="this" FormName="create-user" OnValidSubmit="HandleCreateAsync" class="row g-3">
            <div class="col-sm-4">
                <label for="field-newEmail" class="form-label">@L["common.email"]</label>
                <InputText id="field-newEmail" type="email" @bind-Value="NewEmail" class="form-control" required />
            </div>
            <div class="col-sm-3">
                <label for="field-newDisplayName" class="form-label">@L["settings.permissions.users.displayName"]</label>
                <InputText id="field-newDisplayName" @bind-Value="NewDisplayName" class="form-control" />
            </div>
            <div class="col-sm-3">
                <label for="field-newPassword" class="form-label">@L["common.password"]</label>
                <InputText id="field-newPassword" type="password" @bind-Value="NewPassword" class="form-control" required minlength="12" autocomplete="new-password" />
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" name="NewRequirePasswordChange" value="true" id="field-newRequireChange" checked="@TemporaryPasswords" />
                    <label class="form-check-label small" for="field-newRequireChange">@L["settings.permissions.users.mustChangePassword"]</label>
                </div>
            </div>
            <div class="col-12">
                <div class="form-label d-block">@L["common.roles"]</div>
                @foreach (var role in RoleRows)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="NewRoleIds" value="@role.Id" id="newrole-@role.Id" />
                        <label class="form-check-label" for="newrole-@role.Id">@role.Name</label>
                    </div>
                }
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@L["settings.permissions.users.addUser"]</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    /// <summary>Email is the sign-in name: the email address for a local account, the AD username
    /// for an AD account (whose own email, if AD has one, is AdEmail).</summary>
    /// <param name="EntraLink">"linked", "pending" (an object ID entered, no sign-in yet), or null.</param>
    private sealed record UserRow(string Id, string Email, string? DisplayName, bool IsEnabled, IReadOnlyList<string> RoleNames,
        IReadOnlyList<ExpiryRow> ActiveExpiries, bool IsDirectoryManaged, string? AdEmail, string? EntraLink = null, bool TwoFactor = false);

    private sealed record ExpiryRow(Guid Id, string RoleName, DateTime ExpiresAtUtc);

    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ClaimsPrincipal User => HttpContext?.User ?? new ClaimsPrincipal(new ClaimsIdentity());
    private string? CurrentUserId => User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    private string? CurrentUserName => User.Identity?.Name;
    private string? RemoteIp => HttpContext?.Connection.RemoteIpAddress?.ToString();

    [SupplyParameterFromForm(FormName = "create-user")] private string? NewEmail { get; set; }
    [SupplyParameterFromForm(FormName = "create-user")] private string? NewPassword { get; set; }
    [SupplyParameterFromForm(FormName = "create-user")] private string? NewDisplayName { get; set; }
    [SupplyParameterFromForm(FormName = "create-user")] private List<string>? NewRoleIds { get; set; }
    [SupplyParameterFromForm(FormName = "create-user")] private bool NewRequirePasswordChange { get; set; }

    // Read from the raw form, not [SupplyParameterFromForm] — save-user-roles/extend-expiry/
    // toggle-user-enabled/reset-user-password each have a unique per-row FormName now, which the
    // attribute can't express (it needs a compile-time constant).
    private string? SaveRolesUserId { get; set; }
    private List<string>? SaveRoleIds { get; set; }

    private Guid ExpiryId { get; set; }

    private string? ToggleEnabledUserId { get; set; }

    private string? ResetPasswordUserId { get; set; }
    private string? NewPasswordForReset { get; set; }

    private List<UserRow> UserRows { get; set; } = [];
    private List<IdentityRole> RoleRows { get; set; } = [];
    private string? SavedMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Settings → Security: admin-set passwords start as temporary (the checkboxes start checked).</summary>
    private bool TemporaryPasswords { get; set; }

    private async Task LoadAsync()
    {
        TemporaryPasswords = await SettingsResolver.GetAsync(PasswordChangeRequirement.TemporaryAdminPasswordsKey, false);
        RoleRows = await Db.Roles.OrderBy(r => r.Name).ToListAsync();
        var users = await Db.Users.OrderBy(u => u.Email).ToListAsync();
        var userRoles = await Db.UserRoles.ToListAsync();
        var expiries = await Db.RoleAssignmentExpiries.ToListAsync();
        var roleNamesById = RoleRows.ToDictionary(r => r.Id, r => r.Name ?? r.Id);
        var adUserIds = (await Db.UserLogins.Where(l => l.LoginProvider == ActiveDirectoryUserSync.LoginProvider)
            .Select(l => l.UserId).ToListAsync()).ToHashSet();
        EntraEnabled = await Db.EntraSsoSettings.AnyAsync(s => s.IsEnabled);
        var entraLinks = (await Db.UserLogins.Where(l => l.LoginProvider == EntraOidcOptionsConfigurator.SchemeName)
                .Select(l => new { l.UserId, l.ProviderKey }).ToListAsync())
            .GroupBy(l => l.UserId)
            .ToDictionary(g => g.Key, g => g.Any(l => !EntraLinks.IsPending(l.ProviderKey)) ? "linked" : "pending");

        UserRows = users.Select(u => new UserRow(
            u.Id,
            adUserIds.Contains(u.Id) ? u.UserName ?? u.Id : u.Email ?? u.UserName ?? u.Id,
            u.DisplayName,
            IsUserEnabled(u),
            userRoles.Where(ur => ur.UserId == u.Id).Select(ur => roleNamesById.GetValueOrDefault(ur.RoleId, "?")).OrderBy(n => n).ToList(),
            expiries.Where(e => e.UserId == u.Id)
                .Select(e => new ExpiryRow(e.Id, roleNamesById.GetValueOrDefault(e.RoleId, "?"), e.ExpiresAtUtc))
                .OrderBy(e => e.ExpiresAtUtc).ToList(),
            adUserIds.Contains(u.Id),
            adUserIds.Contains(u.Id) ? u.Email : null,
            entraLinks.GetValueOrDefault(u.Id),
            u.TwoFactorEnabled
        )).OrderBy(r => r.Email, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task HandleCreateAsync()
    {
        var email = (NewEmail ?? "").Trim();
        // Local accounts are always email addresses: sign-in sends anything without "@" to Active
        // Directory, so a local username without one could never sign in.
        if (string.IsNullOrEmpty(email) || !email.Contains('@'))
        {
            ErrorMessage = Loc.T("settings.permissions.users.enterAnEmailAddress");
            await LoadAsync();
            return;
        }

        var user = new ApplicationUser
        {
            UserName = email,
            Email = email,
            EmailConfirmed = true,
            DisplayName = string.IsNullOrWhiteSpace(NewDisplayName) ? null : NewDisplayName.Trim()
        };

        var result = await UserManagerService.CreateAsync(user, NewPassword ?? "");
        if (!result.Succeeded)
        {
            ErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            await LoadAsync();
            return;
        }

        var requestedRoleIds = NewRoleIds ?? [];
        var assignableRoleIds = await FilterAssignableRoleIdsAsync(requestedRoleIds);
        var roleNames = await Db.Roles.Where(r => assignableRoleIds.Contains(r.Id)).Select(r => r.Name!).ToListAsync();
        if (roleNames.Count > 0) await UserManagerService.AddToRolesAsync(user, roleNames);
        await SeedExpiriesForNewlyAssignedRolesAsync(user.Id, assignableRoleIds);

        if (NewRequirePasswordChange) await PasswordChangeRequirement.RequireAsync(UserManagerService, user);
        await AuditService.LogAsync("User.Create", CurrentUserId, CurrentUserName, RemoteIp, email);
        SavedMessage = assignableRoleIds.Count < requestedRoleIds.Count
            ? Loc.T("settings.permissions.users.userCreatedSomeRoleSelections", new { email })
            : Loc.T("settings.permissions.users.userCreated", new { email });
        NewEmail = string.Empty;
        NewPassword = string.Empty;
        NewDisplayName = null;
        NewRoleIds = [];
        await LoadAsync();
    }

    private async Task HandleSaveRolesAsync()
    {
        var saveRolesForm = HttpContext?.Request.Form;
        SaveRolesUserId = saveRolesForm?["SaveRolesUserId"].ToString();
        SaveRoleIds = saveRolesForm?["SaveRoleIds"].ToArray().Where(v => v is not null).Select(v => v!).ToList();

        var userId = SaveRolesUserId ?? "";
        var roleIds = SaveRoleIds ?? [];
        var user = await UserManagerService.FindByIdAsync(userId);
        if (user is null)
        {
            ErrorMessage = Loc.T("settings.permissions.users.thatUserNoLongerExists");
            await LoadAsync();
            return;
        }
        if (await IsDirectoryManagedAsync(user.Id))
        {
            ErrorMessage = Loc.T("settings.permissions.users.thisAccountRolesComeFrom");
            await LoadAsync();
            return;
        }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }

        var currentRoles = await UserManagerService.GetRolesAsync(user);
        var assignableRoleIds = await FilterAssignableRoleIdsAsync(roleIds);
        var targetRoleNames = await Db.Roles.Where(r => assignableRoleIds.Contains(r.Id)).Select(r => r.Name!).ToListAsync();
        // A role the actor couldn't assign, they can't take away either: it stays.
        var currentRoleIds = await Db.UserRoles.Where(ur => ur.UserId == user.Id).Select(ur => ur.RoleId).ToListAsync();
        var removableRoleIds = await FilterAssignableRoleIdsAsync(currentRoleIds);
        var keptRoleNames = await Db.Roles.Where(r => currentRoleIds.Contains(r.Id) && !removableRoleIds.Contains(r.Id)).Select(r => r.Name!).ToListAsync();
        targetRoleNames = targetRoleNames.Union(keptRoleNames).ToList();

        var wasAdmin = await IncludesSuperAdminAsync(currentRoles);
        var staysAdmin = await IncludesSuperAdminAsync(targetRoleNames);
        if (UserManagementPolicy.WouldRemoveLastAdministrator(wasAdmin, staysAdmin, await CountOtherEnabledSuperAdminsAsync(user.Id)))
        {
            ErrorMessage = Loc.T("settings.permissions.users.cantRemoveTheLastSuper");
            await LoadAsync();
            return;
        }

        var toAdd = targetRoleNames.Except(currentRoles).ToList();
        var toRemove = currentRoles.Except(targetRoleNames).ToList();
        if (toAdd.Count > 0) await UserManagerService.AddToRolesAsync(user, toAdd);
        if (toRemove.Count > 0)
        {
            await UserManagerService.RemoveFromRolesAsync(user, toRemove);
            await UserDisabler.EndSessionsAsync(user);
        }

        var addedRoleIds = await Db.Roles.Where(r => toAdd.Contains(r.Name!)).Select(r => r.Id).ToListAsync();
        await SeedExpiriesForNewlyAssignedRolesAsync(user.Id, addedRoleIds);
        var removedRoleIds = await Db.Roles.Where(r => toRemove.Contains(r.Name!)).Select(r => r.Id).ToListAsync();
        if (removedRoleIds.Count > 0)
        {
            Db.RoleAssignmentExpiries.RemoveRange(
                Db.RoleAssignmentExpiries.Where(e => e.UserId == user.Id && removedRoleIds.Contains(e.RoleId)));
            await Db.SaveChangesAsync();
        }

        if (toAdd.Count > 0 || toRemove.Count > 0)
        {
            var details = AuditDiff.Build(AuditDiff.Of("Roles",
                string.Join(", ", currentRoles.OrderBy(r => r)), string.Join(", ", targetRoleNames.OrderBy(r => r))));
            if (details is not null)
                await AuditService.LogAsync("User.Update", CurrentUserId, CurrentUserName, RemoteIp, details);
        }

        SavedMessage = assignableRoleIds.Count < roleIds.Count
            ? Loc.T("settings.permissions.users.savedSomeRoleSelectionsWerent")
            : Loc.T("common.saved");
        await LoadAsync();
    }

    /// <summary>Drops any requested role id the caller isn't allowed to assign: all of them if the
    /// caller lacks Roles.Assign entirely, the Org-tier ones if they hold Roles.Assign but aren't
    /// Org-tier themselves (RoleScopePolicy.CanAssignRole), Super Admin unless they are one, and any
    /// role with a permission the caller doesn't have (AdminScope.CanBindRole) — so an admin can't make
    /// an account that can do more than they can, and sign in as it.</summary>
    private async Task<List<string>> FilterAssignableRoleIdsAsync(List<string> requestedRoleIds)
    {
        if (requestedRoleIds.Count == 0) return [];
        if (!(await AuthorizationService.AuthorizeAsync(User, "Roles.Assign")).Succeeded) return [];

        var actingHighestTier = await HighestScopeTierAsync(CurrentUserId);
        var requestedTiers = await Db.RoleProfiles
            .Where(p => requestedRoleIds.Contains(p.RoleId))
            .ToDictionaryAsync(p => p.RoleId, p => p.MaxScopeTier);

        var scope = await LarisVMS.Web.Services.AdminScope.ForAsync(Db, PermissionService, User);
        return requestedRoleIds
            .Where(id => RoleScopePolicy.CanAssignRole(actingHighestTier, requestedTiers.GetValueOrDefault(id, RoleScopeTier.Group))
                && scope.CanBindRole(id))
            .ToList();
    }

    /// <summary>The most-permissive (numerically lowest) MaxScopeTier across every role the given user
    /// holds — RoleScopeTier.Group (least permissive) if they hold none, or hold only roles with no
    /// RoleProfile row.</summary>
    private async Task<RoleScopeTier> HighestScopeTierAsync(string? userId)
    {
        if (userId is null) return RoleScopeTier.Group;
        var roleIds = await Db.UserRoles.Where(ur => ur.UserId == userId).Select(ur => ur.RoleId).ToListAsync();
        if (roleIds.Count == 0) return RoleScopeTier.Group;

        var tiers = await Db.RoleProfiles.Where(p => roleIds.Contains(p.RoleId)).Select(p => p.MaxScopeTier).ToListAsync();
        return tiers.Count == 0 ? RoleScopeTier.Group : tiers.Min();
    }

    /// <summary>For each of the given role ids that's both AutoExpires and not already tracked for this
    /// user (a role re-checked after already having an expiry row is left alone, not reset), adds a
    /// RoleAssignmentExpiry defaulting to now + DefaultExpiryMinutes. A role with no RoleProfile row, or
    /// AutoExpires=false, is left with no row at all (never expires) — same default as every other role
    /// assignment in this app before this pass existed.</summary>
    private async Task SeedExpiriesForNewlyAssignedRolesAsync(string userId, List<string> roleIds)
    {
        if (roleIds.Count == 0) return;

        var autoExpiring = await Db.RoleProfiles
            .Where(p => roleIds.Contains(p.RoleId) && p.AutoExpires)
            .ToListAsync();
        if (autoExpiring.Count == 0) return;

        var alreadyTracked = await Db.RoleAssignmentExpiries
            .Where(e => e.UserId == userId && roleIds.Contains(e.RoleId))
            .Select(e => e.RoleId).ToListAsync();

        var now = DateTime.UtcNow;
        foreach (var profile in autoExpiring.Where(p => !alreadyTracked.Contains(p.RoleId)))
        {
            Db.RoleAssignmentExpiries.Add(new RoleAssignmentExpiry
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                RoleId = profile.RoleId,
                ExpiresAtUtc = now.AddMinutes(profile.DefaultExpiryMinutes ?? 0),
                AssignedAtUtc = now,
                AssignedByUserId = CurrentUserId
            });
        }
        await Db.SaveChangesAsync();
    }

    /// <summary>Pushes one assignment's expiry back out to now + its role's own DefaultExpiryMinutes —
    /// the admin-override path for "the default wasn't long enough," simpler than picking an exact
    /// arbitrary timestamp (which would need client-timezone-aware input this compact per-row UI
    /// doesn't have room for). Requires Roles.Assign, same as every other expiry-affecting action.</summary>
    private async Task HandleExtendExpiryAsync()
    {
        ExpiryId = Guid.TryParse(HttpContext?.Request.Form["ExpiryId"].ToString(), out var expiryId) ? expiryId : Guid.Empty;
        if (!(await AuthorizationService.AuthorizeAsync(User, "Roles.Assign")).Succeeded)
        {
            ErrorMessage = Loc.T("settings.permissions.users.youDontHavePermissionTo");
            await LoadAsync();
            return;
        }

        var expiry = await Db.RoleAssignmentExpiries.FirstOrDefaultAsync(e => e.Id == ExpiryId);
        if (expiry is null)
        {
            await LoadAsync();
            return;
        }

        var defaultMinutes = await Db.RoleProfiles.Where(p => p.RoleId == expiry.RoleId)
            .Select(p => p.DefaultExpiryMinutes).FirstOrDefaultAsync();
        expiry.ExpiresAtUtc = DateTime.UtcNow.AddMinutes(defaultMinutes ?? 0);
        await Db.SaveChangesAsync();

        await AuditService.LogAsync("Role.ExpiryExtended", CurrentUserId, CurrentUserName, RemoteIp,
            $"Extended to {expiry.ExpiresAtUtc:yyyy-MM-dd HH:mm} UTC");
        SavedMessage = Loc.T("settings.permissions.users.expiryExtended");
        await LoadAsync();
    }

    private async Task HandleToggleEnabledAsync()
    {
        ToggleEnabledUserId = HttpContext?.Request.Form["ToggleEnabledUserId"].ToString();
        var userId = ToggleEnabledUserId ?? "";
        var user = await UserManagerService.FindByIdAsync(userId);
        if (user is null)
        {
            await LoadAsync();
            return;
        }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }

        var isEnabled = IsUserEnabled(user);
        if (isEnabled)
        {
            var roles = await UserManagerService.GetRolesAsync(user);
            var isAdmin = await IncludesSuperAdminAsync(roles);
            if (UserManagementPolicy.WouldDisableLastAdministrator(isAdmin, await CountOtherEnabledSuperAdminsAsync(user.Id)))
            {
                ErrorMessage = Loc.T("settings.permissions.users.cantDisableTheLastEnabled");
                await LoadAsync();
                return;
            }

            // Also ends their sessions and open live-view streams.
            await UserDisabler.DisableAsync(user, byDirectorySync: false, CurrentUserId, CurrentUserName, RemoteIp, user.Email ?? user.UserName);
            SavedMessage = $"\"{user.Email ?? user.UserName}\" disabled.";
        }
        else
        {
            await UserDisabler.EnableAsync(user, CurrentUserId, CurrentUserName, RemoteIp, user.Email ?? user.UserName);
            SavedMessage = $"\"{user.Email ?? user.UserName}\" enabled.";
        }

        await LoadAsync();
    }

    private async Task HandleResetPasswordAsync()
    {
        var resetForm = HttpContext?.Request.Form;
        ResetPasswordUserId = resetForm?["ResetPasswordUserId"].ToString();
        NewPasswordForReset = resetForm?["NewPasswordForReset"].ToString();
        var userId = ResetPasswordUserId ?? "";
        var user = await UserManagerService.FindByIdAsync(userId);
        if (user is null)
        {
            await LoadAsync();
            return;
        }
        if (await IsDirectoryManagedAsync(user.Id))
        {
            ErrorMessage = Loc.T("settings.permissions.users.activeDirectoryAccountsSignIn");
            await LoadAsync();
            return;
        }
        // Your own password is changed with the current one (select your name, then Change password),
        // so a session someone else got hold of can't set a new one here.
        if (user.Id == CurrentUserId)
        {
            ErrorMessage = Loc.T("settings.permissions.users.changeYourOwnPasswordInstead");
            await LoadAsync();
            return;
        }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }

        var token = await UserManagerService.GeneratePasswordResetTokenAsync(user);
        var result = await UserManagerService.ResetPasswordAsync(user, token, NewPasswordForReset ?? "");
        if (!result.Succeeded)
        {
            ErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            await LoadAsync();
            return;
        }

        // Not for your own password: you just chose it.
        if (resetForm?["RequirePasswordChange"].ToString() == "true" && user.Id != CurrentUserId)
            await PasswordChangeRequirement.RequireAsync(UserManagerService, user);
        else
            await PasswordChangeRequirement.ClearAsync(UserManagerService, user);
        // Their sessions end now (yours carries on if this was your own password).
        await Sessions.EndAllAsync(user.Id, keep: user.Id == CurrentUserId && HttpContext is not null ? UserSessionService.Current(HttpContext) : null);
        await AuditService.LogAsync("User.PasswordReset", CurrentUserId, CurrentUserName, RemoteIp, user.Email);
        SavedMessage = Loc.T("settings.permissions.users.passwordResetFor", new { email = user.Email });
        await LoadAsync();
    }

    /// <summary>For someone who lost their phone and their recovery codes: they sign in with just
    /// their password and can set it up again (or are sent to, when it's required). Not for your own
    /// account, which you change on your own Two-factor sign-in page.</summary>
    private async Task HandleResetTwoFactorAsync()
    {
        var user = await UserManagerService.FindByIdAsync(HttpContext?.Request.Form["ResetTwoFactorUserId"].ToString() ?? "");
        if (user is null) { await LoadAsync(); return; }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }

        await UserManagerService.SetTwoFactorEnabledAsync(user, false);
        // A new key, so the lost phone's codes never work again; and wherever the lost phone is
        // signed in, it isn't any more.
        await UserManagerService.ResetAuthenticatorKeyAsync(user);
        await Sessions.EndAllAsync(user.Id);
        await AuditService.LogAsync("User.TwoFactorReset", CurrentUserId, CurrentUserName, RemoteIp, user.Email ?? user.UserName);
        SavedMessage = Loc.T("settings.permissions.users.twoFactorResetFor", new { email = user.Email ?? user.UserName });
        await LoadAsync();
    }

    /// <summary>Signs someone out on every browser at once (a lost laptop, a shared PC); they can
    /// sign in again. Disable the account to keep them out.</summary>
    private async Task HandleEndSessionsAsync()
    {
        var user = await UserManagerService.FindByIdAsync(HttpContext?.Request.Form["EndSessionsUserId"].ToString() ?? "");
        if (user is null) { await LoadAsync(); return; }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }

        var ended = await Sessions.EndAllAsync(user.Id);
        await AuditService.LogAsync("User.SignedOutEverywhere", CurrentUserId, CurrentUserName, RemoteIp, $"{user.Email ?? user.UserName}: {ended} sessions");
        SavedMessage = Loc.T("settings.permissions.users.signedOutEverywhere", new { email = user.Email ?? user.UserName });
        await LoadAsync();
    }

    private static bool IsUserEnabled(ApplicationUser user) => UserDisableService.IsEnabled(user);

    private Task<bool> IsDirectoryManagedAsync(string userId) =>
        Db.UserLogins.AnyAsync(l => l.UserId == userId && l.LoginProvider == ActiveDirectoryUserSync.LoginProvider);

    private bool EntraEnabled;

    /// <summary>Links an account to one Entra user by object ID (completed on that user's first
    /// Microsoft sign-in), or removes the link when blank. Replaces any earlier link.</summary>
    private async Task HandleSetEntraLinkAsync()
    {
        var form = HttpContext?.Request.Form;
        var user = await UserManagerService.FindByIdAsync(form?["EntraLinkUserId"].ToString() ?? "");
        if (user is null) { await LoadAsync(); return; }
        if (await CannotActOnAsync(user, allowSelf: false) is { } denied)
        {
            ErrorMessage = denied;
            await LoadAsync();
            return;
        }
        var raw = form?["EntraObjectId"].ToString().Trim() ?? "";
        Guid? objectId = null;
        if (raw.Length > 0)
        {
            if (!Guid.TryParse(raw, out var parsed))
            {
                ErrorMessage = Loc.T("settings.permissions.users.theEntraObjectIdIs");
                await LoadAsync();
                return;
            }
            objectId = parsed;
            var pendingKey = EntraLinks.PendingKey(parsed);
            if (await Db.UserLogins.AnyAsync(l => l.LoginProvider == EntraOidcOptionsConfigurator.SchemeName && l.ProviderKey == pendingKey && l.UserId != user.Id))
            {
                ErrorMessage = Loc.T("settings.permissions.users.thatEntraObjectIdIs");
                await LoadAsync();
                return;
            }
        }

        foreach (var login in (await UserManagerService.GetLoginsAsync(user)).Where(l => l.LoginProvider == EntraOidcOptionsConfigurator.SchemeName))
            await UserManagerService.RemoveLoginAsync(user, login.LoginProvider, login.ProviderKey);
        if (objectId is { } oid)
            await UserManagerService.AddLoginAsync(user, new UserLoginInfo(EntraOidcOptionsConfigurator.SchemeName, EntraLinks.PendingKey(oid), "Microsoft"));

        await AuditService.LogAsync("User.EntraLink", CurrentUserId, CurrentUserName, RemoteIp,
            objectId is { } linked ? $"{user.Email}: linked to Entra object {linked}" : $"{user.Email}: Microsoft sign-in removed");
        SavedMessage = objectId is null
            ? Loc.T("settings.permissions.users.microsoftSignInRemovedFor", new { email = user.Email })
            : Loc.T("settings.permissions.users.canNowSignInWith", new { email = user.Email });
        await LoadAsync();
    }

    /// <summary>Null when the signed-in admin may reset, disable, or change the roles of
    /// <paramref name="target"/>; otherwise why not. A Super Admin may act on anyone. Anyone else may
    /// not act on a Super Admin, on an account whose roles reach wider than their own (a Site-tier
    /// admin can't take over an Org-tier one), or on one with a permission they don't have. Nobody changes their own roles or disables themselves.</summary>
    private async Task<string?> CannotActOnAsync(ApplicationUser target, bool allowSelf)
    {
        if (!allowSelf && target.Id == CurrentUserId) return Loc.T("settings.permissions.users.youCantChangeYourOwn");
        if (CurrentUserId is not { } actorId) return Loc.T("settings.permissions.users.youDontHavePermissionTo");
        var actor = await UserManagerService.FindByIdAsync(actorId);
        if (actor is null) return Loc.T("settings.permissions.users.youDontHavePermissionTo");
        if (await IncludesSuperAdminAsync(await UserManagerService.GetRolesAsync(actor))) return null;
        if (await IncludesSuperAdminAsync(await UserManagerService.GetRolesAsync(target))) return Loc.T("settings.permissions.users.onlyASuperAdminCan");
        if (await HighestScopeTierAsync(target.Id) < await HighestScopeTierAsync(actorId)) return Loc.T("settings.permissions.users.thisAccountHasWiderAccess");
        // Resetting the password of an account that can do more than you would let you sign in as it.
        var targetRoleIds = await Db.UserRoles.Where(ur => ur.UserId == target.Id).Select(ur => ur.RoleId).ToListAsync();
        var scope = await LarisVMS.Web.Services.AdminScope.ForAsync(Db, PermissionService, User);
        if (!scope.HasEveryPermissionOf(targetRoleIds)) return Loc.T("settings.permissions.users.thisAccountHasPermissionsYouLack");
        return null;
    }

    private async Task<bool> IncludesSuperAdminAsync(IEnumerable<string> roleNames)
    {
        var names = roleNames as ICollection<string> ?? roleNames.ToList();
        if (names.Count == 0) return false;
        var roleIds = await Db.Roles.Where(r => names.Contains(r.Name!)).Select(r => r.Id).ToListAsync();
        return roleIds.Count > 0 && await Db.RoleProfiles.AnyAsync(p => roleIds.Contains(p.RoleId) && p.Tag == RoleTags.SuperAdmin);
    }

    private async Task<int> CountOtherEnabledSuperAdminsAsync(string excludingUserId)
    {
        var superAdminRoleId = await Db.RoleProfiles
            .Where(p => p.Tag == RoleTags.SuperAdmin).Select(p => p.RoleId).FirstOrDefaultAsync();
        if (superAdminRoleId is null) return 0;

        var adminUserIds = await Db.UserRoles.Where(ur => ur.RoleId == superAdminRoleId).Select(ur => ur.UserId).ToListAsync();
        var now = DateTimeOffset.UtcNow;
        return await Db.Users.CountAsync(u =>
            adminUserIds.Contains(u.Id) && u.Id != excludingUserId && (u.LockoutEnd == null || u.LockoutEnd < now));
    }
}
