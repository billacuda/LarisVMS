@page "/Admin/Settings/Encryption"
@attribute [Authorize("Settings.Edit")]
@using System.Security.Claims
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Services
@inject ISettingsResolver Settings
@inject IFootageKeyService FootageKeys
@inject IAuditService AuditService
@inject ISigningKeyService SigningKeys

<PageTitle>@L["settings.encryption.encryptionAndSigningSettings"] - @AppName</PageTitle>

<h1>@L["nav.settings"]</h1>
<SettingsTabs ActiveKey="Encryption" />

@if (!string.IsNullOrEmpty(SavedMessage))
{
    <div class="alert alert-success">@SavedMessage</div>
}

<div class="lv-page-narrow">
    <div class="alert alert-warning small" role="note">
        @L.Markup("settings.encryption.warning")
        <a href="/Help/storage#encryption">@L["common.learnMore"]</a>
    </div>

    <SettingSection Title="@L["settings.encryption.masterKey"]">
        <div id="encryptionKeyPanel" class="small lv-wide">
            @if (!Status.HasMasterKey)
            {
                <p class="mb-2">@L["settings.encryption.noMasterKeyYetCreate"]</p>
                <button type="button" class="btn btn-primary btn-sm" id="encCreateKey">@L["settings.encryption.createMasterKey"]</button>
            }
            else
            {
                <p class="mb-1">@L.Markup(Status.CreatedAt is null ? "settings.encryption.masterKeyId" : "settings.encryption.masterKeyCreated", new { id = Status.MasterKeyId?.ToString()[..8], time = Status.CreatedAt?.ToTimeTag() ?? default })</p>
                <p class="mb-2">
                    @if (Status.BackupDownloadedAt is { } backedUp)
                    {
                        <span>@L.Markup("settings.encryption.backupLastDownloaded", new { time = backedUp.ToTimeTag() })</span>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold">@L["settings.encryption.noBackupDownloadedYetEncryption"]</span>
                    }
                </p>
            }

            @if (Status.HasMasterKey)
            {
                <div class="border rounded p-2 mb-3">
                    <div class="fw-semibold mb-1">@L["settings.encryption.downloadABackup"]</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-5">
                            <label class="form-label small mb-0" for="encPass1">@L["settings.encryption.passphraseLength", new { min = FootageKeyService.MinPassphraseLength }]</label>
                            <input type="password" class="form-control form-control-sm" id="encPass1" autocomplete="new-password" />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small mb-0" for="encPass2">@L["settings.encryption.passphraseAgain"]</label>
                            <input type="password" class="form-control form-control-sm" id="encPass2" autocomplete="new-password" />
                        </div>
                        <div class="col-sm-2">
                            <button type="button" class="btn btn-primary btn-sm w-100" id="encBackup">@L["common.download"]</button>
                        </div>
                    </div>
                    <div class="lv-hint mt-1">@L["settings.encryption.withoutThisPassphraseTheBackup"]</div>
                </div>
            }

            <div class="border rounded p-2">
                <div class="fw-semibold mb-1">@L["settings.encryption.restoreFromABackup"]</div>
                <div class="row g-2 align-items-end">
                    <div class="col-sm-5">
                        <label class="form-label small mb-0" for="encRestoreFile">@L["settings.encryption.backupFile"]</label>
                        <input type="file" class="form-control form-control-sm" id="encRestoreFile" accept=".json,application/json" />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label small mb-0" for="encRestorePass">@L["settings.encryption.passphrase"]</label>
                        <input type="password" class="form-control form-control-sm" id="encRestorePass" autocomplete="off" />
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" id="encRestore">@L["common.restore"]</button>
                    </div>
                </div>
                <div class="lv-hint mt-1">@L["settings.encryption.forARebuiltServerBrings"]</div>
            </div>
            <div id="encryptionKeyStatus" class="mt-2" role="status" aria-live="polite"></div>
        </div>
    </SettingSection>

    <EditForm Model="this" FormName="encryption-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
        <SettingSection Title="@L["settings.encryption.encryptFootage"]" Subtitle="@L["settings.encryption.defaultForEveryCameraNodes"]">
            <SettingField Label="@L["settings.encryption.encryption"]" For="encMode" Wide Hint="@L["settings.encryption.newFootageIsEncryptedOn"]" HelpLink="/Help/storage#encryption">
                <select name="Mode" id="encMode" class="form-select" disabled="@(!Status.Ready)">
                    <option value="Off" selected="@(Mode == "Off")">@L["common.off"]</option>
                    <option value="Video" selected="@(Mode == "Video")">@L["settings.encryption.videoRecordingsAndTalkAudio"]</option>
                    <option value="VideoAndImages" selected="@(Mode == "VideoAndImages")">@L["settings.encryption.videoSnapshotsAndThumbnails"]</option>
                </select>
                @if (!Status.Ready)
                {
                    <div class="lv-hint text-danger">@L["settings.encryption.createTheMasterKeyAnd"]</div>
                }
            </SettingField>
        </SettingSection>
        <div class="lv-savebar">
            <button type="submit" class="btn btn-primary" disabled="@(!Status.Ready)">@L["common.save"]</button>
        </div>
    </EditForm>

    <SettingSection Title="@L["settings.encryption.signing"]" Subtitle="@L["settings.encryption.alwaysOnNothingToSet"]">
        <div class="small lv-wide">
            <p class="mb-2">
                @L.Markup("settings.encryption.signingIntro")
            </p>
            @if (SigningKeysList.Count == 0)
            {
                <p class="text-muted mb-0">@L["settings.encryption.noSigningKeyYetOne"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>@L["common.key"]</th><th>@L["settings.encryption.algorithm"]</th><th>@L["common.created"]</th><th>@L["common.status"]</th><th data-no-sort></th></tr></thead>
                        <tbody>
                            @foreach (var k in SigningKeysList.OrderByDescending(k => k.CreatedAt))
                            {
                                <tr>
                                    <td class="font-monospace" title="@L["settings.encryption.sha256FingerprintOfThe"]">@Fingerprint(k.PublicKeyPem)</td>
                                    <td>@k.Algorithm</td>
                                    <td class="text-nowrap"><time datetime="@k.CreatedAt.ToUtcIso()" data-local="g">@k.CreatedAt.ToLocalTime().ToString("g")</time></td>
                                    <td>
                                        @if (k.RetiredAt is { } retired)
                                        {
                                            <span class="badge text-bg-secondary" title="@L["settings.encryption.retiredAt", new { time = retired.ToLocalTime().ToString("g") }]"
                                                  data-local-title="@retired.ToUtcIso()" data-local-title-prefix="@L["settings.encryption.retiredPrefix"]">@L["settings.encryption.retired"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">@L["settings.encryption.active"]</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" download="laris-signing-key-@(k.Id.ToString()[..8]).pem"
                                           href="data:application/x-pem-file;base64,@Convert.ToBase64String(System.Text.Encoding.ASCII.GetBytes(k.PublicKeyPem))">@L["settings.encryption.publicKey"]</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="lv-hint mt-1">@L["settings.encryption.thePublicKeyLetsAnyone"]</div>
            }
        </div>
    </SettingSection>
</div>

<SectionContent SectionName="PageScripts">
    <PageScript Src="/js/encryption-settings.js" />
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [SupplyParameterFromForm(FormName = "encryption-settings")] private string? Mode { get; set; }

    private FootageKeyStatus Status { get; set; } = new(false, null, null, null);
    private string? SavedMessage { get; set; }
    private List<PublicSigningKey> SigningKeysList { get; set; } = [];

    /// <summary>First 16 bytes of the SHA-256 of the public key (DER), as colon-separated hex.</summary>
    private static string Fingerprint(string pem)
    {
        try
        {
            var body = string.Concat(pem.Split('\n').Where(l => !l.StartsWith("-----")).Select(l => l.Trim()));
            var hash = System.Security.Cryptography.SHA256.HashData(Convert.FromBase64String(body));
            return string.Join(":", hash.Take(16).Select(b => b.ToString("x2")));
        }
        catch (FormatException) { return "?"; }
    }

    protected override async Task OnInitializedAsync()
    {
        Status = await FootageKeys.GetStatusAsync();
        SigningKeysList = await SigningKeys.ListPublicKeysAsync();
        Mode ??= NodeService.NormalizeEncryptMode(await Settings.GetAsync("Storage.Encrypt", "Off"));
    }

    private async Task HandleSaveAsync()
    {
        Status = await FootageKeys.GetStatusAsync();
        if (!Status.Ready) return;
        var user = AuthenticationStateTask is not null ? (await AuthenticationStateTask).User : null;
        var by = user?.Identity?.Name;
        var old = NodeService.NormalizeEncryptMode(await Settings.GetAsync("Storage.Encrypt", "Off"));
        Mode = NodeService.NormalizeEncryptMode(Mode);
        await Settings.SetGlobalAsync("Storage.Encrypt", Mode, by);
        if (old != Mode)
            await AuditService.LogAsync("Settings.Encryption", user?.FindFirst(ClaimTypes.NameIdentifier)?.Value, by, null,
                $"Footage encryption default: {old} → {Mode}");
        SavedMessage = Loc.T("settings.encryption.savedRecordersPickItUp");
    }
}
