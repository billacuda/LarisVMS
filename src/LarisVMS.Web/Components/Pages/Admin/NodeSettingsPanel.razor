@* Node-wide settings on the Nodes page (was Settings → Nodes): auto-update, the release check, and
   the registration key new nodes use. Needs Settings.Edit on top of the page's own Nodes.Edit —
   Nodes.razor only renders this for people who have it, and the save handler checks again. *@
@using System.Security.Claims
@using LarisVMS.Core
@using LarisVMS.Core.Interfaces
@using LarisVMS.Web.Services
@inject ISettingsResolver Settings
@inject IAuditService AuditService
@inject IPermissionService PermissionService
@inject ReleaseCheckState ReleaseCheckState
@inject LarisVMS.Relay.CertHolder Certificates

<section class="card mb-4" id="settings" aria-labelledby="nodeSettingsTitle">
    <div class="card-header"><h2 class="h6 mb-0" id="nodeSettingsTitle">@L["admin.nodeSettingsPanel.updatesAndRegistration"]</h2></div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(SavedMessage))
        {
            <div class="alert alert-success py-2">@SavedMessage</div>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-2" role="alert">@ErrorMessage</div>
        }
        <EditForm Model="this" FormName="node-settings" OnSubmit="HandleSaveAsync" data-dirty-guard>
            <SettingSection Title="@L["admin.nodeSettingsPanel.updates"]">
                <SettingField Label="@L["admin.nodeSettingsPanel.autoUpdate"]" Hint="@L["admin.nodeSettingsPanel.nodesAndProxiesInstallThe"]" HelpLink="/Help/nodes#updates">
                    <div class="form-check mt-1">
                        <InputCheckbox @bind-Value="NodeAutoUpdateEnabled" class="form-check-input" id="NodeAutoUpdateEnabled" />
                        <label class="form-check-label" for="NodeAutoUpdateEnabled">@L["admin.nodeSettingsPanel.autoUpdateNodesAndMedia"]</label>
                    </div>
                </SettingField>
                <SettingField Label="@L["admin.nodeSettingsPanel.newVersions"]" Hint="@L["admin.nodeSettingsPanel.onceADayTheServer"]" HelpLink="/Help/installation#updates">
                    <div class="form-check mt-1">
                        <InputCheckbox @bind-Value="ReleaseCheckEnabled" class="form-check-input" id="ReleaseCheckEnabled" />
                        <label class="form-check-label" for="ReleaseCheckEnabled">@L["admin.nodeSettingsPanel.checkForNewLarisvmsVersions"]</label>
                    </div>
                </SettingField>
            </SettingSection>
            <SettingSection Title="@L["admin.nodeSettingsPanel.registration"]">
                <SettingField For="registrationKeyInput" Label="@L["admin.nodeSettingsPanel.registrationKey"]" Wide Hint="@L["admin.nodeSettingsPanel.usedByInstallNodePs1"]" HelpLink="/Help/installation#nodes">
                    <div class="input-group">
                        <InputText @bind-Value="RegistrationKey" type="password" class="form-control font-monospace" id="registrationKeyInput" />
                        <button type="button" class="btn btn-outline-secondary" data-secret-toggle="registrationKeyInput"
                                data-secret-label="registration key" aria-pressed="false" aria-label="@L["admin.nodeSettingsPanel.showRegistrationKey"]">
                            <span aria-hidden="true" data-secret-glyph>👁️</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="regenerateKeyBtn">@L["admin.nodeSettingsPanel.generate"]</button>
                    </div>
                </SettingField>
            </SettingSection>
            <SettingSection Title="@L["admin.nodeSettingsPanel.serverCertificate"]">
                <SettingField For="field-certificateCheck" Label="@L["admin.nodeSettingsPanel.serverCertificateCheck"]" Wide HelpLink="/Help/nodes#server-certificate"
                              Hint="@L["admin.nodeSettingsPanel.howNodesAndProxiesCheck"]">
                    <select id="field-certificateCheck" name="CertificateCheck" class="form-select" style="max-width: 22rem;">
                        @foreach (var option in Enum.GetValues<LarisVMS.Core.Security.ServerCertificateCheck>())
                        {
                            <option value="@option" selected="@(option == CertificateCheck)">@ServerCertificateSettings.Label(option)</option>
                        }
                    </select>
                    @if (Certificates.IsSelfSigned)
                    {
                        <div class="alert alert-warning small mt-2 mb-0">
                            This server uses a self-signed certificate. Nodes trust it on first use. If the certificate
                            changes, every node and proxy has to be re-registered. Install a certificate from a trusted CA
                            to avoid this.
                            @if (Certificates.Current is { } cert && cert.NotAfter.ToUniversalTime() - DateTime.UtcNow < ServerCertificateSettings.ExpiryWarning)
                            {
                                <div class="mt-1">
                                    @L.Markup("admin.nodeSettingsPanel.certExpires", new { time = cert.NotAfter.ToUniversalTime().ToTimeTag("d") })
                                </div>
                            }
                        </div>
                    }
                </SettingField>
            </SettingSection>
            <div class="lv-savebar">
                <button type="submit" class="btn btn-primary">@L["common.save"]</button>
            </div>
        </EditForm>
        @if (Certificates.IsSelfSigned)
        {
            <EditForm Model="this" FormName="regenerate-server-certificate" OnSubmit="HandleRegenerateAsync" class="mt-2">
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        data-confirm="@L["admin.nodeSettingsPanel.makeANewSelfSigned"]">
                    @L["admin.nodeSettingsPanel.regenerateSelfSignedCertificate"]
                </button>
            </EditForm>
        }
    </div>
</section>

<SectionContent SectionName="PageScripts">
    <script nonce="@Csp.Value">
        (function () {
            var btn = document.getElementById('regenerateKeyBtn');
            var input = document.getElementById('registrationKeyInput');
            if (!btn || !input) return;
            btn.addEventListener('click', function () {
                var bytes = new Uint8Array(24);
                crypto.getRandomValues(bytes);
                input.value = Array.prototype.map.call(bytes, function (b) {
                    return b.toString(16).padStart(2, '0');
                }).join('').toUpperCase();
                // Reveal the freshly generated key so the user can read/copy what they just made.
                input.dispatchEvent(new Event('secret-reveal:show'));
            });
        })();
    </script>
</SectionContent>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "node-settings")] private string? RegistrationKey { get; set; }
    [SupplyParameterFromForm(FormName = "node-settings")] private bool NodeAutoUpdateEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "node-settings")] private bool ReleaseCheckEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "node-settings")] private LarisVMS.Core.Security.ServerCertificateCheck CertificateCheck { get; set; }

    // Loaded by Nodes.razor (see NodeBuildsPanel's Builds for why).
    [Parameter] public string? InitialRegistrationKey { get; set; }
    [Parameter] public bool InitialAutoUpdate { get; set; }
    [Parameter] public bool InitialReleaseCheck { get; set; }

    private string? SavedMessage;
    private string? ErrorMessage;

    private ClaimsPrincipal User => HttpContext?.User ?? new ClaimsPrincipal(new ClaimsIdentity());

    protected override void OnParametersSet()
    {
        // Skip the form fields on this form's own POST: the submitted values are already bound, and
        // reloading here would save the old ones back (see Detection.razor's OnInitializedAsync).
        if (HttpContext?.Request.HasFormContentType == true && HttpContext.Request.Form["_handler"] == "node-settings") return;
        RegistrationKey = InitialRegistrationKey;
        NodeAutoUpdateEnabled = InitialAutoUpdate;
        ReleaseCheckEnabled = InitialReleaseCheck;
    }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.Request.HasFormContentType == true && HttpContext.Request.Form["_handler"] == "node-settings") return;
        CertificateCheck = LarisVMS.Core.Security.ServerCertificateTrust.Parse(
            await Settings.GetRawAsync(ServerCertificateSettings.CheckKey));
    }

    private async Task HandleRegenerateAsync()
    {
        if (!(await PermissionService.GetGrantedAsync(User)).Has("Settings", "Edit")) return;
        if (!Certificates.RegenerateSelfSigned())
        {
            ErrorMessage = Certificates.LastError ?? Loc.T("admin.nodeSettingsPanel.theCertificateCouldntBeRegenerated");
            return;
        }
        await ServerCertificateSettings.TrackAsync(Certificates, Settings, AuditService);
        await AuditService.LogAsync("Server.CertificateRegenerated", User.FindFirst(ClaimTypes.NameIdentifier)?.Value, User.Identity?.Name,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), "Self-signed certificate regenerated");
        SavedMessage = Loc.T("admin.nodeSettingsPanel.aNewSelfSignedCertificate");
    }

    private async Task HandleSaveAsync()
    {
        if (!(await PermissionService.GetGrantedAsync(User)).Has("Settings", "Edit")) return;
        var by = User.Identity?.Name;

        // Nodes would lose the server the moment they got this setting.
        if (CertificateCheck == LarisVMS.Core.Security.ServerCertificateCheck.TrustedOnly && Certificates.IsSelfSigned)
        {
            ErrorMessage = Loc.T("admin.nodeSettingsPanel.installACertificateFromA");
            return;
        }
        var oldCertificateCheck = LarisVMS.Core.Security.ServerCertificateTrust.Parse(await Settings.GetRawAsync(ServerCertificateSettings.CheckKey));
        await Settings.SetGlobalAsync(ServerCertificateSettings.CheckKey, CertificateCheck.ToString(), by);

        // Registration key is diffed as a secret — the entry records that it changed, never the key
        // itself, since the audit log is readable by anyone with Logs.View.
        var oldRegistrationKey = LarisVMS.Infrastructure.Security.SecretProtection.Unprotect(await Settings.GetRawAsync("Node.RegistrationKey"));
        var oldAutoUpdate = await Settings.GetAsync("NodeAutoUpdate.Enabled", true);
        var oldReleaseCheck = await Settings.GetAsync(ReleaseCheckService.EnabledKey, ReleaseCheckService.DefaultEnabled);

        // Blank means "leave unchanged" — the form always submits the current key.
        if (!string.IsNullOrWhiteSpace(RegistrationKey))
            await Settings.SetGlobalAsync("Node.RegistrationKey", LarisVMS.Infrastructure.Security.SecretProtection.Protect(RegistrationKey.Trim())!, by);
        await Settings.SetGlobalAsync("NodeAutoUpdate.Enabled", NodeAutoUpdateEnabled.ToString(), by);
        await Settings.SetGlobalAsync(ReleaseCheckService.EnabledKey, ReleaseCheckEnabled.ToString(), by);
        // Off: the notice goes at once. Back on: check now rather than at the next daily run.
        if (!ReleaseCheckEnabled) ReleaseCheckState.Set(null);
        else if (!oldReleaseCheck) ReleaseCheckState.RequestCheck();

        var details = AuditDiff.Build(
            AuditDiff.Secret("Node.RegistrationKey", oldRegistrationKey,
                string.IsNullOrWhiteSpace(RegistrationKey) ? oldRegistrationKey : RegistrationKey),
            AuditDiff.Of("NodeAutoUpdate.Enabled", oldAutoUpdate.ToString(), NodeAutoUpdateEnabled.ToString()),
            AuditDiff.Of(ReleaseCheckService.EnabledKey, oldReleaseCheck.ToString(), ReleaseCheckEnabled.ToString()),
            AuditDiff.Of("Server certificate check", oldCertificateCheck.ToString(), CertificateCheck.ToString()));
        await AuditService.LogAsync("Settings.Update", User.FindFirst(ClaimTypes.NameIdentifier)?.Value, by,
            HttpContext?.Connection.RemoteIpAddress?.ToString(), details);

        SavedMessage = Loc.T("common.saved");
    }
}
