@page "/Bookmarks"
@attribute [Authorize("Playback.View")]
@using LarisVMS.Core.Interfaces
@inject IBookmarkService BookmarkService
@inject IAuthorizationService AuthorizationService
@inject ICameraAccessService CameraAccess
@inject IPermissionService Permissions

<PageTitle>@L["nav.bookmarks"] - @AppName</PageTitle>

<h1>@L["nav.bookmarks"]</h1>
<p class="text-muted small">@L["bookmarks.momentsMarkedFromPlaybackShared"]</p>

@if (Bookmarks.Count == 0)
{
    <p class="text-muted">@L["bookmarks.noBookmarksYetAddOne"]</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="bookmarksTable"
                   placeholder="@L["bookmarks.filterByCameraNote"]" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="bookmarksPageSize">@L["bookmarks.rowsPerPage"]</label>
            <select id="bookmarksPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="bookmarksTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="all">@L["common.all"]</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" id="bookmarksTable" data-sortable data-paginate>
            <thead>
                <tr>
                    <th>@L["common.camera"]</th>
                    <th>@L["common.time"]</th>
                    <th>@L["bookmarks.note"]</th>
                    <th>@L["bookmarks.createdBy"]</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Bookmarks)
                {
                    <tr>
                        <td data-sort-value="@b.CameraName">@b.CameraName</td>
                        <td data-sort-value="@b.TimestampUtc.Ticks">
                            <time datetime="@b.TimestampUtc.ToUtcIso()" data-local="g">@b.TimestampUtc.ToLocalTime().ToString("g")</time>
                        </td>
                        <td>@b.Note</td>
                        <td class="text-muted small">@(b.CreatedByUserName ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               href="/Playback?cameraId=@b.CameraId&atUtc=@b.TimestampUtc.ToString("o")">
                                @L["bookmarks.play"]
                            </a>
                            @* FormName is unique per row — Blazor throws "more than one named submit
                               event with the name X" if a loop renders the same FormName twice. *@
                            <EditForm Model="this" FormName="@($"delete-bookmark-{b.Id}")" OnValidSubmit="HandleDeleteAsync" class="d-inline">
                                <input type="hidden" name="Id" value="@b.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-confirm="@L["bookmarks.deleteThisBookmark"]">@L["bookmarks.delete"]</button>
                            </EditForm>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="bookmarksTable" class="mt-2"></div>
}

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private List<LarisVMS.Core.Dtos.BookmarkDto> Bookmarks { get; set; } = [];

    // Read from the raw form, not [SupplyParameterFromForm] — that attribute needs a compile-time
    // constant FormName, which a per-row unique name (see above) can't provide.
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Only bookmarks on cameras this person may play back.
    private async Task LoadAsync()
    {
        var playable = await CameraAccess.GetAccessibleCameraIdsAsync(CurrentUser(), LarisVMS.Core.Enums.CameraAccessActions.Playback);
        Bookmarks = (await BookmarkService.ListAsync()).Where(b => playable is null || playable.Contains(b.CameraId)).ToList();
    }

    private System.Security.Claims.ClaimsPrincipal CurrentUser() =>
        HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());

    private async Task HandleDeleteAsync()
    {
        Id = Guid.TryParse(HttpContext?.Request.Form["Id"].ToString(), out var id) ? id : Guid.Empty;
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
        if (!(await AuthorizationService.AuthorizeAsync(user, "Bookmarks.Edit")).Succeeded) return;

        // Your own bookmarks (or anyone's, for a Super Admin), on a camera you may play back.
        if (await BookmarkService.GetOwnerAsync(Id) is { } owner)
        {
            var playable = await CameraAccess.GetAccessibleCameraIdsAsync(user, LarisVMS.Core.Enums.CameraAccessActions.Playback);
            var isOwner = owner.CreatedByUserId == user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var isAdmin = (await Permissions.GetGrantedAsync(user)).IsAdministrator;
            if ((isOwner || isAdmin) && (playable is null || playable.Contains(owner.CameraId)))
                await BookmarkService.DeleteAsync(Id);
        }
        await LoadAsync();
    }
}
