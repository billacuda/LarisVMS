@page "/Exports/Verify"
@attribute [Authorize("Exports.View")]

<PageTitle>@L["exports.verify.verifyAnExport"] - @AppName</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="mb-0">@L["exports.verify.verifyAnExport"]</h1>
    <a class="btn btn-sm btn-outline-secondary ms-auto" href="/Exports">@L["exports.verify.backToExports"]</a>
</div>

<p class="text-muted small" style="max-width: 60rem;">
    @L.Markup("exports.verify.intro")
    <a href="/Help/live-and-playback#verify-an-export">@L["common.learnMore"]</a>
</p>

<div class="card mb-3" style="max-width: 60rem;">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small fw-semibold" for="verifyManifest">@L["exports.verify.manifestManifestJson"]</label>
                <input type="file" class="form-control form-control-sm" id="verifyManifest" accept=".json,application/json" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold" for="verifyVideo">@L["exports.verify.exportedVideo"]</label>
                <input type="file" class="form-control form-control-sm" id="verifyVideo" accept="video/*,.mp4" />
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 mt-3">
            <button type="button" class="btn btn-primary btn-sm" id="verifyRun" disabled>@L["exports.verify.verify"]</button>
            <div class="progress flex-grow-1 d-none" id="verifyProgress" style="height: .6rem;" role="progressbar" aria-label="@L["exports.verify.checkingTheVideo"]">
                <div class="progress-bar" style="width: 0%"></div>
            </div>
        </div>
    </div>
</div>

<div id="verifyResult" style="max-width: 60rem;" aria-live="polite"></div>

<SectionContent SectionName="PageScripts">
    <PageScript Src="/js/sha256-stream.js" />
    <PageScript Src="/js/export-verify-core.js" />
    <PageScript Src="/js/exports-verify.js" />
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
}
