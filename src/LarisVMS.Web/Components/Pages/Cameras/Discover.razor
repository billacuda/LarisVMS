@page "/Cameras/Discover"
@attribute [Authorize("Cameras.Edit")]
@using LarisVMS.Core.Dtos
@using LarisVMS.Core.Interfaces
@inject ICameraDiscoveryService DiscoveryService

<PageTitle>@L["cameras.discover.discoverCameras"] - @AppName</PageTitle>

<h1>@L["cameras.discover.discoverCameras"]</h1>
<p class="text-muted">
    @L.Markup("cameras.discover.intro")
</p>

<EditForm Model="this" FormName="discover-scan" OnSubmit="HandleScanAsync" class="mb-4">
    <button type="submit" class="btn btn-primary">
        @L["cameras.discover.scanLan5s"]
    </button>
</EditForm>

@if (HasScanned)
{
    @if (Results.Count == 0)
    {
        <div class="alert alert-warning">@L["cameras.discover.noDevicesRespondedTheyMay"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>@L["cameras.discover.address"]</th><th>@L["cameras.discover.nameHardware"]</th><th>@L["cameras.discover.deviceServiceUrl"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Results)
                    {
                        <tr>
                            <td>@d.RemoteAddress</td>
                            <td>@(d.NameHint ?? d.HardwareHint ?? "—")</td>
                            <td class="font-monospace small">@d.XAddrs.FirstOrDefault()</td>
                            <td>
                                <a class="btn btn-sm btn-primary"
                                   href="@EditHref(d)">
                                    @L["common.add"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }

    private List<DiscoveredCameraDto> Results { get; set; } = [];
    private bool HasScanned { get; set; }

    private async Task HandleScanAsync()
    {
        Results = (await DiscoveryService.DiscoverAsync(TimeSpan.FromSeconds(5))).ToList();
        HasScanned = true;
    }

    private static string EditHref(DiscoveredCameraDto d)
    {
        var suggestedName = d.NameHint ?? d.HardwareHint ?? d.RemoteAddress;
        return $"/Cameras/Edit?deviceServiceUri={Uri.EscapeDataString(d.XAddrs.FirstOrDefault() ?? "")}&suggestedName={Uri.EscapeDataString(suggestedName)}";
    }
}
