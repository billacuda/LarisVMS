@page "/Cameras/EventTags/{id:guid}"
@attribute [Authorize("Cameras.Edit")]
@using LarisVMS.Core.Interfaces
@inject ICameraService CameraService
@inject NavigationManager Nav

<PageTitle>Event tags: @CameraName - @AppName</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Event tags: @CameraName</h1>
    <a class="btn btn-outline-secondary" href="/Cameras/Edit/@CameraId">Back to camera</a>
</div>

<p class="text-muted small">
    A rule matches ONVIF PullPoint notifications from this camera by topic and tags the timeline with
    a color of your choice — motion, object detection, tamper alarms, anything the camera's own
    firmware pushes. Give it a <strong>Start topic</strong> alone if the topic's own payload carries a
    true/false state (most motion/alarm topics do); give it a matching <strong>Stop topic</strong> too
    if the camera fires two distinct topics for the rising and falling edge instead. Either way the
    tag starts the instant the rising edge is seen and only ever ends on the falling edge — never on a
    timeout. Turn on <strong>Drives recording</strong> to also keep/discard segments by this rule the
    same way built-in motion does, for a Motion-mode camera.
</p>

<div class="row g-3">
    <div class="col-lg-7">
        <div id="eventTagListPanel">
            <p class="text-muted small">Loading rules…</p>
        </div>

        <div id="eventTagFormPanel" class="border rounded p-3 mt-3" style="display: none;">
            <h6 id="eventTagFormTitle">New rule</h6>
            <input type="hidden" id="eventTagFormId" />
            <div class="mb-2">
                <label class="form-label small">Name</label>
                <input type="text" id="eventTagFormName" class="form-control form-control-sm" placeholder="e.g. Person detected" required />
            </div>
            <div class="mb-2">
                <label class="form-label small">Start topic</label>
                <input type="text" id="eventTagFormStartTopic" class="form-control form-control-sm" list="observedTopicsList" required />
            </div>
            <div class="mb-2">
                <label class="form-label small">Stop topic <span class="text-muted">(optional — leave blank to use the start topic's own true/false state)</span></label>
                <input type="text" id="eventTagFormStopTopic" class="form-control form-control-sm" list="observedTopicsList" />
            </div>
            <datalist id="observedTopicsList"></datalist>
            <div class="mb-2">
                <label class="form-label small">Timeline color</label>
                <input type="color" id="eventTagFormColor" class="form-control form-control-sm form-control-color" value="#ff9800" />
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="eventTagFormDrivesRecording" class="form-check-input" />
                <label class="form-check-label small" for="eventTagFormDrivesRecording">Drives recording (keep/discard segments in Motion mode, same as built-in motion)</label>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="eventTagFormEnabled" class="form-check-input" checked />
                <label class="form-check-label small" for="eventTagFormEnabled">Enabled</label>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="eventTagFormSaveBtn" class="btn btn-primary btn-sm">Save</button>
                <button type="button" id="eventTagFormCancelBtn" class="btn btn-outline-secondary btn-sm">Cancel</button>
                <button type="button" id="eventTagFormDeleteBtn" class="btn btn-outline-danger btn-sm ms-auto" style="display: none;">Delete</button>
            </div>
        </div>

        <button type="button" id="eventTagNewBtn" class="btn btn-primary btn-sm mt-3">New rule</button>
    </div>

    <div class="col-lg-5">
        <h6>Observed topics</h6>
        <p class="text-muted small">
            Every distinct ONVIF topic this camera has actually sent, most recent first — probed from
            its real event history, not guessed. Click one to use it as the new rule's Start topic.
        </p>
        <div id="observedTopicsPanel">
            <p class="text-muted small">Loading…</p>
        </div>
    </div>
</div>

<SectionContent SectionName="PageScripts">
    <script src="/js/event-tag-rules-editor.js"></script>
    <script>
        window.larisvmsEventTagRulesEditor.init({
            cameraId: '@CameraId',
            listPanelId: 'eventTagListPanel',
            newBtnId: 'eventTagNewBtn',
            formPanelId: 'eventTagFormPanel',
            formTitleId: 'eventTagFormTitle',
            formIdInputId: 'eventTagFormId',
            formNameId: 'eventTagFormName',
            formStartTopicId: 'eventTagFormStartTopic',
            formStopTopicId: 'eventTagFormStopTopic',
            formColorId: 'eventTagFormColor',
            formDrivesRecordingId: 'eventTagFormDrivesRecording',
            formEnabledId: 'eventTagFormEnabled',
            formSaveBtnId: 'eventTagFormSaveBtn',
            formCancelBtnId: 'eventTagFormCancelBtn',
            formDeleteBtnId: 'eventTagFormDeleteBtn',
            observedTopicsPanelId: 'observedTopicsPanel',
            observedTopicsListId: 'observedTopicsList'
        });
    </script>
</SectionContent>

@code {
    [CascadingParameter(Name = "AppName")] private string? AppName { get; set; }
    [Parameter] public Guid Id { get; set; }

    private Guid CameraId { get; set; }
    private string CameraName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var camera = await CameraService.GetAsync(Id);
        if (camera is null) { Nav.NavigateTo("/Cameras", forceLoad: true); return; }

        CameraId = Id;
        CameraName = camera.Name;
    }
}
