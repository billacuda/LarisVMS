@* Port of Pages/Shared/_PaginationControls.cshtml — same PaginationViewModel/PaginationWindow this
   app's list pages already build (CurrentPage, TotalPages, PageUrl(page) -> href). *@
@using LarisVMS.Web.Helpers

@if (Model.TotalPages > 1)
{
    <nav class="@Model.CssClass" aria-label="@Model.AriaLabel">
        <ul class="pagination pagination-sm flex-wrap mb-0">
            <li class="page-item @(_atFirst ? "disabled" : "")">
                <a class="page-link" href="@(_atFirst ? "#" : Model.PageUrl(1))" title="First page" aria-label="First page">«</a>
            </li>
            <li class="page-item @(_atFirst ? "disabled" : "")">
                <a class="page-link" href="@(_atFirst ? "#" : Model.PageUrl(Math.Max(1, Model.CurrentPage - 10)))" title="Back 10 pages" aria-label="Back 10 pages">‹‹</a>
            </li>
            <li class="page-item @(_atFirst ? "disabled" : "")">
                <a class="page-link" href="@(_atFirst ? "#" : Model.PageUrl(Model.CurrentPage - 1))" aria-label="Previous page">‹</a>
            </li>
            @foreach (var p in _pages)
            {
                @if (p is null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Model.PageUrl(p.Value)">@p</a>
                    </li>
                }
            }
            <li class="page-item @(_atLast ? "disabled" : "")">
                <a class="page-link" href="@(_atLast ? "#" : Model.PageUrl(Model.CurrentPage + 1))" aria-label="Next page">›</a>
            </li>
            <li class="page-item @(_atLast ? "disabled" : "")">
                <a class="page-link" href="@(_atLast ? "#" : Model.PageUrl(Math.Min(Model.TotalPages, Model.CurrentPage + 10)))" title="Forward 10 pages" aria-label="Forward 10 pages">››</a>
            </li>
            <li class="page-item @(_atLast ? "disabled" : "")">
                <a class="page-link" href="@(_atLast ? "#" : Model.PageUrl(Model.TotalPages))" title="Last page" aria-label="Last page">»</a>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter, EditorRequired] public PaginationViewModel Model { get; set; } = null!;

    private List<int?> _pages = [];
    private bool _atFirst;
    private bool _atLast;

    protected override void OnParametersSet()
    {
        _pages = PaginationWindow.Compute(Model.CurrentPage, Model.TotalPages);
        _atFirst = Model.CurrentPage <= 1;
        _atLast = Model.CurrentPage >= Model.TotalPages;
    }
}
