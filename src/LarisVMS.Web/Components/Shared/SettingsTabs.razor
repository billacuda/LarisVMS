@* Blazor port of Pages/Admin/Settings/_SettingsTabs.cshtml — kept in sync manually as tabs migrate
   off Razor Pages one at a time. Plain <a href> links (not asp-page), so navigating to a
   still-Razor-Pages tab or an already-migrated Blazor one both just work. *@
<ul class="nav nav-tabs mb-3 flex-wrap">
    @foreach (var (key, href, icon, labelKey) in Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(key == ActiveKey ? "active" : "")" href="@href" aria-current="@(key == ActiveKey ? "page" : null)"><span aria-hidden="true">@icon</span> @L[labelKey]</a>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public string ActiveKey { get; set; } = "";

    private static readonly (string Key, string Href, string Icon, string LabelKey)[] Tabs =
    [
        ("ActiveDirectory", "/Admin/Settings/ActiveDirectory", "🏢", "settings.tabs.activeDirectory"),
        ("Backups", "/Admin/Settings/Backups", "💾", "settings.tabs.backups"),
        ("Branding", "/Admin/Settings/Branding", "🎨", "settings.tabs.branding"),
        ("CameraAccess", "/Admin/Settings/CameraAccess", "🗝️", "settings.tabs.cameraAccess"),
        ("Cameras", "/Admin/Settings/Cameras", "📷", "settings.tabs.cameras"),
        ("Detection", "/Admin/Settings/Detection", "🤖", "settings.tabs.detection"),
        ("Email", "/Admin/Settings/Email", "✉️", "settings.tabs.email"),
        ("Encryption", "/Admin/Settings/Encryption", "🔐", "settings.tabs.encryption"),
        ("Events", "/Admin/Settings/Events", "🏷️", "settings.tabs.events"),
        ("Language", "/Admin/Settings/Language", "🌐", "settings.tabs.language"),
        ("LiveView", "/Admin/Settings/LiveView", "🖥️", "settings.tabs.liveView"),
        ("Notifications", "/Admin/Settings/Notifications", "🔔", "settings.tabs.notifications"),
        ("Logs", "/Admin/Settings/Logs", "📝", "settings.tabs.logs"),
        ("Permissions", "/Admin/Settings/Permissions/Matrix", "🛡️", "settings.tabs.permissions"),
        ("Recording", "/Admin/Settings/Recording", "🎥", "settings.tabs.recording"),
        ("Security", "/Admin/Settings/Security", "🔒", "settings.tabs.security"),
        ("StorageAndRetention", "/Admin/Settings/StorageAndRetention", "🗄️", "settings.tabs.storageAndRetention")
    ];
}
