@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <script nonce="@Csp.Value">
        // Back/forward must never land on ERR_CACHE_MISS / "Confirm form resubmission". A page
        // rendered as the response to a form POST (a settings page after Save, a form redisplayed
        // with an error) is a POST entry in the browser's history; replacing the entry with its own
        // URL turns it into a plain GET entry, so returning to it just reloads the page. Harmless on
        // a page that came from a GET. Keeps the current state and #hash.
        try { history.replaceState(history.state, '', location.href); } catch (e) { /* not fatal */ }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @* PWA: manifest (Program.cs /manifest.webmanifest) + icons make the site installable on phones. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <base href="/" />
    <link rel="stylesheet" href="@V("/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="@V("/css/theme.css")" />
    <link rel="stylesheet" href="@V("/css/site.css")" />
    <HeadOutlet />
    <script nonce="@Csp.Value">
        // Anti-flash: applies the stored theme (or the system preference, when unset — 'auto' is
        // the default) before first paint. Kept identical to _Layout.cshtml's copy so Razor-Pages-
        // served and Blazor-served pages never disagree on initial theme during the migration.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    <script src="@V("/js/inline-actions.js")"></script>
</head>
@* data-enhance-nav="false": every link is an ordinary page load. Blazor's enhanced navigation swaps
   the next page into this document instead, and the scripts that page brings (its PageScripts —
   dashboard grid, Activity, Live/View players, Razor Pages reached from here) are never executed, so a
   page reached by clicking a link came up half-built until it was refreshed. *@
<body data-enhance-nav="false">
    <Routes />

    @* Straight after the content, before the other scripts, so the page's title moves into the top
       bar before first paint. It also re-runs after each enhanced navigation (see the file). *@
    <script src="@V("/js/page-title.js")"></script>

    <script src="@V("/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="@V("/js/local-time.js")"></script>
    <script src="@V("/js/user-preferences.js")"></script>
    <script src="@V("/js/theme.js")"></script>
    <script src="@V("/js/pwa.js")"></script>
    <script src="@V("/js/notifications.js")"></script>
    <script src="@V("/js/sortable-table.js")"></script>
    <script src="@V("/js/list-filter.js")"></script>
    <script src="@V("/js/table-pagination.js")"></script>
    <script src="@V("/js/column-picker.js")"></script>
    <script src="@V("/js/secret-reveal.js")"></script>
    @* Equivalent of Razor Pages' @section Scripts: a page's own <SectionContent SectionName="PageScripts">
       renders here — after every global helper above — regardless of where it's declared in that
       page's markup. Required for anything (like dashboard.js) that depends on a global helper
       (larisvmsPreferences, etc.) already having run; a plain <script> tag embedded directly in a
       page's own markup executes wherever it sits in the render tree, which is before this point. *@
    <SectionOutlet SectionName="PageScripts" />
    <script src="_framework/blazor.web.js"></script>
    @* Must load after blazor.web.js — it registers a listener on Blazor's own 'enhancedload' event.
       See the file's own comment for why this exists: keeps the sidebar's active-nav highlight and
       the theme correct across enhanced navigation, which doesn't reliably re-apply either on its
       own. *@
    <script src="@V("/js/blazor-chrome-sync.js")"></script>
    @* Must load after blazor.web.js for the same reason as blazor-chrome-sync.js above — it
       registers an 'enhancedload' listener so filter save/restore (Snapshots, Audit Logs) actually
       fires on Blazor's in-app navigation, not just the first hard load. See the file's own
       comment. *@
    <script src="@V("/js/remember-filters.js")"></script>
    @* Must load after blazor.web.js for the same 'enhancedload' reason. Inert on pages without
       [data-show-when] / form[data-dirty-guard]. *@
    <script src="@V("/js/conditional-fields.js")"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Same ?v=<hash> cache-buster asp-append-version adds on Razor Pages, so a deploy's CSS/JS
    // reaches browsers instead of a stale cached copy.
    private string V(string path) => FileVersion.AddFileVersionToPath(HttpContext?.Request.PathBase ?? default, path);
}
