@using Microsoft.AspNetCore.Identity
@using LarisVMS.Core.Entities

<div class="d-flex align-items-center gap-2">
@if (_isSignedIn)
{
    <a class="btn btn-link btn-sm p-0 text-decoration-none" href="/Notifications" title="@L["layout.myNotifications"]" aria-label="@L["layout.myNotifications"]">🔔</a>
    <a class="text-muted small d-none d-sm-inline text-truncate lv-username text-decoration-none" href="/Identity/Account/ChangePassword"
       title="@L["layout.changePasswordFor", new { user = _userName }]">@_userName</a>
    <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" class="d-inline">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-link btn-sm p-0">@L["layout.logout"]</button>
    </form>
}
else
{
    <a class="btn btn-link btn-sm p-0" href="/Identity/Account/Login">@L["layout.login"]</a>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isSignedIn;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
        _isSignedIn = user.Identity?.IsAuthenticated == true;
        _userName = user.Identity?.Name;
    }
}
