@using Microsoft.AspNetCore.Identity
@using LarisVMS.Core.Entities

<div class="d-flex align-items-center gap-2">
@if (_isSignedIn)
{
    <span class="text-muted small">@_userName</span>
    <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" class="d-inline">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-link btn-sm p-0">Logout</button>
    </form>
}
else
{
    <a class="btn btn-link btn-sm p-0" href="/Identity/Account/Login">Login</a>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isSignedIn;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationStateTask is not null
            ? (await AuthenticationStateTask).User
            : new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
        _isSignedIn = user.Identity?.IsAuthenticated == true;
        _userName = user.Identity?.Name;
    }
}
