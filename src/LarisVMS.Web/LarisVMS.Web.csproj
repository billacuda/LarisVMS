<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.216.0</Version>
    <!-- S5332 ("use https not http"): every http:// URL in this project targets a recorder node on
         the LAN. Nodes present no TLS certificate by design (see the architecture notes / the many
         Web->Node call sites in Program.cs, Nodes.cshtml.cs, ExportJobDispatcher.cs); each call is
         instead HMAC-signed with that node's own MediaSigningKey and the browser never talks to a
         node directly. External calls in this app all use https. -->
    <NoWarn>$(NoWarn);S5332</NoWarn>
    <!-- S8970 ("remove this null-forgiving operator; nullable warnings are disabled here") only fires
         in .razor files, where it misreads the generated code's #nullable switches: removing the
         operators it flags brings back real CS86xx warnings. Nullable is on project-wide, so outside
         Razor the rule never applies. -->
    <NoWarn>$(NoWarn);S8970</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LarisVMS.Infrastructure\LarisVMS.Infrastructure.csproj" />
    <ProjectReference Include="..\LarisVMS.Onvif\LarisVMS.Onvif.csproj" />
    <ProjectReference Include="..\LarisVMS.Relay\LarisVMS.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK's implicit content glob only picks up *.json (appsettings.json,
         appsettings.*.json) for automatic publish-copy — a *.json.example file's real extension is
         .example, so it needs an explicit Content item or dotnet publish never puts it in the publish
         output, and install-web.ps1's "seed appsettings.Production.json from the .example if missing"
         step has nothing to seed from. -->
    <Content Include="appsettings.Production.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Help pages (Components/Pages/Help) — Markdown embedded in the assembly so a deploy can never
         ship the page without its content. -->
    <EmbeddedResource Include="Help\*.md" LogicalName="Help/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reason Infrastructure and Media expose theirs: pure decision functions
         (LogsRetentionService.ShouldDelete and friends) are unit-tested directly rather than being
         made public purely to satisfy a test. -->
    <InternalsVisibleTo Include="LarisVMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
