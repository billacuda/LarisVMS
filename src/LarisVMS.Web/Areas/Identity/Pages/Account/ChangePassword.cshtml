@page
@model LarisVMS.Web.Areas.Identity.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = L["account.password.title"].Value;
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">@L["account.password.title"]</h1>

        @if (Model.NotHere is not null)
        {
            <div class="alert alert-info">@Model.NotHere</div>
        }
        else
        {
            @if (Model.Required)
            {
                <div class="alert alert-warning">@L["account.password.required"]</div>
            }
            @if (Model.Changed)
            {
                <div class="alert alert-success" role="status">@L["account.password.changed"]</div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="text" name="username" value="@User.Identity?.Name" autocomplete="username" hidden />
                <div class="mb-3">
                    <label asp-for="Input.CurrentPassword" class="form-label"></label>
                    <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" minlength="12" />
                    <div class="form-text">@L["account.password.rules"]</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" minlength="12" />
                </div>
                <button type="submit" class="btn btn-primary w-100">@L["account.password.submit"]</button>
            </form>
        }

        @if (Model.Required)
        {
            <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" class="mt-3 text-center">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link btn-sm">@L["layout.logout"]</button>
            </form>
        }
        else
        {
            <partial name="_AccountLinks" model="@("password")" />
        }
    </div>
</div>
