@page
@model LarisVMS.Web.Pages.Admin.ApiKeys.IndexModel
@{
    ViewData["Title"] = L["admin.apiKeys.apiKeys"].Value;
}
<h1>@L["admin.apiKeys.apiKeys"]</h1>

<p class="text-muted">
    @L.Html("admin.apiKeys.intro")
</p>

@if (Model.NewRawKey is not null)
{
    <div class="alert alert-success">
        <strong>@L["admin.apiKeys.created", new { name = Model.NewKeyName }]</strong> @L["admin.apiKeys.copyThisKeyNowIt"]
        <div class="input-group mt-2">
            <input type="text" class="form-control font-monospace" value="@Model.NewRawKey" readonly
                   id="newRawKey" data-action="select" />
            <button type="button" class="btn btn-outline-secondary" data-copy-from="#newRawKey">@L["common.copy"]</button>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["common.name"]</th>
                    <th>@L["common.role"]</th>
                    <th>@L["common.key"]</th>
                    <th>@L["common.created"]</th>
                    <th>@L["admin.apiKeys.lastUsed"]</th>
                    <th>@L["admin.apiKeys.expires"]</th>
                    <th>@L["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Keys)
                {
                    <tr>
                        <td>@k.Name</td>
                        <td>
                            @k.RoleName
                            @if (k.Limited)
                            {
                                <span class="badge text-bg-info" title="@L["admin.apiKeys.limitedHint"]">@L["admin.apiKeys.limited"]</span>
                            }
                        </td>
                        <td class="font-monospace small">@k.KeyPrefix&hellip;</td>
                        <td class="small text-muted"><time datetime="@k.CreatedAtUtc.ToUtcIso()" data-local="g">@k.CreatedAtUtc.ToLocalTime().ToString("g")</time></td>
                        <td class="small text-muted">@if (k.LastUsedAtUtc is { } used) {<time datetime="@used.ToUtcIso()" data-local="g">@used.ToLocalTime().ToString("g")</time>} else {<text>@L["admin.apiKeys.never"]</text>}</td>
                        <td class="small text-muted">@if (k.ExpiresAtUtc is { } expires) {<time datetime="@expires.ToUtcIso()" data-local="d">@expires.ToLocalTime().ToString("d")</time>} else {<text>@L["admin.apiKeys.never"]</text>}</td>
                        <td>
                            @if (k.Revoked)
                            {
                                <span class="badge text-bg-secondary">@L["admin.apiKeys.revoked"]</span>
                            }
                            else if (k.Expired)
                            {
                                <span class="badge text-bg-warning">@L["admin.apiKeys.expired"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">@L["admin.apiKeys.active"]</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!k.Revoked)
                            {
                                <a asp-page="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-secondary">@L["common.edit"]</a>
                                <form method="post" asp-page-handler="Revoke" asp-route-id="@k.Id" class="d-inline"
                                      data-confirm="@L["admin.apiKeys.revokeConfirm", new { name = k.Name }]">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["common.revoke"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Keys.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-3">@L["admin.apiKeys.noApiKeysYet"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a asp-page="Edit" class="btn btn-primary">@L["admin.apiKeys.addKey"]</a>
<a href="/Help/api" class="btn btn-link">@L["admin.apiKeys.apiDocumentation"]</a>
