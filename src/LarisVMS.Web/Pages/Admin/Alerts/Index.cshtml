@page
@model LarisVMS.Web.Pages.Admin.Alerts.IndexModel
@{
    ViewData["Title"] = L["admin.alerts.alerts"].Value;
}
<h1>@L["admin.alerts.alerts"]</h1>

<p class="text-muted small">
    @L["admin.alerts.watchACameraOrNode"] <a href="/Help/alerts">@L["common.learnMore"]</a>
</p>

@if (Model.IsSuperAdmin)
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link @(Model.Personal ? "" : "active")" href="/Admin/Alerts">@L["admin.alerts.sharedRules"]</a></li>
        <li class="nav-item"><a class="nav-link @(Model.Personal ? "active" : "")" href="/Admin/Alerts?personal=true">@L["admin.alerts.usersPersonalNotifications"]</a></li>
    </ul>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["common.name"]</th>
                    <th>@L["admin.alerts.condition"]</th>
                    <th>@(Model.Personal ? L["admin.alerts.owner"].Value : L["admin.alerts.teamChannels"].Value)</th>
                    <th>@L["admin.alerts.subscribers"]</th>
                    <th>@L["admin.alerts.lastFired"]</th>
                    <th>@L["common.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rules)
                {
                    <tr>
                        <td>
                            @if (Model.Personal) { @r.Name } else { <a asp-page="Edit" asp-route-id="@r.Id">@r.Name</a> }
                            @if (r.TypeTurnedOff)
                            {
                                <span class="badge text-bg-warning ms-1" title="@L["admin.alerts.thisNotificationTypeIsTurned"]">@L["admin.alerts.pausedForUsers"]</span>
                            }
                        </td>
                        <td class="small">@r.ConditionSummary</td>
                        <td class="small">@(Model.Personal ? r.OwnerName : r.ChannelList)</td>
                        <td class="small">@r.Subscribers@(r.AllowSubscribe ? " · open" : "")</td>
                        <td class="small text-muted">@if (r.LastFiredAt is { } fired) {<time datetime="@fired.ToUtcIso()" data-local="g">@fired.ToLocalTime().ToString("g")</time>} else {<text>@L["admin.alerts.never"]</text>}</td>
                        <td>
                            @if (r.IsEnabled)
                            {
                                <span class="badge text-bg-success">@L["common.enabled"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@L["common.disabled"]</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@r.Id" asp-route-personal="@Model.Personal" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(r.IsEnabled ? L["common.disable"].Value : L["common.enable"].Value)
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" asp-route-personal="@Model.Personal" class="d-inline"
                                  data-confirm="@L["admin.alerts.deleteConfirm", new { name = r.Name }]">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["common.delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Rules.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">@(Model.Personal ? L["admin.alerts.noPersonalNotificationsYet"].Value : L["admin.alerts.noAlertRulesYet"].Value)</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Personal)
{
    <a asp-page="Edit" class="btn btn-primary">@L["admin.alerts.addRule"]</a>
}
