@page "{id:guid?}"
@model LarisVMS.Web.Pages.Admin.Alerts.EditModel
@using LarisVMS.Core
@using LarisVMS.Core.Enums
@{
    ViewData["Title"] = Model.Id is null ? "Add alert rule" : "Edit alert rule";
}
<h1>@(Model.Id is null ? "Add alert rule" : "Edit alert rule")</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-page-handler="Save">
    <input type="hidden" asp-for="Id" />

    <div class="card mb-3">
        <div class="card-header fw-semibold">Condition</div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsEnabled" id="isEnabled" />
                <label class="form-check-label" for="isEnabled">Enabled</label>
            </div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label">Name</label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="e.g. Front door camera offline" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label">
                        Cooldown (minutes)
                    </label>
                    <input type="number" asp-for="CooldownMinutes" class="form-control" min="1" />
                    <div class="lv-hint">Minimum time between repeat firings.</div>
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Condition type</label>
                    <select asp-for="ConditionType" id="conditionType" class="form-select">
                        <option value="@AlertConditionType.CameraNotReporting">Camera not reporting</option>
                        <option value="@AlertConditionType.NodeOffline">Node offline</option>
                        <option value="@AlertConditionType.NodeStorageLow">Node storage low</option>
                        <option value="@AlertConditionType.NodeFailoverActivated">Node failover activated</option>
                        <option value="@AlertConditionType.MotionDetected">Motion detected</option>
                        <option value="@AlertConditionType.ObjectDetected">Object detected</option>
                        <option value="@AlertConditionType.SpeedOver">Speed over a limit</option>
                        <option value="@AlertConditionType.EvidenceLockExpiringSoon">Evidence lock ending soon</option>
                        <option value="@AlertConditionType.EvidenceLockRemoved">Evidence lock removed</option>
                    </select>
                </div>

                <div class="col-sm-6" id="cameraField">
                    <label class="form-label">Camera</label>
                    <select asp-for="CameraId" id="cameraSelect" class="form-select">
                        <option value="" id="cameraEmptyOption">(choose a camera)</option>
                        @foreach (var c in Model.Cameras)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6" id="nodeField">
                    <label class="form-label" id="nodeLabel">Node</label>
                    <select asp-for="NodeId" id="nodeSelect" class="form-select">
                        <option value="" id="nodeEmptyOption">(choose a node)</option>
                        @foreach (var n in Model.Nodes)
                        {
                            <option value="@n.Id">@n.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3" id="thresholdField">
                    <label class="form-label">
                        Free space threshold (%)
                    </label>
                    <input type="number" asp-for="ThresholdPercent" class="form-control" min="1" max="99" />
                    <div class="lv-hint">Fires when free space drops below this.</div>
                </div>
            </div>

            @* Detection and motion alerts: every filter is optional and they all have to match. Motion
               uses only the zone and the schedule. *@
            <div id="detectionFields" class="row g-3 mt-1">
                <div class="col-12"><hr class="my-1" /><div class="small text-muted" data-detection-only>
                    Fires within seconds of a matching AI detection. Leave a filter empty to match anything.
                    Needs AI detection on the camera; colors and zones use each object's own box.
                </div><div class="small text-muted" data-motion-only>
                    Fires within seconds of motion on the camera, or only in one server motion zone.
                </div></div>
                <div class="col-sm-3" id="speedField">
                    <label class="form-label">Speed limit (@SpeedUnits.Label(Model.SpeedUnit))</label>
                    <input type="number" asp-for="SpeedThreshold" class="form-control" min="1" step="any" />
                    <div class="lv-hint">Fires at or over this. Speeds come from speed traps (Cameras → Speed traps).</div>
                </div>
                <div class="col-sm-3" data-detection-only>
                    <label class="form-label">Category</label>
                    <select asp-for="CategoryFilter" class="form-select">
                        <option value="">(any)</option>
                        @foreach (var name in Model.Categories.Select(c => c.Name))
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3" data-detection-only>
                    <label class="form-label">Label</label>
                    <input type="text" asp-for="LabelFilter" class="form-control" list="alertLabelList" placeholder="e.g. truck" />
                    <datalist id="alertLabelList">
                        @foreach (var l in Model.Labels.Select(l => l.Label).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(l => l))
                        {
                            <option value="@l"></option>
                        }
                    </datalist>
                </div>
                <div class="col-sm-3" data-detection-only>
                    <label class="form-label">Color</label>
                    <select asp-for="ColorFilter" class="form-select">
                        <option value="">(any)</option>
                        @foreach (var name in ObjectColors.All.Select(c => c.Name))
                        {
                            <option value="@name">@ObjectColors.Display(name)</option>
                        }
                    </select>
                    <div class="lv-hint">For people, matches the shirt or the pants.</div>
                </div>
                <div class="col-sm-4">
                    <label class="form-label">Zone</label>
                    <select asp-for="ZoneId" id="zoneSelect" class="form-select">
                        <option value="" id="zoneAnyOption">(anywhere in view)</option>
                        @foreach (var z in Model.Zones)
                        {
                            <option value="@z.Id" data-camera="@z.CameraId" data-kind="@z.Kind">@z.Name</option>
                        }
                    </select>
                    <div class="lv-hint" data-detection-only>Where the object stands (the bottom of its box). Pick a camera first.</div>
                    <div class="lv-hint" data-motion-only>Server motion zones only. Pick a camera first.</div>
                </div>
                <div class="col-sm-8">
                    <label class="form-label d-block">Active</label>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @foreach (var d in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday })
                        {
                            <div class="form-check form-check-inline me-0">
                                <input class="form-check-input" type="checkbox" name="ScheduleDays" value="@d" id="day-@d"
                                       checked="@Model.ScheduleDays.Contains(d)" />
                                <label class="form-check-label small" for="day-@d">@d.ToString()[..3]</label>
                            </div>
                        }
                        <input type="time" asp-for="ScheduleStart" class="form-control form-control-sm" style="width: 8rem;" aria-label="From" />
                        <span class="small">to</span>
                        <input type="time" asp-for="ScheduleEnd" class="form-control form-control-sm" style="width: 8rem;" aria-label="Until" />
                    </div>
                    <div class="lv-hint">No days ticked = every day; no times = all day. 22:00 to 06:00 runs overnight. In <span id="tzName">@(Model.ScheduleTimeZoneName ?? "your time zone")</span>.</div>
                    <input type="hidden" asp-for="TimeZoneId" id="timeZoneId" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Notifications to users</div>
        <div class="card-body">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" asp-for="AllowSubscribe" id="allowSubscribe" />
                <label class="form-check-label" for="allowSubscribe">Let users subscribe</label>
            </div>
            <div class="lv-hint">Users can then turn this on for themselves under My notifications, in the browser or by email.
                Each user only gets it for cameras they can view. <a href="/Help/alerts#notifications">Learn more</a></div>
            @if (Model.Id is null)
            {
                <div class="small text-muted mt-2">Save the rule to add subscribers.</div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Team channels</div>
        <div class="card-body">
            <p class="text-muted small">At most one delivery per channel. Turn a channel on and fill
                in its fields to send a firing there.</p>

            <div class="row g-3 align-items-end border-bottom pb-3 mb-3">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="EmailEnabled" id="emailEnabled" />
                        <label class="form-check-label" for="emailEnabled">Email</label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <input type="email" asp-for="EmailTo" class="form-control" placeholder="ops@example.com" />
                </div>
                <div class="col-sm-4 text-muted small">Sends through Admin → Settings → Email.</div>
            </div>

            <div class="row g-3 align-items-end border-bottom pb-3 mb-3">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="WebhookEnabled" id="webhookEnabled" />
                        <label class="form-check-label" for="webhookEnabled">Webhook</label>
                    </div>
                </div>
                <div class="col-sm-10">
                    <input type="url" asp-for="WebhookUrl" class="form-control" placeholder="https://example.com/hook" />
                </div>
            </div>

            <div class="row g-3 align-items-end border-bottom pb-3 mb-3">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="NtfyEnabled" id="ntfyEnabled" />
                        <label class="form-check-label" for="ntfyEnabled">ntfy</label>
                    </div>
                </div>
                <div class="col-sm-5">
                    <input type="text" asp-for="NtfyTopic" class="form-control" placeholder="Topic" />
                </div>
                <div class="col-sm-5">
                    <input type="url" asp-for="NtfyServerUrl" class="form-control" placeholder="Server (default https://ntfy.sh)" />
                </div>
            </div>

            <div class="row g-3 align-items-end border-bottom pb-3 mb-3">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="PushoverEnabled" id="pushoverEnabled" />
                        <label class="form-check-label" for="pushoverEnabled">Pushover</label>
                    </div>
                </div>
                <div class="col-sm-5">
                    <input type="text" asp-for="PushoverAppToken" class="form-control" placeholder="App token" autocomplete="off" />
                </div>
                <div class="col-sm-5">
                    <input type="text" asp-for="PushoverUserKey" class="form-control" placeholder="User key" autocomplete="off" />
                </div>
            </div>

            <div class="row g-3 align-items-end border-bottom pb-3 mb-3">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="SlackEnabled" id="slackEnabled" />
                        <label class="form-check-label" for="slackEnabled">Slack</label>
                    </div>
                </div>
                <div class="col-sm-10">
                    <input type="url" asp-for="SlackWebhookUrl" class="form-control" placeholder="Incoming webhook URL" />
                </div>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-sm-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="TeamsEnabled" id="teamsEnabled" />
                        <label class="form-check-label" for="teamsEnabled">Teams</label>
                    </div>
                </div>
                <div class="col-sm-10">
                    <input type="url" asp-for="TeamsWebhookUrl" class="form-control" placeholder="Incoming webhook URL" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@if (Model.Id is { } ruleId)
{
    <div class="card my-3">
        <div class="card-header fw-semibold">Subscribers</div>
        <div class="card-body">
            @if (Model.Subscribers.Count == 0)
            {
                <p class="text-muted small">Nobody gets this as a personal notification yet.</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead><tr><th>User</th><th>Browser</th><th>Email</th><th>Muted</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sub in Model.Subscribers)
                        {
                            <tr>
                                <td>@sub.UserName</td>
                                <td>@(sub.Browser ? "✓" : "—")</td>
                                <td>@(sub.Email ? "✓" : "—")</td>
                                <td class="small">
                                    @if (sub.MutedUntilUtc is { } muted && muted > DateTime.UtcNow)
                                    {
                                        @if (muted == DateTime.MaxValue) { <span>until turned back on</span> }
                                        else { <span>until <time datetime="@muted.ToUtcIso()" data-local="g">@muted.ToLocalTime().ToString("g")</time></span> }
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="RemoveSubscriber" asp-route-id="@ruleId" class="d-inline">
                                        <input type="hidden" name="subscriptionId" value="@sub.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <form method="post" asp-page-handler="AddSubscribers" asp-route-id="@ruleId" class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label small mb-0" for="addUserId">Add a user</label>
                    <select name="addUserId" id="addUserId" class="form-select form-select-sm">
                        <option value="">(none)</option>
                        @foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label small mb-0" for="addRoleId">or everyone in a role</label>
                    <select name="addRoleId" id="addRoleId" class="form-select form-select-sm">
                        <option value="">(none)</option>
                        @foreach (var r in Model.Roles) { <option value="@r.Id">@r.Name</option> }
                    </select>
                </div>
                <div class="col-sm-auto">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="addBrowser" value="true" id="addBrowser" checked />
                        <label class="form-check-label small" for="addBrowser">Browser</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="addEmail" value="true" id="addEmail" />
                        <label class="form-check-label small" for="addEmail">Email</label>
                    </div>
                </div>
                <div class="col-sm-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                </div>
                <div class="col-12 lv-hint">Each person can change how they get it, mute it, or unsubscribe under My notifications.</div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script nonce="@Csp.Value">
        (function () {
            var conditionType = document.getElementById('conditionType');
            var cameraField = document.getElementById('cameraField');
            var nodeField = document.getElementById('nodeField');
            var thresholdField = document.getElementById('thresholdField');
            var detectionFields = document.getElementById('detectionFields');
            var speedField = document.getElementById('speedField');
            var cameraSelect = document.getElementById('cameraSelect');
            var cameraEmptyOption = document.getElementById('cameraEmptyOption');
            var zoneSelect = document.getElementById('zoneSelect');
            var nodeLabel = document.getElementById('nodeLabel');
            var nodeEmptyOption = document.getElementById('nodeEmptyOption');
            if (!conditionType) return;

            // The schedule runs in the zone of whoever saves the rule.
            var tz = document.getElementById('timeZoneId');
            try {
                var zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (tz && zone) tz.value = zone;
            } catch (e) { /* leave the stored zone */ }

            // The options carry enum names (that's what the select tag helper binds), so compare names.
            function update() {
                var value = conditionType.value;
                var isCamera = value === '@nameof(AlertConditionType.CameraNotReporting)';
                var isNodeOffline = value === '@nameof(AlertConditionType.NodeOffline)';
                var isStorageLow = value === '@nameof(AlertConditionType.NodeStorageLow)';
                var isFailover = value === '@nameof(AlertConditionType.NodeFailoverActivated)';
                var isSpeed = value === '@nameof(AlertConditionType.SpeedOver)';
                var isDetection = isSpeed || value === '@nameof(AlertConditionType.ObjectDetected)';
                var isLock = value === '@nameof(AlertConditionType.EvidenceLockExpiringSoon)' || value === '@nameof(AlertConditionType.EvidenceLockRemoved)';
                var isMotion = value === '@nameof(AlertConditionType.MotionDetected)';
                var cameraScoped = isDetection || isLock || isMotion;
                var nodeCondition = isNodeOffline || isStorageLow || isFailover;
                cameraField.style.display = (isCamera || cameraScoped) ? '' : 'none';
                cameraEmptyOption.textContent = cameraScoped ? '(any camera)' : '(choose a camera)';
                // Camera-scoped types can be limited to one node's cameras when no camera is chosen.
                nodeField.style.display = (nodeCondition || (cameraScoped && !cameraSelect.value)) ? '' : 'none';
                nodeLabel.textContent = nodeCondition ? 'Node' : 'Only cameras on node';
                nodeEmptyOption.textContent = nodeCondition ? '(choose a node)' : '(any node)';
                thresholdField.style.display = isStorageLow ? '' : 'none';
                detectionFields.style.display = (isDetection || isMotion) ? '' : 'none';
                speedField.style.display = isSpeed ? '' : 'none';
                Array.prototype.forEach.call(detectionFields.querySelectorAll('[data-detection-only]'), function (el) { el.style.display = isMotion ? 'none' : ''; });
                Array.prototype.forEach.call(detectionFields.querySelectorAll('[data-motion-only]'), function (el) { el.style.display = isMotion ? '' : 'none'; });
                document.getElementById('zoneAnyOption').textContent = isMotion ? '(whole camera)' : '(anywhere in view)';
                updateZones();
            }

            // Only the chosen camera's zones are offered; for motion, only its server motion zones.
            function updateZones() {
                var cam = cameraSelect.value;
                var motionOnly = conditionType.value === '@nameof(AlertConditionType.MotionDetected)';
                Array.prototype.forEach.call(zoneSelect.options, function (opt) {
                    if (!opt.value) return;
                    var show = cam && opt.getAttribute('data-camera') === cam
                        && (!motionOnly || opt.getAttribute('data-kind') === '@nameof(ZoneKind.ServerMotion)');
                    opt.hidden = !show;
                    if (!show && opt.selected) zoneSelect.value = '';
                });
                zoneSelect.disabled = !cam;
            }
            conditionType.addEventListener('change', update);
            cameraSelect.addEventListener('change', updateZones);
            cameraSelect.addEventListener('change', update);
            update();
            updateZones();
        })();
    </script>
}
