@page
@model LarisVMS.Web.Pages.Admin.Settings.StorageAndRetentionModel
@{
    ViewData["Title"] = "Storage and retention settings";
}
<h1>Settings</h1>
<partial name="_SettingsTabs" model="@("StorageAndRetention")" />

<p class="text-muted">
    Override per node on <a asp-page="/Admin/Nodes">Admin &rarr; Nodes</a>, or per camera on that
    camera's edit page; a camera-level override wins over its node's, which wins over the global
    defaults here.
</p>

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}

<form method="post" class="row g-3" style="max-width: 560px;">
    <div class="col-12">
        <label class="form-label">
            Default storage root
            <button type="button" class="help-icon" data-help-target="storageRootHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <input asp-for="StorageRootPath" class="form-control font-monospace" placeholder="e.g. E:\LarisVMS\recordings or \\files1\nvr$\LarisVMS" />
        <div class="help-text-source" id="storageRootHelp">
            Local disk path or UNC share recorder nodes write to when they have no
            <a asp-page="/Admin/Nodes">node-specific override</a>. Changing this only affects where a
            node writes <strong>new</strong> recordings from its next reconcile cycle on — it does not
            move footage already written under the old path.
        </div>
    </div>
    <div class="col-12">
        <label class="form-label">
            Global retention (days)
            <button type="button" class="help-icon" data-help-target="retentionHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <input asp-for="RetentionDays" type="number" min="0" class="form-control" required />
        <div class="help-text-source" id="retentionHelp">0 = keep forever unless a node/camera override says otherwise.</div>
    </div>
    <div class="col-12">
        <label class="form-label">
            Watermark (% of volume used)
            <button type="button" class="help-icon" data-help-target="watermarkHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <input asp-for="WatermarkPercent" type="number" min="1" max="99" class="form-control" required />
        <div class="help-text-source" id="watermarkHelp">
            When a node's storage root passes this usage, its oldest unlocked segments across every
            camera on that node are deleted regardless of retention/quota — a hard backstop against a
            full disk, not a preference.
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary"><span aria-hidden="true">💾</span> Save</button>
    </div>
</form>
