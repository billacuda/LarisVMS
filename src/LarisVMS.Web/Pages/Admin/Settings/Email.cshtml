@page
@model LarisVMS.Web.Pages.Admin.Settings.EmailModel
@using LarisVMS.Core.Enums
@{
    ViewData["Title"] = "Email";
}
<h1>Settings</h1>
<partial name="_SettingsTabs" model="@("Email")" />

<p class="text-muted">
    The outbound sender alert notifications (M15) will send through.
</p>

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="card mb-3">
        <div class="card-header fw-semibold">Sender</div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsEnabled" id="isEnabled" />
                <label class="form-check-label" for="isEnabled">Email enabled</label>
            </div>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label class="form-label">Provider</label>
                    <select asp-for="Provider" id="provider" class="form-select">
                        <option value="@EmailProviderType.Smtp">SMTP</option>
                        <option value="@EmailProviderType.Graph">Microsoft Graph</option>
                        <option value="@EmailProviderType.Gmail">Gmail</option>
                    </select>
                </div>
                <div class="col-sm-4">
                    <label class="form-label">From address</label>
                    <input type="email" asp-for="FromAddress" class="form-control" placeholder="alerts@example.com" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label">From name</label>
                    <input type="text" asp-for="FromName" class="form-control" placeholder="LarisVMS" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="smtpCard">
        <div class="card-header fw-semibold">SMTP</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label">Host</label>
                    <input type="text" asp-for="SmtpHost" class="form-control" placeholder="smtp.example.com" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Port</label>
                    <input type="number" asp-for="SmtpPort" class="form-control" min="1" max="65535" />
                </div>
                <div class="col-sm-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="SmtpUseSsl" id="smtpUseSsl" />
                        <label class="form-check-label" for="smtpUseSsl">Use SSL/TLS</label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Username</label>
                    <input type="text" asp-for="SmtpUsername" class="form-control" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Password</label>
                    <input type="password" asp-for="SmtpPassword" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.HasStoredSmtpPassword ? "•••••••• (leave blank to keep)" : "")" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="graphCard">
        <div class="card-header fw-semibold">Microsoft Graph</div>
        <div class="card-body">
            <p class="text-muted small">
                App-only auth (client-credentials flow) against an Entra app registration granted the
                <code>Mail.Send</code> application permission — no per-user consent or refresh token.
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label">Tenant ID</label>
                    <input type="text" asp-for="GraphTenantId" class="form-control" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Client ID</label>
                    <input type="text" asp-for="GraphClientId" class="form-control" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Client secret</label>
                    <input type="password" asp-for="GraphClientSecret" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.HasStoredGraphClientSecret ? "•••••••• (leave blank to keep)" : "")" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Shared mailbox (optional)</label>
                    <input type="email" asp-for="GraphSharedMailbox" class="form-control" placeholder="Defaults to the from address" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="gmailCard">
        <div class="card-header fw-semibold">Gmail</div>
        <div class="card-body">
            <p class="text-muted small">
                Per-user OAuth2 against a Google Cloud project's OAuth client — needs a one-time
                consent redirect. Enter the Client ID/Secret and Gmail address below, save, then
                connect.
            </p>
            @if (Model.IsGmailConnected)
            {
                <div class="alert alert-success py-2">Connected.</div>
            }
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label">Client ID</label>
                    <input type="text" asp-for="GmailClientId" class="form-control" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Client secret</label>
                    <input type="password" asp-for="GmailClientSecret" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.HasStoredGmailClientSecret ? "•••••••• (leave blank to keep)" : "")" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Gmail address</label>
                    <input type="email" asp-for="GmailEmailAddress" class="form-control" placeholder="alerts@gmail.com" />
                </div>
                <div class="col-sm-6 d-flex align-items-end">
                    <button type="submit" asp-page-handler="ConnectGmail" class="btn btn-outline-primary">
                        Save and connect to Google
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Test</div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6">
                    <label class="form-label">Send a test email to</label>
                    <input type="email" asp-for="TestRecipient" class="form-control" placeholder="you@example.com" />
                </div>
                <div class="col-auto">
                    <button type="submit" asp-page-handler="TestSend" class="btn btn-outline-primary">
                        Save and send test
                    </button>
                </div>
            </div>
            <div class="form-text">Saves the form above first, then sends through it — a test always
                reflects exactly what's stored, not an unsaved edit.</div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" asp-page-handler="Save" class="btn btn-primary">Save</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var provider = document.getElementById('provider');
            var cards = {
                '@((int)EmailProviderType.Smtp)': document.getElementById('smtpCard'),
                '@((int)EmailProviderType.Graph)': document.getElementById('graphCard'),
                '@((int)EmailProviderType.Gmail)': document.getElementById('gmailCard')
            };
            if (!provider) return;

            function update() {
                Object.keys(cards).forEach(function (key) {
                    cards[key].style.display = key === provider.value ? '' : 'none';
                });
            }
            provider.addEventListener('change', update);
            update();
        })();
    </script>
}
