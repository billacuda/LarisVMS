@page
@model LarisVMS.Web.Pages.Admin.Settings.BrandingModel
@{
    ViewData["Title"] = "Branding";
}
<h1>Settings</h1>
<partial name="_SettingsTabs" model="@("Branding")" />

<p class="text-muted">
    Applies across the whole site — every page's navbar, footer, links and buttons, including the
    sign-in page. Anything left blank falls back to the built-in default, so you can brand only the
    parts you care about.
</p>

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="row g-3" style="max-width: 560px;">
    <div class="col-12">
        <label class="form-label" for="AppName">Application name</label>
        <input asp-for="AppName" id="AppName" class="form-control" maxlength="100" />
        <div class="form-text">Shown in the navbar, the browser tab title and the footer.</div>
    </div>

    <div class="col-sm-6">
        <label class="form-label" for="PrimaryColor">Primary color</label>
        <div class="input-group">
            @* The color input is the picker; the text input is what actually posts, so a value can
               also be pasted in exactly (and so an empty value stays empty — a color input can't
               represent "unset", it always reports a color). *@
            <input type="color" class="form-control form-control-color" id="PrimaryColorPicker"
                   value="@(Model.PrimaryColor ?? "#0d6efd")" title="Pick a primary color"
                   aria-label="Pick a primary color" />
            <input asp-for="PrimaryColor" id="PrimaryColor" class="form-control" placeholder="#0d6efd"
                   pattern="^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" />
        </div>
        <div class="form-text">Buttons and links. Blank = Bootstrap default blue.</div>
    </div>

    <div class="col-sm-6">
        <label class="form-label" for="AccentColor">Navbar color</label>
        <div class="input-group">
            <input type="color" class="form-control form-control-color" id="AccentColorPicker"
                   value="@(Model.AccentColor ?? "#212529")" title="Pick a navbar color"
                   aria-label="Pick a navbar color" />
            <input asp-for="AccentColor" id="AccentColor" class="form-control" placeholder="#212529"
                   pattern="^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" />
        </div>
        <div class="form-text">Blank = the default dark navbar.</div>
    </div>

    <div class="col-12">
        <label class="form-label" for="FontKey">Font</label>
        <select asp-for="FontKey" id="FontKey" class="form-select">
            <option value="">Default (Bootstrap)</option>
            @foreach (var (key, label) in Model.FontChoices)
            {
                <option value="@key" selected="@(key == Model.FontKey ? "selected" : null)">@label</option>
            }
        </select>
        <div class="form-text">
            A fixed list of widely-available font stacks — no web fonts are downloaded, and no
            custom CSS is accepted.
        </div>
    </div>

    <div class="col-12">
        <label class="form-label" for="LogoFile">Logo</label>
        <div class="d-flex align-items-center gap-3 mb-2">
            <img id="logoPreview" src="@(Model.LogoDataUri ?? "")" alt="Current logo preview"
                 class="border rounded bg-body-tertiary p-1"
                 style="max-height: 48px; width: auto; @(Model.LogoDataUri is null ? "display:none;" : "")" />
            <span id="logoEmpty" class="text-muted small @(Model.LogoDataUri is null ? "" : "d-none")">No logo set.</span>
        </div>
        <input type="file" id="LogoFile" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" />
        <div class="form-text">
            PNG, JPEG, GIF or WebP, under @(Model.MaxLogoBytes / 1024)KB. Shown beside the app name in
            the navbar, scaled to fit. SVG isn't accepted, since an SVG file can carry script.
        </div>
        @if (Model.LogoDataUri is not null)
        {
            <div class="form-check mt-2">
                <input asp-for="RemoveLogo" class="form-check-input" id="RemoveLogo" />
                <label class="form-check-label" for="RemoveLogo">Remove the current logo</label>
            </div>
        }
        @* The image never travels as a file upload — it's read client-side and posted as a data URI
           in this hidden field, which is also exactly how it's stored. That keeps the whole feature
           free of filesystem writes and upload plumbing. *@
        <input asp-for="LogoDataUri" type="hidden" id="LogoDataUri" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary"><span aria-hidden="true">💾</span> Save</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            // Keeps each color picker and its text input in step, in both directions.
            function linkColor(pickerId, textId) {
                var picker = document.getElementById(pickerId);
                var text = document.getElementById(textId);
                if (!picker || !text) return;
                picker.addEventListener('input', function () { text.value = picker.value; });
                text.addEventListener('input', function () {
                    if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(text.value)) picker.value = text.value;
                });
            }
            linkColor('PrimaryColorPicker', 'PrimaryColor');
            linkColor('AccentColorPicker', 'AccentColor');

            var file = document.getElementById('LogoFile');
            var hidden = document.getElementById('LogoDataUri');
            var preview = document.getElementById('logoPreview');
            var empty = document.getElementById('logoEmpty');
            var maxBytes = @Model.MaxLogoBytes;

            if (file) {
                file.addEventListener('change', function () {
                    var chosen = file.files && file.files[0];
                    if (!chosen) return;
                    var reader = new FileReader();
                    reader.onload = function () {
                        // Checked against the encoded length, since that's what actually gets stored
                        // and re-sent on every page render — not the raw file size, which is ~25%
                        // smaller and would let an over-cap value through to be rejected server-side.
                        if (reader.result.length > maxBytes) {
                            alert('That image is too large once encoded. Please use one under ' +
                                Math.floor(maxBytes / 1024) + 'KB.');
                            file.value = '';
                            return;
                        }
                        hidden.value = reader.result;
                        preview.src = reader.result;
                        preview.style.display = '';
                        if (empty) empty.classList.add('d-none');
                    };
                    reader.readAsDataURL(chosen);
                });
            }
        })();
    </script>
}
