@page
@model LarisVMS.Web.Pages.Admin.Settings.BackupsModel
@using LarisVMS.Core.Enums
@{
    ViewData["Title"] = L["settings.backups.backups"].Value;
}
<h1>@L["nav.settings"]</h1>
<partial name="_SettingsTabs" model="@("Backups")" />

<p class="text-muted small">
    @if (Model.IsMariaDb)
    {
        @L.Html("settings.backups.introMariaDb")
    }
    else
    {
        @L.Html("settings.backups.introSqlServer")
    }
    <a href="/Help/backups">@L["common.learnMore"]</a>
</p>


@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.Message <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["common.close"]"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["common.close"]"></button>
    </div>
}

@if (Model.IsRemoteSql)
{
    <div class="alert alert-warning">
        @L.Html("settings.backups.remoteSqlServer", new { source = Model.DataSource })
    </div>
}

<div class="card mb-3">
    <div class="card-header fw-semibold">@L["settings.backups.schedule"]</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Save">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="BackupEnabled" />
                <label class="form-check-label" asp-for="BackupEnabled">@L["settings.backups.runADailyBackupAutomatically"]</label>
            </div>
            <div class="row g-3">
                <div class="col-sm-2">
                    <label class="form-label" asp-for="BackupTime">@L["settings.backups.timeServerLocal"]</label>
                    <input asp-for="BackupTime" class="form-control" placeholder="03:00" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" asp-for="BackupDirectory">
                        @L["settings.backups.backupDirectory"]
                    </label>
                    <input asp-for="BackupDirectory" class="form-control" placeholder="D:\Backups\LarisVMS" />
                    @if (Model.IsMariaDb)
                    {
                        <div class="lv-hint">@L["settings.backups.aFolderOnThisServer"]</div>
                    }
                    else
                    {
                        <div class="lv-hint">@L["settings.backups.aFolderTheSqlServer"]</div>
                    }
                </div>
                @if (Model.IsMariaDb)
                {
                    <div class="col-sm-4">
                        <label class="form-label" asp-for="MariaDbDumpPath">mariadb-dump</label>
                        <input asp-for="MariaDbDumpPath" class="form-control" placeholder="@(Model.DetectedDumpPath ?? L["settings.backups.notFound"].Value)" />
                        <div class="lv-hint">@L["settings.backups.optionalBlankUsesTheMariadb"]</div>
                    </div>
                }
                else
                {
                    <div class="col-sm-4">
                        <label class="form-label" asp-for="EncryptionCertificate">@L["settings.backups.encryptionCertificate"]</label>
                        <input asp-for="EncryptionCertificate" class="form-control" placeholder="@L["settings.backups.notEncrypted"]" />
                        <div class="lv-hint">@L["settings.backups.optionalTheNameOfA"]</div>
                    </div>
                }
                <div class="col-sm-2">
                    <label class="form-label" asp-for="RetentionCount">@L["settings.backups.keepLast"]</label>
                    <input asp-for="RetentionCount" type="number" min="1" class="form-control" />
                    <div class="form-text">@(Model.IsMariaDb ? "backups" : L["settings.backups.backupsLocalSqlOnly"].Value)</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm mt-3"><span aria-hidden="true">💾</span> @L["common.save"]</button>
        </form>
        <form method="post" asp-page-handler="RunNow" class="mt-2">
            <button type="submit" class="btn btn-outline-secondary btn-sm">@L["settings.backups.backUpNow"]</button>
            <span class="text-muted small ms-2">@L["settings.backups.runsImmediatelyLargeDatabasesCan"]</span>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">@L["settings.backups.history"]</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>@L["settings.backups.started"]</th>
                    <th>@L["common.status"]</th>
                    <th>@L["settings.backups.trigger"]</th>
                    <th>@L["settings.backups.file"]</th>
                    <th>@L["common.size"]</th>
                    <th>@L["common.error"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.History)
                {
                    var badgeClass = b.Status switch
                    {
                        BackupStatus.Success => "text-bg-success",
                        BackupStatus.Failed => "text-bg-danger",
                        _ => "text-bg-secondary"
                    };
                    <tr>
                        <td class="small" ><time datetime="@b.StartedAt.ToUtcIso()" data-local="g">@b.StartedAt.ToLocalTime().ToString("g")</time></td>
                        <td><span class="badge @badgeClass">@b.Status</span></td>
                        <td class="small">@b.TriggeredBy</td>
                        <td class="small font-monospace">@b.FilePath</td>
                        <td class="small">@(b.SizeBytes is { } s ? ByteFormat.Format(s) : "—")</td>
                        <td class="small text-danger">@b.Error</td>
                    </tr>
                }
                @if (Model.History.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">@L["settings.backups.noBackupsYet"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
