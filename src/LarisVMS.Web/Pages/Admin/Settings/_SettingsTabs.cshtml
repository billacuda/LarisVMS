@* Shared tab strip for Settings. Each tab is a real page with its own route, matching the same
   "tabs are just navigation between real pages, not client-side panels" reasoning as
   Pages/Logs/_LogsTabs — several of these (Backups, Branding, Nodes) already carry real forms, file
   upload, and table actions with their own OnPost handlers, which would be awkward and risky to
   merge into one giant page/handler. Sorted alphabetically by label, not by any notion of importance
   or how often a given tab is used.
   "Permissions" (roles/permissions overhaul) folds together what used to be three separate tabs —
   Roles, Users, and Security — into Pages/Admin/Settings/Permissions/{Matrix,Roles,Users}.cshtml,
   itself tab-stripped one level down by _PermissionsTabs.cshtml. Security's live/playback custom
   port setting moved onto the Live View tab instead, since it isn't permission-related.
   Security itself came back (M20 pass 2) for the IP allow lists — a new, genuinely security/network-
   access themed pair of settings, not a resurrection of the retired tab's old content.
   Model: the active tab's key. *@
@model string
@{
    (string Key, string Href, string Icon, string LabelKey)[] tabs =
    [
        ("ActiveDirectory", "/Admin/Settings/ActiveDirectory", "🏢", "settings.tabs.activeDirectory"),
        ("Backups", "/Admin/Settings/Backups", "💾", "settings.tabs.backups"),
        ("Branding", "/Admin/Settings/Branding", "🎨", "settings.tabs.branding"),
        ("CameraAccess", "/Admin/Settings/CameraAccess", "🗝️", "settings.tabs.cameraAccess"),
        ("Cameras", "/Admin/Settings/Cameras", "📷", "settings.tabs.cameras"),
        ("Detection", "/Admin/Settings/Detection", "🤖", "settings.tabs.detection"),
        ("Email", "/Admin/Settings/Email", "✉️", "settings.tabs.email"),
        ("Encryption", "/Admin/Settings/Encryption", "🔐", "settings.tabs.encryption"),
        ("Events", "/Admin/Settings/Events", "🏷️", "settings.tabs.events"),
        ("Language", "/Admin/Settings/Language", "🌐", "settings.tabs.language"),
        ("LiveView", "/Admin/Settings/LiveView", "🖥️", "settings.tabs.liveView"),
        ("Logs", "/Admin/Settings/Logs", "📝", "settings.tabs.logs"),
        ("Permissions", "/Admin/Settings/Permissions/Matrix", "🛡️", "settings.tabs.permissions"),
        ("Recording", "/Admin/Settings/Recording", "🎥", "settings.tabs.recording"),
        ("Security", "/Admin/Settings/Security", "🔒", "settings.tabs.security"),
        ("StorageAndRetention", "/Admin/Settings/StorageAndRetention", "🗄️", "settings.tabs.storageAndRetention")
    ];
}
<ul class="nav nav-tabs mb-3 flex-wrap">
    @foreach (var (key, href, icon, labelKey) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(key == Model ? "active" : "")" href="@href" aria-current="@(key == Model ? "page" : null)"><span aria-hidden="true">@icon</span> @L[labelKey]</a>
        </li>
    }
</ul>
