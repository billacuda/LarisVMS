@page
@model LarisVMS.Web.Pages.Admin.Settings.SecurityModel
@{
    ViewData["Title"] = "Security settings";
}
<h1>Settings</h1>
<partial name="_SettingsTabs" model="@("Security")" />

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="row g-3" style="max-width: 560px;">
    <div class="col-12">
        <h5>Session lifetime</h5>
        <p class="text-muted small">
            How long a signed-in session stays good before it's forced to log in again, per role. A
            user holding more than one role is bound by whichever role's own limit is shortest — a
            role set to "never expire" does not let a user escape a stricter role's own limit just by
            also holding it.
        </p>
    </div>

    @if (Model.Roles.Count == 0)
    {
        <p class="text-muted">No roles exist yet.</p>
    }
    else
    {
        @foreach (var role in Model.Roles)
        {
            <div class="col-12">
                <label class="form-label">@role.RoleName</label>
                <div class="input-group" style="max-width: 220px;">
                    <input name="hours[@role.RoleId]" type="number" min="0" class="form-control" value="@role.Hours" required />
                    <span class="input-group-text">hours</span>
                </div>
            </div>
        }
        <div class="col-12">
            <div class="form-text">0 = never expire for that role. Default is 24 hours.</div>
        </div>
    }

    <div class="col-12 mt-4">
        <h5>Live/playback port</h5>
        <p class="text-muted small">
            Separates live view and playback traffic (the <code>/live</code> WebSocket relay,
            <code>/playback-segment</code>, <code>/playback-thumbnail</code>,
            <code>/export-download</code>, and camera snapshots) onto a port of its own, away from
            the management interface — useful if you want to firewall the two differently, or expose
            only one of them beyond the LAN.
        </p>
    </div>
    <div class="col-6">
        <label class="form-label">Custom port</label>
        <input asp-for="CustomPort" type="number" min="1" max="65535" class="form-control" placeholder="(none — everything on the same port)" />
        <div class="form-text">
            Setting this alone doesn't open a new listening port — IIS's own site bindings do that.
            Add a matching <code>New-WebBinding</code> for this port on the same site first (see the
            README), <strong>then</strong> set it here. Once set, live/playback routes stop
            responding on the management port, and every other route stops responding on this one.
            Leave blank to disable — everything goes back to sharing whatever port(s) IIS already
            binds.
        </div>
    </div>

    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary"><span aria-hidden="true">💾</span> Save</button>
    </div>
</form>
