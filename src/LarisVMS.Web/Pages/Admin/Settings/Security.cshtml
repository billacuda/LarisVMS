@page
@model LarisVMS.Web.Pages.Admin.Settings.SecurityModel
@{
    ViewData["Title"] = "Security settings";
}
<h1>Settings</h1>
<partial name="_SettingsTabs" model="@("Security")" />

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<p class="text-muted">
    One IP or CIDR block per line (e.g. <code>10.0.0.5</code> or <code>10.0.0.0/24</code>); lines
    starting with <code>#</code> are ignored. Leave a list blank to leave it unrestricted — that's the
    default. A management/API list that would exclude the address you're saving from is refused rather
    than applied.
</p>

<form method="post" class="row g-3" style="max-width: 720px;">
    <div class="col-12">
        <label class="form-label">
            Management / API
            <button type="button" class="help-icon" data-help-target="mgmtListHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <textarea asp-for="ManagementAllowList" class="form-control font-monospace" rows="6"
                  placeholder="10.0.0.0/24&#10;192.168.1.50&#10;# office VPN"></textarea>
        <div class="help-text-source" id="mgmtListHelp">Everything except live view and playback — the admin UI, and the REST API.</div>
    </div>

    <div class="col-12">
        <label class="form-label">
            Live View / Playback
            <button type="button" class="help-icon" data-help-target="liveViewListHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </label>
        <textarea asp-for="LiveViewAllowList" class="form-control font-monospace" rows="6"
                  placeholder="10.0.0.0/24"></textarea>
        <div class="help-text-source" id="liveViewListHelp">
            The <code>/live</code> WebSocket relay, <code>/playback-segment</code>,
            <code>/playback-thumbnail</code>, <code>/export-download</code>, and camera snapshots.
        </div>
    </div>

    <div class="col-12 mt-4">
        <h5>
            Entra ID sign-in
            <button type="button" class="help-icon" data-help-target="entraHelp" tabindex="0" aria-label="Help">ℹ️</button>
        </h5>
        <div class="help-text-source" id="entraHelp">
            "Sign in with Microsoft" on the Login page, for an existing account only — it signs in to
            an account already created on <a asp-page="/Admin/Settings/Permissions/Users">Admin &rarr;
            Users</a> whose email matches, and never creates one. Register an app in Entra with redirect
            URI <code>https://@Model.Request.Host/signin-oidc</code>, then enter its details below.
            Takes effect immediately — no restart needed.
        </div>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="EntraEnabled" id="entraEnabled" />
            <label class="form-check-label" for="entraEnabled">Enabled</label>
        </div>
    </div>
    <div class="col-sm-6">
        <label class="form-label">Tenant ID</label>
        <input asp-for="EntraTenantId" class="form-control font-monospace" placeholder="00000000-0000-0000-0000-000000000000" />
    </div>
    <div class="col-sm-6">
        <label class="form-label">Client ID</label>
        <input asp-for="EntraClientId" class="form-control font-monospace" placeholder="00000000-0000-0000-0000-000000000000" />
    </div>
    <div class="col-sm-6">
        <label class="form-label">Client secret</label>
        <input asp-for="EntraClientSecret" type="password" class="form-control" autocomplete="off"
               placeholder="@(Model.HasStoredEntraClientSecret ? "•••••••• (unchanged if left blank)" : "")" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary"><span aria-hidden="true">💾</span> Save</button>
    </div>
</form>
