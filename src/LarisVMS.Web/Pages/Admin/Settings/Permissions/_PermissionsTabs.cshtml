@* Sub-tab strip for the consolidated Permissions page, nested one level below _SettingsTabs — same
   "tabs are real pages with their own routes" convention (see _SettingsTabs.cshtml's own comment).
   Model: the active sub-tab's key. *@
@model string
@{
    (string Key, string Href, string Label)[] tabs =
    [
        ("Matrix", "/Admin/Settings/Permissions/Matrix", "Permissions Matrix"),
        ("Roles", "/Admin/Settings/Permissions/Roles", "Roles"),
        ("Users", "/Admin/Settings/Permissions/Users", "Users")
    ];
}
<ul class="nav nav-pills mb-3">
    @foreach (var (key, href, label) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(key == Model ? "active" : "")" href="@href">@label</a>
        </li>
    }
</ul>
