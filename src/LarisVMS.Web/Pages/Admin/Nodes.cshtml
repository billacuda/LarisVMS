@page
@model LarisVMS.Web.Pages.Admin.NodesModel
@{
    ViewData["Title"] = "Nodes";
}
<h1>Recorder nodes</h1>
<p class="text-muted">
    Recording runs in a separate Windows Service ("node") per the architecture plan, not inside this
    IIS-hosted app, so it survives app pool recycles and deploys. Install a node with
    <code>install-node.ps1</code> using the registration key from
    <a asp-page="/Admin/Settings/Nodes">Admin &rarr; Settings &rarr; Nodes</a>. Once
    installed, a node updates itself once a build registered by <code>deploy.ps1</code> is approved
    on <a asp-page="/Admin/NodeBuilds/Index">Admin &rarr; Node Builds</a> — no re-running the install
    script on every recorder machine.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* Survives the post-restart redirect via TempData — see NodesModel.StatusMessage. *@
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")" role="status">@Model.StatusMessage</div>
}

@if (Model.Nodes.Count == 0)
{
    <p class="text-muted">No nodes have registered yet.</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="nodesTable"
                   placeholder="Filter by name, IP, platform&hellip;" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="nodesPageSize">Rows per page</label>
            <select id="nodesPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="nodesTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle" id="nodesTable" data-sortable data-paginate>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>IP</th>
                    <th>Version</th>
                    <th>Platform</th>
                    <th data-no-sort>Encoders</th>
                    <th data-no-sort>AI accelerator</th>
                    <th data-no-sort>Detection model</th>
                    <th>Last seen</th>
                    <th data-sort-numeric>Cameras</th>
                    <th>Storage root</th>
                    <th data-sort-numeric>Storage usage</th>
                    <th data-sort-numeric>Retention (days)</th>
                    <th data-no-sort>Streaming &amp; failover</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Nodes)
                {
                    <tr>
                        <form method="post" asp-page-handler="Update" asp-route-id="@n.Id">
                            <td style="min-width: 12rem;" data-sort-value="@n.Name">
                                <input name="Name" class="form-control form-control-sm" value="@n.Name" required />
                            </td>
                            <td>
                                @{
                                    var stale = n.LastSeenAt is null || n.LastSeenAt < DateTime.UtcNow.AddMinutes(-2);
                                }
                                <span class="badge @(stale ? "text-bg-secondary" : "text-bg-success")">@n.Status</span>
                                @if (Model.StaleCameraCountByNode.GetValueOrDefault(n.Id) is > 0 and var staleCount)
                                {
                                    var staleTooltip = string.Join("\n", Model.StaleCamerasByNode[n.Id]
                                        .OrderBy(r => r.ClearsAtUtc)
                                        .Select(r => $"{r.CameraName} — falls off {r.ClearsAtUtc.ToLocalTime():g}"));
                                    <span class="ms-1" title="@staleTooltip">⚠️ @staleCount</span>
                                }
                                @if (n.StoragePressureActive)
                                {
                                    var since = n.StoragePressureSince?.ToLocalTime().ToString("g");
                                    <span class="ms-1 text-warning" title="This node's primary volume is over the storage watermark@(since is null ? "" : $" (since {since})") — its oldest footage is being archived early (or deleted, if archiving is unavailable) to keep the disk under the limit.">⚠️ storage full</span>
                                }
                                @if (string.IsNullOrWhiteSpace(n.StorageRootPath))
                                {
                                    <span class="ms-1 text-danger" title="This node has no storage path — it is recording nothing. Set a storage path below and save.">⚠️ no storage path — not recording</span>
                                }
                            </td>
                            <td class="font-monospace">@(n.LastIpAddress ?? "—")</td>
                            <td>@n.Version</td>
                            <td>@n.Platform</td>
                            <td>
                                @{
                                    var encoders = string.IsNullOrEmpty(n.DetectedEncodersJson)
                                        ? []
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(n.DetectedEncodersJson) ?? [];
                                }
                                @if (encoders.Count == 0)
                                {
                                    <span class="text-muted small" title="No successful ffmpeg -encoders probe reported yet — needs a heartbeat from a node running M17 or later.">none reported</span>
                                }
                                else
                                {
                                    foreach (var enc in encoders)
                                    {
                                        <span class="badge text-bg-secondary font-monospace">@enc</span>
                                    }
                                }
                            </td>
                            <td style="min-width: 9rem;">
                                @* Object detection plan decision 2: hardware accelerator is a
                                   per-node setting, not per-camera. Auto picks the best of whatever
                                   DetectedAcceleratorsJson (below) reports actually present on this
                                   node; an explicit choice is only honored if that hardware is
                                   actually detected — see NodeWorker/AccelSelection. *@
                                <select name="aiAccelerator" class="form-select form-select-sm">
                                    <option value="" selected="@(n.AiAccelerator is null)">Auto</option>
                                    @foreach (var accel in Enum.GetValues<LarisVMS.Core.Enums.AiAccelerator>().Where(a => a != LarisVMS.Core.Enums.AiAccelerator.Auto))
                                    {
                                        <option value="@accel" selected="@(n.AiAccelerator == accel)">@accel</option>
                                    }
                                </select>
                                @{
                                    var detectedAccelerators = string.IsNullOrEmpty(n.DetectedAcceleratorsJson)
                                        ? []
                                        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(n.DetectedAcceleratorsJson) ?? [];
                                }
                                <div class="mt-1">
                                    @if (detectedAccelerators.Count == 0)
                                    {
                                        <span class="text-muted small" title="No successful accelerator probe reported yet — needs a heartbeat from a node running this build or later.">none reported</span>
                                    }
                                    else
                                    {
                                        foreach (var accel in detectedAccelerators)
                                        {
                                            <span class="badge text-bg-secondary font-monospace">@accel</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td style="min-width: 9rem;">
                                @* Node-scoped override (Detection.ModelFamily/Detection.DFineWeights)
                                   — see NodeConfigResponse.DetectionModelFamily's own doc comment for
                                   why this is per-node, not per-camera. Global default is set on
                                   Admin/Settings/Detection. *@
                                <select name="modelFamilyOverride" class="form-select form-select-sm">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.ModelFamilyOverride.GetValueOrDefault(n.Id)))">
                                        (inherit — currently @Model.EffectiveModelFamily.GetValueOrDefault(n.Id, "Auto"))
                                    </option>
                                    <option value="Auto" selected="@(Model.ModelFamilyOverride.GetValueOrDefault(n.Id) == "Auto")">Auto (YOLOX)</option>
                                    <option value="YoloX" selected="@(Model.ModelFamilyOverride.GetValueOrDefault(n.Id) == "YoloX")">YOLOX</option>
                                    <option value="DFine" selected="@(Model.ModelFamilyOverride.GetValueOrDefault(n.Id) == "DFine")">D-FINE (experimental)</option>
                                    <option value="RfDetr" disabled>RF-DETR (not yet available)</option>
                                </select>
                                @{ var yls = Model.YoloXSizeOverride.GetValueOrDefault(n.Id); }
                                <select name="yoloXSizeOverride" class="form-select form-select-sm mt-1" title="YOLOX model size (only used when the family resolves to YOLOX)">
                                    <option value="" selected="@(string.IsNullOrEmpty(yls))">(inherit YOLOX size)</option>
                                    @foreach (var s in new[] { "Nano", "Tiny", "S", "M", "L", "X" })
                                    {
                                        <option value="@s" selected="@(yls == s)">YOLOX-@s</option>
                                    }
                                </select>
                                <input type="number" name="maxFpsOverride" class="form-control form-control-sm mt-1" min="0" max="60"
                                       placeholder="max fps (inherit)" title="Max detection frames/sec for this node — blank inherits the global setting"
                                       value="@(Model.MaxFpsOverride.GetValueOrDefault(n.Id)?.ToString())" />
                                <select name="dfineWeightsOverride" class="form-select form-select-sm mt-1">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.DFineWeightsOverride.GetValueOrDefault(n.Id)))">(inherit D-FINE weights)</option>
                                    <option value="Obj2Coco" selected="@(Model.DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj2Coco")">Obj2Coco (small)</option>
                                    <option value="Obj2CocoMedium" selected="@(Model.DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj2CocoMedium")">Obj2Coco (medium)</option>
                                    <option value="Obj365" selected="@(Model.DFineWeightsOverride.GetValueOrDefault(n.Id) == "Obj365")">Obj365 (small)</option>
                                </select>
                                @* Detection/hardware-acceleration overhaul, pass 1 — same per-node
                                   override shape as the two selects above. *@
                                <select name="aspectModeOverride" class="form-select form-select-sm mt-1">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.AspectModeOverride.GetValueOrDefault(n.Id)))">
                                        (inherit — currently @Model.EffectiveAspectMode.GetValueOrDefault(n.Id, "Letterbox"))
                                    </option>
                                    <option value="Letterbox" selected="@(Model.AspectModeOverride.GetValueOrDefault(n.Id) == "Letterbox")">Letterbox</option>
                                    <option value="Stretch" selected="@(Model.AspectModeOverride.GetValueOrDefault(n.Id) == "Stretch")">Stretch</option>
                                    <option value="Slice" selected="@(Model.AspectModeOverride.GetValueOrDefault(n.Id) == "Slice")">Slice (requires GPU preprocessing)</option>
                                </select>
                                @* D-FINE TensorRT mode — same per-node override shape. Only acted on
                                   for a D-FINE pipeline on a node with Vision:EnableTensorRt set. *@
                                <select name="dfineTensorRtModeOverride" class="form-select form-select-sm mt-1"
                                        title="How D-FINE uses TensorRT on this node — blank inherits the global setting">
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.DFineTensorRtModeOverride.GetValueOrDefault(n.Id)))">
                                        (inherit D-FINE TensorRT — currently @Model.EffectiveDFineTensorRtMode.GetValueOrDefault(n.Id, "Off"))
                                    </option>
                                    <option value="Off" selected="@(Model.DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "Off")">Off (plain CUDA)</option>
                                    <option value="FP32" selected="@(Model.DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "FP32")">FP32</option>
                                    <option value="FP16" disabled="@(Model.DFineTensorRtModeOverride.GetValueOrDefault(n.Id) != "FP16")" selected="@(Model.DFineTensorRtModeOverride.GetValueOrDefault(n.Id) == "FP16")">FP16 (not yet available)</option>
                                </select>
                            </td>
                            <td data-sort-value="@(n.LastSeenAt?.Ticks ?? 0)">
                                @if (n.LastSeenAt is { } seen)
                                {
                                    <span title="@seen.ToString("u")">@seen.ToLocalTime().ToString("g")</span>
                                }
                                else
                                {
                                    <span class="text-muted">never</span>
                                }
                                @if (n.ClockSkewSeconds is { } skew && Math.Abs(skew) > 60)
                                {
                                    <span class="ms-1" title="This node's own clock disagrees with the server's by about @Math.Round(skew) second(s) (measured @n.ClockSkewMeasuredAt?.ToLocalTime().ToString("g")) — check NTP/time sync on that machine.">⚠️ clock</span>
                                }
                            </td>
                            <td>@Model.CameraCountByNode.GetValueOrDefault(n.Id, 0)</td>
                            <td style="min-width: 16rem;" data-sort-value="@n.StorageRootPath">
                                <input name="StorageRootPath" class="form-control form-control-sm font-monospace"
                                       value="@n.StorageRootPath" placeholder="e.g. E:\LarisVMS\recordings" required
                                       title="Where this node records to. Required — a node with no storage path records nothing." />
                                <input name="archiveRootPath" class="form-control form-control-sm font-monospace mt-1"
                                       value="@n.ArchiveRootPath" placeholder="archive volume (optional)"
                                       title="Optional secondary (SMB / USB) volume for aged-out footage. Must be a separate location from the recording path above." />
                            </td>
                            <td style="min-width: 12rem;" data-sort-value="@((n.StorageTotalBytes is { } t && n.StorageFreeBytes is { } f) ? t - f : -1)">
                                @if (n.StorageTotalBytes is { } total && n.StorageFreeBytes is { } free)
                                {
                                    var usedPercent = total > 0 ? 100.0 * (total - free) / total : 0;
                                    <div class="progress" style="height: 0.5rem;" title="@ByteFormat.Format(total - free) used of @ByteFormat.Format(total)">
                                        <div class="progress-bar @(usedPercent > 90 ? "bg-danger" : usedPercent > 75 ? "bg-warning" : "")"
                                             style="width: @usedPercent.ToString("0.#")%"></div>
                                    </div>
                                    <span class="small text-muted">
                                        @ByteFormat.Format(free) free
                                        @if (Model.DaysRemaining.GetValueOrDefault(n.Id) is { } days)
                                        {
                                            <text>&middot; ~@days.ToString("0") day(s) left</text>
                                        }
                                        else
                                        {
                                            <text>&middot; <span title="Needs about a day of recording history to estimate">runway not yet estimated</span></text>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">no report yet</span>
                                }
                                @if (n.ArchiveTotalBytes is { } aTotal && n.ArchiveFreeBytes is { } aFree)
                                {
                                    var aUsedPercent = aTotal > 0 ? 100.0 * (aTotal - aFree) / aTotal : 0;
                                    <div class="progress mt-1" style="height: 0.5rem;" title="Archive volume: @ByteFormat.Format(aTotal - aFree) used of @ByteFormat.Format(aTotal)">
                                        <div class="progress-bar bg-secondary" style="width: @aUsedPercent.ToString("0.#")%"></div>
                                    </div>
                                    <span class="small text-muted">
                                        archive: @ByteFormat.Format(aFree) free
                                        @if (Model.ArchiveDaysRemaining.GetValueOrDefault(n.Id) is { } aDays)
                                        {
                                            <text>&middot; ~@aDays.ToString("0") day(s) left</text>
                                        }
                                        else
                                        {
                                            <text>&middot; <span title="Needs about a day of archiving activity to estimate">runway not yet estimated</span></text>
                                        }
                                    </span>
                                }
                            </td>
                            <td style="min-width: 8rem;" data-sort-value="@Model.EffectiveRetentionDays.GetValueOrDefault(n.Id, 30)">
                                <input name="RetentionDaysOverride" type="number" min="0" class="form-control form-control-sm"
                                       value="@Model.RetentionOverride.GetValueOrDefault(n.Id)"
                                       placeholder="(global: @Model.EffectiveRetentionDays.GetValueOrDefault(n.Id, 30))" />
                                @{ var archEn = Model.ArchiveEnabledOverride.GetValueOrDefault(n.Id, ""); }
                                <select name="archiveEnabledOverride" class="form-select form-select-sm mt-1"
                                        title="Whether aged-out footage on this node is archived rather than deleted">
                                    <option value="" selected="@(archEn == "")">archive: inherit (@(Model.EffectiveArchiveEnabled.GetValueOrDefault(n.Id) ? "on" : "off"))</option>
                                    <option value="True" selected="@(archEn == "True")">archive: on</option>
                                    <option value="False" selected="@(archEn == "False")">archive: off</option>
                                </select>
                                <input name="archiveRetentionDaysOverride" type="number" min="0" class="form-control form-control-sm mt-1"
                                       value="@Model.ArchiveRetentionOverride.GetValueOrDefault(n.Id)"
                                       placeholder="archive days (global: @Model.EffectiveArchiveRetentionDays.GetValueOrDefault(n.Id, 0))"
                                       title="How long footage stays on the archive volume, from its original record date. 0 = keep forever." />
                            </td>
                            <td style="min-width: 13rem;">
                                @{
                                    var dsm = n.DirectStreamingMode ?? "";
                                    var ins = n.AllowInsecureClientEndpoint;
                                }
                                <select name="directStreamingMode" class="form-select form-select-sm"
                                        title="Where this node's live/playback bytes flow">
                                    <option value="" selected="@(dsm == "")">inherit (@Model.GlobalDirectStreaming)</option>
                                    <option value="Proxy" selected="@(dsm == "Proxy")">Proxy</option>
                                    <option value="Direct" selected="@(dsm == "Direct")">Direct</option>
                                </select>
                                <input name="clientEndpointHost" class="form-control form-control-sm mt-1"
                                       value="@n.ClientEndpointHost" placeholder="client endpoint FQDN" />
                                <input name="clientCertPfxPath" class="form-control form-control-sm mt-1"
                                       value="@n.ClientCertPfxPath" placeholder="cert .pfx path (optional)" />
                                <input name="clientCertPfxPassword" type="password" autocomplete="new-password"
                                       class="form-control form-control-sm mt-1" placeholder="pfx password (unchanged)" />
                                <select name="allowInsecureClientEndpoint" class="form-select form-select-sm mt-1"
                                        title="Allow a self-signed certificate on this node's client endpoint">
                                    <option value="" selected="@(ins is null)">insecure: inherit (@(Model.GlobalAllowInsecureClientEndpoint ? "allow" : "block"))</option>
                                    <option value="true" selected="@(ins == true)">insecure: allow</option>
                                    <option value="false" selected="@(ins == false)">insecure: block</option>
                                </select>
                                @if (Model.AvailableProxies.Count > 0)
                                {
                                    <select name="primaryProxyId" class="form-select form-select-sm mt-1" title="Route this node's cameras through this media proxy">
                                        <option value="" selected="@(n.PrimaryProxyId is null)">no proxy (direct / central)</option>
                                        @foreach (var px in Model.AvailableProxies)
                                        {
                                            <option value="@px.Id" selected="@(n.PrimaryProxyId == px.Id)">via @px.Name</option>
                                        }
                                    </select>
                                    <select name="backupProxyId" class="form-select form-select-sm mt-1" title="Used when the primary proxy is unhealthy">
                                        <option value="" selected="@(n.BackupProxyId is null)">no backup proxy</option>
                                        @foreach (var px in Model.AvailableProxies)
                                        {
                                            <option value="@px.Id" selected="@(n.BackupProxyId == px.Id)">backup: @px.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" name="primaryProxyId" value="@(n.PrimaryProxyId?.ToString() ?? "")" />
                                    <input type="hidden" name="backupProxyId" value="@(n.BackupProxyId?.ToString() ?? "")" />
                                }

                                @* Failover plan phase 3: recording failover. *@
                                @{
                                    var otherNodes = Model.Nodes.Where(x => x.Id != n.Id).ToList();
                                    var backup = n.BackupNodeId is { } bnid ? Model.Nodes.FirstOrDefault(x => x.Id == bnid) : null;
                                    string AccelLabel(LarisVMS.Core.Entities.Node x) =>
                                        x.AiAccelerator?.ToString()
                                        ?? (string.IsNullOrWhiteSpace(x.DetectedAcceleratorsJson) || x.DetectedAcceleratorsJson == "[]" ? "none/CPU" : x.DetectedAcceleratorsJson.Trim('[', ']', '"'));
                                    var hwMismatch = backup is not null && !string.Equals(AccelLabel(backup), AccelLabel(n), StringComparison.OrdinalIgnoreCase);
                                }
                                <select name="backupNodeId" class="form-select form-select-sm mt-1"
                                        title="Recording failover: this node's cameras move here for recording while it is down">
                                    <option value="" selected="@(n.BackupNodeId is null)">no backup node (recording stops if down)</option>
                                    @foreach (var bn in otherNodes)
                                    {
                                        <option value="@bn.Id" selected="@(n.BackupNodeId == bn.Id)">fails over to @bn.Name</option>
                                    }
                                </select>
                                <div class="form-check form-check-sm mt-1">
                                    <input class="form-check-input" type="checkbox" name="disableAiObjectDetection" value="true"
                                           id="recOnly_@n.Id" checked="@n.DisableAiObjectDetection" />
                                    <label class="form-check-label small" for="recOnly_@n.Id"
                                           title="Never run AI object detection on this node — it still records continuously and tags ONVIF events">
                                        recording only (AI detection off)
                                    </label>
                                </div>
                                @if (hwMismatch && backup is not null)
                                {
                                    <div class="small text-warning mt-1" title="During a failover, AI detection and hardware transcoding for this node's cameras may be slower or unavailable on the backup.">
                                        ⚠️ backup @backup.Name has different acceleration (@AccelLabel(n) vs @AccelLabel(backup))
                                    </div>
                                }
                                @if (backup is { DisableAiObjectDetection: true })
                                {
                                    <div class="small text-warning mt-1">⚠️ backup @backup.Name is recording-only — object detection pauses for this node's cameras during a failover</div>
                                }
                                @{
                                    var (fBadge, fText) = n.FailoverState switch
                                    {
                                        LarisVMS.Core.Enums.NodeFailoverState.FailedOverAway when n.FailoverReason == LarisVMS.Core.Enums.NodeFailoverReason.Maintenance
                                            => ("text-bg-warning", "in maintenance — cameras on backup"),
                                        LarisVMS.Core.Enums.NodeFailoverState.FailedOverAway
                                            => ("text-bg-danger", "failed over — cameras on backup"),
                                        LarisVMS.Core.Enums.NodeFailoverState.HostingFailover
                                            => ("text-bg-info", "hosting failover cameras"),
                                        _ => ("", ""),
                                    };
                                }
                                @if (fText.Length > 0)
                                {
                                    <div class="mt-1"><span class="badge @fBadge">@fText</span>
                                        @if (n.FailoverSinceUtc is { } fsince)
                                        {
                                            <span class="text-muted small" title="@fsince.ToString("u")"> since @fsince.ToLocalTime().ToString("g")</span>
                                        }
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    @if (n.ClientEndpointReportedPort is { } cePort)
                                    {
                                        <text>endpoint&nbsp;:@cePort</text>
                                        @if (n.ClientEndpointCertNotAfter is { } na)
                                        {
                                            <text> &middot; cert to @na.ToLocalTime().ToString("d")</text>
                                        }
                                        @if (n.ClientEndpointCertIsSelfSigned == true)
                                        {
                                            <span class="text-warning"> &middot; self-signed</span>
                                        }
                                    }
                                    else
                                    {
                                        <text>no client endpoint running</text>
                                    }
                                    @if (!string.IsNullOrEmpty(n.ClientEndpointLastError))
                                    {
                                        <div class="text-danger" title="@n.ClientEndpointLastError">⚠️ endpoint error</div>
                                    }
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="submit" class="btn btn-sm btn-outline-primary"><span aria-hidden="true">💾</span> Save</button>
                            </td>
                        </form>
                        <td class="text-end text-nowrap">
                            @* Restarts the node's Windows Service only — never the machine it runs on.
                               Confirmed because recording on this node's cameras stops for the few
                               seconds it takes to come back. *@
                            <form method="post" asp-page-handler="Restart" asp-route-id="@n.Id" class="d-inline"
                                  onsubmit="return confirm('Restart the LarisVMS node service on &quot;@n.Name&quot;?\n\nRecording on its @Model.CameraCountByNode.GetValueOrDefault(n.Id) camera(s) will stop for a few seconds. This restarts the service only, not the machine.');">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Restart this node's service (not the machine)"><span aria-hidden="true">🔄</span> Restart</button>
                            </form>
                            @* Failover plan phase 5: clears a wedged rolling check-in nonce (a
                               heartbeat response the node never received). Harmless if the node is
                               healthy — it just re-syncs the nonce on its next cycle. *@
                            <form method="post" asp-page-handler="ResetAuth" asp-route-id="@n.Id" class="d-inline"
                                  onsubmit="return confirm('Reset the check-in nonce for &quot;@n.Name&quot;?\n\nUse this only if the node shows repeated auth failures after a missed heartbeat — it clears the rolling nonce so the node re-syncs on its next check-in. No effect on a healthy node.');">
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Clear this node's rolling check-in nonce (recovery for a locked-out node)"><span aria-hidden="true">🔑</span> Reset auth</button>
                            </form>
                            @* Failover plan phase 3: maintenance mode — fails this node's cameras over
                               to its backup and holds them there until turned off. *@
                            @{
                                var maintCams = Model.CameraCountByNode.GetValueOrDefault(n.Id);
                                var maintBackup = n.BackupNodeId is { } mbid ? Model.Nodes.FirstOrDefault(x => x.Id == mbid)?.Name : null;
                            }
                            <form method="post" asp-page-handler="SetMaintenance" asp-route-id="@n.Id" class="d-inline"
                                  onsubmit="return confirm('@(n.MaintenanceMode
                                      ? "Take this node out of maintenance? Its cameras return to it once it is a confirmed-healthy quorum."
                                      : maintBackup is not null
                                          ? $"Put this node into maintenance? Its {maintCams} camera(s) fail over to node " + maintBackup + $" for recording within about 15 seconds, and will not fail back until you turn maintenance off."
                                          : $"Put this node into maintenance? It has NO backup node - its {maintCams} camera(s) will STOP recording until maintenance is turned off.")');">
                                <input type="hidden" name="enabled" value="@((!n.MaintenanceMode).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn btn-sm @(n.MaintenanceMode ? "btn-warning" : "btn-outline-warning")"
                                        title="@(n.MaintenanceMode ? "End maintenance mode" : "Fail this node's cameras over to its backup for maintenance")">
                                    <span aria-hidden="true">🛠️</span> @(n.MaintenanceMode ? "End maintenance" : "Maintenance")
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@n.Id" class="d-inline"
                                  onsubmit="return confirm('Delete node &quot;@n.Name&quot;? Cameras assigned to it will be unassigned, not deleted. Past recordings are unaffected.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><span aria-hidden="true">🗑️</span> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="nodesTable" class="mt-2"></div>

    <div class="card mt-3" style="max-width: 640px;">
        <div class="card-body py-2">
            <h6 class="card-title mb-1">Streaming relay (since @Model.RelayMetrics.SinceUtc.ToLocalTime().ToString("g"))</h6>
            <p class="card-text small text-muted mb-0">
                Live streams relayed through this server right now: <strong>@Model.RelayMetrics.ActiveLiveRelays</strong>
                (@Model.RelayMetrics.LiveRelaysStarted total) &middot;
                playback segments proxied: <strong>@Model.RelayMetrics.PlaybackSegmentsProxied</strong>
                (@ByteFormat.Format(Model.RelayMetrics.PlaybackBytesProxied)).
                With <a asp-page="/Admin/Settings/LiveView">direct streaming</a> on, these trend toward zero.
            </p>
        </div>
    </div>

    <p class="text-muted small mt-3">
        Every node records to its own storage path (there is no global default) — usually set when the
        node is installed (<code>install-node.ps1 -StorageRoot …</code>), editable here. The archive
        volume is optional and must be a separate location. A node with no storage path records
        nothing until one is set.
        Blank retention inherits the <a asp-page="/Admin/Settings/StorageAndRetention">global default</a>; a value here
        overrides it for every camera on this node unless that camera has its own override too. "Days
        left" is a rough estimate from this node's write rate over the last 24h, not disk health. The
        ⚠️ count next to a node's status is how many cameras have footage still sitting on this node
        after being reassigned elsewhere or removed — hover it for which cameras and when each one's
        leftover footage ages out of retention (which is what clears the warning on its own, with
        nothing to do here) — see <a asp-page="/Cameras/Index">Cameras</a> for which ones.
    </p>
}
