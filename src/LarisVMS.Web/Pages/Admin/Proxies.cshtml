@page
@model LarisVMS.Web.Pages.Admin.ProxiesModel
@{
    ViewData["Title"] = L["admin.proxies.mediaProxies"].Value;
    var serverOrigin = $"{Request.Scheme}://{Request.Host}";
    var regKey = string.IsNullOrEmpty(Model.RegistrationKey) ? "<set one on Admin - Settings - Nodes>" : Model.RegistrationKey;
}

<h1>@L["admin.proxies.mediaProxies"]</h1>
<p class="text-muted small">@L.Html("admin.proxies.intro")</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="card mb-3" style="max-width: 60rem;">
    <div class="card-body py-2 small">
        @L.Html("admin.proxies.installIntro")
        <div class="d-flex align-items-start gap-2 mb-0 mt-1">
            <pre id="proxyInstallCmd" class="mb-0 flex-grow-1">.\install-proxy.ps1 -ServerUrl @serverOrigin -RegistrationKey @regKey -ClientPort 4443 [-ClientPfxPath C:\certs\proxy.pfx -ClientPfxPassword ...]</pre>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" title="@L["admin.proxies.copyCommand"]"
                    data-copy-from="#proxyInstallCmd">📋</button>
        </div>
        @L.Html("admin.proxies.installAfter")
    </div>
</div>

@if (Model.Proxies.Count == 0)
{
    <p class="text-muted">@L["admin.proxies.noProxiesHaveRegisteredYet"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["common.name"]</th>
                    <th>@L["admin.proxies.health"]</th>
                    <th>@L["admin.proxies.routableHost"]</th>
                    <th>@L["common.port"]</th>
                    <th>@L["admin.proxies.certificate"]</th>
                    <th>@L["nav.nodes"]</th>
                    <th>@L["common.version"]</th>
                    <th>@L["common.enabled"]</th>
                    <th data-no-sort></th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Proxies)
                {
                    var stale = p.LastSeenAt is null || p.LastSeenAt < DateTime.UtcNow.AddMinutes(-2);
                    var ins = p.AllowInsecure;
                    <tr>
                        <form method="post" asp-page-handler="Update" asp-route-id="@p.Id">
                            <td style="min-width: 9rem;"><input name="name" class="form-control form-control-sm" value="@p.Name" required /></td>
                            <td>
                                @if (!p.Enabled)
                                {
                                    <span class="badge text-bg-secondary">@L["admin.proxies.disabled"]</span>
                                }
                                else if (p.Healthy)
                                {
                                    <span class="badge text-bg-success">@L["admin.proxies.healthy"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger" title="@p.LastError">@L["admin.proxies.unhealthy"]</span>
                                }
                                @if (stale)
                                {
                                    <div class="text-muted small" title="@L["admin.proxies.noCheckInInThe"]">@L["admin.proxies.notCheckingIn"]</div>
                                }
                            </td>
                            <td style="min-width: 10rem;"><input name="host" class="form-control form-control-sm" value="@p.Host" placeholder="@L["admin.proxies.proxyFqdn"]" required /></td>
                            <td style="width: 6rem;"><input name="port" type="number" min="1" max="65535" class="form-control form-control-sm" value="@(p.Port == 0 ? "" : p.Port.ToString())" placeholder="@(p.ReportedPort?.ToString() ?? "4443")" /></td>
                            <td style="min-width: 15rem;">
                                <input name="certPfxPath" class="form-control form-control-sm" value="@p.CertPfxPath" placeholder="@L["admin.proxies.certPfxPathOptional"]" />
                                <input name="certPfxPassword" type="password" autocomplete="new-password" class="form-control form-control-sm mt-1" placeholder="@L["admin.proxies.pfxPasswordUnchanged"]" />
                                <select name="allowInsecure" class="form-select form-select-sm mt-1">
                                    <option value="" selected="@(ins is null)">@L["admin.proxies.insecureInheritGlobal"]</option>
                                    <option value="true" selected="@(ins == true)">@L["admin.proxies.insecureAllow"]</option>
                                    <option value="false" selected="@(ins == false)">@L["admin.proxies.insecureBlock"]</option>
                                </select>
                                <div class="small text-muted mt-1">
                                    @if (p.ReportedPort is { } rp)
                                    {
                                        <text>@L["admin.proxies.serving", new { port = rp }]</text>
                                        @if (p.CertNotAfter is { } na)
                                        {
                                            <text> &middot; @L.Html("admin.proxies.certTo", new { time = na.ToTimeTag("d") })</text>
                                        }
                                        @if (p.CertIsSelfSigned == true)
                                        {
                                            <span class="text-warning"> @L["admin.proxies.selfSigned"]</span>
                                        }
                                    }
                                    else
                                    {
                                        <text>@L["admin.proxies.endpointNotReportedYet"]</text>
                                    }
                                </div>
                            </td>
                            <td class="text-center">@Model.AssignedNodeCount.GetValueOrDefault(p.Id)</td>
                            <td>@p.Version</td>
                            <td class="text-center"><input type="checkbox" name="enabled" value="true" checked="@p.Enabled" /></td>
                            <td class="text-end"><button type="submit" class="btn btn-sm btn-outline-primary"><span aria-hidden="true">💾</span> @L["common.save"]</button></td>
                        </form>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                                  data-confirm="@L["admin.proxies.removeConfirm", new { name = p.Name }]">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><span aria-hidden="true">🗑️</span> @L["common.delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
