@page
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Admin.NodeBuilds.IndexModel
@{
    ViewData["Title"] = "Node Builds";
}
<h1>Recorder node &amp; media proxy builds</h1>
<p class="text-muted">
    Every <code>deploy.ps1</code> run that builds a new recorder-node version registers it here as
    <strong>Pending</strong> (and, with <code>-BuildProxy</code>, the media proxy build too — its
    <strong>Platform</strong> is <code>proxy-win-x64</code>). Approve one to make it the version every
    recorder node or media proxy whose reported version is older downloads, verifies, and applies on
    its own next check-in — no more manually re-running <code>build-node.ps1</code> /
    <code>install-node.ps1</code> (or <code>build-proxy.ps1</code> / <code>install-proxy.ps1</code>)
    on each machine.
    A build with a ✅ under <strong>Vision</strong> also carries a matching
    <code>LarisVMS.Vision.Service.exe</code>, applied alongside the node exe in the same update —
    but only on a node that already has AI detection installed; a node's first-ever Vision Service
    install still needs one <code>install-node.ps1</code> run (its native DLLs and exported model
    aren't things this download/swap path delivers, only the exe itself). Controlled globally by the
    <a asp-page="/Admin/Settings/Nodes">node auto-update setting</a>.
</p>
<p class="text-muted small">
    ⚠️ The Vision binary here is one hardware accelerator variant, whatever <code>build-node.ps1</code>
    was run with (<code>-Accel</code>, CPU by default) — there's no per-node selection. If this fleet's
    recorder nodes have genuinely mixed hardware (some GPU-capable, some not), approving a
    GPU-built row would push it to every already-Vision-equipped node regardless of what it can
    actually run; a node that can't load it simply has AI detection fail to start (logged, retried —
    recording itself is completely unaffected). For a mixed fleet, manage the Vision Service binary on
    those specific machines by hand instead (<code>install-node.ps1 -Accel &lt;...&gt;</code>).
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@{
    var pending = Model.Builds.Where(b => b.Status == NodeBuildStatus.Pending).ToList();
    var decided = Model.Builds.Where(b => b.Status != NodeBuildStatus.Pending).ToList();
}

<h2 class="h5">Pending approval</h2>
@if (pending.Count == 0)
{
    <p class="text-muted">Nothing waiting on approval. Run <code>deploy.ps1</code> to register a new build.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Platform</th>
                    <th>Registered</th>
                    <th data-sort-numeric>Size</th>
                    <th>SHA-256</th>
                    <th>Vision</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in pending)
                {
                    <tr>
                        <td>@b.Version</td>
                        <td>@b.Platform</td>
                        <td><span title="@b.UploadedAt.ToString("u")">@b.UploadedAt.ToLocalTime().ToString("g")</span></td>
                        <td>@ByteFormat.Format(b.SizeBytes)</td>
                        <td class="font-monospace small">@b.Sha256[..12]&hellip;</td>
                        <td>@(b.VisionFilePath is not null ? "✅" : "—")</td>
                        <td>@b.Notes</td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@b.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@b.Id" class="d-inline"
                                  onclick="return confirm('Reject build @b.Version? It stays listed below for the record, but no node will ever be offered it.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5">History</h2>
@if (decided.Count == 0)
{
    <p class="text-muted">No approved or rejected builds yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Platform</th>
                    <th>Registered</th>
                    <th data-sort-numeric>Size</th>
                    <th>SHA-256</th>
                    <th>Status</th>
                    <th>By</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in decided)
                {
                    <tr>
                        <td>@b.Version</td>
                        <td>@b.Platform</td>
                        <td><span title="@b.UploadedAt.ToString("u")">@b.UploadedAt.ToLocalTime().ToString("g")</span></td>
                        <td>@ByteFormat.Format(b.SizeBytes)</td>
                        <td class="font-monospace small">@b.Sha256[..12]&hellip;</td>
                        <td>@(b.VisionFilePath is not null ? "✅" : "—")</td>
                        <td>
                            @if (b.Status == NodeBuildStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Rejected</span>
                            }
                        </td>
                        <td>@b.ApprovedBy</td>
                        <td>@b.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        The newest Approved build per platform (by registration time) is what a node's next heartbeat
        compares against.
    </p>
}
