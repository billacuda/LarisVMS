@page
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Admin.NodeBuilds.IndexModel
@{
    ViewData["Title"] = "Node Builds";
}
<h1>Recorder node &amp; media proxy builds</h1>
<p class="text-muted small">
    New node and proxy builds wait here. Only the newest build of each kind is offered for approval; older
    ones move to History as superseded. Approving one updates every older node on its next check-in.
    A node's first AI detection install still needs <code>install-node.ps1</code>. <a href="/Help/nodes#updates">Learn more</a>
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@{
    var pending = Model.Builds.Where(b => b.Status == NodeBuildStatus.Pending).ToList();
    var decided = Model.Builds.Where(b => b.Status != NodeBuildStatus.Pending).ToList();
}

<h2 class="h5">Pending approval</h2>
@if (pending.Count == 0)
{
    <p class="text-muted">Nothing waiting on approval. Run <code>deploy.ps1</code> to register a new build.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Platform</th>
                    <th>Registered</th>
                    <th data-sort-numeric>Size</th>
                    <th>SHA-256</th>
                    <th>Vision</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in pending)
                {
                    <tr>
                        <td>@b.Version</td>
                        <td>@b.Platform</td>
                        <td><span title="@b.UploadedAt.ToString("u")">@b.UploadedAt.ToLocalTime().ToString("g")</span></td>
                        <td>@ByteFormat.Format(b.SizeBytes)</td>
                        <td class="font-monospace small">@b.Sha256[..12]&hellip;</td>
                        <td>@(b.VisionFilePath is not null ? "✅" : "—")</td>
                        <td>@b.Notes</td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@b.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@b.Id" class="d-inline"
                                  onclick="return confirm('Reject build @b.Version? It stays listed below for the record, but no node will ever be offered it.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5">History</h2>
@if (decided.Count == 0)
{
    <p class="text-muted">No approved, rejected or superseded builds yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Platform</th>
                    <th>Registered</th>
                    <th data-sort-numeric>Size</th>
                    <th>SHA-256</th>
                    <th>Vision</th>
                    <th>Status</th>
                    <th>By</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in decided)
                {
                    <tr>
                        <td>@b.Version</td>
                        <td>@b.Platform</td>
                        <td><span title="@b.UploadedAt.ToString("u")">@b.UploadedAt.ToLocalTime().ToString("g")</span></td>
                        <td>@ByteFormat.Format(b.SizeBytes)</td>
                        <td class="font-monospace small">@b.Sha256[..12]&hellip;</td>
                        <td>@(b.VisionFilePath is not null ? "✅" : "—")</td>
                        <td>
                            @switch (b.Status)
                            {
                                case NodeBuildStatus.Approved:
                                    <span class="badge bg-success">Approved</span>
                                    break;
                                case NodeBuildStatus.Superseded:
                                    <span class="badge bg-light text-dark border" title="A newer build was registered or approved before this one was">Superseded</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Rejected</span>
                                    break;
                            }
                        </td>
                        <td>@b.ApprovedBy</td>
                        <td>@b.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        The newest Approved build per platform (by registration time) is what a node's next heartbeat
        compares against.
    </p>
}
