@using Microsoft.EntityFrameworkCore
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Data
@inject ApplicationDbContext LayoutDb
@inject IBrandingService BrandingService
@inject IPermissionService PermissionService
@{
    // Every field is already validated by the service (see Branding.Normalize*), which is what makes
    // interpolating the colors/font into the style block below safe.
    var branding = await BrandingService.GetAsync();
    var pageTitle = branding.AppName;
    string? _version = null;
    try
    {
        var latest = await LayoutDb.AppVersions
            .OrderByDescending(v => v.Major).ThenByDescending(v => v.Minor).ThenByDescending(v => v.Patch)
            .FirstOrDefaultAsync();
        _version = latest?.ToVersionString();
    }
    catch { /* pre-setup: no schema yet */ }

    // Which nav buttons this user can actually use — one call, at most one DB round trip regardless
    // of how many buttons below check it (see PermissionService.GetGrantedAsync's own doc comment).
    // This renders on every single page in the app, including the anonymous Login page, so a naive
    // per-button IAuthorizationService.AuthorizeAsync call (itself several DB round trips each, see
    // PermissionService.HasPermissionAsync) would have meant dozens of extra queries on every request.
    var nav = await PermissionService.GetGrantedAsync(User);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    // Each button's check matches the [Authorize] on the page it links to exactly — see the comment
    // beside each <li> below for which page's policy it mirrors. A button is only ever hidden, never
    // disabled: a user who can't act on a page shouldn't see a dead link inviting them to try.
    var showLive = nav.Has("Cameras", "View");
    var showPlayback = nav.Has("Playback", "View");
    var showExports = nav.Has("Exports", "View");
    var showBookmarks = nav.Has("Playback", "View");
    var showSnapshots = nav.Has("Playback", "View");
    var showViews = nav.Has("Views", "View");
    var showCameras = nav.Has("Cameras", "View");
    var showNodes = nav.Has("Nodes", "Edit");
    // Either tab's own gate — Pages/Logs/Index always redirects to Audit Logs first, but a user
    // holding only SystemLogs.View can still reach System Logs directly, so the button must not
    // disappear just because they lack the *other* tab's permission.
    var showLogs = nav.Has("Logs", "View") || nav.Has("SystemLogs", "View");
    // Same reasoning for Settings: seven of its eight tabs are gated by Settings.Edit and only
    // Backups by its own Backups.Edit, so "can reach something behind this button" is the OR of both,
    // not just whichever tab happens to be first (Backups, alphabetically).
    var showSettings = nav.Has("Settings", "Edit") || nav.Has("Backups", "Edit");
    var showPlugins = nav.Has("Plugins", "View");
    var showAlerts = nav.Has("Alerts", "Edit");
    var showApiKeys = nav.Has("ApiKeys", "Edit");
    // An empty dropdown toggle with nothing inside it is worse than no dropdown at all.
    var showAdminDropdown = showSettings || showPlugins || showAlerts || showApiKeys;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @pageTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (branding.PrimaryColor is not null || branding.AccentColor is not null || branding.FontStack is not null)
    {
        <style>
            @if (branding.PrimaryColor is { } primary)
            {
                @Html.Raw($":root {{ --bs-primary: {primary}; --bs-link-color: {primary}; }}")
                @Html.Raw($".btn-primary {{ --bs-btn-bg: {primary}; --bs-btn-border-color: {primary}; }}")
            }
            @* Accent drives the one place a second brand color reads as deliberate rather than
               decorative: the navbar. Left alone when unset, so the default dark navbar stands. *@
            @if (branding.AccentColor is { } accent)
            {
                @Html.Raw($"#mainNav {{ background-color: {accent} !important; }}")
            }
            @if (branding.FontStack is { } fontStack)
            {
                @Html.Raw($"body {{ font-family: {fontStack}; }}")
            }
        </style>
    }
    <script>
        // Anti-flash: applies the stored theme (or the system preference, when unset — 'auto' is
        // the default) before first paint.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3" id="mainNav">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                @if (branding.LogoDataUri is { } logo)
                {
                    @* Height-capped so any uploaded aspect ratio fits the navbar without resizing it;
                       alt is empty because the brand name sits right beside it — announcing both
                       would just repeat the same thing to a screen reader. *@
                    <img src="@logo" alt="" style="max-height: 28px; width: auto;" />
                }
                <span>@pageTitle</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            @* Emoji, not an icon font: this app has no icon library and already uses bare emoji as
               its de facto icon system (🟢/🔴 camera state, ⚠️ warnings, 🌙/☀️ theme). aria-hidden on
               each one so a screen reader announces "Live", not "satellite antenna Live".
               Every item below is permission-gated — see the `show*` booleans computed above — so an
               anonymous visitor (the Login page uses this same layout) or a Viewer-role user sees
               only what they can actually do something with, not a wall of dead links. *@
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @* Bare [Authorize] — any authenticated user, no specific resource/action. *@
                    @if (isAuthenticated)
                    {
                        <li class="nav-item"><a class="nav-link" href="/"><span aria-hidden="true">🏠︎</span> Dashboard</a></li>
                    }
                    @* Live/Index requires Cameras.View, same as the Cameras list below. *@
                    @if (showLive)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Live"><span aria-hidden="true">📡</span> Live</a></li>
                    }
                    @if (showPlayback)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Playback"><span aria-hidden="true">▶️</span> Playback</a></li>
                    }
                    @if (showExports)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Exports"><span aria-hidden="true">🎬</span> Exports</a></li>
                    }
                    @if (showBookmarks)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Bookmarks"><span aria-hidden="true">🔖</span> Bookmarks</a></li>
                    }
                    @if (showSnapshots)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Snapshots"><span aria-hidden="true">📸</span> Snapshots</a></li>
                    }
                    @if (showViews)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Views"><span aria-hidden="true">🖼️</span> Views</a></li>
                    }
                    @if (showCameras)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Cameras"><span aria-hidden="true">📷</span> Cameras</a></li>
                    }
                    @* Its own top-level button, promoted out of the Admin dropdown — fleet monitoring
                       is something an operator checks routinely, not an occasional administrative
                       task, and it's gated by Nodes.Edit same as before (Admin/Nodes.cshtml.cs's own
                       comment explains why this page uses one combined Edit permission rather than
                       splitting View/Edit the way most other resources don't either). *@
                    @if (showNodes)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Admin/Nodes"><span aria-hidden="true">🔗</span> Nodes</a></li>
                    }
                    @* Its own top-level button rather than another item buried in the Admin dropdown
                       — logs are something everyone with access checks routinely, not an occasional
                       administrative task, and the dropdown was getting crowded (nine items) with
                       several pages nobody could find without already knowing they existed. Branding,
                       Event Colors, Backups, and the standalone Settings page moved into Settings'
                       own tabs instead of shrinking this list by only one. *@
                    @if (showLogs)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Logs"><span aria-hidden="true">📜</span> Logs</a></li>
                    }
                    @if (showAdminDropdown)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="adminNavDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false"><span aria-hidden="true">⚙️</span> Admin</a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminNavDropdown">
                                @if (showSettings)
                                {
                                    <li><a class="dropdown-item" href="/Admin/Settings">Settings</a></li>
                                }
                                @if (showPlugins)
                                {
                                    <li><a class="dropdown-item" href="/Admin/Plugins">Plugins</a></li>
                                }
                                @if (showAlerts)
                                {
                                    <li><a class="dropdown-item" href="/Admin/Alerts">Alerts</a></li>
                                }
                                @if (showApiKeys)
                                {
                                    <li><a class="dropdown-item" href="/Admin/ApiKeys">API Keys</a></li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav me-2">
                    <li class="nav-item">
                        <button class="btn btn-sm btn-outline-light" id="themeToggle" type="button"
                                onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme"><span id="themeIcon" aria-hidden="true">🌙</span></button>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main role="main" class="container-fluid px-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4 py-2">
            &copy; @DateTime.UtcNow.Year @pageTitle @(_version is not null ? $"v{_version}" : "")
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @* Loaded before anything that reads/writes a user preference, including theme.js and
       table-pagination.js right below it. *@
    <script src="~/js/user-preferences.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/sortable-table.js" asp-append-version="true"></script>
    <script src="~/js/list-filter.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/column-picker.js" asp-append-version="true"></script>
    @* Inert on any page without a form[data-remember-filters], so it costs nothing to load globally
       rather than adding a Scripts section to each filter page that wants it. *@
    <script src="~/js/remember-filters.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
