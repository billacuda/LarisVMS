@using Microsoft.EntityFrameworkCore
@using LarisVMS.Infrastructure.Data
@inject ApplicationDbContext LayoutDb
@inject IConfiguration Configuration
@{
    var appName = Configuration["Branding:AppName"];
    var primaryColor = Configuration["Branding:PrimaryColor"];
    var pageTitle = string.IsNullOrWhiteSpace(appName) ? "LarisVMS" : appName;
    string? _version = null;
    try
    {
        var latest = await LayoutDb.AppVersions
            .OrderByDescending(v => v.Major).ThenByDescending(v => v.Minor).ThenByDescending(v => v.Patch)
            .FirstOrDefaultAsync();
        _version = latest?.ToVersionString();
    }
    catch { /* pre-setup: no schema yet */ }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @pageTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(primaryColor))
    {
        <style>
            :root { --bs-primary: @primaryColor; }
            .btn-primary { --bs-btn-bg: @primaryColor; --bs-btn-border-color: @primaryColor; }
        </style>
    }
    <script>
        // Anti-flash: applies the stored theme (or the system preference, when unset — 'auto' is
        // the default) before first paint.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3" id="mainNav">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">@pageTitle</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Live">Live</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Playback">Playback</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Exports">Exports</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Views">Views</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Cameras">Cameras</a></li>
                    @* One dropdown for every admin-only page, not flat top-level links per page — Node
                       Builds previously had no nav entry of its own at all (only reachable via a
                       help-text link from Nodes/Settings), which is exactly the "can't find it"
                       pattern this groups against for every admin page added after this one too. *@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="adminNavDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminNavDropdown">
                            <li><a class="dropdown-item" href="/Admin/Nodes">Nodes</a></li>
                            <li><a class="dropdown-item" href="/Admin/NodeBuilds">Node Builds</a></li>
                            <li><a class="dropdown-item" href="/Admin/Settings">Settings</a></li>
                            <li><a class="dropdown-item" href="/Admin/Logs">Audit Log</a></li>
                            <li><a class="dropdown-item" href="/Admin/Backup">Backups</a></li>
                            <li><a class="dropdown-item" href="/Admin/SystemLogs">System Logs</a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="navbar-nav me-2">
                    <li class="nav-item">
                        <button class="btn btn-sm btn-outline-light" id="themeToggle" type="button"
                                onclick="toggleTheme()" title="Toggle theme"><span id="themeIcon">🌙</span></button>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main role="main" class="container-fluid px-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4 py-2">
            &copy; @DateTime.UtcNow.Year LarisVMS @(_version is not null ? $"v{_version}" : "")
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/sortable-table.js" asp-append-version="true"></script>
    <script src="~/js/list-filter.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
