@using Microsoft.EntityFrameworkCore
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Data
@inject ApplicationDbContext LayoutDb
@inject IBrandingService BrandingService
@{
    // Every field is already validated by the service (see Branding.Normalize*), which is what makes
    // interpolating the colors/font into the style block below safe.
    var branding = await BrandingService.GetAsync();
    var pageTitle = branding.AppName;
    string? _version = null;
    try
    {
        var latest = await LayoutDb.AppVersions
            .OrderByDescending(v => v.Major).ThenByDescending(v => v.Minor).ThenByDescending(v => v.Patch)
            .FirstOrDefaultAsync();
        _version = latest?.ToVersionString();
    }
    catch { /* pre-setup: no schema yet */ }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @pageTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (branding.PrimaryColor is not null || branding.AccentColor is not null || branding.FontStack is not null)
    {
        <style>
            @if (branding.PrimaryColor is { } primary)
            {
                @Html.Raw($":root {{ --bs-primary: {primary}; --bs-link-color: {primary}; }}")
                @Html.Raw($".btn-primary {{ --bs-btn-bg: {primary}; --bs-btn-border-color: {primary}; }}")
            }
            @* Accent drives the one place a second brand color reads as deliberate rather than
               decorative: the navbar. Left alone when unset, so the default dark navbar stands. *@
            @if (branding.AccentColor is { } accent)
            {
                @Html.Raw($"#mainNav {{ background-color: {accent} !important; }}")
            }
            @if (branding.FontStack is { } fontStack)
            {
                @Html.Raw($"body {{ font-family: {fontStack}; }}")
            }
        </style>
    }
    <script>
        // Anti-flash: applies the stored theme (or the system preference, when unset — 'auto' is
        // the default) before first paint.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3" id="mainNav">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                @if (branding.LogoDataUri is { } logo)
                {
                    @* Height-capped so any uploaded aspect ratio fits the navbar without resizing it;
                       alt is empty because the brand name sits right beside it — announcing both
                       would just repeat the same thing to a screen reader. *@
                    <img src="@logo" alt="" style="max-height: 28px; width: auto;" />
                }
                <span>@pageTitle</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            @* Emoji, not an icon font: this app has no icon library and already uses bare emoji as
               its de facto icon system (🟢/🔴 camera state, ⚠️ warnings, 🌙/☀️ theme). aria-hidden on
               each one so a screen reader announces "Live", not "satellite antenna Live". *@
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><span aria-hidden="true">📊</span> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Live"><span aria-hidden="true">📡</span> Live</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Playback"><span aria-hidden="true">▶️</span> Playback</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Exports"><span aria-hidden="true">🎬</span> Exports</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Views"><span aria-hidden="true">🔲</span> Views</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Cameras"><span aria-hidden="true">📷</span> Cameras</a></li>
                    @* One dropdown for every admin-only page, not flat top-level links per page — Node
                       Builds previously had no nav entry of its own at all (only reachable via a
                       help-text link from Nodes/Settings), which is exactly the "can't find it"
                       pattern this groups against for every admin page added after this one too. *@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="adminNavDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false"><span aria-hidden="true">⚙️</span> Admin</a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminNavDropdown">
                            <li><a class="dropdown-item" href="/Admin/Nodes">Nodes</a></li>
                            <li><a class="dropdown-item" href="/Admin/NodeBuilds">Node Builds</a></li>
                            <li><a class="dropdown-item" href="/Admin/Settings">Settings</a></li>
                            <li><a class="dropdown-item" href="/Admin/Branding">Branding</a></li>
                            <li><a class="dropdown-item" href="/Admin/EventColors">Event Colors</a></li>
                            <li><a class="dropdown-item" href="/Admin/Logs">Audit Log</a></li>
                            <li><a class="dropdown-item" href="/Admin/Backup">Backups</a></li>
                            <li><a class="dropdown-item" href="/Admin/SystemLogs">System Logs</a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="navbar-nav me-2">
                    <li class="nav-item">
                        <button class="btn btn-sm btn-outline-light" id="themeToggle" type="button"
                                onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme"><span id="themeIcon" aria-hidden="true">🌙</span></button>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main role="main" class="container-fluid px-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4 py-2">
            &copy; @DateTime.UtcNow.Year @pageTitle @(_version is not null ? $"v{_version}" : "")
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/sortable-table.js" asp-append-version="true"></script>
    <script src="~/js/list-filter.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
