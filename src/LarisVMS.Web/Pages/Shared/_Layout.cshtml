@using Microsoft.EntityFrameworkCore
@using LarisVMS.Core.Interfaces
@using LarisVMS.Infrastructure.Data
@inject ApplicationDbContext LayoutDb
@inject IBrandingService BrandingService
@inject IPermissionService PermissionService
@{
    // Every field is already validated by the service (see Branding.Normalize*), which is what makes
    // interpolating the colors/font into the style block below safe.
    var branding = await BrandingService.GetAsync();
    var pageTitle = branding.AppName;
    string? _version = null;
    try
    {
        var latest = await LayoutDb.AppVersions
            .OrderByDescending(v => v.Major).ThenByDescending(v => v.Minor).ThenByDescending(v => v.Patch)
            .FirstOrDefaultAsync();
        _version = latest?.ToVersionString();
    }
    catch { /* pre-setup: no schema yet */ }

    // Which nav buttons this user can actually use — one call, at most one DB round trip regardless
    // of how many buttons below check it (see PermissionService.GetGrantedAsync's own doc comment).
    // This renders on every single page in the app, including the anonymous Login page, so a naive
    // per-button IAuthorizationService.AuthorizeAsync call (itself several DB round trips each, see
    // PermissionService.HasPermissionAsync) would have meant dozens of extra queries on every request.
    var nav = await PermissionService.GetGrantedAsync(User);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    // Each button's check matches the [Authorize] on the page it links to exactly — see the comment
    // beside each nav item below for which page's policy it mirrors. A button is only ever hidden,
    // never disabled: a user who can't act on a page shouldn't see a dead link inviting them to try.
    var showLive = nav.Has("Cameras", "View");
    var showPlayback = nav.Has("Playback", "View");
    var showExports = nav.Has("Exports", "View");
    var showBookmarks = nav.Has("Playback", "View");
    var showSnapshots = nav.Has("Playback", "View");
    var showViews = nav.Has("Views", "View");
    var showCameras = nav.Has("Cameras", "View");
    var showNodes = nav.Has("Nodes", "Edit");
    // Either tab's own gate — Pages/Logs/Index always redirects to Audit Logs first, but a user
    // holding only SystemLogs.View can still reach System Logs directly, so the button must not
    // disappear just because they lack the *other* tab's permission.
    var showLogs = nav.Has("Logs", "View") || nav.Has("SystemLogs", "View");
    // Same reasoning for Settings: seven of its eight tabs are gated by Settings.Edit and only
    // Backups by its own Backups.Edit, so "can reach something behind this button" is the OR of both,
    // not just whichever tab happens to be first (Backups, alphabetically).
    var showSettings = nav.Has("Settings", "Edit") || nav.Has("Backups", "Edit");
    var showPlugins = nav.Has("Plugins", "View");
    var showAlerts = nav.Has("Alerts", "Edit");
    var showApiKeys = nav.Has("ApiKeys", "Edit");
    // The sidebar's single "Settings" item replaces the old navbar dropdown; Nodes/Logs/Plugins/
    // Alerts/API keys move from top-level nav buttons into cards on that hub page (Pages/Admin/
    // Settings/Index.cshtml) instead, so this is now "can reach the hub at all", not "expand a
    // dropdown of buttons" — same OR of every gate the hub could show a card for.
    var showSettingsHub = showSettings || showPlugins || showAlerts || showApiKeys || showNodes || showLogs;

    // Sidebar active-item state — the old top navbar never marked a current page, but a persistent
    // sidebar reads as broken without one telling you where you are.
    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string prefix) => prefix == "/"
        ? currentPath == "/"
        : currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @* PWA: manifest (Program.cs /manifest.webmanifest) + icons make the site installable on phones. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] - @pageTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (branding.PrimaryColor is not null || branding.AccentColor is not null || branding.FontStack is not null)
    {
        <style>
            @* --lv-accent is what the sidebar's active item, buttons, links, and every other themed
               control in theme.css actually read — --bs-primary/--bs-link-color are kept in step
               alongside it for any plain Bootstrap component that still reads them directly (see
               theme.css's own comment on which components do). *@
            @if (branding.PrimaryColor is { } primary)
            {
                @Html.Raw($":root {{ --lv-accent: {primary}; --bs-primary: {primary}; --bs-link-color: {primary}; }}")
                @Html.Raw($".btn-primary {{ --bs-btn-bg: {primary}; --bs-btn-border-color: {primary}; }}")
            }
            @* Accent drives the one place a second brand color reads as deliberate rather than
               decorative: previously the whole dark navbar, now just the sidebar's brand/logo strip
               — NOT the whole .lv-side surface, which must keep following --lv-surface so the
               sidebar still turns light/dark with the rest of the app. A fixed, always-on brand
               color is fine for a small logo header (many apps keep that constant across themes);
               it broke the toggle when it covered the entire sidebar instead. Left alone when unset,
               so the default light/dark brand strip stands. *@
            @if (branding.AccentColor is { } accent)
            {
                @* White brand text matches this field's original contract from the old dark navbar
                   (its nav-link text was always white, so an admin already picked a color that reads
                   well with white — same assumption carried over, just scoped to this smaller strip
                   instead of computing contrast against an arbitrary chosen color). *@
                @Html.Raw($".lv-brand {{ background-color: {accent} !important; }} .lv-brand-text, .lv-brand-sub {{ color: #fff !important; }}")
            }
            @if (branding.FontStack is { } fontStack)
            {
                @Html.Raw($"body {{ font-family: {fontStack}; }}")
            }
        </style>
    }
    <script>
        // Anti-flash: applies the stored theme (or the system preference, when unset — 'auto' is
        // the default) before first paint.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="lv-shell">
        @* Emoji, not an icon font: this app has no icon library and already uses bare emoji as its
           de facto icon system (🟢/🔴 camera state, ⚠️ warnings, 🌙/☀️ theme). aria-hidden on each one
           so a screen reader announces "Live", not "satellite antenna Live".
           Every item below is permission-gated — see the `show*` booleans computed above — so an
           anonymous visitor (the Login page uses this same layout) or a Viewer-role user sees only
           what they can actually do something with, not a wall of dead links.
           `offcanvas-lg` (Bootstrap's responsive offcanvas) is what makes this a permanent sidebar
           at desktop widths and an overlay drawer, toggled by the topbar's hamburger button, below
           lg — a plain collapse there pushed in beside the page and squeezed it on a phone.
           Bootstrap's own offcanvas plugin (already loaded) drives both, no new JS. *@
        <aside class="lv-side offcanvas-lg offcanvas-start" id="lvSidebar" tabindex="-1" aria-label="Navigation">
            <div class="lv-brand">
                @if (branding.LogoDataUri is { } logo)
                {
                    <img src="@logo" alt="" />
                }
                <div>
                    <div class="lv-brand-text">@pageTitle</div>
                    <div class="lv-brand-sub">Video Management</div>
                </div>
                <button type="button" class="btn-close d-lg-none ms-auto" data-bs-dismiss="offcanvas"
                        data-bs-target="#lvSidebar" aria-label="Close navigation"></button>
            </div>
            <nav class="lv-nav">
                @* Bare [Authorize] — any authenticated user, no specific resource/action. *@
                @if (isAuthenticated)
                {
                    <a class="lv-navitem@(IsActive("/") ? " active" : "")" href="/"><span aria-hidden="true">🏠︎</span> Dashboard</a>
                }
                @* Live/Index requires Cameras.View, same as the Cameras list below. *@
                @if (showLive)
                {
                    <a class="lv-navitem@(IsActive("/Live") ? " active" : "")" href="/Live"><span aria-hidden="true">📡</span> Live</a>
                }
                @if (showPlayback)
                {
                    <a class="lv-navitem@(IsActive("/Playback") ? " active" : "")" href="/Playback"><span aria-hidden="true">▶️</span> Playback</a>
                }
                @if (showExports)
                {
                    <a class="lv-navitem@(IsActive("/Exports") ? " active" : "")" href="/Exports"><span aria-hidden="true">🎬</span> Exports</a>
                }
                @if (showBookmarks)
                {
                    <a class="lv-navitem@(IsActive("/Bookmarks") ? " active" : "")" href="/Bookmarks"><span aria-hidden="true">🔖</span> Bookmarks</a>
                }
                @if (showSnapshots)
                {
                    <a class="lv-navitem@(IsActive("/Snapshots") ? " active" : "")" href="/Snapshots"><span aria-hidden="true">📸</span> Snapshots</a>
                }
                @if (showViews)
                {
                    <a class="lv-navitem@(IsActive("/Views") ? " active" : "")" href="/Views"><span aria-hidden="true">🖼️</span> Views</a>
                }
                @if (showCameras)
                {
                    <a class="lv-navitem@(IsActive("/Cameras") ? " active" : "")" href="/Cameras"><span aria-hidden="true">📷</span> Cameras</a>
                }
                @* Single "Settings" item replaces the old Admin dropdown + top-level Nodes/Logs
                   buttons — see Pages/Admin/Settings/Index.cshtml, which links out to every
                   permission-gated destination those used to. *@
                @if (showSettingsHub)
                {
                    <a class="lv-navitem@(IsActive("/Admin/Settings") ? " active" : "")" href="/Admin/Settings"><span aria-hidden="true">⚙️</span> Settings</a>
                }
                @if (isAuthenticated)
                {
                    <a class="lv-navitem@(IsActive("/Help") ? " active" : "")" href="/Help"><span aria-hidden="true">❓</span> Help</a>
                }
            </nav>
            <div class="lv-side-foot">
                &copy; @DateTime.UtcNow.Year @pageTitle @(_version is not null ? $"v{_version}" : "")
            </div>
        </aside>

        <div class="lv-main">
            <div class="lv-topbar" id="lvTopbar">
                <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#lvSidebar" aria-controls="lvSidebar" aria-label="Open navigation">
                    <span aria-hidden="true">☰</span>
                </button>
                <div class="lv-topbar-right ms-auto">
                    <button class="lv-darktoggle" id="themeToggle" type="button"
                            onclick="toggleTheme()" title="Toggle theme" aria-label="Toggle theme"><span id="themeIcon" aria-hidden="true">🌙</span></button>
                    <partial name="_LoginPartial" />
                </div>
            </div>

            <main role="main" class="lv-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @* Loaded before anything that reads/writes a user preference, including theme.js and
       table-pagination.js right below it. *@
    <script src="~/js/user-preferences.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/sortable-table.js" asp-append-version="true"></script>
    <script src="~/js/list-filter.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/column-picker.js" asp-append-version="true"></script>
    @* Inert on any page without a form[data-remember-filters], so it costs nothing to load globally
       rather than adding a Scripts section to each filter page that wants it. *@
    <script src="~/js/remember-filters.js" asp-append-version="true"></script>
    @* Same again — inert with no button[data-secret-toggle] on the page. *@
    <script src="~/js/secret-reveal.js" asp-append-version="true"></script>
    @* Inert on pages without [data-show-when] / form[data-dirty-guard]. *@
    <script src="~/js/conditional-fields.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
