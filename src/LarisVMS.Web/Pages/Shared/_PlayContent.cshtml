@* Shared between Views/Play.cshtml and Live/Index.cshtml — see PlayViewModelBuilder's own doc
   comment for why. asp-page below is deliberately absolute (/Views/Index, not "Index") since this
   partial's own "current page" isn't fixed to one route. *@
@using LarisVMS.Web.Helpers
@model LarisVMS.Web.Pages.Views.PlayViewModel
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2" id="viewPlayToolbar">
    <h1 class="mb-0 h4">@Model.Name</h1>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.Views.Count > 0 && Model.Tree is { } tree)
        {
            @* The same view tree as the Views page, open-only: Private, each role's folder, and roles'
               views an admin let this person open. Camera count in each label, so switching is a
               choice between "House (6)" and "Yard (2)" rather than between two bare names. Closed
               on an outside click or Escape by view-play.js (wireViewTreePicker). *@
            <details class="d-inline-block position-relative" id="viewTreePickerDetails">
                <summary class="btn btn-sm btn-outline-secondary" style="list-style:none; cursor:pointer;"
                         title="@L["playContent.switchViewNow"]" aria-label="@L["playContent.switchViewNow"]">
                    <span aria-hidden="true">▦</span> @L["playContent.views"] ▾
                </summary>
                <nav class="position-absolute end-0 mt-1 p-2 bg-body border rounded shadow small"
                     style="z-index:1000; width:20rem; max-width:calc(100vw - 24px); max-height:28rem; overflow-y:auto;"
                     aria-label="@L["playContent.switchViewNow"]">
                    <ul class="vt-list vt-top">
                        @foreach (var root in tree.Trees.Where(t => t.Views.Count > 0))
                        {
                            <li class="vt-root">
                                <div class="vt-row">
                                    <span aria-hidden="true">@(root.Kind == "private" ? "🔒" : "👥")</span>
                                    <span class="vt-name">@root.Name</span>
                                </div>
                                @{ PickerLevel(root, null); }
                            </li>
                        }
                    </ul>
                </nav>
            </details>
        }
        @* Watch one camera directly, no saved View needed — explicit user ask. A <select> can't hold
           a filter box, so this is a <details> popover instead, same convention _ColumnPicker.cshtml
           already establishes for "small filterable list in a dropdown" on this app's other pages.
           Populated/filtered/wired by view-play.js's wireCameraPicker, from the same Model.Cameras
           feed (already CameraAccess-narrowed) the player itself consumes — nothing here can offer a
           camera the viewer isn't already allowed to watch. *@
        @if (Model.Cameras.Count > 0)
        {
            <details class="d-inline-block position-relative" id="cameraPickerDetails">
                <summary class="btn btn-sm btn-outline-secondary" style="list-style:none; cursor:pointer;">
                    <span aria-hidden="true">📷</span> @L["common.camera"]
                </summary>
                <div class="position-absolute end-0 mt-1 p-2 bg-body border rounded shadow"
                     style="z-index:1000; width:16rem; max-width:calc(100vw - 24px); max-height:20rem; overflow-y:auto;">
                    <input type="search" class="form-control form-control-sm mb-2" id="cameraPickerFilter"
                           placeholder="@L["playContent.filterCameras"]" aria-label="@L["playContent.filterCameras2"]" autocomplete="off" />
                    <div id="cameraPickerList" class="list-group list-group-flush"></div>
                </div>
            </details>
        }
        @* AI detection bounding-box overlay (live-view.js's startDetectionOverlay) — a pure
           client-side toggle, all off by default: nothing is drawn and no /detections WebSocket
           is opened for any tile until Moving or Idle is switched on. Confidence only decorates
           boxes that are already being drawn, so it is disabled while both of those are off, and
           Path (each moving object's travel path) needs Moving — see wireDetectionToggles for those
           dependencies. All four persist per user (server-backed preferences, not localStorage) so
           they survive a refresh and a sign-in elsewhere. *@
        <div class="d-flex flex-wrap align-items-center gap-3 small" id="detectionToggleGroup" title="@L["playContent.aiDetectionBoxes"]">
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowMoving">
                <label class="form-check-label" for="detectionShowMoving">@L["playContent.moving"]</label>
            </div>
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowIdle">
                <label class="form-check-label" for="detectionShowIdle">@L["playContent.idle"]</label>
            </div>
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowConfidence" disabled>
                <label class="form-check-label" for="detectionShowConfidence">@L["playContent.confidence"]</label>
            </div>
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowSpeed" disabled checked>
                <label class="form-check-label" for="detectionShowSpeed">@L["playContent.speed"]</label>
            </div>
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowColor" disabled checked>
                <label class="form-check-label" for="detectionShowColor">@L["playContent.color"]</label>
            </div>
            <div class="form-check form-switch form-check-inline mb-0 me-0">
                <input class="form-check-input" type="checkbox" role="switch" id="detectionShowPath" disabled>
                <label class="form-check-label" for="detectionShowPath">@L["common.path"]</label>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="kioskBtn" title="@L["playContent.toggleFullscreenKioskMode"]">@L["playContent.fullscreen"]</button>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Views/Index">@L["playContent.backToViews"]</a>
    </div>
</div>

<div id="viewPlayGrid"></div>

@functions {
    // One level of a view tree in the view picker: folders that hold a view somewhere below, then
    // views, each linking to it (the current one marked).
    void PickerLevel(LarisVMS.Core.Interfaces.ViewTreeRootDto root, Guid? parentId)
    {
        var folders = root.Folders.Where(f => f.ParentId == parentId && HasViews(root, f.Id)).ToList();
        var views = root.Views.Where(v => v.FolderId == parentId).ToList();
        if (folders.Count == 0 && views.Count == 0) return;
        <ul class="vt-list">
            @foreach (var f in folders)
            {
                <li>
                    <div class="vt-row"><span aria-hidden="true">📁</span> <span class="vt-name">@f.Name</span></div>
                    @{ PickerLevel(root, f.Id); }
                </li>
            }
            @foreach (var v in views)
            {
                <li>
                    <a class="vt-row" href="/Views/Play/@v.Id" aria-current="@(v.Id == Model.CurrentViewId ? "page" : null)">
                        <span aria-hidden="true">▦</span> @L["views.nameWithCells", new { name = v.Name, cells = v.Cells }]
                    </a>
                </li>
            }
        </ul>
    }

    static bool HasViews(LarisVMS.Core.Interfaces.ViewTreeRootDto root, Guid folderId) =>
        root.Views.Any(v => v.FolderId == folderId)
        || root.Folders.Any(f => f.ParentId == folderId && HasViews(root, f.Id));
}
