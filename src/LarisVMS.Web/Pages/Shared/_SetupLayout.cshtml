@inject LocaleCatalog LocaleCatalog
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@LanguageChoices.Lang" dir="@LanguageChoices.Dir" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <script nonce="@Csp.Value">
        // Back/forward must never land on ERR_CACHE_MISS / "Confirm form resubmission". A page
        // rendered as the response to a form POST (a settings page after Save, a form redisplayed
        // with an error) is a POST entry in the browser's history; replacing the entry with its own
        // URL turns it into a plain GET entry, so returning to it just reloads the page. Harmless on
        // a page that came from a GET. Keeps the current state and #hash.
        try { history.replaceState(history.state, '', location.href); } catch (e) { /* not fatal */ }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @* PWA: manifest (Program.cs /manifest.webmanifest) + icons make the site installable on phones. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] - @L["setup.title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/@LanguageChoices.BootstrapCss" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script nonce="@Csp.Value">
        // Anti-flash: same mechanism as Pages/Shared/_Layout.cshtml — applies the stored theme (or
        // the system preference, when unset) before first paint, so Setup follows a preference set
        // once the rest of the app is reachable instead of always rendering light.
        (function () {
            var t = localStorage.getItem('larisvms.theme');
            if (t === 'dark' || t === 'light') {
                document.documentElement.setAttribute('data-bs-theme', t);
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>
    <script src="/locales/@(LanguageChoices.Lang).js?v=@LocaleCatalog.Version"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/inline-actions.js" asp-append-version="true"></script>
    <script src="~/js/form-errors.js" asp-append-version="true"></script>
</head>
<body class="bg-body-tertiary">
    <div class="position-absolute top-0 end-0 m-3 d-flex gap-2">
        <partial name="_LanguagePicker" />
        <button class="lv-darktoggle" id="themeToggle" type="button"
                data-action="toggle-theme" title="@L["layout.toggleTheme"]" aria-label="@L["layout.toggleTheme"]"><span id="themeIcon" aria-hidden="true">🌙</span></button>
    </div>
    <div class="container" style="max-width: 640px; margin-top: 4rem;">
        <h1 class="mb-4 text-center">@L["setup.title"]</h1>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/user-preferences.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
</body>
</html>
