@page
@model LarisVMS.Web.Pages.Cameras.IndexModel
@{
    ViewData["Title"] = "Cameras";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Cameras</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-page="Groups">Groups</a>
        <a class="btn btn-primary" asp-page="Discover">Discover</a>
        <a class="btn btn-primary" asp-page="Edit">Add manually</a>
    </div>
</div>

@if (Model.Cameras.Count == 0)
{
    <p class="text-muted">No cameras yet. Use <a asp-page="Discover">Discover</a> to scan the LAN, or add one manually.</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="camerasTable"
                   placeholder="Filter by name, host, group, node&hellip;" />
        </div>
        <div class="col-sm-auto d-flex align-items-center gap-2">
            <label class="form-label small mb-0" for="camerasPageSize">Rows per page</label>
            <select id="camerasPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="camerasTable">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
        </div>
        <div class="col-sm-auto ms-sm-auto">
            <partial name="_ColumnPicker" model="@("camerasTable")" />
        </div>
    </div>

    @* This form has no visible fields of its own — the node <select>, the Reassign button, and
       every row's checkbox below all point at it via the HTML5 form="bulkReassignForm"
       attribute instead of DOM nesting, since the table already has its own per-row forms
       (ToggleEnabled, Probe) and nested <form> elements are invalid HTML with unpredictable
       submit behavior. *@
    <form method="post" asp-page-handler="Reassign" id="bulkReassignForm"></form>

    <div class="d-flex align-items-center gap-2 mb-2">
        <select name="nodeId" form="bulkReassignForm" class="form-select form-select-sm" style="max-width: 16rem;">
            <option value="">(unassign)</option>
            @foreach (var n in Model.Nodes)
            {
                <option value="@n.Id">@n.Name</option>
            }
        </select>
        <button type="submit" form="bulkReassignForm" class="btn btn-sm btn-outline-primary" id="bulkReassignBtn" disabled>
            Reassign selected to node
        </button>
        <span id="bulkSelectedCount" class="text-muted small"></span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle" id="camerasTable" data-sortable data-paginate data-column-picker>
            <thead>
                <tr>
                    <th data-no-sort><input type="checkbox" class="form-check-input" id="selectAllCameras" /></th>
                    <th data-no-sort>Status</th>
                    <th>Name</th>
                    <th data-col="host">Host</th>
                    <th data-no-sort data-col="https">HTTPS</th>
                    <th data-col="group">Group</th>
                    <th data-col="node">Node</th>
                    <th data-col="model">Manufacturer / Model</th>
                    <th data-col="profiles">Profiles</th>
                    <th data-col="capabilities">Capabilities</th>
                    <th data-sort-numeric data-col="streams">Streams</th>
                    <th data-sort-numeric data-col="storage">Storage used</th>
                    <th data-sort-numeric data-col="retention">Retention</th>
                    <th data-col="probed">Last probed</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cameras)
                {
                    var staleNodeIds = Model.StaleSegmentNodeIds.GetValueOrDefault(c.Id);
                    <tr>
                        <td><input type="checkbox" class="form-check-input camera-select" name="ids" form="bulkReassignForm" value="@c.Id" /></td>
                        <td>
                            <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@c.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-link p-0 border-0 text-decoration-none" style="font-size: 1.1rem; line-height: 1;"
                                        title="@(c.IsEnabled ? "Enabled — click to disable" : "Disabled — click to enable")">
                                    @(c.IsEnabled ? "🟢" : "🔴")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@c.Id">@c.Name</a>
                            @if (c.VideoSourceToken is { } channelToken)
                            {
                                <span class="ms-1" title="One lens of a multi-sensor device (video source @channelToken) — its other channels are separate cameras in this list">🔀</span>
                            }
                            @if (LarisVMS.Core.CameraIntegrations.ByKey(c.IntegrationKey) is { } integration)
                            {
                                <span class="ms-1" title="@integration.DisplayName — this camera uses a vendor integration alongside ONVIF">🧩</span>
                            }
                            @if (staleNodeIds is { Count: > 0 })
                            {
                                var staleNames = string.Join(", ", staleNodeIds.Select(id => Model.Nodes.FirstOrDefault(n => n.Id == id)?.Name ?? "a deleted node"));
                                <span class="ms-1" title="Has recordings still on @staleNames — no longer this camera's assigned node">⚠️</span>
                            }
                        </td>
                        <td>@c.Host</td>
                        <td>
                            @* DeviceServiceUri is stored with its scheme (http:// or https://) —
                               AddAsync/UpdateAsync both validate it as an absolute URI before saving,
                               so parsing it back out here is safe rather than tracking a second,
                               separately-settable "use HTTPS" flag that could drift from what the
                               URL itself actually says. *@
                            @if (Uri.TryCreate(c.DeviceServiceUri, UriKind.Absolute, out var deviceUri) && deviceUri.Scheme == Uri.UriSchemeHttps)
                            {
                                <span title="This camera's device service URL uses HTTPS">🔒</span>
                            }
                        </td>
                        <td>@(c.Group?.Name ?? "—")</td>
                        <td>
                            @if (c.Node is { } node)
                            {
                                <a asp-page="/Admin/Nodes">@node.Name</a>
                            }
                            else
                            {
                                <span class="text-muted" title="No node assigned — this camera won't record">unassigned</span>
                            }
                        </td>
                        <td>@c.Manufacturer @c.Model</td>
                        <td>
                            @if (c.Capabilities is { } cap)
                            {
                                if (cap.ProfileS) { <span class="badge text-bg-primary me-1">S</span> }
                                if (cap.ProfileT) { <span class="badge text-bg-primary me-1">T</span> }
                                if (cap.ProfileG) { <span class="badge text-bg-primary me-1">G</span> }
                                if (cap.ProfileM) { <span class="badge text-bg-primary me-1">M</span> }
                            }
                            else
                            {
                                <span class="text-muted">not probed</span>
                            }
                        </td>
                        <td>
                            @if (c.Capabilities is { } cap2)
                            {
                                if (cap2.HasPtz) { <span class="badge text-bg-light border me-1" title="PTZ">PTZ</span> }
                                if (cap2.HasAudioOut) { <span class="badge text-bg-light border me-1" title="Two-way audio">Talk</span> }
                                if (cap2.HasAnalyticsMetadata) { <span class="badge text-bg-light border me-1" title="Analytics metadata">Meta</span> }
                                if (cap2.HasRelayOutputs || cap2.HasDigitalInputs) { <span class="badge text-bg-light border me-1" title="Relay / digital I/O">I/O</span> }
                            }
                        </td>
                        <td>@c.Streams.Count</td>
                        <td data-sort-value="@Model.StorageUsedBytes.GetValueOrDefault(c.Id)">
                            @ByteFormat.Format(Model.StorageUsedBytes.GetValueOrDefault(c.Id))
                            @if (c.QuotaBytes is { } quota)
                            {
                                <span class="text-muted">/ @ByteFormat.Format(quota)</span>
                            }
                        </td>
                        <td data-sort-value="@Model.EffectiveRetentionDays.GetValueOrDefault(c.Id, 30)">@Model.EffectiveRetentionDays.GetValueOrDefault(c.Id, 30) day(s)</td>
                        <td data-sort-value="@(c.LastProbedAt?.Ticks ?? 0)">
                            @if (c.LastProbedAt is { } probed)
                            {
                                <span title="@probed.ToString("u")">@probed.ToLocalTime().ToString("g")</span>
                            }
                            else
                            {
                                <span class="text-muted">never</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="Zones" asp-route-id="@c.Id">Zones</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="EventTags" asp-route-id="@c.Id">Event tags</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="Schedule" asp-route-id="@c.Id">Schedule</a>
                            <form method="post" asp-page-handler="Probe" asp-route-id="@c.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><span aria-hidden="true">🔍</span> Re-probe</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div data-paginate-controls-for="camerasTable" class="mt-2"></div>
}

@section Scripts {
    <script>
        (function () {
            var selectAll = document.getElementById('selectAllCameras');
            var reassignBtn = document.getElementById('bulkReassignBtn');
            var countLabel = document.getElementById('bulkSelectedCount');
            var reassignForm = document.getElementById('bulkReassignForm');
            if (!selectAll || !reassignBtn || !reassignForm) return;

            function checkboxes() {
                return Array.prototype.slice.call(document.querySelectorAll('.camera-select'));
            }

            function updateBulkState() {
                var checked = checkboxes().filter(function (cb) { return cb.checked; });
                reassignBtn.disabled = checked.length === 0;
                countLabel.textContent = checked.length > 0 ? checked.length + ' selected' : '';
            }

            selectAll.addEventListener('change', function () {
                checkboxes().forEach(function (cb) { cb.checked = selectAll.checked; });
                updateBulkState();
            });

            document.addEventListener('change', function (e) {
                if (e.target.classList && e.target.classList.contains('camera-select')) updateBulkState();
            });

            reassignForm.addEventListener('submit', function (e) {
                if (checkboxes().filter(function (cb) { return cb.checked; }).length === 0) e.preventDefault();
            });
        })();
    </script>
}
