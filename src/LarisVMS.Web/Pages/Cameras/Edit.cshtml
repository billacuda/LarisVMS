@page "{id:guid?}"
@model LarisVMS.Web.Pages.Cameras.EditModel
@using LarisVMS.Core.Entities
@{
    ViewData["Title"] = Model.IsNew ? "Add camera" : "Edit camera";
    var hasOnvifEvents = Model.Capabilities?.HasEvents ?? false;
    // data-show-when for the inherit ("") option: only known when the camera has no override of its
    // own — EffectiveRecordingMode includes this camera's override.
    string ModeShowWhen(params string[] modes) =>
        "RecordingModeOverride=" + string.Join(",", modes)
        + (string.IsNullOrEmpty(Model.RecordingModeOverride) && modes.Contains(Model.EffectiveRecordingMode) ? "," : "");
}
<div class="lv-page-narrow">
<nav aria-label="breadcrumb" class="small mb-1"><a href="/Cameras">&larr; Cameras</a></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@(Model.IsNew ? "Add camera" : Model.Name)</h1>
    @if (!Model.IsNew)
    {
        <div class="btn-group">
            <a class="btn btn-outline-secondary" asp-page="Zones" asp-route-id="@Model.Id">Zones</a>
            <a class="btn btn-outline-secondary" href="/Cameras/EventTags/@Model.Id">Event tags</a>
            <a class="btn btn-outline-secondary" asp-page="Schedule" asp-route-id="@Model.Id">Schedule</a>
            <button type="submit" form="cameraForm" asp-page-handler="Probe" class="btn btn-outline-secondary"
                    title="Re-read this camera's capabilities and streams"><span aria-hidden="true">🔍</span> Re-probe</button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ProbeMessage))
{
    <div class="alert alert-info">@Model.ProbeMessage</div>
}

@* Only ever offered right after a probe, which is the one thing that reports the device's channel
   list. A camera already pinned to a channel shows what it covers instead of re-offering the split. *@
@if (!Model.IsNew && Model.DetectedChannelCount > 1 && Model.VideoSourceToken is null)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <div class="flex-grow-1">
            <strong>This device has @Model.DetectedChannelCount channels.</strong>
            Split it into one camera per lens so each records the right one. This camera becomes channel 1 and keeps its recordings.
            <a href="/Help/cameras#multi-channel">Learn more</a>
        </div>
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" asp-page-handler="SplitChannels" class="btn btn-warning"
                    onclick="return confirm('Add one camera per channel on this device?');">
                <span aria-hidden="true">🔀</span> Split into @Model.DetectedChannelCount cameras
            </button>
        </form>
    </div>
}

<form method="post" id="cameraForm" data-dirty-guard>
    <input type="hidden" asp-for="Id" />

    <section class="lv-section">
        <div class="lv-section-head"><h2 class="lv-section-title">General</h2></div>
        <div class="lv-section-body">
            <div class="lv-field">
                <label class="form-label" asp-for="Name">Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            @if (!Model.IsNew)
            {
                <div class="lv-field">
                    <label class="form-label">Status</label>
                    <div class="form-check mt-1">
                        <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="IsEnabled">Enabled</label>
                    </div>
                    <div class="lv-hint">Disabled cameras don't record or stream.</div>
                </div>
                <div class="lv-field lv-field-wide">
                    <label class="form-label">Groups</label>
                    <div>
                        @if (Model.CurrentGroups.Count == 0)
                        {
                            <span class="text-muted small">Not in any group.</span>
                        }
                        @foreach (var g in Model.CurrentGroups)
                        {
                            <span class="badge text-bg-secondary me-1">@g.Name</span>
                        }
                        <a class="small ms-1" href="/Cameras/Groups">Manage groups</a>
                    </div>
                </div>
            }
            @if (Model.VideoSourceToken is { } channelToken)
            {
                <div class="lv-field lv-field-wide">
                    <div class="lv-hint">🔀 One channel of a multi-sensor device (video source <code>@channelToken</code>). Its other channels are separate cameras.</div>
                </div>
            }
        </div>
    </section>

    <section class="lv-section">
        <div class="lv-section-head"><h2 class="lv-section-title">Connection</h2></div>
        <div class="lv-section-body">
            <div class="lv-field lv-field-wide">
                <label class="form-label" asp-for="DeviceServiceUri">Device service URL</label>
                <input asp-for="DeviceServiceUri" class="form-control font-monospace" placeholder="http://192.168.1.50/onvif/device_service" required />
                @if (!Model.IsNew)
                {
                    <div class="lv-hint">Changing the address re-probes the camera on save.</div>
                }
            </div>
            <div class="lv-field">
                <label class="form-label" asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" autocomplete="off" />
            </div>
            <div class="lv-field">
                <label class="form-label" asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password"
                       placeholder="@(Model.IsNew ? "" : "(unchanged)")" />
                @if (!Model.IsNew)
                {
                    <div class="lv-hint">Leave blank to keep the current password.</div>
                }
            </div>
            <div class="lv-field">
                <label class="form-label" asp-for="NodeId">Recorder node</label>
                <select asp-for="NodeId" class="form-select">
                    <option value="">(unassigned — won't record)</option>
                    @foreach (var n in Model.Nodes)
                    {
                        <option value="@n.Id">@n.Name</option>
                    }
                </select>
                @if (Model.Nodes.Count == 0)
                {
                    <div class="lv-hint">No nodes have registered yet. See <a href="/Help/installation">Installation</a>.</div>
                }
            </div>
        </div>
    </section>

    @if (!Model.IsNew)
    {
        <section class="lv-section">
            <div class="lv-section-head">
                <h2 class="lv-section-title">Recording</h2>
                <div class="lv-section-sub">Blank fields inherit from the node or global settings.</div>
            </div>
            <div class="lv-section-body">
                <div class="lv-field">
                    <label class="form-label" asp-for="RecordingModeOverride">Recording mode</label>
                    <select asp-for="RecordingModeOverride" class="form-select">
                        <option value="">inherit — @Model.EffectiveRecordingMode</option>
                        <option value="Continuous">Continuous</option>
                        <option value="Motion">Motion only</option>
                        <option value="Schedule">Schedule</option>
                        <option value="Event">Event (tagged trigger)</option>
                    </select>
                    <div class="lv-hint">Which footage is kept. <a href="/Help/recording#modes">Learn more</a></div>
                </div>
                <div class="lv-field">
                    <label class="form-label" asp-for="SegmentSecondsOverride">Segment length (seconds)</label>
                    <input asp-for="SegmentSecondsOverride" type="number" min="5" max="300" class="form-control"
                           placeholder="inherit — @Model.EffectiveSegmentSeconds" />
                    <div class="lv-hint">Shorter means faster playback seeking. Changing it briefly restarts recording.</div>
                </div>
                @if (!Model.HasServerMotionZone && !hasOnvifEvents)
                {
                    <div class="lv-field lv-field-wide" data-show-when="@ModeShowWhen("Motion")">
                        <div class="alert alert-warning py-2 mb-0 small">
                            No motion zone or camera motion events yet, so Motion mode keeps everything.
                            <a asp-page="Zones" asp-route-id="@Model.Id">Add a zone</a>
                        </div>
                    </div>
                }
                @if (!Model.HasScheduleWindow)
                {
                    <div class="lv-field lv-field-wide" data-show-when="@ModeShowWhen("Schedule")">
                        <div class="alert alert-warning py-2 mb-0 small">
                            No schedule window yet, so Schedule mode keeps everything.
                            <a asp-page="Schedule" asp-route-id="@Model.Id">Add a schedule</a>
                        </div>
                    </div>
                }
                @if (!Model.HasDrivingEventRule)
                {
                    <div class="lv-field lv-field-wide" data-show-when="@ModeShowWhen("Event")">
                        <div class="alert alert-warning py-2 mb-0 small">
                            No event tag rule drives recording yet, so Event mode keeps everything.
                            <a href="/Cameras/EventTags/@Model.Id">Add a rule</a>
                        </div>
                    </div>
                }
                <div class="lv-field" data-show-when="@ModeShowWhen("Motion", "Event")">
                    <label class="form-label" asp-for="MotionPreRollSecondsOverride">Pre-roll (seconds)</label>
                    <input asp-for="MotionPreRollSecondsOverride" type="number" min="0" class="form-control"
                           placeholder="inherit — @Model.EffectiveMotionPreRollSeconds" />
                    <div class="lv-hint">Footage kept before activity starts.</div>
                </div>
                <div class="lv-field" data-show-when="@ModeShowWhen("Motion", "Event")">
                    <label class="form-label" asp-for="MotionPostRollSecondsOverride">Post-roll (seconds)</label>
                    <input asp-for="MotionPostRollSecondsOverride" type="number" min="0" class="form-control"
                           placeholder="inherit — @Model.EffectiveMotionPostRollSeconds" />
                    <div class="lv-hint">Footage kept after activity stops.</div>
                </div>
            </div>
        </section>

        <section class="lv-section">
            <div class="lv-section-head"><h2 class="lv-section-title">Storage &amp; retention</h2></div>
            <div class="lv-section-body">
                <div class="lv-field">
                    <label class="form-label" asp-for="QuotaGb">Storage quota (GB)</label>
                    <input asp-for="QuotaGb" type="number" step="0.1" min="0" class="form-control" placeholder="no quota" />
                    <div class="lv-hint">Using @ByteFormat.Format(Model.StorageUsedBytes). Oldest footage goes first when over.</div>
                </div>
                <div class="lv-field">
                    <label class="form-label" asp-for="RetentionDaysOverride">Retention (days)</label>
                    <input asp-for="RetentionDaysOverride" type="number" min="0" class="form-control"
                           placeholder="inherit — @Model.EffectiveRetentionDays" />
                    <div class="lv-hint">0 keeps forever.</div>
                </div>
                <div class="lv-field">
                    <label class="form-label" asp-for="ArchiveRetentionDaysOverride">Archive retention (days)</label>
                    <input asp-for="ArchiveRetentionDaysOverride" type="number" min="0" class="form-control"
                           placeholder="inherit — @Model.EffectiveArchiveRetentionDays" />
                    <div class="lv-hint">
                        Archiving is @(Model.EffectiveArchiveEnabled ? "on" : "off") for this camera. 0 keeps forever.
                        <a href="/Help/storage#archive">Learn more</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="lv-section">
            <div class="lv-section-head">
                <h2 class="lv-section-title">AI detection</h2>
                <div class="lv-section-sub">Unchecked “Override” inherits from AI detection settings.</div>
            </div>
            <div class="lv-section-body">
                <div class="lv-field lv-field-wide">
                    <div class="form-check">
                        <input asp-for="AiDetectionEnabled" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fw-semibold" asp-for="AiDetectionEnabled">Watch this camera for objects</label>
                    </div>
                    <div class="lv-hint">The accelerator is chosen per node. <a href="/Help/ai-detection">Learn more</a></div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" asp-for="AiDetectionStreamRoleOverride">Detection stream</label>
                    <select asp-for="AiDetectionStreamRoleOverride" class="form-select">
                        <option value="">inherit — @Model.EffectiveAiDetectionStreamRole</option>
                        <option value="Sub">Sub</option>
                        <option value="Main">Main</option>
                    </select>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" asp-for="AiDetectionOrientationOverride">Orientation</label>
                    <select asp-for="AiDetectionOrientationOverride" class="form-select">
                        <option value="">inherit — @Model.EffectiveAiDetectionOrientation</option>
                        <option value="Auto">Auto</option>
                        <option value="Landscape">Landscape</option>
                        <option value="Portrait">Portrait</option>
                    </select>
                    <div class="lv-hint">Use Portrait for corridor-mode cameras.</div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" for="confidenceOverrideSlider">Confidence threshold</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" class="form-check-input" id="confidenceOverrideToggle" checked="@(Model.ConfidenceOverride.HasValue)" />
                            <label class="form-check-label small" for="confidenceOverrideToggle">Override</label>
                        </div>
                        <input type="range" name="ConfidenceOverride" id="confidenceOverrideSlider" min="0" max="1" step="0.05" class="form-range"
                               value="@((Model.ConfidenceOverride ?? Model.EffectiveConfidence).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                               disabled="@(!Model.ConfidenceOverride.HasValue)" />
                        <output class="text-muted small" style="min-width: 2.5em;" id="confidenceOverrideReadout">@Math.Round((Model.ConfidenceOverride ?? Model.EffectiveConfidence) * 100)</output>
                    </div>
                    <div class="lv-hint">Raise it for a camera with false detections.</div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" for="iouOverrideSlider">IoU threshold</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" class="form-check-input" id="iouOverrideToggle" checked="@(Model.IouOverride.HasValue)" />
                            <label class="form-check-label small" for="iouOverrideToggle">Override</label>
                        </div>
                        <input type="range" name="IouOverride" id="iouOverrideSlider" min="0" max="1" step="0.05" class="form-range"
                               value="@((Model.IouOverride ?? Model.EffectiveIou).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                               disabled="@(!Model.IouOverride.HasValue)" />
                        <output class="text-muted small" style="min-width: 2.5em;" id="iouOverrideReadout">@Math.Round((Model.IouOverride ?? Model.EffectiveIou) * 100)</output>
                    </div>
                    <div class="lv-hint">Overlap for merging duplicate boxes.</div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" for="maxFpsOverrideSlider">Detection frame rate (fps)</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" class="form-check-input" id="maxFpsOverrideToggle" checked="@(Model.MaxFpsOverride.HasValue)" />
                            <label class="form-check-label small" for="maxFpsOverrideToggle">Override</label>
                        </div>
                        <input type="range" name="MaxFpsOverride" id="maxFpsOverrideSlider" min="0" max="30" step="1" class="form-range"
                               value="@(Model.MaxFpsOverride ?? Model.EffectiveMaxFps)"
                               disabled="@(!Model.MaxFpsOverride.HasValue)" />
                        @{ var maxFpsShown = Model.MaxFpsOverride ?? Model.EffectiveMaxFps; }
                        <output class="text-muted small" style="min-width: 3.5em;" id="maxFpsOverrideReadout">@(maxFpsShown == 0 ? "no cap" : maxFpsShown.ToString())</output>
                    </div>
                    <div class="lv-hint">Lower saves GPU/CPU. 0 is no cap.</div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" asp-for="RejectMotionJitterOverride">Stationary-object jitter rejection</label>
                    <select asp-for="RejectMotionJitterOverride" class="form-select">
                        <option value="">inherit — @(Model.EffectiveRejectMotionJitter ? "on" : "off")</option>
                        <option value="True">On</option>
                        <option value="False">Off</option>
                    </select>
                    <div class="lv-hint">Stops parked cars' box wobble counting as motion. <a href="/Help/ai-detection#jitter">Learn more</a></div>
                </div>
                <div class="lv-field" data-show-when="AiDetectionEnabled=true">
                    <label class="form-label" for="jitterPixelsOverrideSlider">Jitter threshold (pixels)</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-check-inline mb-0">
                            <input type="checkbox" class="form-check-input" id="jitterPixelsOverrideToggle" checked="@(Model.MotionJitterPixelsOverride.HasValue)" />
                            <label class="form-check-label small" for="jitterPixelsOverrideToggle">Override</label>
                        </div>
                        <input type="range" name="MotionJitterPixelsOverride" id="jitterPixelsOverrideSlider" min="1" max="15" step="1" class="form-range"
                               value="@(Model.MotionJitterPixelsOverride ?? Model.EffectiveMotionJitterPixels)"
                               disabled="@(!Model.MotionJitterPixelsOverride.HasValue)" />
                        <output class="text-muted small" style="min-width: 2.5em;" id="jitterPixelsOverrideReadout">@(Model.MotionJitterPixelsOverride ?? Model.EffectiveMotionJitterPixels)</output>
                    </div>
                    <div class="lv-hint">Used only when jitter rejection is on.</div>
                </div>
            </div>
        </section>

        <section class="lv-section">
            <div class="lv-section-head"><h2 class="lv-section-title">Motion</h2></div>
            <div class="lv-section-body">
                <div class="lv-field">
                    <label class="form-label" asp-for="MotionDetectionSourceOverride">Motion source</label>
                    <select asp-for="MotionDetectionSourceOverride" class="form-select">
                        <option value="">Auto (best available)</option>
                        <option value="ServerMotion">Server-side motion (pixel zone)</option>
                        <option value="CameraEvent">Camera events (ONVIF)</option>
                        <option value="Integration">Vendor integration</option>
                        <option value="AiDetection">AI detection</option>
                    </select>
                    <div class="lv-hint">Which signal gates Motion-mode recording. <a href="/Help/motion#source">Learn more</a></div>
                </div>
                <div class="lv-field">
                    <label class="form-label">Server-side motion</label>
                    <div class="form-check mt-1">
                        <input asp-for="ServerMotionEnabled" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="ServerMotionEnabled">Run pixel motion detection</label>
                    </div>
                    <div class="lv-hint">Tags plain motion on the timeline. Off saves CPU.</div>
                </div>
            </div>
        </section>
    }

    <div class="lv-savebar">
        @* Explicit handler — a handler-less submit posts to the current URL, which still carries
           "?handler=Probe" after Re-probe and would re-probe rather than save. *@
        <button type="submit" class="btn btn-primary" asp-page-handler="Save">@(Model.IsNew ? "Add & probe" : "Save")</button>
        <a href="/Cameras" class="btn btn-link">Cancel</a>
    </div>
</form>

@if (!Model.IsNew)
{
    <details class="lv-section mt-3">
        <summary class="lv-section-head" style="cursor: pointer;">
            <span class="lv-section-title">Device</span>
            <span class="lv-section-sub ms-2">Integration, capabilities and streams</span>
        </summary>
        <div class="p-3">
            @if (Model.Integration is { } integration)
            {
                <p class="small mb-3">
                    <span aria-hidden="true">🧩</span> <strong>@integration.DisplayName</strong> integration is active.
                    <span class="text-muted">@integration.Summary</span>
                </p>
            }

            @if (Model.Capabilities is { } cap)
            {
                <h3 class="h6">Capabilities <span class="text-muted small fw-normal">probed @cap.ProbedAt.ToLocalTime().ToString("g")</span></h3>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var (label, has) in new[] {
                        ("Profile S", cap.ProfileS), ("Profile T", cap.ProfileT), ("Profile G", cap.ProfileG), ("Profile M", cap.ProfileM),
                        ("PTZ", cap.HasPtz), ("Imaging", cap.HasImaging), ("Events", cap.HasEvents), ("Analytics", cap.HasAnalyticsMetadata),
                        ("Two-way audio", cap.HasAudioOut), ("Relay outputs", cap.HasRelayOutputs), ("Digital inputs", cap.HasDigitalInputs) })
                    {
                        <span class="badge @(has ? "text-bg-success" : "bg-transparent text-body-secondary border")">@(has ? "✓" : "✗") @label</span>
                    }
                </div>

                <h3 class="h6">Streams</h3>
                @if (Model.Streams.Count == 0)
                {
                    <p class="text-muted small">No streams recorded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>On</th><th>Name</th><th>Role</th><th>Resolution</th><th>Codec</th><th>FPS</th><th>Bitrate</th><th>Audio</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.Streams.OrderBy(s => s.Role))
                                {
                                    <tr class="@(s.IsEnabled ? "" : "text-muted")" title="@s.RtspUri">
                                        <form method="post" asp-page-handler="UpdateStream">
                                            <input type="hidden" name="Id" value="@Model.Id" />
                                            <input type="hidden" name="streamId" value="@s.Id" />
                                            <td>
                                                <input type="checkbox" class="form-check-input" name="streamIsEnabled" value="true" @(s.IsEnabled ? "checked" : "") />
                                            </td>
                                            <td style="min-width: 8rem;">
                                                <input name="customName" class="form-control form-control-sm" value="@s.CustomName" placeholder="@s.Role" />
                                            </td>
                                            <td>@s.Role</td>
                                            <td>@(s.Width is not null ? $"{s.Width}x{s.Height}" : "—")</td>
                                            <td>@(s.Codec ?? "—")</td>
                                            <td>@(s.Fps?.ToString() ?? "—")</td>
                                            <td>@(s.BitrateKbps is not null ? $"{s.BitrateKbps} kbps" : "—")</td>
                                            <td>@(s.HasAudio ? s.AudioCodec ?? "yes" : "no")</td>
                                            <td class="text-end"><button type="submit" class="btn btn-sm btn-outline-primary">Save</button></td>
                                        </form>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="lv-hint">Hover a stream for its RTSP URL.</div>
                }
            }
            else
            {
                <p class="text-muted small mb-0">Not probed yet. Use Re-probe to read the camera's capabilities.</p>
            }
        </div>
    </details>

    <div class="lv-danger-zone d-flex flex-wrap align-items-center gap-2">
        <div class="flex-grow-1 small">Deleting a camera removes it from LarisVMS.</div>
        <button type="submit" form="cameraForm" asp-page-handler="Delete" class="btn btn-sm btn-outline-danger"
                onclick="return confirm('Delete this camera?');">Delete camera</button>
    </div>
}
</div>

@section Scripts {
    <script>
        // Override slider readouts, wired by id. A disabled range fires no 'input' events, so re-sync
        // when the Override toggle flips.
        (function () {
            function wireOverride(toggleId, rangeId, readoutId, transform, zeroLabel) {
                var toggle = document.getElementById(toggleId);
                var range = document.getElementById(rangeId);
                var readout = document.getElementById(readoutId);
                if (!toggle || !range || !readout) return;
                function sync() {
                    var value = transform(range.value);
                    readout.textContent = zeroLabel && value === 0 ? zeroLabel : value;
                }
                range.addEventListener('input', sync);
                toggle.addEventListener('change', function () {
                    range.disabled = !toggle.checked;
                    sync();
                });
                sync();
            }
            var asPercent = function (v) { return Math.round(v * 100); };
            var asInt = function (v) { return Math.round(v); };
            wireOverride('confidenceOverrideToggle', 'confidenceOverrideSlider', 'confidenceOverrideReadout', asPercent);
            wireOverride('iouOverrideToggle', 'iouOverrideSlider', 'iouOverrideReadout', asPercent);
            wireOverride('jitterPixelsOverrideToggle', 'jitterPixelsOverrideSlider', 'jitterPixelsOverrideReadout', asInt);
            wireOverride('maxFpsOverrideToggle', 'maxFpsOverrideSlider', 'maxFpsOverrideReadout', asInt, 'no cap');
        })();
    </script>
}
