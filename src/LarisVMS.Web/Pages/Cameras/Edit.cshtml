@page "{id:guid?}"
@model LarisVMS.Web.Pages.Cameras.EditModel
@using LarisVMS.Core.Entities
@{
    ViewData["Title"] = Model.IsNew ? "Add camera" : "Edit camera";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@(Model.IsNew ? "Add camera" : Model.Name)</h1>
    @if (!Model.IsNew)
    {
        <div class="btn-group">
            <a class="btn btn-outline-secondary" asp-page="Zones" asp-route-id="@Model.Id">Zones</a>
            <a class="btn btn-outline-secondary" asp-page="EventTags" asp-route-id="@Model.Id">Event tags</a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ProbeMessage))
{
    <div class="alert alert-info">@Model.ProbeMessage</div>
}

<form method="post" class="row g-3" style="max-width: 640px;">
    <input type="hidden" asp-for="Id" />
    <div class="col-12">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="col-12">
        <label class="form-label">
            Device service URL
            @if (!Model.IsNew)
            {
                <button type="button" class="help-icon" data-help-target="deviceUriHelp" tabindex="0" aria-label="Help">ℹ️</button>
            }
        </label>
        <input asp-for="DeviceServiceUri" class="form-control font-monospace" placeholder="http://192.168.1.50/onvif/device_service" required />
        @if (!Model.IsNew)
        {
            <div class="help-text-source" id="deviceUriHelp">
                Change the scheme here (<code>http://</code> &harr; <code>https://</code>) if the
                camera's own web server switches, or update the address if its IP changes. Saving a
                change re-probes the camera automatically, since its capability report can otherwise
                go stale against the new address.
            </div>
        }
    </div>
    @if (!Model.IsNew)
    {
        <div class="col-12">
            <label class="form-label">Groups</label>
            <div>
                @if (Model.CurrentGroups.Count == 0)
                {
                    <span class="text-muted">Not in any group yet.</span>
                }
                else
                {
                    @foreach (var g in Model.CurrentGroups)
                    {
                        <span class="badge text-bg-secondary me-1">@g.Name</span>
                    }
                }
            </div>
            <div class="form-text">
                <a asp-page="Groups">Manage groups &rarr;</a>
            </div>
        </div>
    }
    <div class="col-12">
        <label class="form-label">Recorder node</label>
        <select asp-for="NodeId" class="form-select">
            <option value="">(unassigned — won't record)</option>
            @foreach (var n in Model.Nodes)
            {
                <option value="@n.Id">@n.Name</option>
            }
        </select>
        @if (Model.Nodes.Count == 0)
        {
            <div class="form-text">No nodes have registered yet — see <a asp-page="/Admin/Nodes">Admin &rarr; Nodes</a>.</div>
        }
    </div>
    <div class="col-6">
        <label class="form-label">Username</label>
        <input asp-for="Username" class="form-control" autocomplete="off" />
    </div>
    <div class="col-6">
        <label class="form-label">Password @(Model.IsNew ? "" : "(leave blank to keep current)")</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
    </div>
    @if (!Model.IsNew)
    {
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="IsEnabled">Enabled</label>
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Storage quota (GB)
                <button type="button" class="help-icon" data-help-target="quotaHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="QuotaGb" type="number" step="0.1" min="0" class="form-control" placeholder="(no quota — shares the pool)" />
            <div class="help-text-source" id="quotaHelp">
                Using @ByteFormat.Format(Model.StorageUsedBytes) now. Oldest footage is
                evicted first once this camera goes over quota.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Retention override (days)
                <button type="button" class="help-icon" data-help-target="retentionHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="RetentionDaysOverride" type="number" min="0" class="form-control"
                   placeholder="(inherit — currently @Model.EffectiveRetentionDays days)" />
            <div class="help-text-source" id="retentionHelp">0 = keep forever on this camera. Blank inherits the node's/global setting.</div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Archive retention override (days)
                <button type="button" class="help-icon" data-help-target="archiveRetentionHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="ArchiveRetentionDaysOverride" type="number" min="0" class="form-control"
                   placeholder="(inherit — currently @Model.EffectiveArchiveRetentionDays days)" />
            <div class="help-text-source" id="archiveRetentionHelp">
                How long this camera's footage stays on the archive volume, counted from its original
                recording date — set this higher than other cameras to keep this one archived longer.
                0 = keep forever. Blank inherits the node's/global setting.
                Archiving is currently @(Model.EffectiveArchiveEnabled ? "on" : "off") for this camera
                (set on <a asp-page="/Admin/Nodes">the node</a> or <a asp-page="/Admin/Settings/StorageAndRetention">globally</a>).
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">Recording mode override</label>
            <select asp-for="RecordingModeOverride" class="form-select">
                <option value="">(inherit — currently @Model.EffectiveRecordingMode)</option>
                <option value="Continuous">Continuous</option>
                <option value="Motion">Motion only</option>
                <option value="Schedule">Schedule</option>
                <option value="Event">Event (a specific tagged trigger)</option>
            </select>
            @{ var hasOnvifEvents = Model.Capabilities?.HasEvents ?? false; }
            @if (!Model.HasServerMotionZone && !hasOnvifEvents)
            {
                <div class="form-text text-warning">
                    No enabled Motion zone on this camera yet, and it doesn't advertise ONVIF events
                    either — Motion mode won't discard anything until one exists
                    (<a asp-page="Zones" asp-route-id="@Model.Id">set one up</a>). Recording behaves
                    like Continuous in the meantime, not "record nothing."
                </div>
            }
            else
            {
                <div class="mt-1">
                    <button type="button" class="help-icon" data-help-target="motionModeHelp" tabindex="0" aria-label="Help">ℹ️ About Motion mode</button>
                    <div class="help-text-source" id="motionModeHelp">
                        Segments with no activity — from a Motion zone@(hasOnvifEvents ? " or this camera's own ONVIF motion events" : "") —
                        are deleted shortly after they're written, instead of waiting for a retention sweep
                        (<a asp-page="Zones" asp-route-id="@Model.Id">manage zones</a>).
                        <strong>Unverified against a real camera</strong> — see CHANGELOG.
                    </div>
                </div>
            }
            @if (!Model.HasScheduleWindow)
            {
                <div class="form-text text-warning">
                    No enabled schedule window yet — Schedule mode keeps everything until one exists
                    (<a asp-page="Schedule" asp-route-id="@Model.Id">set one up</a>).
                </div>
            }
            else
            {
                <div class="mt-1">
                    <button type="button" class="help-icon" data-help-target="scheduleModeHelp" tabindex="0" aria-label="Help">ℹ️ About Schedule mode</button>
                    <div class="help-text-source" id="scheduleModeHelp">
                        Schedule mode keeps a segment only if it starts inside an enabled window
                        (<a asp-page="Schedule" asp-route-id="@Model.Id">manage schedule</a>), evaluated
                        against the recorder node's own local clock.
                    </div>
                </div>
            }
            @if (!Model.HasDrivingEventRule)
            {
                <div class="form-text text-warning">
                    No enabled event tag rule has "Drives recording" checked yet — Event mode keeps
                    everything until one exists
                    (<a asp-page="EventTags" asp-route-id="@Model.Id">set one up</a>). Unlike Motion
                    mode, Event mode ignores Motion zones and the built-in motion classifier entirely
                    — only a driving rule's own trigger counts.
                </div>
            }
            else
            {
                <div class="mt-1">
                    <button type="button" class="help-icon" data-help-target="eventModeHelp" tabindex="0" aria-label="Help">ℹ️ About Event mode</button>
                    <div class="help-text-source" id="eventModeHelp">
                        Event mode keeps a segment only if a driving
                        (<a asp-page="EventTags" asp-route-id="@Model.Id">event tag rule</a>) fired within
                        its pre/post-roll window — not any activity, unlike Motion mode.
                        <strong>Unverified against a real camera</strong> — see CHANGELOG.
                    </div>
                </div>
            }
        </div>
        <div class="col-6">
            <label class="form-label">
                AI object detection
                <button type="button" class="help-icon" data-help-target="aiDetectionHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <div class="form-check">
                <input asp-for="AiDetectionEnabled" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="AiDetectionEnabled">Watch this camera for AI object detection</label>
            </div>
            <div class="help-text-source" id="aiDetectionHelp">
                Which hardware accelerator actually runs detection is a per-node setting, not chosen
                here (<a asp-page="/Admin/Nodes">manage nodes</a>). If the assigned node has none
                available, this is logged once and every other detection path already configured for
                this camera keeps working unaffected.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Detection stream override
                <button type="button" class="help-icon" data-help-target="aiStreamRoleHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <select asp-for="AiDetectionStreamRoleOverride" class="form-select">
                <option value="">(inherit — currently @Model.EffectiveAiDetectionStreamRole)</option>
                <option value="Sub">Sub</option>
                <option value="Main">Main</option>
            </select>
            <div class="help-text-source" id="aiStreamRoleHelp">
                Which of this camera's streams AI detection watches. Global default is set on
                <a asp-page="/Admin/Settings/Detection">AI Detection settings</a>.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Camera orientation override
                <button type="button" class="help-icon" data-help-target="aiOrientationHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <select asp-for="AiDetectionOrientationOverride" class="form-select">
                <option value="">(inherit — currently @Model.EffectiveAiDetectionOrientation)</option>
                <option value="Auto">Auto</option>
                <option value="Landscape">Landscape</option>
                <option value="Portrait">Portrait</option>
            </select>
            <div class="help-text-source" id="aiOrientationHelp">
                Set this to Portrait for a corridor-mounted camera that reports a landscape detection
                stream (704x480) but actually sends portrait video (480x704). Left on Auto, detection
                runs on a horizontally squashed frame and snapshot crops come out stretched. The node's
                detection log names this setting when it sees the mismatch.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Confidence threshold override
                <button type="button" class="help-icon" data-help-target="aiConfidenceHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input" id="confidenceOverrideToggle"
                           checked="@(Model.ConfidenceOverride.HasValue)" />
                    <label class="form-check-label small" for="confidenceOverrideToggle">Override</label>
                </div>
                <input type="range" name="ConfidenceOverride" id="confidenceOverrideSlider" min="0" max="1" step="0.05" class="form-range"
                       value="@((Model.ConfidenceOverride ?? Model.EffectiveConfidence).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                       disabled="@(!Model.ConfidenceOverride.HasValue)" />
                <output class="text-muted small" style="min-width: 2.5em;" id="confidenceOverrideReadout">@Math.Round((Model.ConfidenceOverride ?? Model.EffectiveConfidence) * 100)</output>
            </div>
            <div class="help-text-source" id="aiConfidenceHelp">
                Minimum detection score for this camera specifically — e.g. a camera prone to
                misdetecting a stationary object may need a higher threshold. Unchecked "Override"
                inherits the node's/global setting from <a asp-page="/Admin/Settings/Detection">AI Detection settings</a>.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                IoU threshold override
                <button type="button" class="help-icon" data-help-target="aiIouHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input" id="iouOverrideToggle"
                           checked="@(Model.IouOverride.HasValue)" />
                    <label class="form-check-label small" for="iouOverrideToggle">Override</label>
                </div>
                <input type="range" name="IouOverride" id="iouOverrideSlider" min="0" max="1" step="0.05" class="form-range"
                       value="@((Model.IouOverride ?? Model.EffectiveIou).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                       disabled="@(!Model.IouOverride.HasValue)" />
                <output class="text-muted small" style="min-width: 2.5em;" id="iouOverrideReadout">@Math.Round((Model.IouOverride ?? Model.EffectiveIou) * 100)</output>
            </div>
            <div class="help-text-source" id="aiIouHelp">
                Overlap threshold for merging duplicate boxes, for this camera specifically. Unchecked
                "Override" inherits the node's/global setting from <a asp-page="/Admin/Settings/Detection">AI Detection settings</a>.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Stationary-object jitter rejection
                <button type="button" class="help-icon" data-help-target="aiRejectJitterHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <select asp-for="RejectMotionJitterOverride" class="form-select">
                <option value="">(inherit — currently @(Model.EffectiveRejectMotionJitter ? "on" : "off"))</option>
                <option value="True">On</option>
                <option value="False">Off</option>
            </select>
            <div class="help-text-source" id="aiRejectJitterHelp">
                Turn this On for a camera that has a parked vehicle in view whose box wobble is being
                reported as motion. It smooths the movement check so frame-to-frame box jitter doesn't
                count as moving — but can also hold a genuinely slow-moving object as idle, so it is
                off by default. Global default on <a asp-page="/Admin/Settings/Detection">AI Detection settings</a>.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Jitter threshold override (pixels)
                <button type="button" class="help-icon" data-help-target="aiJitterPixelsHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input" id="jitterPixelsOverrideToggle"
                           checked="@(Model.MotionJitterPixelsOverride.HasValue)" />
                    <label class="form-check-label small" for="jitterPixelsOverrideToggle">Override</label>
                </div>
                <input type="range" name="MotionJitterPixelsOverride" id="jitterPixelsOverrideSlider" min="1" max="15" step="1" class="form-range"
                       value="@(Model.MotionJitterPixelsOverride ?? Model.EffectiveMotionJitterPixels)"
                       disabled="@(!Model.MotionJitterPixelsOverride.HasValue)" />
                <output class="text-muted small" style="min-width: 2.5em;" id="jitterPixelsOverrideReadout">@(Model.MotionJitterPixelsOverride ?? Model.EffectiveMotionJitterPixels)</output>
            </div>
            <div class="help-text-source" id="aiJitterPixelsHelp">
                Minimum real pixel travel before a box counts as moving — only used when jitter
                rejection is on for this camera. Higher rejects more wobble but ignores slower genuine
                movement. Unchecked "Override" inherits the node's/global setting from
                <a asp-page="/Admin/Settings/Detection">AI Detection settings</a>.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Motion detection source
                <button type="button" class="help-icon" data-help-target="motionSourceHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <select asp-for="MotionDetectionSourceOverride" class="form-select">
                <option value="">(auto — richest configured signal)</option>
                <option value="ServerMotion">Server-side motion (pixel zone)</option>
                <option value="CameraEvent">Camera events (ONVIF)</option>
                <option value="Integration">Vendor integration</option>
                <option value="AiDetection">AI detection</option>
            </select>
            <div class="help-text-source" id="motionSourceHelp">
                Only matters in Motion mode, and only narrows the three generic "something moved"
                signals (server-side zone, ONVIF camera events, vendor integration) to exactly one at
                a time, so the timeline doesn't collect redundant overlapping entries for the same
                event. A named event tag rule and AI detection's own object labels always tag the
                timeline regardless of this choice. Leave on auto to prefer whichever of the three is
                actually configured, richest signal first.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Server-side motion detection
                <button type="button" class="help-icon" data-help-target="serverMotionHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <div class="form-check">
                <input asp-for="ServerMotionEnabled" class="form-check-input" type="checkbox" />
                <label class="form-check-label" asp-for="ServerMotionEnabled">Run server-side pixel motion detection on this camera</label>
            </div>
            <div class="help-text-source" id="serverMotionHelp">
                Independent of the motion detection source above — that setting only chooses which
                signal <em>gates recording</em> in Motion mode, not whether server-side motion runs at
                all. Leave this on to keep tagging the timeline with plain motion as a fallback even
                when AI detection (or another source) is the chosen gate — useful in case something
                triggers motion without an object being detected. Turn it off to stop the CPU cost of
                this camera's motion decode entirely, if you don't need the fallback.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Pre-roll override (seconds)
                <button type="button" class="help-icon" data-help-target="preRollHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="MotionPreRollSecondsOverride" type="number" min="0" class="form-control"
                   placeholder="(inherit — currently @Model.EffectiveMotionPreRollSeconds s)" />
            <div class="help-text-source" id="preRollHelp">
                Only matters in Motion mode. How far <strong>before</strong> activity starts a
                segment still counts as worth keeping — this is how much lead-up you get on a
                motion event, e.g. someone walking into frame before they trip the zone.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Post-roll override (seconds)
                <button type="button" class="help-icon" data-help-target="postRollHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="MotionPostRollSecondsOverride" type="number" min="0" class="form-control"
                   placeholder="(inherit — currently @Model.EffectiveMotionPostRollSeconds s)" />
            <div class="help-text-source" id="postRollHelp">
                Only matters in Motion mode. How long <strong>after</strong> activity stops a
                segment still counts as worth keeping.
            </div>
        </div>
        <div class="col-6">
            <label class="form-label">
                Segment length override (seconds)
                <button type="button" class="help-icon" data-help-target="segmentLengthHelp" tabindex="0" aria-label="Help">ℹ️</button>
            </label>
            <input asp-for="SegmentSecondsOverride" type="number" min="5" max="300" class="form-control"
                   placeholder="(inherit — currently @Model.EffectiveSegmentSeconds s)" />
            <div class="help-text-source" id="segmentLengthHelp">
                Applies regardless of recording mode. Smaller for a busy/high-resolution camera keeps
                worst-case Playback scrub latency down; changing it restarts this camera's recording
                session (brief interruption) to take effect.
            </div>
        </div>
    }
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Add & probe" : "Save")</button>
        @if (!Model.IsNew)
        {
            <button type="submit" asp-page-handler="Probe" class="btn btn-outline-secondary"><span aria-hidden="true">🔍</span> Re-probe</button>
            <button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger"
                    onclick="return confirm('Delete this camera?');">Delete</button>
        }
        <a asp-page="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@* Only ever offered right after a probe, which is the one thing that reports the device's channel
   list. A camera already pinned to a channel shows what it covers instead of re-offering the split. *@
@if (!Model.IsNew && Model.DetectedChannelCount > 1 && Model.VideoSourceToken is null)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <div class="flex-grow-1">
            <strong>This device has @Model.DetectedChannelCount channels.</strong>
            It looks like a multi-sensor camera (several lenses in one housing). Right now this single
            camera picks its streams from across all of them, which can mean it records the wrong lens.
            Splitting creates one camera per channel — each records independently and can be placed in
            a view on its own. Your existing camera becomes channel 1 and keeps its recordings.
        </div>
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" asp-page-handler="SplitChannels" class="btn btn-warning"
                    onclick="return confirm('Add one camera per channel on this device?');">
                <span aria-hidden="true">🔀</span> Split into @Model.DetectedChannelCount cameras
            </button>
        </form>
    </div>
}
else if (Model.VideoSourceToken is { } channelToken)
{
    <p class="text-muted small">
        <span aria-hidden="true">🔀</span>
        One channel of a multi-sensor device — this camera records only video source
        <code>@channelToken</code>. Its sibling channels are separate cameras on the
        <a asp-page="Index">Cameras</a> list.
    </p>
}

@if (Model.Integration is { } integration)
{
    <div class="alert alert-info d-flex align-items-start gap-2">
        <span aria-hidden="true">🧩</span>
        <div>
            <strong>@integration.DisplayName</strong> is active for this camera.
            <div class="small">@integration.Summary</div>
            <div class="form-text">
                Detected automatically from the make and model this camera reports
                (@(Model.Capabilities is null ? "re-probe to refresh" : "re-probe to re-check")). The
                recorder node connects to the camera's own API alongside ONVIF — no setup needed here.
            </div>
        </div>
    </div>
}

@if (Model.Capabilities is { } cap)
{
    <h2 class="mt-5 h4">Capabilities</h2>
    <p class="text-muted small">
        Best-effort inference from advertised ONVIF services, not certified conformance. Probed
        @cap.ProbedAt.ToString("u").
    </p>
    <table class="table" style="max-width: 480px;">
        <tbody>
            <tr><th>Profile S (streaming)</th><td>@(cap.ProfileS ? "Yes" : "No")</td></tr>
            <tr><th>Profile T (advanced)</th><td>@(cap.ProfileT ? "Yes" : "No")</td></tr>
            <tr><th>Profile G (recording)</th><td>@(cap.ProfileG ? "Yes" : "No")</td></tr>
            <tr><th>Profile M (metadata)</th><td>@(cap.ProfileM ? "Yes" : "No")</td></tr>
            <tr><th>PTZ</th><td>@(cap.HasPtz ? "Yes" : "No")</td></tr>
            <tr><th>Imaging</th><td>@(cap.HasImaging ? "Yes" : "No")</td></tr>
            <tr><th>Events</th><td>@(cap.HasEvents ? "Yes" : "No")</td></tr>
            <tr><th>Analytics metadata</th><td>@(cap.HasAnalyticsMetadata ? "Yes" : "No")</td></tr>
            <tr><th>Two-way audio</th><td>@(cap.HasAudioOut ? "Yes" : "No")</td></tr>
            <tr><th>Relay outputs</th><td>@(cap.HasRelayOutputs ? "Yes" : "No")</td></tr>
            <tr><th>Digital inputs</th><td>@(cap.HasDigitalInputs ? "Yes" : "No")</td></tr>
        </tbody>
    </table>

    <h2 class="h4">Streams</h2>
    @if (Model.Streams.Count == 0)
    {
        <p class="text-muted">No streams recorded.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead><tr><th>Enabled</th><th>Name</th><th>Role</th><th>Resolution</th><th>Codec</th><th>FPS</th><th>Bitrate</th><th>Audio</th><th>RTSP</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Streams.OrderBy(s => s.Role))
                {
                    <tr class="@(s.IsEnabled ? "" : "text-muted")">
                        <form method="post" asp-page-handler="UpdateStream">
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <input type="hidden" name="streamId" value="@s.Id" />
                            <td>
                                <input type="checkbox" class="form-check-input" name="streamIsEnabled" value="true" @(s.IsEnabled ? "checked" : "") />
                            </td>
                            <td style="min-width: 10rem;">
                                <input name="customName" class="form-control form-control-sm" value="@s.CustomName" placeholder="@s.Role" />
                            </td>
                            <td>@s.Role</td>
                            <td>@(s.Width is not null ? $"{s.Width}x{s.Height}" : "—")</td>
                            <td>@(s.Codec ?? "—")</td>
                            <td>@(s.Fps?.ToString() ?? "—")</td>
                            <td>@(s.BitrateKbps is not null ? $"{s.BitrateKbps} kbps" : "—")</td>
                            <td>@(s.HasAudio ? s.AudioCodec ?? "yes" : "no")</td>
                            <td class="font-monospace small">@s.RtspUri</td>
                            <td class="text-end"><button type="submit" class="btn btn-sm btn-outline-primary"><span aria-hidden="true">💾</span> Save</button></td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@section Scripts {
    <script>
        // Confidence/IoU override slider readouts, wired explicitly by id rather than the previous
        // oninput="this.nextElementSibling..." adjacency coupling and the checkbox's own inline
        // onchange — that read as structurally correct on paper but didn't update while dragging in
        // practice. Explicit ids sidestep whatever the adjacency assumption was actually getting
        // wrong, and initializing from the slider's own value below (rather than trusting the two to
        // already agree) rules out the readout and the slider ever silently disagreeing.
        (function () {
            function wireOverride(toggleId, rangeId, readoutId, transform) {
                var toggle = document.getElementById(toggleId);
                var range = document.getElementById(rangeId);
                var readout = document.getElementById(readoutId);
                if (!toggle || !range || !readout) return;
                function sync() { readout.textContent = transform(range.value); }
                range.addEventListener('input', sync);
                toggle.addEventListener('change', function () {
                    range.disabled = !toggle.checked;
                    // A disabled <input type="range"> fires no 'input' events at all, so re-enabling
                    // it could otherwise leave the readout showing whatever it last synced to
                    // (possibly the inherited value shown while disabled) rather than the slider's
                    // actual current position.
                    sync();
                });
                sync(); // in case the slider's own value differs from what was rendered server-side
            }
            var asPercent = function (v) { return Math.round(v * 100); };
            var asInt = function (v) { return Math.round(v); };
            wireOverride('confidenceOverrideToggle', 'confidenceOverrideSlider', 'confidenceOverrideReadout', asPercent);
            wireOverride('iouOverrideToggle', 'iouOverrideSlider', 'iouOverrideReadout', asPercent);
            wireOverride('jitterPixelsOverrideToggle', 'jitterPixelsOverrideSlider', 'jitterPixelsOverrideReadout', asInt);
        })();
    </script>
}
