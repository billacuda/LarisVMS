@page "{id:guid}"
@model LarisVMS.Web.Pages.Cameras.SpeedTrapsModel
@{
    ViewData["Title"] = L["cameras.speedTraps.speedTraps"].Value + Model.CameraName;
    var metric = Model.SpeedUnit != LarisVMS.Core.SpeedUnits.Mph;
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["cameras.speedTraps.heading", new { camera = Model.CameraName }]</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Zones" asp-route-id="@Model.CameraId">@L["cameras.speedTraps.zones"]</a>
        <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@Model.CameraId">@L["cameras.speedTraps.backToCamera"]</a>
    </div>
</div>

@if (!Model.AiDetectionEnabled)
{
    <div class="alert alert-warning py-2 small" role="note">
        @L["cameras.speedTraps.aiDetectionIsOffFor"]
    </div>
}

<div class="alert alert-info py-2 small mb-3" role="note">
    @L.Html("cameras.speedTraps.intro")
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="border rounded bg-body-tertiary position-relative" style="aspect-ratio: 16/9; overflow: hidden;">
            <video id="trapLiveVideo" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:contain;" muted playsinline aria-label="@L["common.liveVideo"]"></video>
            <canvas id="trapCanvas" style="position:absolute; top:0; left:0; width: 100%; height: 100%; cursor: crosshair;"></canvas>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
            <button type="button" id="trapNewBtn" class="btn btn-primary btn-sm">@L["cameras.speedTraps.newSpeedTrap"]</button>
            <button type="button" id="trapRedrawBtn" class="btn btn-outline-secondary btn-sm" style="display: none;">@L["cameras.speedTraps.redrawLines"]</button>
            <div class="form-check form-switch mb-0 ms-2">
                <input class="form-check-input" type="checkbox" role="switch" id="trapShowBoxes" checked>
                <label class="form-check-label small" for="trapShowBoxes">@L["cameras.speedTraps.showMovingObjectsAndTheir"]</label>
            </div>
            <span id="trapStatus" class="text-muted small" role="status" aria-live="polite"></span>
        </div>
        <p id="trapHint" class="text-muted small mt-1">@L["cameras.speedTraps.selectASpeedTrapTo"]</p>
    </div>
    <div class="col-lg-4">
        <div id="trapListPanel"><p class="text-muted small">@L["cameras.speedTraps.loadingSpeedTraps"]</p></div>

        <div id="trapFormPanel" class="border rounded p-3 mt-3" style="display: none;">
            <h6 id="trapFormTitle">@L["cameras.speedTraps.newSpeedTrap"]</h6>
            <div class="mb-2">
                <label class="form-label small" for="trapFormName">@L["common.name"]</label>
                <input type="text" id="trapFormName" class="form-control form-control-sm" maxlength="100" placeholder="@L["cameras.speedTraps.eGStreetEastbound"]" />
            </div>
            <div class="mb-2">
                <label class="form-label small" for="trapFormDistance">@L["cameras.speedTraps.distanceBetweenAAndB"]</label>
                <div class="input-group input-group-sm">
                    <input type="number" id="trapFormDistance" class="form-control" min="0.1" step="any" />
                    <select id="trapFormDistanceUnit" class="form-select" style="max-width: 6rem;" aria-label="@L["cameras.speedTraps.distanceUnit"]">
                        <option value="m" selected="@metric">@L["cameras.speedTraps.metres"]</option>
                        <option value="ft" selected="@(!metric)">@L["cameras.speedTraps.feet"]</option>
                    </select>
                </div>
                <div class="lv-hint">@L["cameras.speedTraps.measureAlongTheRoadNot"]</div>
            </div>
            <div class="mb-2">
                <label class="form-label small" for="trapFormLimit">@L["cameras.speedTraps.speedLimitOptional", new { unit = LarisVMS.Core.SpeedUnits.Label(Model.SpeedUnit) }]</label>
                <input type="number" id="trapFormLimit" class="form-control form-control-sm" min="1" step="any" />
                <div class="lv-hint">@L["cameras.speedTraps.speedsOverThisAreHighlighted"]</div>
            </div>
            <div class="mb-2">
                <label class="form-label small" for="trapFormDirection">@L["cameras.speedTraps.direction"]</label>
                <select id="trapFormDirection" class="form-select form-select-sm">
                    <option value="any">@L["cameras.speedTraps.directionAny"]</option>
                    <option value="ab">@L["cameras.speedTraps.directionAB"]</option>
                    <option value="ba">@L["cameras.speedTraps.directionBA"]</option>
                </select>
                <div class="lv-hint">@L["cameras.speedTraps.directionHint"]</div>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="trapFormEnabled" class="form-check-input" checked />
                <label class="form-check-label small" for="trapFormEnabled">@L["common.enabled"]</label>
            </div>
            <div id="trapFormError" class="text-danger small mb-2" role="alert"></div>
            <div class="d-flex gap-2">
                <button type="button" id="trapFormSaveBtn" class="btn btn-primary btn-sm">@L["common.save"]</button>
                <button type="button" id="trapFormCancelBtn" class="btn btn-outline-secondary btn-sm">@L["common.cancel"]</button>
                <button type="button" id="trapFormDeleteBtn" class="btn btn-outline-danger btn-sm ms-auto" style="display: none;">@L["common.delete"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/media-endpoint.js" asp-append-version="true"></script>
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script src="~/js/canvas-keyboard.js" asp-append-version="true"></script>
    <script src="~/js/speed-trap-editor.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        window.larisvmsSpeedTrapEditor.init({
            cameraId: '@Model.CameraId',
            snapshotUrl: '/api/cameras/@Model.CameraId/snapshot',
            codecHint: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Codec)),
            hasAudio: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HasAudio)),
            speedUnit: '@Model.SpeedUnit'
        });
    </script>
}
