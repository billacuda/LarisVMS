@page "{id:guid}"
@model LarisVMS.Web.Pages.Cameras.ZonesModel
@{
    ViewData["Title"] = L["cameras.zones.zones"].Value + Model.CameraName;
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["cameras.zones.heading", new { camera = Model.CameraName }]</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="SpeedTraps" asp-route-id="@Model.CameraId">@L["cameras.zones.speedTraps"]</a>
        <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@Model.CameraId">@L["cameras.zones.backToCamera"]</a>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <div class="btn-group" role="group" aria-label="@L["cameras.zones.activeMotionRegionMethod"]">
        <button type="button" id="modeToggleGrid" class="btn btn-outline-primary">@L["cameras.zones.grid"]</button>
        <button type="button" id="modeTogglePolygon" class="btn btn-outline-primary">@L["cameras.zones.polygonZones"]</button>
    </div>
    @* Privacy masks are drawn here whichever motion method is active — this button only changes what
       the editor shows, never how the camera detects motion. *@
    <button type="button" id="modeTogglePrivacy" class="btn btn-outline-dark">@L["cameras.zones.privacyMasks"]</button>
    <span class="text-muted small">@L["cameras.zones.oneMethodIsActiveAt"] <a href="/Help/motion#zones">@L["common.learnMore"]</a></span>
</div>
<div class="alert alert-info py-2 small mb-3" role="note">
    @L["cameras.zones.changesHereSwitchingBetweenGrid"]
</div>

<div id="gridPane">
    <p class="text-muted small">@L["cameras.zones.clickACellToMask"]</p>
</div>
<div id="polygonPane" style="display: none;">
    <p class="text-muted small">
        @L.Html("cameras.zones.polygonIntro")
    </p>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="border rounded bg-body-tertiary position-relative" style="aspect-ratio: 16/9; overflow: hidden;">
            <video id="zoneLiveVideo" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:contain;" muted playsinline aria-label="@L["common.liveVideo"]"></video>
            <canvas id="zoneCanvas" style="position:absolute; top:0; left:0; width: 100%; height: 100%; cursor: crosshair;"></canvas>
        </div>

        <div id="gridControls" class="mt-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div>
                    <label for="gridSizeSelect" class="form-label small mb-0">@L["cameras.zones.gridSize"]</label>
                    <select id="gridSizeSelect" class="form-select form-select-sm">
                        <option value="16">@L["cameras.zones.1616Coarse"]</option>
                        <option value="32" selected>@L["cameras.zones.3232Default"]</option>
                        <option value="64">@L["cameras.zones.6464Fine"]</option>
                    </select>
                </div>
                <div class="flex-grow-1" style="min-width: 200px;">
                    <label for="gridSensitivity" class="form-label small mb-0">Sensitivity: <span id="gridSensitivityValue">3%</span></label>
                    <input type="range" id="gridSensitivity" class="form-range" min="1" max="90" value="3" />
                </div>
                <button type="button" id="gridSaveBtn" class="btn btn-primary btn-sm" disabled>@L["common.save"]</button>
                <span id="gridStatus" class="text-muted small"></span>
            </div>
            <p class="text-muted small mt-1">@L["cameras.zones.redCellsAreMaskedChanging"]</p>
        </div>

        <div id="polygonControls" class="d-flex gap-2 mt-2" style="display: none;">
            <button type="button" id="zoneDrawBtn" class="btn btn-primary btn-sm">@L["cameras.zones.drawNewZone"]</button>
            <button type="button" id="zoneCancelDrawBtn" class="btn btn-outline-secondary btn-sm" style="display: none;">@L["cameras.zones.cancelDrawing"]</button>
            <button type="button" id="zoneUndoPointBtn" class="btn btn-outline-secondary btn-sm" style="display: none;">@L["cameras.zones.undoLastPoint"]</button>
            <span id="zoneStatus" class="text-muted small align-self-center"></span>
        </div>
        <p id="polygonHint" class="text-muted small mt-1" style="display: none;">
            @L["cameras.zones.clickToPlaceEachCorner"]
        </p>
    </div>
    <div class="col-lg-4" id="polygonSidebar" style="display: none;">
        @* Privacy masks view only. *@
        <div id="privacyOptions" class="border rounded p-2 mb-3 small" style="display: none;">
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" role="switch" id="privacyBlocksDetections">
                <label class="form-check-label" for="privacyBlocksDetections">@L["cameras.zones.alsoIgnoreDetectionsInsidePrivacy"]</label>
            </div>
            <div class="text-muted">
                @L["cameras.zones.offAMaskOnlyHides"]
            </div>
            <div class="text-muted" id="privacyOptionsStatus" role="status" aria-live="polite"></div>
        </div>
        <div id="zoneListPanel">
            <p class="text-muted small">@L["cameras.zones.loadingZones"]</p>
        </div>

        <div id="zoneFormPanel" class="border rounded p-3 mt-3" style="display: none;">
            <h6 id="zoneFormTitle">@L["cameras.zones.newZone"]</h6>
            <input type="hidden" id="zoneFormId" />
            <input type="hidden" id="zoneFormPolygonJson" />
            <div class="mb-2">
                <label for="zoneFormName" class="form-label small">@L["common.name"]</label>
                <input type="text" id="zoneFormName" class="form-control form-control-sm" required />
            </div>
            <div class="mb-2">
                <label for="zoneFormKind" class="form-label small">@L["cameras.zones.kind"]</label>
                <select id="zoneFormKind" class="form-select form-select-sm">
                    <option value="ServerMotion">@L["cameras.zones.motionServerSide"]</option>
                    <option value="Ignore">@L["cameras.zones.ignoreExcludedFromMotion"]</option>
                    <option value="CameraMotion">@L["cameras.zones.motionCameraSideNotYet"]</option>
                    <option value="Privacy">@L["cameras.zones.privacyMaskBurnIn"]</option>
                </select>
            </div>
            <div class="mb-2" id="zoneFormSensitivityGroup">
                <label for="zoneFormSensitivity" class="form-label small">
                    Sensitivity: <span id="zoneFormSensitivityValue">3%</span>
                </label>
                <input type="range" id="zoneFormSensitivity" class="form-range" min="1" max="90" value="3" />
                <div class="lv-hint">@L["cameras.zones.lowerIsMoreSensitiveStart"]</div>
            </div>
            <div class="form-check mb-2">
                <input type="checkbox" id="zoneFormEnabled" class="form-check-input" checked />
                <label class="form-check-label small" for="zoneFormEnabled">@L["common.enabled"]</label>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="zoneFormSaveBtn" class="btn btn-primary btn-sm">@L["common.save"]</button>
                <button type="button" id="zoneFormCancelBtn" class="btn btn-outline-secondary btn-sm">@L["common.cancel"]</button>
                <button type="button" id="zoneFormDeleteBtn" class="btn btn-outline-danger btn-sm ms-auto" style="display: none;">@L["common.delete"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/media-endpoint.js" asp-append-version="true"></script>
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script src="~/js/canvas-keyboard.js" asp-append-version="true"></script>
    <script src="~/js/zones-editor.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        window.larisvmsZonesEditor.init({
            cameraId: '@Model.CameraId',
            snapshotUrl: '/api/cameras/@Model.CameraId/snapshot',
            videoId: 'zoneLiveVideo',
            codecHint: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Codec)),
            hasAudio: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HasAudio)),
            canvasId: 'zoneCanvas',

            modeToggleGridId: 'modeToggleGrid',
            modeTogglePolygonId: 'modeTogglePolygon',
            modeTogglePrivacyId: 'modeTogglePrivacy',
            privacyOptionsId: 'privacyOptions',
            privacyBlocksDetectionsId: 'privacyBlocksDetections',
            privacyOptionsStatusId: 'privacyOptionsStatus',
            gridPaneId: 'gridPane',
            polygonPaneId: 'polygonPane',
            gridControlsId: 'gridControls',
            polygonControlsId: 'polygonControls',
            polygonHintId: 'polygonHint',
            polygonSidebarId: 'polygonSidebar',
            gridSizeSelectId: 'gridSizeSelect',
            gridSensitivityId: 'gridSensitivity',
            gridSensitivityValueId: 'gridSensitivityValue',
            gridSaveBtnId: 'gridSaveBtn',
            gridStatusId: 'gridStatus',

            drawBtnId: 'zoneDrawBtn',
            cancelDrawBtnId: 'zoneCancelDrawBtn',
            undoPointBtnId: 'zoneUndoPointBtn',
            statusId: 'zoneStatus',
            listPanelId: 'zoneListPanel',
            formPanelId: 'zoneFormPanel',
            formTitleId: 'zoneFormTitle',
            formIdInputId: 'zoneFormId',
            formPolygonInputId: 'zoneFormPolygonJson',
            formNameId: 'zoneFormName',
            formKindId: 'zoneFormKind',
            formSensitivityGroupId: 'zoneFormSensitivityGroup',
            formSensitivityId: 'zoneFormSensitivity',
            formSensitivityValueId: 'zoneFormSensitivityValue',
            formEnabledId: 'zoneFormEnabled',
            formSaveBtnId: 'zoneFormSaveBtn',
            formCancelBtnId: 'zoneFormCancelBtn',
            formDeleteBtnId: 'zoneFormDeleteBtn'
        });
    </script>
}
