@page "{id:guid}"
@model LarisVMS.Web.Pages.Cameras.DeviceSettingsModel
@{
    ViewData["Title"] = L["cameras.deviceSettings.deviceSettings"].Value + Model.CameraName;
}
<div class="lv-page-narrow">
<nav aria-label="@L["cameras.deviceSettings.breadcrumb"]" class="small mb-1">
    <a href="/Cameras">@L["cameras.deviceSettings.cameras"]</a> / <a asp-page="Edit" asp-route-id="@Model.CameraId">@Model.CameraName</a>
</nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="mb-0">@L["cameras.deviceSettings.deviceSettings2"]</h1>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <details class="column-picker d-inline-block position-relative d-none" id="dsApplyTo">
            <summary class="btn btn-outline-secondary" id="dsApplyToLabel">@L["cameras.deviceSettings.thisCameraOnly"]</summary>
            <div class="column-picker-menu ds-applyto-menu" id="dsApplyToMenu"></div>
        </details>
        <button type="button" class="btn btn-outline-secondary" id="dsRefresh" title="@L["cameras.deviceSettings.readTheSettingsFromThe"]">
            <span aria-hidden="true">↻</span> @L["common.refresh"]
        </button>
    </div>
</div>
<p class="text-muted small mb-3">
    @L["cameras.deviceSettings.intro", new { camera = Model.MakeAndModel is null ? Model.CameraName : Model.CameraName + " · " + Model.MakeAndModel }]
    <a href="/Help/cameras#device-settings">@L["common.learnMore"]</a>
</p>

<div id="dsBulkNote" class="alert alert-info py-2 small d-none" role="status"></div>
<div id="dsRoot">
    <p class="text-muted small"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> @L["cameras.deviceSettings.readingSettingsFromTheCamera"]</p>
</div>
</div>

@section Scripts {
    <script src="~/js/camera-device-settings.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        window.larisvmsDeviceSettings.init({
            cameraId: '@Model.CameraId',
            withIds: @Json.Serialize(Model.WithIds),
            rootId: 'dsRoot',
            refreshBtnId: 'dsRefresh',
            applyToId: 'dsApplyTo',
            applyToLabelId: 'dsApplyToLabel',
            applyToMenuId: 'dsApplyToMenu',
            bulkNoteId: 'dsBulkNote'
        });
    </script>
}
