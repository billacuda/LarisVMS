@page
@model LarisVMS.Web.Pages.Cameras.GroupsModel
@using LarisVMS.Core.Entities
@{
    ViewData["Title"] = "Camera groups";
}
<h1>Camera groups</h1>
<p class="text-muted">
    Sites / buildings / floors — used to organize cameras, to scope settings overrides, and as the
    scope a role's <a asp-page="/Admin/Settings/CameraAccess">Camera Access</a> grant narrows down to.
    A camera can belong to any number of groups, as long as they're all under the same top-level site.
    <strong>There's no separate "site" field to set</strong> — a group's site is simply whichever
    top-level group (no parent) it descends from; add one with "Parent" left as "(top level)" below
    to create a new site, or a sub-group under an existing one for a building/floor within it.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}

<div class="card mb-4" style="max-width: 640px;">
    <div class="card-header fw-semibold">Add group</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-2">
            <div class="col-12">
                <label class="form-label">New group name</label>
                <input asp-for="NewName" class="form-control" required />
            </div>
            <div class="col-12">
                <label class="form-label">Parent</label>
                <select asp-for="NewParentId" class="form-select">
                    <option value="">(top level)</option>
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><span aria-hidden="true">➕</span> Add group</button>
            </div>
        </form>
    </div>
</div>

@foreach (var g in Model.Groups)
{
    var members = Model.Cameras.Where(c => c.Groups.Any(mg => mg.Id == g.Id)).OrderBy(c => c.Name).ToList();
    var isBuiltIn = g.Id == CameraGroup.AllCamerasId;
    var bodyId = $"group-body-{g.Id}";

    <div class="card mb-3" style="max-width: 640px; margin-left: @(Model.Depth(g) * 1.75)rem;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <button type="button" class="btn btn-link text-decoration-none p-0 fw-semibold group-collapse-toggle"
                    data-bs-toggle="collapse" data-bs-target="#@bodyId" aria-expanded="true">
                <span class="group-collapse-icon" aria-hidden="true">▾</span> @g.Name
                <span class="text-muted small fw-normal">(@members.Count)</span>
            </button>
            @if (!isBuiltIn)
            {
                <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id" class="d-inline"
                      onclick="return confirm('Delete this group?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><span aria-hidden="true">🗑️</span> Delete</button>
                </form>
            }
        </div>
        <div class="collapse show" id="@bodyId">
            <div class="card-body">
                @if (isBuiltIn)
                {
                    <p class="text-muted small mb-0">
                        Built in — every camera is automatically a member (@members.Count total).
                        Nothing to manage here; membership follows camera creation/deletion on its own.
                    </p>
                }
                else
                {
                    @if (members.Count == 0)
                    {
                        <p class="text-muted small mb-2">No cameras in this group yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-2">
                            @foreach (var c in members)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>@c.Name</span>
                                    <form method="post" asp-page-handler="RemoveCamera" class="d-inline">
                                        <input type="hidden" name="cameraId" value="@c.Id" />
                                        <input type="hidden" name="groupId" value="@g.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remove</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }

                    <button type="button" class="btn btn-sm btn-primary manage-cameras-btn" data-bs-toggle="modal" data-bs-target="#manageCamerasModal"
                            data-group-id="@g.Id" data-group-name="@g.Name"
                            data-member-ids="@string.Join(",", members.Select(m => m.Id))">
                        Manage cameras
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (Model.Groups.Count == 0)
{
    <p class="text-muted">No groups yet — add one above.</p>
}

<div class="modal fade" id="manageCamerasModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="SetGroupCameras">
                <input type="hidden" name="groupId" id="manageCamerasGroupId" />
                <div class="modal-header">
                    <h5 class="modal-title">Cameras in <span id="manageCamerasGroupName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Cameras.Count == 0)
                    {
                        <p class="text-muted mb-0">No cameras exist yet.</p>
                    }
                    else
                    {
                        <p class="text-muted small">
                            Checking a camera already in a group under a different site will fail —
                            see each camera's current group(s) below.
                        </p>
                        @foreach (var c in Model.Cameras)
                        {
                            <div class="form-check">
                                <input class="form-check-input manage-cameras-checkbox" type="checkbox" name="cameraIds"
                                       value="@c.Id" id="managecam-@c.Id" data-camera-id="@c.Id" />
                                @{ var otherGroups = c.Groups.Where(cg => cg.Id != CameraGroup.AllCamerasId).ToList(); }
                                <label class="form-check-label" for="managecam-@c.Id">
                                    @c.Name
                                    @if (otherGroups.Count > 0)
                                    {
                                        <span class="text-muted small">(currently: @string.Join(", ", otherGroups.Select(cg => cg.Name)))</span>
                                    }
                                </label>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Rotates the collapse chevron to match Bootstrap's own aria-expanded state on the toggle
           button — set automatically by the collapse plugin, no extra JS needed to track it. */
        .group-collapse-icon { display: inline-block; transition: transform .15s ease-in-out; }
        .group-collapse-toggle[aria-expanded="false"] .group-collapse-icon { transform: rotate(-90deg); }
    </style>
}

@section Scripts {
    <script>
        // The one shared modal above is reused for every group's "Manage cameras" button rather than
        // rendering N modals (one per group) with N full copies of the camera checkbox list — its
        // show.bs.modal listener reads which group was clicked from the triggering button's own data
        // attributes and (re)populates the form's hidden groupId, heading, and checkbox states before
        // Bootstrap actually shows it.
        (function () {
            var modal = document.getElementById('manageCamerasModal');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', function (event) {
                var btn = event.relatedTarget;
                if (!btn) return;

                var groupId = btn.getAttribute('data-group-id');
                var groupName = btn.getAttribute('data-group-name');
                var memberIds = (btn.getAttribute('data-member-ids') || '').split(',').filter(Boolean);

                document.getElementById('manageCamerasGroupId').value = groupId;
                document.getElementById('manageCamerasGroupName').textContent = groupName;

                modal.querySelectorAll('.manage-cameras-checkbox').forEach(function (cb) {
                    cb.checked = memberIds.indexOf(cb.getAttribute('data-camera-id')) !== -1;
                });
            });
        })();
    </script>
}
