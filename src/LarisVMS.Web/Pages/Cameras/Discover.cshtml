@page
@model LarisVMS.Web.Pages.Cameras.DiscoverModel
@{
    ViewData["Title"] = "Discover cameras";
}
<h1>Discover cameras</h1>
<p class="text-muted">
    WS-Discovery only finds cameras on the same broadcast domain as this server (or, once nodes
    exist, the recorder node running the scan). Cameras on another VLAN need to be
    <a asp-page="Edit">added manually</a> with their device service URL.
</p>

<form method="post" asp-page-handler="Scan" class="mb-4">
    <button type="submit" class="btn btn-primary" @(Model.Scanning ? "disabled" : "")>
        Scan LAN (5s)
    </button>
</form>

@if (Model.HasScanned)
{
    @if (Model.Results.Count == 0)
    {
        <div class="alert alert-warning">No devices responded. They may be on a different subnet/VLAN — add manually instead.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Address</th><th>Name / hardware</th><th>Device service URL</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Results)
                    {
                        <tr>
                            <td>@d.RemoteAddress</td>
                            <td>@(d.NameHint ?? d.HardwareHint ?? "—")</td>
                            <td class="font-monospace small">@d.XAddrs.FirstOrDefault()</td>
                            <td>
                                <a class="btn btn-sm btn-primary"
                                   asp-page="Edit"
                                   asp-route-deviceServiceUri="@d.XAddrs.FirstOrDefault()"
                                   asp-route-suggestedName="@(d.NameHint ?? d.HardwareHint ?? d.RemoteAddress)">
                                    Add
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
