@page
@model LarisVMS.Web.Pages.Live.IndexModel
@{
    ViewData["Title"] = Model.Vm?.Name ?? "Live";
}

@if (Model.Vm is { } vm)
{
    <partial name="_PlayContent" model="vm" />
}
else
{
    <h1>Live</h1>

    <p class="text-muted">
        No views exist yet, <a asp-page="/Views/Index">click here to create one!</a>
    </p>
}

@section Scripts {
    @if (Model.Vm is { } vm)
    {
        <partial name="_PlayScripts" model="vm" />
    }
}
