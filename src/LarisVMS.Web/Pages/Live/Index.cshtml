@page
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Live.IndexModel
@{
    ViewData["Title"] = "Live";
}
<h1>Live</h1>

@if (Model.Views.Count > 0)
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-sm-4">
            <select class="form-select" id="liveViewPicker" onchange="if (this.value) location.href = '/Views/Play/' + this.value;">
                <option value="">All cameras (below)</option>
                @foreach (var v in Model.Views)
                {
                    <option value="@v.Id">@v.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-8 text-muted small">
            Pick a saved view to watch its own layout live, with kiosk mode and (if it has a tour
            interval set) rotation through other views. This page's own grid below shows every
            camera flat, always available as a quick fallback.
        </div>
    </div>
}

@if (Model.Cameras.Count == 0)
{
    <p class="text-muted">No cameras are both enabled and assigned to a node yet.</p>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Cameras)
        {
            var mainStream = c.Streams.FirstOrDefault(s => s.Role == CameraStreamRole.Main);
            var hasAudio = mainStream?.HasAudio ?? false;
            <div class="col-12 col-md-6 col-lg-4" data-camera-tile="@c.Id" data-has-audio="@hasAudio.ToString().ToLowerInvariant()" data-codec="@mainStream?.Codec">
                <div class="card h-100">
                    <div class="ratio ratio-16x9 bg-dark">
                        @* No positioning classes here on purpose: this is a direct child of .ratio,
                           so Bootstrap's own ".ratio > *" rule already makes it position:absolute
                           and 100% width/height — adding position-relative (a `!important` utility
                           class) fights that rule instead of complementing it and broke the ratio box
                           entirely (cells rendered square, video never appeared). It still works as a
                           positioning context for the status child below, since position:absolute
                           (which it gets for free) is a valid containing block. *@
                        <div class="camera-tile-frame">
                            <video class="w-100 h-100" style="object-fit: contain;" muted playsinline></video>
                            <div class="position-absolute top-50 start-50 translate-middle text-white small text-center live-status px-2"></div>
                            <span class="badge bg-danger position-absolute top-0 start-0 m-1 live-motion-badge d-none"
                                  title="Motion detected">● Motion</span>
                            @* Only shown once this one tile has been toggled into playback mode (see the
                               live-playback-toggle button below) — every other tile keeps showing pure live
                               video with no timeline at all, exactly as before. Grouped in one wrapper so
                               fullscreen mode (.tile-fullscreen in site.css) can hide both together. Left
                               clearance (`right:96px`) keeps it from sitting under live-controls' own corner. *@
                            <div class="position-absolute bottom-0 start-0 d-none d-flex align-items-end gap-1 p-1 pb-mini-timeline-area" style="right:96px;">
                                <button type="button" class="btn btn-outline-light btn-sm pb-mini-playpause" style="padding:.1rem .35rem;" title="Play/Pause">▶</button>
                                <canvas class="pb-mini-timeline flex-grow-1" style="height:18px; touch-action:none; cursor:pointer; display:block;"></canvas>
                            </div>
                            @* Shown on hover (or always, while this tile is fullscreen — see .tile-fullscreen
                               in site.css) — deliberately not native <video controls>: that includes a
                               click-anywhere-on-the-video-to-pause behavior in most browsers, which makes no
                               sense for a continuous live feed (there's nothing to "resume" from a pause on a
                               live MSE stream) and was confirmed live as unwanted.
                               Double-click the tile itself (not these buttons) toggles fullscreen — see
                               fullscreen-tile.js — with wheel-to-zoom/drag-to-pan active while fullscreen. *@
                            <div class="position-absolute bottom-0 end-0 m-1 btn-group btn-group-sm live-controls d-none">
                                <button type="button" class="btn btn-outline-light live-mute-toggle" style="padding:.1rem .35rem;" title="Mute">🔊</button>
                                <button type="button" class="btn btn-outline-light live-playback-toggle" style="padding:.1rem .35rem;" title="Playback">⏱</button>
                                <button type="button" class="btn btn-outline-light live-fullscreen-toggle" style="padding:.1rem .35rem;" title="Fullscreen">⛶</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body py-2">
                        <span>@c.Name</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script src="~/js/fullscreen-tile.js" asp-append-version="true"></script>
    <script src="~/js/timeline.js" asp-append-version="true"></script>
    <script src="~/js/playback-player.js" asp-append-version="true"></script>
    <script>
        // Live's per-tile playback toggle is single-camera-at-a-time: switching a second tile into
        // playback mode reverts whichever tile was previously toggled back to live first. Keyed by
        // cameraId so exitPlaybackMode() can be reached from any other tile's enterPlaybackMode().
        var liveTileControllers = {};
        function exitAnyOtherPlaybackTile(exceptCameraId) {
            Object.keys(liveTileControllers).forEach(function (id) {
                if (id !== exceptCameraId) liveTileControllers[id].exitPlaybackModeIfActive();
            });
        }

        document.querySelectorAll('[data-camera-tile]').forEach(function (tile) {
            var frame = tile.querySelector('.camera-tile-frame');
            var video = tile.querySelector('video');
            var status = tile.querySelector('.live-status');
            var controls = tile.querySelector('.live-controls');
            var muteBtn = tile.querySelector('.live-mute-toggle');
            var fullscreenBtn = tile.querySelector('.live-fullscreen-toggle');
            var playbackToggleBtn = tile.querySelector('.live-playback-toggle');
            var miniTimelineArea = tile.querySelector('.pb-mini-timeline-area');
            var miniTimelineCanvas = tile.querySelector('.pb-mini-timeline');
            var miniPlayPauseBtn = tile.querySelector('.pb-mini-playpause');

            var cameraId = tile.dataset.cameraTile;
            var codec = tile.dataset.codec;
            var hasAudio = tile.dataset.hasAudio === 'true';

            var liveStop = null;
            var pbPlayer = null;
            var pbTimeline = null;
            var pbPlaying = false;
            var inPlaybackMode = false;

            tile.addEventListener('mouseenter', function () { if (controls) controls.classList.remove('d-none'); });
            tile.addEventListener('mouseleave', function () { if (controls) controls.classList.add('d-none'); });

            function setMuteIcon() {
                if (!muteBtn) return;
                muteBtn.textContent = video.muted ? '🔇' : '🔊';
                muteBtn.title = video.muted ? 'Unmute' : 'Mute';
            }
            if (muteBtn) {
                muteBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    video.muted = !video.muted;
                    setMuteIcon();
                });
            }

            // Fullscreens the tile's own frame (video + status/motion badge + controls), not the
            // bare <video> — keeps these buttons themselves inside the fullscreened render subtree
            // (see fullscreen-tile.js's own comment for why) so exiting fullscreen has a button, not
            // just Esc. Double-clicking the frame does the same toggle; both share one wired handle.
            var fsHandle = window.larisvmsFullscreenTile.wire(frame, video, {
                onFullscreenChange: function (active) {
                    if (!fullscreenBtn) return;
                    fullscreenBtn.textContent = active ? '⤢' : '⛶';
                    fullscreenBtn.title = active ? 'Exit fullscreen' : 'Fullscreen';
                }
            });
            if (fullscreenBtn) {
                fullscreenBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (fsHandle.isFullscreen()) fsHandle.exitFullscreen();
                    else frame.requestFullscreen().catch(function () { /* ignore */ });
                });
            }

            function startLive() {
                // No stop() was kept before this feature existed — every camera connected for as
                // long as the page stayed open, with start()'s own auto-reconnect handling drops on
                // its own. Now retained per-tile specifically so entering playback mode can end this
                // session cleanly instead of leaving it running underneath the swapped-in player.
                liveStop = window.larisvmsLiveView.start(cameraId, video, status, codec, hasAudio);
            }

            // Reuses playback-player.js's own MSE/segment-fetch tile (exactly what the Playback page
            // uses) rather than reimplementing it — only the mini timeline + play/pause wrapper here
            // is new. No timeline is ever added to a tile that stays live; this only appears on the
            // one tile actively toggled into playback mode.
            async function enterPlaybackMode() {
                if (inPlaybackMode) return;
                exitAnyOtherPlaybackTile(cameraId);
                if (liveStop) { liveStop(); liveStop = null; }
                inPlaybackMode = true;
                if (playbackToggleBtn) { playbackToggleBtn.textContent = '📡'; playbackToggleBtn.title = 'Back to live'; }
                if (miniTimelineArea) miniTimelineArea.classList.remove('d-none');
                status.textContent = 'Loading…';

                pbPlayer = window.larisvmsPlaybackPlayer.createTile(cameraId, video, status, codec, hasAudio);
                var initialMs = await window.larisvmsPlaybackPlayer.resolveInitialPlayheadMs(cameraId);
                pbPlaying = false;
                if (miniPlayPauseBtn) miniPlayPauseBtn.textContent = '▶';
                if (miniTimelineCanvas) {
                    pbTimeline = window.larisvmsTimeline.create(miniTimelineCanvas, {
                        initialCenterMs: initialMs,
                        initialRangeMs: 10 * 60 * 1000,
                        onScrub: function (ms) { if (pbPlayer) pbPlayer.seekTo(ms, pbPlaying); }
                    });
                }
                await pbPlayer.seekTo(initialMs, false);
            }

            function exitPlaybackModeIfActive() {
                if (!inPlaybackMode) return;
                inPlaybackMode = false;
                if (playbackToggleBtn) { playbackToggleBtn.textContent = '⏱'; playbackToggleBtn.title = 'Playback'; }
                if (miniTimelineArea) miniTimelineArea.classList.add('d-none');
                if (pbPlayer) { pbPlayer.teardown(); pbPlayer = null; }
                pbTimeline = null;
                startLive();
            }

            if (playbackToggleBtn) {
                playbackToggleBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (inPlaybackMode) exitPlaybackModeIfActive(); else enterPlaybackMode();
                });
            }
            if (miniPlayPauseBtn) {
                miniPlayPauseBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (!inPlaybackMode || !pbPlayer) return;
                    pbPlaying = !pbPlaying;
                    miniPlayPauseBtn.textContent = pbPlaying ? '⏸' : '▶';
                    if (pbPlaying) video.play().catch(function () { /* autoplay policy */ }); else video.pause();
                });
            }

            liveTileControllers[cameraId] = { exitPlaybackModeIfActive: exitPlaybackModeIfActive };

            // Starts muted regardless of any previous session's state — autoplay-with-sound is
            // blocked by browser policy anyway, and starting muted keeps behavior consistent across
            // tiles instead of depending on whichever camera happened to be unmuted last.
            video.muted = true;
            setMuteIcon();
            startLive();
        });

        // M8, unverified against a real camera: the motion-detection pipeline itself has never been
        // watched trip against a real event, so treat this badge the same way for now — a visual
        // aid to check, not yet a proven signal.
        window.larisvmsLiveView.startMotionIndicatorPolling(5000);
    </script>
}
