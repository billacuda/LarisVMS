@page
@model LarisVMS.Web.Pages.Logs.AuditLogsModel
@{
    ViewData["Title"] = "Audit Logs";
}
<h1>Logs</h1>
<partial name="_LogsTabs" model="@("AuditLogs")" />

<p class="text-muted">
    Who did what and when — logins, camera/node/settings changes, and exports. Retention is
    configurable on <a asp-page="/Admin/Settings/Logs">Admin &rarr; Settings &rarr; Logs</a>
    (kept forever by default).
</p>

@* Selections survive navigating away and refreshing — see remember-filters.js. *@
<form method="get" class="row g-2 mb-3" data-remember-filters="auditlogs">
    <div class="col-md-3">
        <input type="text" name="q" value="@Model.Query" class="form-control form-control-sm" placeholder="Search action or details..." />
    </div>
    <div class="col-md-2">
        <input type="text" name="actor" value="@Model.ActorFilter" class="form-control form-control-sm" placeholder="Actor username..." />
    </div>
    <div class="col-md-2">
        <input type="date" name="from" value="@Model.From" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@Model.To" class="form-control form-control-sm" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a href="/Logs/AuditLogs" class="btn btn-sm btn-outline-secondary w-100" data-clear-filters>Clear</a>
    </div>
    @if (Model.CanExport)
    {
        <div class="col-md-1">
            <a href="?handler=Export&q=@Uri.EscapeDataString(Model.Query ?? "")&actor=@Uri.EscapeDataString(Model.ActorFilter ?? "")&from=@Uri.EscapeDataString(Model.From ?? "")&to=@Uri.EscapeDataString(Model.To ?? "")"
               class="btn btn-sm btn-outline-secondary w-100">Export CSV</a>
        </div>
    }
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Action</th>
                    <th>Actor</th>
                    <th>Details</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="small text-muted text-nowrap" title="@log.OccurredAt.ToString("u")">@log.OccurredAt.ToLocalTime().ToString("g")</td>
                        <td class="small font-monospace">@log.Action</td>
                        <td class="small">@(log.UserName ?? log.UserId ?? "system")</td>
                        <td class="small">@log.Details</td>
                        <td class="small text-muted">@log.IpAddress</td>
                    </tr>
                }
                @if (Model.Logs.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No audit log entries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* pageNumber, not page — see AuditLogsModel.OnGetAsync's own comment for why "page" is a reserved
   Razor Pages route-value name and silently never binds. Each filter value is escaped here (the
   per-page @for loop this replaced never was) — Query/ActorFilter are free-text search input, and an
   unescaped "&" or "#" in either would otherwise corrupt the very query string carrying it. *@
<partial name="Shared/_PaginationControls" model="@(new LarisVMS.Web.Helpers.PaginationViewModel(
    Model.CurrentPage, Model.TotalPages,
    p => $"?q={Uri.EscapeDataString(Model.Query ?? "")}&actor={Uri.EscapeDataString(Model.ActorFilter ?? "")}" +
         $"&from={Uri.EscapeDataString(Model.From ?? "")}&to={Uri.EscapeDataString(Model.To ?? "")}&pageNumber={p}"))" />
