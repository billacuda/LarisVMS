@* Shared tab strip for the Logs area. Each tab is a real page with its own route and its own
   [Authorize] policy (Logs.View for the audit trail, SystemLogs.View for the application log) —
   deliberately not a client-side JS panel toggle, since combining two independently-gated,
   independently-paginated views into one page load would mean fetching both every time regardless
   of which one is actually being looked at, or duplicating each page's own query-string filter
   state into one shared component. A plain nav-tabs strip that navigates between real pages costs
   nothing extra and keeps each page's existing filter/pagination logic untouched.
   Model: the active tab's key ("AuditLogs" or "SystemLogs"). *@
@model string
@{
    (string Key, string Href, string Label)[] tabs =
    [
        ("AuditLogs", "/Logs/AuditLogs", "📋 Audit Logs"),
        ("SystemLogs", "/Logs/SystemLogs", "🖥️ System Logs")
    ];
}
<ul class="nav nav-tabs mb-3">
    @foreach (var (key, href, label) in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(key == Model ? "active" : "")" href="@href">@label</a>
        </li>
    }
</ul>
