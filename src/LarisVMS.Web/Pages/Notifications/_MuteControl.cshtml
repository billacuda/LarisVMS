@model (Guid RuleId, DateTime MutedUntilUtc, string ReturnTab)
@* Mute one subscription for a while. MutedUntilUtc is default(DateTime) when not muted. *@
@{
    var muted = Model.MutedUntilUtc > DateTime.UtcNow;
}
<form method="post" asp-page-handler="Mute" class="d-flex align-items-center gap-1">
    <input type="hidden" name="ruleId" value="@Model.RuleId" />
    <input type="hidden" name="returnTab" value="@Model.ReturnTab" />
    @if (muted)
    {
        <span class="small text-muted">
            @if (Model.MutedUntilUtc == DateTime.MaxValue) { <text>@L["notifications.muteControl.mutedUntilOn"]</text> }
            else { <text>@L.Html("notifications.muteControl.mutedUntil", new { time = Model.MutedUntilUtc.ToTimeTag() })</text> }
        </span>
        <button type="submit" name="muteFor" value="off" class="btn btn-sm btn-outline-secondary">@L["notifications.muteControl.unmute"]</button>
    }
    else
    {
        <select name="muteFor" class="form-select form-select-sm" style="width: auto;" aria-label="@L["notifications.muteControl.mute"]" title="@L["common.appliesImmediately"]" data-submit-on-change>
            <option value="">@L["notifications.muteControl.mute2"]</option>
            <option value="1">@L["notifications.muteControl.for1Hour"]</option>
            <option value="8">@L["notifications.muteControl.for8Hours"]</option>
            <option value="24">@L["notifications.muteControl.for1Day"]</option>
            <option value="forever">@L["notifications.muteControl.untilITurnItBack"]</option>
        </select>
    }
</form>
