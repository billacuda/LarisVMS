@page
@using System.Text.Json
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Playback.IndexModel
@{
    ViewData["Title"] = L["nav.playback"].Value;
    var camerasJson = JsonSerializer.Serialize(Model.Cameras.Select(c =>
    {
        var main = c.Streams.FirstOrDefault(s => s.Role == CameraStreamRole.Main);
        // hasSpeaker: recorded two-way audio can play on this camera's tiles even when the camera
        // sends no audio of its own, so its tiles still get a volume control.
        return new { id = c.Id, name = c.Name, codec = main?.Codec, hasAudio = main?.HasAudio ?? false,
            hasSpeaker = c.Capabilities != null && c.Capabilities.HasAudioOut };
    }));
    var viewsJson = JsonSerializer.Serialize(Model.Views.Select(v => new { id = v.Id, name = v.Name, layoutJson = v.LayoutJson }));
}

@if (Model.Cameras.Count == 0)
{
    <h1>@L["nav.playback"]</h1>
    <p class="text-muted">@L["playback.noCamerasAreBothEnabled"]</p>
}
else if (Model.Views.Count == 0)
{
    <h1>@L["nav.playback"]</h1>
    <p class="text-muted">
        @L.Html("playback.noViewsYet")
    </p>
}
else
{
    @* id="pbLayout" fills whatever vertical space is left below the nav bar (measured/kept in sync
       by JS — see layoutForViewport in the Scripts section — since the nav's actual height varies
       with viewport width, e.g. the collapsed hamburger menu on narrow screens). The video grid
       takes all the remaining room after the toolbar and timeline strip claim theirs; the timeline
       stays pinned at the bottom of that space rather than wherever document flow would put it. *@
    <div id="pbLayout" style="display:flex; flex-direction:column; min-height:0;">
        <div class="d-flex flex-wrap align-items-center gap-2 py-2" id="pbToolbar">
            <label for="playbackViewPicker" class="form-label small mb-0">@L["playback.view"]</label>
            <select id="playbackViewPicker" class="form-select form-select-sm" style="max-width: 16rem;">
                <option value="">@L["playback.chooseAView"]</option>
                @* Camera count in the label — same form as the Views/Play picker. *@
                @foreach (var v in Model.Views)
                {
                    <option value="@v.Id">@L["views.nameWithCells", new { name = v.Name, cells = ViewLayout.CountCells(v.LayoutJson) }]</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pbPlayPause" disabled>@L["playback.play"]</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pbJumpNow" title="@L["playback.jumpEveryCameraToThe"]" disabled><span aria-hidden="true">⏭</span> @L["playback.now"]</button>
            <label class="form-label small mb-0" for="pbSpeed">@L["playback.speed"]</label>
            <select id="pbSpeed" class="form-select form-select-sm" style="max-width: 6rem;">
                <option value="0.03125">1/32×</option>
                <option value="0.0625">1/16×</option>
                <option value="0.125">1/8×</option>
                <option value="0.25">1/4×</option>
                <option value="0.5">1/2×</option>
                <option value="1" selected>1×</option>
                <option value="2">2×</option>
                <option value="4">4×</option>
                <option value="8">8×</option>
                <option value="16">16×</option>
                <option value="32">32×</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pbExportBtn"><span aria-hidden="true">🎬</span> @L["playback.export"]</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pbBookmarkBtn"><span aria-hidden="true">🔖</span> @L["playback.bookmark"]</button>
            @if (Model.CanLock)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" id="pbLockBtn" title="@L["playback.keepThisFootageFromBeing"]"><span aria-hidden="true">🔒</span> @L["playback.lock"]</button>
            }
            @* Populated only for a Bookmark's "▶ Play" deep link whose camera isn't in any view this
               user can see (Pages/Bookmarks/Index.cshtml.cs's own doc comment describes this case) —
               empty and invisible on an ordinary visit. *@
            <span id="pbDeepLinkStatus" class="small" role="status" aria-live="polite"></span>
            <div class="form-check form-switch mb-0 ms-auto">
                <input type="checkbox" class="form-check-input" id="pbEventTags" />
                <label class="form-check-label small" for="pbEventTags">@L["playback.eventTags"]</label>
            </div>
            <div class="form-check form-switch mb-0">
                <input type="checkbox" class="form-check-input" id="pbHour24" />
                <label class="form-check-label small" for="pbHour24">@L["playback.24HourClock"]</label>
            </div>
            @* Only meaningful on a phone-width viewport, where the timeline overlays the video and
               can auto-hide (see wireMobileTimelineOverlay) — hidden on desktop rather than shown as
               an always-inert control. *@
            <div class="form-check form-switch mb-0 d-md-none">
                <input type="checkbox" class="form-check-input" id="pbAutoHideTimeline" />
                <label class="form-check-label small" for="pbAutoHideTimeline">@L["playback.autoHideTimeline"]</label>
            </div>
        </div>

        @* Hidden until Export… is clicked — a plain inline form, not a modal, per the feature's own
           "don't over-build this" guidance. Cameras are whichever are currently on screen in the
           cameras (populated in JS from the full camera list, pre-checked for whatever's in the
           selected view), start/end default to a 5-minute window centered on the current playhead. *@
        <div id="pbExportPanel" class="d-none border rounded p-2 mb-2 bg-body-tertiary" style="flex:0 0 auto;">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <span class="form-label small mb-1 d-block" id="pbExportCamerasLabel">@L["nav.cameras"]</span>
                    <details class="position-relative column-picker" id="pbExportCamerasPicker">
                        <summary class="form-select form-select-sm text-start text-truncate" id="pbExportCamerasSummary" aria-labelledby="pbExportCamerasLabel pbExportCamerasSummary" style="min-width: 12rem; max-width: 18rem;">@L["playback.chooseCameras"]</summary>
                        <div class="column-picker-menu" id="pbExportCameras" style="inset-inline-start: 0; inset-inline-end: auto; min-width: 16rem;"></div>
                    </details>
                </div>
                <div>
                    <label class="form-label small mb-0" for="pbExportFrom">@L["common.start"]</label>
                    <input type="datetime-local" id="pbExportFrom" class="form-control form-control-sm" step="1" />
                </div>
                <div>
                    <label class="form-label small mb-0" for="pbExportTo">@L["playback.end"]</label>
                    <input type="datetime-local" id="pbExportTo" class="form-control form-control-sm" step="1" />
                </div>
                <button type="button" class="btn btn-sm btn-primary" id="pbExportSubmit">@L["playback.startExport"]</button>
                <span id="pbExportStatus" class="small" role="status" aria-live="polite"></span>
            </div>
        </div>

        @* Hidden until Bookmark… is clicked, same "plain inline form, not a modal" shape as the
           export panel above. Marks the *primary* (starred) tile's camera at the current playhead —
           the same camera the per-camera timeline already drives — since a bookmark is one instant on
           one camera's timeline, not a whole view. *@
        <div id="pbBookmarkPanel" class="d-none border rounded p-2 mb-2 bg-body-tertiary" style="flex:0 0 auto;">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <span id="pbBookmarkTarget" class="small text-muted"></span>
                <div class="flex-grow-1" style="min-width:12rem;">
                    <label class="form-label small mb-0" for="pbBookmarkNote">@L["playback.note"]</label>
                    <input type="text" id="pbBookmarkNote" class="form-control form-control-sm" maxlength="1000" placeholder="@L["playback.whatHappeningHere"]" />
                </div>
                <button type="button" class="btn btn-sm btn-primary" id="pbBookmarkSubmit">@L["playback.saveBookmark"]</button>
                <span id="pbBookmarkStatus" class="small" role="status" aria-live="polite"></span>
            </div>
        </div>

        @* Evidence lock: same inline-panel shape as Export. More than 30 days shows the storage warning
           with a shortcut to export the same range instead. *@
        @if (Model.CanLock)
        {
            <div id="pbLockPanel" class="d-none border rounded p-2 mb-2 bg-body-tertiary" style="flex:0 0 auto;">
                <div class="d-flex flex-wrap align-items-end gap-3">
                    <div>
                        <span class="form-label small mb-1 d-block" id="pbLockCamerasLabel">@L["nav.cameras"]</span>
                        <details class="position-relative column-picker" id="pbLockCamerasPicker">
                            <summary class="form-select form-select-sm text-start text-truncate" id="pbLockCamerasSummary" aria-labelledby="pbLockCamerasLabel pbLockCamerasSummary" style="min-width: 12rem; max-width: 18rem;">@L["playback.chooseCameras"]</summary>
                            <div class="column-picker-menu" id="pbLockCameras" style="inset-inline-start: 0; inset-inline-end: auto; min-width: 16rem;"></div>
                        </details>
                    </div>
                    <div>
                        <label class="form-label small mb-0" for="pbLockFrom">@L["common.start"]</label>
                        <input type="datetime-local" id="pbLockFrom" class="form-control form-control-sm" step="1" />
                    </div>
                    <div>
                        <label class="form-label small mb-0" for="pbLockTo">@L["playback.end"]</label>
                        <input type="datetime-local" id="pbLockTo" class="form-control form-control-sm" step="1" />
                    </div>
                    <div>
                        <label class="form-label small mb-0" for="pbLockDuration">@L["playback.keepFor"]</label>
                        <select id="pbLockDuration" class="form-select form-select-sm">
                            <option value="1d">@L["playback.1Day"]</option>
                            <option value="3d">@L["playback.3Days"]</option>
                            <option value="7d" selected>@L["playback.7Days"]</option>
                            <option value="14d">@L["playback.14Days"]</option>
                            <option value="30d">@L["playback.30Days"]</option>
                            <option value="custom">@L["playback.untilADate"]</option>
                            <option value="indefinite">@L["playback.indefinitely"]</option>
                        </select>
                    </div>
                    <div id="pbLockUntilWrap" class="d-none">
                        <label class="form-label small mb-0" for="pbLockUntil">@L["playback.until"]</label>
                        <input type="date" id="pbLockUntil" class="form-control form-control-sm" />
                    </div>
                    <div class="flex-grow-1" style="min-width:12rem;">
                        <label class="form-label small mb-0" for="pbLockReason">@L["playback.reason"]</label>
                        <input type="text" id="pbLockReason" class="form-control form-control-sm" maxlength="500" placeholder="@L["playback.caseNumberIncidentOrRequest"]" />
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" id="pbLockSubmit">@L["playback.lockFootage"]</button>
                    <span id="pbLockStatus" class="small" role="status" aria-live="polite"></span>
                </div>
                <div id="pbLockWarning" class="d-none">
                    <div class="alert alert-warning small py-1 px-2 mt-2 mb-0 d-flex flex-wrap align-items-center gap-2" role="alert">
                        <span class="flex-grow-1">@L["playback.locksLongerThan30Days"]</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="pbLockExportInstead">@L["playback.exportThisRangeInstead"]</button>
                    </div>
                </div>
                <div class="small text-muted mt-1">@L["playback.lockedFootageIsNeverDeleted"] <a href="/Help/live-and-playback#evidence-locks">@L["common.learnMore"]</a></div>
            </div>
        }

        <div id="playbackTiles" style="flex:1 1 auto; min-height:0;"></div>

        <div id="pbTimelineArea" style="flex:0 0 auto;" class="pt-1">
            @* "Selected camera" only needs saying while the "All cameras" strip below is also
               showing. For single-camera playback (one tile) playback-player.js hides both this
               label and #pbGlobalTimelineWrap to give the video grid back that vertical space. *@
            <div id="pbSelectedCameraLabel" class="form-label small mb-0">@L["playback.selectedCamera"]</div>
            <canvas id="playbackTimeline" aria-labelledby="pbSelectedCameraLabel" style="width: 100%; height: 30px; cursor: pointer; touch-action: none; display: block;"></canvas>
            <div class="d-flex justify-content-center align-items-center gap-2 mb-1">
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" id="pbTimelineZoomOut" title="@L["playback.timelineZoomOut"]" aria-label="@L["playback.timelineZoomOut"]">−</button>
                <div id="pbCurrentTime" class="text-muted small text-center"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0" id="pbTimelineZoomIn" title="@L["playback.timelineZoomIn"]" aria-label="@L["playback.timelineZoomIn"]">+</button>
            </div>

            <div id="pbGlobalTimelineWrap">
                <div id="pbGlobalTimelineLabel" class="form-label small mb-0">@L["playback.allCamerasRecordingOnAny"]</div>
                <canvas id="playbackGlobalTimeline" aria-labelledby="pbGlobalTimelineLabel" style="width: 100%; height: 30px; cursor: pointer; touch-action: none; display: block;"></canvas>
            </div>

            <p class="text-muted small mt-1 mb-0">@L["playback.scrollToZoomDragTo"] <a href="/Help/live-and-playback#timeline">@L["playback.moreTips"]</a></p>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/audio-controls.js" asp-append-version="true"></script>
    <script src="~/js/timeline.js" asp-append-version="true"></script>
    <script src="~/js/fullscreen-tile.js" asp-append-version="true"></script>
    <script src="~/js/catchup-badge.js" asp-append-version="true"></script>
    <script src="~/js/talk-playback.js" asp-append-version="true"></script>
    <script src="~/js/speed-playback.js" asp-append-version="true"></script>
    <script src="~/js/canvas-keyboard.js" asp-append-version="true"></script>
    <script src="~/js/redaction-editor.js" asp-append-version="true"></script>
    <script src="~/js/playback-player.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        (function () {
            var layoutEl = document.getElementById('pbLayout');
            if (!layoutEl) return; // no cameras/views — nothing to size

            // Keeps the whole layout filling exactly the space below the nav bar, so the timeline
            // stays pinned at the bottom of the viewport and the video grid claims everything above
            // it — recomputed on resize per the requirement that this adapt live, not just on load.
            // Measures pbLayout's own current top (not the nav's) so this stays correct regardless
            // of margins/padding between the nav and here — whatever's actually above this element.
            function layoutForViewport() {
                var top = layoutEl.getBoundingClientRect().top;
                layoutEl.style.height = Math.max(200, window.innerHeight - top) + 'px';
            }
            layoutForViewport();
            window.addEventListener('resize', layoutForViewport);

            window.larisvmsPlaybackPage.init({
                cameras: @Html.Raw(camerasJson),
                views: @Html.Raw(viewsJson),
                pickerId: 'playbackViewPicker',
                tilesId: 'playbackTiles',
                timelineCanvasId: 'playbackTimeline',
                globalTimelineCanvasId: 'playbackGlobalTimeline',
                timelineAreaId: 'pbTimelineArea',
                playPauseBtnId: 'pbPlayPause',
                jumpNowBtnId: 'pbJumpNow',
                speedSelectId: 'pbSpeed',
                currentTimeId: 'pbCurrentTime',
                hour24ToggleId: 'pbHour24',
                eventTagsToggleId: 'pbEventTags',
                autoHideToggleId: 'pbAutoHideTimeline',
                exportBtnId: 'pbExportBtn',
                exportPanelId: 'pbExportPanel',
                exportCamerasId: 'pbExportCameras',
                exportFromId: 'pbExportFrom',
                exportToId: 'pbExportTo',
                exportSubmitId: 'pbExportSubmit',
                exportStatusId: 'pbExportStatus',
                bookmarkBtnId: 'pbBookmarkBtn',
                bookmarkPanelId: 'pbBookmarkPanel',
                bookmarkTargetId: 'pbBookmarkTarget',
                bookmarkNoteId: 'pbBookmarkNote',
                bookmarkSubmitId: 'pbBookmarkSubmit',
                bookmarkStatusId: 'pbBookmarkStatus',
                lockBtnId: 'pbLockBtn',
                lockPanelId: 'pbLockPanel',
                lockCamerasId: 'pbLockCameras',
                lockFromId: 'pbLockFrom',
                lockToId: 'pbLockTo',
                lockDurationId: 'pbLockDuration',
                lockUntilWrapId: 'pbLockUntilWrap',
                lockUntilId: 'pbLockUntil',
                lockReasonId: 'pbLockReason',
                lockWarningId: 'pbLockWarning',
                lockExportInsteadId: 'pbLockExportInstead',
                lockSubmitId: 'pbLockSubmit',
                lockStatusId: 'pbLockStatus',
                // M18: a Bookmark's "▶ Play" link (Pages/Bookmarks/Index) — both null for an
                // ordinary visit. deepLinkAtUtc is an ISO string (Html.Raw's JSON-encoded form of a
                // DateTime); the client parses it once cameras/views are loaded.
                deepLinkCameraId: @Html.Raw(Model.CameraId is { } dlc ? System.Text.Json.JsonSerializer.Serialize(dlc.ToString()) : "null"),
                deepLinkAtUtc: @Html.Raw(Model.AtUtc is { } dla ? System.Text.Json.JsonSerializer.Serialize(dla.ToString("o")) : "null"),
                deepLinkStatusId: 'pbDeepLinkStatus'
            });
        })();
    </script>
}
