@page
@model LarisVMS.Web.Pages.Snapshots.IndexModel
@{
    ViewData["Title"] = "Snapshots";
    // Reused by the pagination links below so paging preserves whatever the kinds filter is
    // currently set to — null (never touched) means no suffix at all, matching Kinds' own
    // "absent = no additional narrowing" default.
    var kindsQuery = Model.Kinds is null ? "" : string.Concat(Model.Kinds.Select(k => "&kinds=" + Uri.EscapeDataString(k)));
}
<h1>Snapshots</h1>
<p class="text-muted">
    Every motion event, browsable as a thumbnail — zones, camera-pushed motion, custom tags, and
    detected objects all appear here. Each thumbnail is pulled live from the recording itself, so a
    card with no image means that moment's footage has since aged out of retention.
</p>

@* data-remember-filters: these selections survive navigating away and coming back, or a refresh —
   see remember-filters.js. The Clear link below carries data-clear-filters so clearing actually
   clears rather than being restored again on the next load. *@
<form method="get" class="row g-2 mb-3" data-remember-filters="snapshots">
    <div class="col-md-3">
        <select name="cameraId" class="form-select form-select-sm">
            <option value="">All cameras</option>
            @foreach (var c in Model.Cameras)
            {
                <option value="@c.Id" selected="@(Model.CameraId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="from" value="@Model.From" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@Model.To" class="form-control form-control-sm" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a href="/Snapshots" class="btn btn-sm btn-outline-secondary w-100" data-clear-filters>Clear</a>
    </div>

    @* Only checkboxes actually posted change anything (an unchecked box submits nothing at all), so
       every one starts checked unless the URL already names a narrower set — see IsKindChecked's own
       comment for why that's the right default for both a fresh visit and a Filter re-submit. *@
    <div class="col-12 d-flex flex-wrap gap-3 mt-1">
        <div class="form-check form-check-inline mb-0">
            <input type="checkbox" class="form-check-input" id="kind-motion" name="kinds" value="Motion" checked="@Model.IsKindChecked("Motion")" />
            <label class="form-check-label small" for="kind-motion">🌀 Motion</label>
        </div>
        <div class="form-check form-check-inline mb-0">
            <input type="checkbox" class="form-check-input" id="kind-customtag" name="kinds" value="@IndexModel.CustomTagToken" checked="@Model.IsKindChecked(IndexModel.CustomTagToken)" />
            <label class="form-check-label small" for="kind-customtag">🏷️ Custom tags</label>
        </div>
        @foreach (var kind in Model.DetectionKinds)
        {
            var name = kind.ToString();
            <div class="form-check form-check-inline mb-0">
                <input type="checkbox" class="form-check-input" id="kind-@name" name="kinds" value="@name" checked="@Model.IsKindChecked(name)" />
                <label class="form-check-label small" for="kind-@name">
                    @LarisVMS.Core.Enums.DetectionDisplay.Emoji(kind) @LarisVMS.Core.Enums.DetectionDisplay.Label(kind)
                </label>
            </div>
        }
    </div>
</form>

@if (Model.Results.Items.Count == 0)
{
    <p class="text-muted">No motion events found@(Model.CameraId is not null || Model.From is not null || Model.To is not null ? " for this filter." : " yet.")</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var s in Model.Results.Items)
        {
            var atUtcIso = s.AtUtc.ToString("o");
            <div class="col">
                <div class="card h-100" style="border-color: @s.ColorHex;">
                    @* Plain hand-written href, not asp-page/asp-route-* — matches Bookmarks/Index.cshtml's
                       own "▶ Play" link exactly (same deep-link scheme, same destination page), after the
                       tag-helper form of this same link was confirmed live to render pointing back at this
                       page's own current filter state instead of /Playback. Bookmarks' plain-string version
                       has been live and working since M18; this sidesteps whatever the tag-helper issue was
                       rather than chasing it further. *@
                    <a href="/Playback?cameraId=@s.CameraId&atUtc=@Uri.EscapeDataString(atUtcIso)">
                        @* object-fit:contain, not cover — cover crops a non-16:9 source frame (portrait
                           cameras especially) to fill the box; contain always shows the whole frame,
                           letterboxed instead of cropped. exact=true resolves this instant precisely
                           rather than snapping to the nearest 5 minutes (see GetExactThumbnailInfoAsync)
                           — a motion event is exactly the kind of moment likely to fall in a bucketed
                           lookup's coverage gap on a Motion-mode camera. onerror swaps in a text
                           placeholder rather than just hiding the image, so a card whose footage has
                           since aged out of retention still reads as "nothing here", not "broken". *@
                        <img src="/playback-thumbnail/@s.CameraId?atUtc=@Uri.EscapeDataString(atUtcIso)&exact=true"
                             loading="lazy" class="card-img-top" style="aspect-ratio: 16/9; object-fit: contain; background: var(--bs-secondary-bg);"
                             alt="Snapshot thumbnail"
                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                        <div class="d-none text-muted small text-center d-flex align-items-center justify-content-center"
                             style="aspect-ratio: 16/9; background: var(--bs-secondary-bg);">
                            No thumbnail available
                        </div>
                    </a>
                    <div class="card-body py-2 px-2">
                        <span class="badge" style="background-color: @s.ColorHex;">@s.Emoji @s.Label</span>
                        <span class="badge bg-secondary" title="How long this event lasted">@IndexModel.FormatDuration(s.Duration)</span>
                        <div class="small text-muted mt-1">@s.CameraName</div>
                        <div class="small text-muted" title="@s.AtUtc.ToString("u")">@s.AtUtc.ToLocalTime().ToString("g")</div>
                    </div>
                    <div class="card-footer py-1 px-2 text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Playback?cameraId=@s.CameraId&atUtc=@Uri.EscapeDataString(atUtcIso)">▶ Play</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* pageNumber, not page — see IndexModel.OnGetAsync's own comment for why "page" is a reserved Razor
   Pages route-value name and silently never binds from here. *@
<partial name="Shared/_PaginationControls" model="@(new LarisVMS.Web.Helpers.PaginationViewModel(
    Model.Results.CurrentPage, Model.Results.TotalPages,
    p => $"?cameraId={Model.CameraId}&from={Model.From}&to={Model.To}&pageNumber={p}{kindsQuery}"))" />
