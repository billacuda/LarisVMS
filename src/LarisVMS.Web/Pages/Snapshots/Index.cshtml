@page
@model LarisVMS.Web.Pages.Snapshots.IndexModel
@{
    ViewData["Title"] = "Snapshots";
    // Reused by the pagination links below so paging preserves whatever the kinds/excludedLabels
    // filters are currently set to — null (never touched) means no suffix at all, matching each
    // one's own "absent = no additional narrowing" default.
    var kindsQuery = Model.Kinds is null ? "" : string.Concat(Model.Kinds.Select(k => "&kinds=" + Uri.EscapeDataString(k)));
    var excludedLabelsQuery = Model.ExcludedLabels is null ? "" : string.Concat(Model.ExcludedLabels.Select(l => "&excludedLabels=" + Uri.EscapeDataString(l)));

    // pageNumber, not page — see IndexModel.OnGetAsync's own comment for why "page" is a reserved
    // Razor Pages route-value name and silently never binds from here. Built once, rendered both
    // above and below the grid so paging is reachable wherever the user is scrolled.
    Func<int, string> snapshotPageUrl = p => $"?mode={Model.Mode}&cameraId={Model.CameraId}&groupId={Model.GroupId}&viewId={Model.ViewId}&from={Model.From}&to={Model.To}&pageNumber={p}{kindsQuery}{excludedLabelsQuery}";
}
<h1>Snapshots <span id="snapshotLoadStatus" class="badge bg-secondary ms-2 d-none fw-normal"></span></h1>
<p class="text-muted">
    Every motion event, browsable as a thumbnail — zones, camera-pushed motion, custom tags, and
    detected objects all appear here. Each thumbnail is pulled live from the recording itself, and a
    card disappears once its own footage ages out of retention, so what's shown here can always be
    played back.
</p>

@* data-remember-filters: these selections survive navigating away and coming back, or a refresh —
   see remember-filters.js. The Clear link below carries data-clear-filters so clearing actually
   clears rather than being restored again on the next load. *@
<form method="get" class="row g-2 mb-3" data-remember-filters="snapshots" id="snapshotFilterForm">
    <div class="col-md-2">
        <select name="mode" id="snapshotMode" class="form-select form-select-sm">
            <option value="single" selected="@(Model.Mode == "single")">Single camera</option>
            <option value="all" selected="@(Model.Mode == "all")">All cameras</option>
            <option value="group" selected="@(Model.Mode == "group")">Camera group</option>
            <option value="view" selected="@(Model.Mode == "view")">View</option>
        </select>
    </div>
    <div class="col-md-3 snapshot-mode-target" data-for-mode="single">
        <select name="cameraId" class="form-select form-select-sm">
            @foreach (var c in Model.Cameras)
            {
                <option value="@c.Id" selected="@(Model.CameraId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3 snapshot-mode-target d-none" data-for-mode="group">
        <select name="groupId" class="form-select form-select-sm">
            <option value="">Select a group…</option>
            @foreach (var g in Model.Groups)
            {
                <option value="@g.Id" selected="@(Model.GroupId == g.Id)">@(new string('—', Model.Depth(g))) @g.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3 snapshot-mode-target d-none" data-for-mode="view">
        <select name="viewId" class="form-select form-select-sm">
            <option value="">Select a view…</option>
            @foreach (var v in Model.Views)
            {
                <option value="@v.Id" selected="@(Model.ViewId == v.Id)">@v.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="from" value="@Model.From" class="form-control form-control-sm" />
    </div>
    <div class="col-md-2">
        <input type="date" name="to" value="@Model.To" class="form-control form-control-sm" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a href="/Snapshots" class="btn btn-sm btn-outline-secondary w-100" data-clear-filters>Clear</a>
    </div>
</form>

@{
    // Unified top-level filter-tree nodes: DetectionKinds ∪ AI-detection categories, deduped by
    // name — the same "Vehicle"/"Animal"/"Human" shared-token dedup TimelineService.GetSnapshotsAsync's
    // own kinds-filter comment describes, now driving the tree instead of two separate checkbox rows.
    var topLevelKinds = Model.DetectionKinds
        .Select(k => (Name: k.ToString(), Emoji: (string?)LarisVMS.Core.Enums.DetectionDisplay.Emoji(k), ColorHex: (string?)null))
        .ToList();
    var topLevelCategoriesOnly = Model.DetectedObjectCategories
        .Where(c => !topLevelKinds.Any(k => k.Name.Equals(c.Name, StringComparison.OrdinalIgnoreCase)))
        .Select(c => (Name: c.Name, Emoji: (string?)null, ColorHex: (string?)c.ColorHex));
    var topLevelNodes = topLevelKinds.Concat(topLevelCategoriesOnly).ToList();
}
<div class="d-flex flex-column flex-lg-row gap-3">
    @* Collapsible filter tree — everything checked by default (see IsKindChecked/IsLabelChecked),
       unchecking a whole category excludes everything under it (the existing Kinds behavior),
       unchecking one specific label under a category excludes just that label. Checkbox states here
       feed snapshotFilterForm via the name="kinds" attribute (category/kind nodes, submitted
       natively) and, for specific labels, via the hidden excludedLabels inputs the script below
       builds right before submit — see that script's own comment for why labels need this instead
       of a plain checked-box name/value pair. *@
    <aside class="snapshot-filter-tree" style="min-width: 15rem; max-width: 18rem;">
        <div class="d-flex flex-column gap-1">
            <div class="form-check mb-0">
                <input type="checkbox" class="form-check-input" id="kind-motion" name="kinds" value="Motion" checked="@Model.IsKindChecked("Motion")" form="snapshotFilterForm" />
                <label class="form-check-label small" for="kind-motion">🌀 Motion</label>
            </div>
            <div class="form-check mb-0">
                <input type="checkbox" class="form-check-input" id="kind-customtag" name="kinds" value="@IndexModel.CustomTagToken" checked="@Model.IsKindChecked(IndexModel.CustomTagToken)" form="snapshotFilterForm" />
                <label class="form-check-label small" for="kind-customtag">🏷️ Custom tags</label>
            </div>
            @foreach (var node in topLevelNodes)
            {
                var children = Model.DetectedObjectLabels.Where(l => l.CategoryName.Equals(node.Name, StringComparison.OrdinalIgnoreCase)).ToList();
                if (children.Count == 0)
                {
                    <div class="form-check mb-0">
                        <input type="checkbox" class="form-check-input" id="kind-@node.Name" name="kinds" value="@node.Name" checked="@Model.IsKindChecked(node.Name)" form="snapshotFilterForm" />
                        <label class="form-check-label small" for="kind-@node.Name">
                            @if (node.Emoji is { } emoji) { @emoji }
                            else if (node.ColorHex is { } color) { <span class="badge" style="background-color: @color;">&nbsp;</span> }
                            @node.Name
                        </label>
                    </div>
                }
                else
                {
                    <details open class="snapshot-filter-tree-node">
                        <summary class="d-flex align-items-center gap-1">
                            <span class="snapshot-tree-caret" aria-hidden="true">▸</span>
                            <input type="checkbox" class="form-check-input snapshot-tree-parent" id="kind-@node.Name" name="kinds" value="@node.Name"
                                   checked="@Model.IsKindChecked(node.Name)" form="snapshotFilterForm" data-children-of="@node.Name" onclick="event.stopPropagation();" />
                            <label class="form-check-label small" for="kind-@node.Name" onclick="event.stopPropagation();">
                                @if (node.ColorHex is { } color2) { <span class="badge" style="background-color: @color2;">&nbsp;</span> }
                                @node.Name
                            </label>
                        </summary>
                        <div class="snapshot-tree-children d-flex flex-column gap-1 mt-1">
                            @foreach (var child in children)
                            {
                                var token = $"{node.Name}:{child.Label}";
                                <div class="form-check mb-0">
                                    <input type="checkbox" class="form-check-input snapshot-tree-child" id="label-@token" data-label-token="@token"
                                           data-parent-name="@node.Name" checked="@Model.IsLabelChecked(node.Name, child.Label)" />
                                    <label class="form-check-label small" for="label-@token">@Char.ToUpperInvariant(child.Label[0])@child.Label[1..]</label>
                                </div>
                            }
                        </div>
                    </details>
                }
            }
        </div>
    </aside>

    <div class="flex-grow-1">
    @if (Model.Results.Items.Count == 0)
    {
        <p class="text-muted">No motion events found@(Model.Mode != "all" || Model.From is not null || Model.To is not null ? " for this filter." : " yet.")</p>
    }
    else
    {
    <partial name="Shared/_PaginationControls" model="@(new LarisVMS.Web.Helpers.PaginationViewModel(
        Model.Results.CurrentPage, Model.Results.TotalPages, snapshotPageUrl, CssClass: "mb-3", AriaLabel: "Pagination (top)"))" />
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var s in Model.Results.Items)
        {
            var atUtcIso = s.AtUtc.ToString("o");
            // Pass 2b: Playback deep-links use PlayFromUtc (pre-roll-earlier than StartUtc) so the
            // viewer actually catches the subject entering frame, while the thumbnail image itself
            // stays on atUtc's own sample point below — see SnapshotDto's doc comment for why the two
            // must not be unified.
            var playFromUtcIso = s.PlayFromUtc.ToString("o");
            <div class="col">
                @* Every card gets a 3px border in its badge color. One distinct color → a plain solid
                   border; two or more (an AI-detection group carrying, say, a person and a vehicle) →
                   a 3px gradient ring, lowest-hue color at the upper-left corner and the rest
                   clockwise. See Helpers/SnapshotBorderStyle.cs and the .snapshot-card--framed block
                   in site.css. *@
                @{
                    var frameColors = LarisVMS.Web.Helpers.SnapshotBorderStyle.OrderColors(
                        s.Badges.Select(b => b.ColorHex).DefaultIfEmpty(s.ColorHex));
                    var frameGradient = LarisVMS.Web.Helpers.SnapshotBorderStyle.GradientCss(frameColors);
                }
                <div class="card h-100@(frameGradient is null ? "" : " snapshot-card--framed")"
                     style="@(frameGradient is null
                                ? $"border-width: 3px; border-color: {(frameColors.Count == 1 ? frameColors[0] : s.ColorHex)};"
                                : $"--snapshot-frame: {frameGradient};")">
                    @* Plain hand-written href, not asp-page/asp-route-* — matches Bookmarks/Index.cshtml's
                       own "▶ Play" link exactly (same deep-link scheme, same destination page), after the
                       tag-helper form of this same link was confirmed live to render pointing back at this
                       page's own current filter state instead of /Playback. Bookmarks' plain-string version
                       has been live and working since M18; this sidesteps whatever the tag-helper issue was
                       rather than chasing it further. *@
                    @* Object detection plan decision 10: an AI-detection span's image comes from
                       /snapshot-image (cropped to the detection box, from its own best-scoring frame)
                       instead of the plain uncropped /playback-thumbnail every other kind of span
                       uses — GetSnapshotImageInfoAsync itself falls back to a 404 (same onerror
                       placeholder below) if the underlying span turns out to have no captured box
                       after all, so this is safe to route unconditionally off IsAiDetection. *@
                    @{
                        var imgSrc = s.IsAiDetection
                            ? $"/snapshot-image/{s.CameraId}/{s.Id}"
                            : $"/playback-thumbnail/{s.CameraId}?atUtc={Uri.EscapeDataString(atUtcIso)}&exact=true";
                    }
                    <a href="/Playback?cameraId=@s.CameraId&atUtc=@Uri.EscapeDataString(playFromUtcIso)">
                        @* object-fit:contain, not cover — cover crops a non-16:9 source frame (portrait
                           cameras especially) to fill the box; contain always shows the whole frame,
                           letterboxed instead of cropped. exact=true resolves this instant precisely
                           rather than snapping to the nearest 5 minutes (see GetExactThumbnailInfoAsync)
                           — a motion event is exactly the kind of moment likely to fall in a bucketed
                           lookup's coverage gap on a Motion-mode camera. onerror swaps in a text
                           placeholder rather than just hiding the image, so a card whose footage has
                           since aged out of retention still reads as "nothing here", not "broken". *@
                        <img src="@imgSrc"
                             loading="lazy" class="card-img-top" data-snapshot-thumb style="aspect-ratio: 16/9; object-fit: contain; background: var(--bs-secondary-bg);"
                             alt="Snapshot thumbnail"
                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                        <div class="d-none text-muted small text-center d-flex align-items-center justify-content-center"
                             style="aspect-ratio: 16/9; background: var(--bs-secondary-bg);">
                            No thumbnail available
                        </div>
                    </a>
                    <div class="card-body py-2 px-2">
                        @* One badge normally; several when overlapping AI-detection spans on one
                           camera were grouped into this card (a person and a dog in the same frame).
                           TimelineService always fills Badges with at least the primary. *@
                        @foreach (var badge in s.Badges)
                        {
                            <span class="badge" style="background-color: @badge.ColorHex;">@badge.Emoji @badge.Label</span>
                        }
                        <span class="badge bg-secondary" title="How long this event lasted">@IndexModel.FormatDuration(s.Duration)</span>
                        <div class="small text-muted mt-1">@s.CameraName</div>
                        @* "G" (long time), not "g" (short time) — includes seconds, which matters
                           here specifically for lining up exactly when a snapshot's frame was
                           grabbed against the live view / recording, given the known Sub-detection
                           vs Main-recording timing gap (see SnapshotImageCapture's own doc comment
                           on DefaultMarginFraction). *@
                        <div class="small text-muted" title="@s.AtUtc.ToString("u")">@s.AtUtc.ToLocalTime().ToString("G")</div>
                    </div>
                    <div class="card-footer py-1 px-2 text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Playback?cameraId=@s.CameraId&atUtc=@Uri.EscapeDataString(playFromUtcIso)">▶ Play</a>
                    </div>
                </div>
            </div>
        }
    </div>
    }

    <partial name="Shared/_PaginationControls" model="@(new LarisVMS.Web.Helpers.PaginationViewModel(
        Model.Results.CurrentPage, Model.Results.TotalPages, snapshotPageUrl))" />
    </div>
</div>

@section Scripts {
    <script src="~/js/snapshot-load-status.js" asp-append-version="true"></script>
    @* Filter-tree parent/child sync, the excludedLabels submit build, and per-user memory of the
       tree's expand/collapse + checkbox state — see snapshot-filter-tree.js. *@
    <script src="~/js/snapshot-filter-tree.js" asp-append-version="true"></script>
    <script>
        // Shows only the selector matching the current mode — the other two stay in the form
        // (unselected, so they submit nothing) but hidden, same "only what's relevant is visible"
        // shape as this page's own kinds checkboxes.
        (function () {
            var modeSelect = document.getElementById('snapshotMode');
            var targets = document.querySelectorAll('.snapshot-mode-target');
            function applyMode() {
                targets.forEach(function (el) {
                    el.classList.toggle('d-none', el.getAttribute('data-for-mode') !== modeSelect.value);
                });
            }
            modeSelect.addEventListener('change', applyMode);
            applyMode();
        })();
    </script>
}
