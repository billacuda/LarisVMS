@page
@using System.Globalization
@model LarisVMS.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
@functions {
    // Kept trivially simple deliberately: dashboard.js has to render the identical string for the
    // same row (this markup is only the pre-JS fallback — see dashboard.js's own header), so the two
    // must agree exactly, and anything more elaborate than "codec, rate in kHz" invites drift.
    static string AudioSummary(string? codec, int? sampleRateHz)
    {
        if (string.IsNullOrWhiteSpace(codec)) return "—";
        if (sampleRateHz is not { } hz) return codec;
        // Invariant, not the server's culture: dashboard.js formats the same number with JS's own
        // always-a-dot toFixed, and a comma-decimal server culture would otherwise make the row
        // change appearance the moment the first poll replaced this markup.
        return $"{codec} {(hz / 1000.0).ToString("0.#", CultureInfo.InvariantCulture)} kHz";
    }
}
<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="mb-0">Dashboard</h1>
    @* dashboard.js's poll() fills this in ("Updated h:mm:ss a") after every successful refresh —
       server-rendered blank so a JS-disabled/failed-to-load page doesn't show a stale claim. *@
    <span id="dashboardRefreshStatus" class="text-muted small"></span>
</div>

<div class="row g-3 mb-3" id="dashboardSummary">
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6" id="dashRecordingCount">@Model.RecordingCount</div>
                <div class="text-muted small">Recording</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 @(Model.NotReportingCount > 0 ? "text-danger" : "")" id="dashNotReportingCount">@Model.NotReportingCount</div>
                <div class="text-muted small">Not reporting</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 text-muted" id="dashDisabledCount">@Model.DisabledCount</div>
                <div class="text-muted small">Disabled</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-6 @(Model.NodesOnlineCount < Model.NodesTotalCount ? "text-danger" : "")" id="dashNodesOnline">@Model.NodesOnlineCount / @Model.NodesTotalCount</div>
                <div class="text-muted small">Nodes online</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    @* Persisted server-side (see user-preferences.js) so the choice survives a reload and follows
       the signed-in user across devices — same preference-service convention as the theme toggle and
       Playback's own remembered zoom/24h-clock settings. The thumbnail <th>/<td> always exist in the
       table regardless of this (see dashboard.js) — toggling only ever shows/hides via CSS, never
       adds/removes the column itself, so sortable-table.js's per-column-index click handlers (bound
       once, on load) never see their column indices shift out from under them. Kept as its own
       switch rather than folded into the generic column picker below: showing a thumbnail is a
       heavier, per-row network fetch, not just a display toggle on data already present, so it
       deserves to read as a deliberate choice rather than living next to "hide the Bitrate column". *@
    <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="dashboardThumbToggle">
        <label class="form-check-label" for="dashboardThumbToggle">Show thumbnails</label>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label small mb-0" for="dashboardPageSize">Rows per page</label>
        <select id="dashboardPageSize" class="form-select form-select-sm" style="width: auto;" data-paginate-size-for="dashboardTable">
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="all">All</option>
        </select>
        <partial name="_ColumnPicker" model="@("dashboardTable")" />
    </div>
</div>

<style>
    /* Column stays structurally present at all times (see the toggle's own comment above) — hiding
       it is purely visual. Both the header and every row's cell share this class. */
    #dashboardTable.hide-thumb-col .thumb-col { display: none; }
</style>

<p class="text-muted" id="dashboardEmptyMessage" style="@(Model.Rows.Count == 0 ? "" : "display:none;")">
    No cameras yet — add one from <a href="/Cameras">Cameras</a>.
</p>

<div class="table-responsive" id="dashboardTableWrap" style="@(Model.Rows.Count == 0 ? "display:none;" : "")">
    <table class="table table-hover align-middle hide-thumb-col" id="dashboardTable" data-sortable data-paginate data-column-picker>
        <thead>
            <tr>
                <th class="thumb-col" data-no-sort>Thumbnail</th>
                <th>Camera</th>
                <th data-col="node">Node</th>
                <th data-no-sort>Status</th>
                <th class="text-end" data-sort-numeric data-col="fps">FPS</th>
                <th class="text-end" data-sort-numeric data-col="bitrate">Bitrate</th>
                @* Sorted by sample rate, which is the only numeric part of the cell — sorting a
                   mixed "codec + rate" string alphabetically would order by codec name instead,
                   which the header gives no hint of. *@
                <th data-sort-numeric data-col="audio">Audio</th>
                <th class="text-end" data-sort-numeric data-col="reconnects">Reconnects</th>
                <th data-sort-numeric data-col="lastreport">Last report</th>
            </tr>
        </thead>
        <tbody id="dashboardTableBody">
            @foreach (var r in Model.Rows)
            {
                <tr data-camera-id="@r.CameraId">
                    <td class="thumb-col"></td>
                    <td><a asp-page="/Cameras/Edit" asp-route-id="@r.CameraId">@r.CameraName</a></td>
                    <td>
                        @if (!r.NodeAssigned)
                        {
                            <span class="text-muted">unassigned</span>
                        }
                        else
                        {
                            @r.NodeName
                            <span class="badge @(r.NodeOnline ? "text-bg-success" : "text-bg-secondary") ms-1">@(r.NodeOnline ? "online" : "offline")</span>
                        }
                    </td>
                    <td>
                        @if (!r.CameraEnabled)
                        {
                            <span class="badge text-bg-secondary">Disabled</span>
                        }
                        else if (!r.NodeAssigned)
                        {
                            <span class="badge text-bg-warning">No node</span>
                        }
                        else if (r.HealthFresh)
                        {
                            <span class="badge text-bg-success">Recording</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Not reporting</span>
                        }
                    </td>
                    <td class="text-end" data-sort-value="@(r.HealthFresh ? r.Fps : null)">@(r.HealthFresh ? r.Fps?.ToString() ?? "—" : "—")</td>
                    <td class="text-end" data-sort-value="@(r.HealthFresh ? r.BitrateKbps : null)">@(r.HealthFresh && r.BitrateKbps is { } kbps ? $"{kbps:N0} kbps" : "—")</td>
                    <td data-sort-value="@r.AudioSampleRateHz">@AudioSummary(r.AudioCodec, r.AudioSampleRateHz)</td>
                    <td class="text-end" data-sort-value="@r.ReconnectCount">@(r.ReconnectCount?.ToString() ?? "—")</td>
                    @* ApplicationDbContext's UtcDateTimeConverter already guarantees Kind=Utc here — no SpecifyKind needed. *@
                    <td class="small text-muted" data-sort-value="@(r.HealthReportedAt.HasValue ? new DateTimeOffset(r.HealthReportedAt.Value).ToUnixTimeMilliseconds() : 0)">
                        @if (r.HealthReportedAt is { } reported)
                        {
                            <span title="@reported.ToString("u")">@reported.ToLocalTime().ToString("g")</span>
                        }
                        else
                        {
                            <span>never</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div data-paginate-controls-for="dashboardTable" class="mt-2"></div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
