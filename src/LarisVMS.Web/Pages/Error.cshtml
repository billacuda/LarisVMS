@page
@model LarisVMS.Web.Pages.ErrorModel
@{
    ViewData["Title"] = L["common.error"].Value;
}
<h1 class="text-danger">@L["error.error"]</h1>
<h2 class="text-danger">@L["error.anErrorOccurredWhileProcessing"]</h2>
@if (Model.ShowRequestId)
{
    <p><strong>@L["error.requestId"]</strong> <code>@Model.RequestId</code></p>
}
