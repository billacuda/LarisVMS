@page "{id:guid?}"
@using System.Text.Json
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Views.PlayModel
@{
    ViewData["Title"] = Model.Name;
    var camerasJson = JsonSerializer.Serialize(Model.Cameras.Select(c =>
    {
        var main = c.Streams.FirstOrDefault(s => s.Role == CameraStreamRole.Main);
        // width/height are the Main stream's own probed resolution — the derived phone stack sizes
        // its cells from the camera's real aspect rather than the editor-chosen one, which could
        // never have matched for any camera that isn't 16:9 (see aspect-ratio.js's nearest()).
        return new { id = c.Id, name = c.Name, codec = main?.Codec, hasAudio = main?.HasAudio ?? false,
            hasPtz = c.Capabilities != null && c.Capabilities.HasPtz,
            width = main?.Width, height = main?.Height };
    }));
}
<div class="d-flex justify-content-between align-items-center mb-2" id="viewPlayToolbar">
    <h1 class="mb-0 h4">@Model.Name</h1>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.Views.Count > 0)
        {
            <select class="form-select form-select-sm" style="width:auto;" id="viewPlayPicker"
                    title="Switch view" aria-label="Switch view"
                    onchange="if (this.value) location.href = '/Views/Play/' + this.value;">
                @* Camera count in the label, so switching views is a choice between "House (6)" and
                   "Yard (2)" rather than between two bare names. Counts cells, matching the Cameras
                   column on Views/Index — the two would otherwise disagree for a view that places
                   the same camera in more than one cell. *@
                @foreach (var v in Model.Views)
                {
                    <option value="@v.Id" selected="@(v.Id == Model.CurrentViewId ? "selected" : null)">@v.Name (@ViewLayout.CountCells(v.LayoutJson))</option>
                }
            </select>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary" id="kioskBtn" title="Toggle fullscreen kiosk mode">⛶ Fullscreen</button>
        <a class="btn btn-sm btn-outline-secondary" asp-page="Index">Back to views</a>
    </div>
</div>

<div id="viewPlayGrid"></div>

@section Scripts {
    <script src="~/js/aspect-ratio.js" asp-append-version="true"></script>
    <script src="~/js/audio-controls.js" asp-append-version="true"></script>
    <script src="~/js/ptz-controls.js" asp-append-version="true"></script>
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script src="~/js/fullscreen-tile.js" asp-append-version="true"></script>
    <script src="~/js/timeline.js" asp-append-version="true"></script>
    <script src="~/js/playback-player.js" asp-append-version="true"></script>
    <script src="~/js/view-play.js" asp-append-version="true"></script>
    <script>
        window.larisvmsViewPlay.init({
            layoutJson: @Html.Raw(JsonSerializer.Serialize(Model.LayoutJson)),
            cameras: @Html.Raw(camerasJson),
            currentViewId: @Html.Raw(JsonSerializer.Serialize(Model.CurrentViewId.ToString())),
            gridElId: 'viewPlayGrid',
            badgeCorner: @Html.Raw(JsonSerializer.Serialize(Model.EventBadgeCornerValue)),
            kioskBtnId: 'kioskBtn',
            navElId: 'mainNav',
            toolbarElId: 'viewPlayToolbar',
            isTour: @Html.Raw(Model.IsTour ? "true" : "false"),
            tourViewIds: @Html.Raw(JsonSerializer.Serialize(Model.TourViewIds)),
            tourIndex: @Model.TourIndex,
            tourIntervalSeconds: @Model.TourIntervalSeconds
        });
        window.larisvmsLiveView.startMotionIndicatorPolling(5000);
    </script>
}
