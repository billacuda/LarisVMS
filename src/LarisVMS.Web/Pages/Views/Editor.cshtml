@page "{id:guid}"
@using System.Text.Json
@using LarisVMS.Core.Enums
@model LarisVMS.Web.Pages.Views.EditorModel
@{
    ViewData["Title"] = L["views.editor.editView"].Value + Model.Name;
    var camerasJson = JsonSerializer.Serialize(Model.Cameras.Select(c =>
    {
        var main = c.Streams.FirstOrDefault(s => s.Role == CameraStreamRole.Main);
        // width/height let a newly-added cell default to the camera's own aspect ratio instead of a
        // blanket 16:9 — see aspect-ratio.js's nearest().
        return new { id = c.Id, name = c.Name, codec = main?.Codec, hasAudio = main?.HasAudio ?? false,
            width = main?.Width, height = main?.Height };
    }));
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["views.editor.editView2"]</h1>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-page="Play" asp-route-id="@Model.Id">@L["common.open"]</a>
        <a class="btn btn-outline-secondary" asp-page="Index">@L["views.editor.backToViews"]</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.ReadOnly)
{
    <div class="alert alert-info" role="status">@L["views.sharedReadOnly"]</div>
}
<form method="post" id="viewEditorForm">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="layoutJson" id="layoutJsonInput" value="@Model.LayoutJson" />

    <div class="row g-2 align-items-end mb-3">
        <div class="col-sm-4">
            <label for="field-name" class="form-label small">@L["common.name"]</label>
            <input id="field-name" type="text" name="name" class="form-control" value="@Model.Name" required />
        </div>
        <div class="col-sm-2">
            <div class="form-check mt-4">
                <input type="checkbox" name="isShared" id="isSharedCheck" class="form-check-input" value="true" @(Model.IsShared ? "checked" : "") />
                <label class="form-check-label" for="isSharedCheck">@L["views.editor.shared"]</label>
            </div>
        </div>
        <div class="col-sm-3">
            <label for="field-sequenceIntervalSeconds" class="form-label small">@L["views.editor.tourIntervalSeconds0Off"]</label>
            <input id="field-sequenceIntervalSeconds" type="number" name="sequenceIntervalSeconds" class="form-control" min="0" value="@Model.SequenceIntervalSeconds" />
        </div>
        <div class="col-sm-2">
            <div class="form-check mt-4">
                <input type="checkbox" id="mobileTwoColumnCheck" class="form-check-input" />
                <label class="form-check-label" for="mobileTwoColumnCheck">@L["views.editor.2ColumnsOnPhone"]</label>
            </div>
        </div>
        <div class="col-sm-1 text-end">
            <button type="submit" class="btn btn-primary" disabled="@Model.ReadOnly"><span aria-hidden="true">💾</span> @L["common.save"]</button>
        </div>
    </div>
</form>

<div class="row g-3">
    <div class="col-md-3">
        <h6>@L["nav.cameras"]</h6>
        @if (Model.Cameras.Count == 0)
        {
            <p class="text-muted small">@L["views.editor.noCamerasAreBothEnabled"]</p>
        }
        else
        {
            <div id="cameraPalette">
                @foreach (var c in Model.Cameras)
                {
                    <div class="grid-stack-item camera-palette-item mb-1" gs-w="4" gs-h="3">
                        <div class="grid-stack-item-content list-group-item list-group-item-action d-flex justify-content-between align-items-center py-1"
                             data-camera-id="@c.Id" data-camera-name="@c.Name" style="cursor: grab;" role="button" tabindex="0">
                            @c.Name
                            <span class="text-primary">+</span>
                        </div>
                    </div>
                }
            </div>
        }
        <p class="text-muted small mt-2">@L["views.editor.dragACameraOntoThe"]</p>
    </div>
    <div class="col-md-9">
        <div id="viewGrid" class="grid-stack border rounded bg-body-tertiary"></div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/gridstack/dist/gridstack.min.css" asp-append-version="true" />
    <style>
        /* Keep the camera palette in normal list layout. GridStack's own stylesheet absolutely
           positions .grid-stack-item / .grid-stack-item-content on the assumption that they're
           already inside a .grid-stack container — the palette needs the same classes for
           GridStack.setupDragIn to recognize it as a drag source, but isn't itself a grid. */
        #cameraPalette .camera-palette-item {
            position: relative !important;
            width: auto !important;
            height: auto !important;
            inset: auto !important;
            margin: 0 0 4px 0 !important;
        }
        #cameraPalette .camera-palette-item > .grid-stack-item-content {
            position: relative !important;
            inset: auto !important;
            width: auto !important;
            height: auto !important;
        }
    </style>
}

@section Scripts {
    <script src="~/lib/gridstack/dist/gridstack-all.js" asp-append-version="true"></script>
    <script src="~/js/grid-keyboard.js" asp-append-version="true"></script>
    <script src="~/js/aspect-ratio.js" asp-append-version="true"></script>
    <script src="~/js/media-endpoint.js" asp-append-version="true"></script>
    <script src="~/js/live-view.js" asp-append-version="true"></script>
    <script src="~/js/view-editor.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        window.larisvmsViewEditor.init({
            layoutJson: document.getElementById('layoutJsonInput').value,
            cameras: @Html.Raw(camerasJson),
            mobileTwoColumnCheckId: 'mobileTwoColumnCheck',
            formId: 'viewEditorForm',
            layoutInputId: 'layoutJsonInput'
        });
    </script>
}
