@page
@model LarisVMS.Web.Pages.Views.IndexModel
@{
    ViewData["Title"] = L["nav.views"].Value;
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1>@L["nav.views"]</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.TourViewCount > 0)
        {
            <a class="btn btn-outline-secondary" asp-page="Play" asp-route-tour="true">@L["views.startTour", new { count = Model.TourViewCount }]</a>
        }
        <button type="button" class="btn btn-outline-secondary" id="vtNewFolder">@L["views.newFolder"]</button>
        <button type="button" class="btn btn-primary" id="vtNewView">@L["views.newView"]</button>
    </div>
</div>

<div class="alert alert-danger d-none" role="alert" id="vtAlert"></div>

<div class="row g-2 align-items-center mb-2">
    <div class="col-sm-5">
        <input type="search" class="form-control" id="vtFilter" placeholder="@L["views.filterByName"]" aria-label="@L["views.filterByName"]" />
    </div>
    <div class="col-sm-7 small text-muted">@L["views.treeHint"] <a href="/Help/live-and-playback#views">@L["common.learnMore"]</a></div>
</div>

<div id="viewTree" class="view-tree" role="tree" aria-label="@L["nav.views"]">
    <p class="text-muted small">@L["views.loading"]</p>
</div>

<div id="vtMenu" class="dropdown-menu shadow" role="menu" style="position: fixed;"></div>

<div class="modal fade" id="vtDialog" tabindex="-1" aria-labelledby="vtDialogTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="vtDialogForm">
            <div class="modal-header">
                <h2 class="modal-title h5" id="vtDialogTitle"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["common.close"]"></button>
            </div>
            <div class="modal-body">
                <p id="vtDialogMessage" class="mb-2"></p>
                <input type="text" class="form-control d-none" id="vtDialogInput" maxlength="200" autocomplete="off" aria-labelledby="vtDialogTitle" />
                <div class="form-check mt-2 d-none" id="vtDialogCheckWrap">
                    <input type="checkbox" class="form-check-input" id="vtDialogCheck" />
                    <label class="form-check-label" for="vtDialogCheck" id="vtDialogCheckLabel"></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["common.cancel"]</button>
                <button type="submit" class="btn btn-primary" id="vtDialogOk"></button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/view-tree.js" asp-append-version="true"></script>
    <script nonce="@Csp.Value">
        window.larisvmsViewTree.init({
            treeId: 'viewTree', menuId: 'vtMenu', filterId: 'vtFilter', alertId: 'vtAlert',
            newViewId: 'vtNewView', newFolderId: 'vtNewFolder', dialogId: 'vtDialog'
        });
    </script>
}
