@page
@model LarisVMS.Web.Pages.Views.IndexModel
@{
    ViewData["Title"] = L["nav.views"].Value;
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1>@L["nav.views"]</h1>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.TourViews.Count > 0)
        {
            <a class="btn btn-outline-secondary" asp-page="Play" asp-route-tour="true">@L["views.startTour", new { count = Model.TourViews.Count }]</a>
        }
        <form method="post" asp-page-handler="Create" class="d-inline">
            <input type="hidden" name="name" value="New view" />
            <button type="submit" class="btn btn-primary">@L["views.newView"]</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Views.Count == 0)
{
    <p class="text-muted">@L["views.noViewsYet"]</p>
}
else
{
    <div class="row g-2 align-items-center mb-2">
        <div class="col-sm-4">
            <input type="search" class="form-control" data-filter-table="viewsTable" placeholder="@L["views.filterByName"]" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle" id="viewsTable" data-sortable>
            <thead>
                <tr>
                    <th>@L["common.name"]</th>
                    <th>@L["views.owner"]</th>
                    <th>@L["views.shared"]</th>
                    <th data-sort-numeric>@L["nav.cameras"]</th>
                    <th data-sort-numeric>@L["views.tourInterval"]</th>
                    <th data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Views)
                {
                    var cellCount = ViewLayout.CountCells(v.LayoutJson);
                    var isOwner = v.OwnerId == Model.CurrentUserId;
                    <tr>
                        <td><a asp-page="Play" asp-route-id="@v.Id">@v.Name</a></td>
                        <td>@(isOwner ? L["views.you"].Value : L["views.anotherUser"].Value)</td>
                        <td>@(v.IsShared ? L["views.shared"].Value : L["views.personal"].Value)</td>
                        <td>@cellCount</td>
                        <td data-sort-value="@v.SequenceIntervalSeconds">
                            @(v.SequenceIntervalSeconds > 0 ? $"{v.SequenceIntervalSeconds}s" : "—")
                        </td>
                        <td class="text-end text-nowrap">
                            @if (Model.CanEditViews)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-page="Editor" asp-route-id="@v.Id">@L["common.edit"]</a>
                            }
                            @if (isOwner || Model.CanEditViews)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@v.Id" class="d-inline"
                                      data-confirm="@L["views.deleteConfirm", new { name = v.Name }]">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["common.delete"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
