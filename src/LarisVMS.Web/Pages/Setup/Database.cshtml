@page
@model LarisVMS.Web.Pages.Setup.DatabaseModel
@using LarisVMS.Core.Enums
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = L["setup.database.database"].Value;
    var mariaDb = Model.Provider == DatabaseProvider.MariaDb;
}
<h2 class="h5 mb-3">@L["setup.database.1Database"]</h2>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
<form method="post">
    <fieldset class="mb-3">
        <legend class="form-label fs-6">@L["setup.database.databaseType"]</legend>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Provider" value="@DatabaseProvider.SqlServer" id="providerSqlServer" data-db-provider />
            <label class="form-check-label" for="providerSqlServer">@L["setup.database.sqlServer"]</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Provider" value="@DatabaseProvider.MariaDb" id="providerMariaDb" data-db-provider />
            <label class="form-check-label" for="providerMariaDb">MariaDB</label>
        </div>
    </fieldset>

    <div id="sqlServerFields" @(mariaDb ? "hidden" : null)>
        <div class="mb-3">
            <label class="form-label" asp-for="ServerName">@L["setup.database.sqlServer"]</label>
            <input asp-for="ServerName" class="form-control" placeholder="." />
            <div class="form-text">
                <code>.</code> is SQL Server on this machine. For SQL Server Express, use <code>.\SQLEXPRESS</code>.
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="DatabaseName">@L["setup.database.databaseName"]</label>
            <input asp-for="DatabaseName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Username">@L["setup.database.sqlLoginOptionalBlankUses"]</label>
            <input asp-for="Username" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password">@L["common.password"]</label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="TrustServerCertificate" class="form-check-input" />
            <label class="form-check-label" asp-for="TrustServerCertificate">@L["setup.database.trustThisServerCertificate"]</label>
            <div class="form-text">@L["setup.database.onlyForASqlServer"]</div>
        </div>
    </div>

    <div id="mariaDbFields" @(mariaDb ? null : "hidden")>
        <div class="row g-3 mb-3">
            <div class="col-8">
                <label class="form-label" asp-for="MariaDbHost">@L["common.host"]</label>
                <input asp-for="MariaDbHost" class="form-control" placeholder="localhost" />
            </div>
            <div class="col-4">
                <label class="form-label" asp-for="MariaDbPort">@L["common.port"]</label>
                <input asp-for="MariaDbPort" type="number" min="1" max="65535" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="MariaDbDatabaseName">@L["setup.database.databaseName"]</label>
            <input asp-for="MariaDbDatabaseName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="MariaDbUsername">@L["common.user"]</label>
            <input asp-for="MariaDbUsername" class="form-control" autocomplete="off" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="MariaDbPassword">@L["common.password"]</label>
            <input asp-for="MariaDbPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="form-text">
                @L.Html("setup.database.mariaDbPasswordHint")
            </div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="MariaDbTrustServerCertificate" class="form-check-input" />
            <label class="form-check-label" asp-for="MariaDbTrustServerCertificate">@L["setup.database.trustThisServerCertificate"]</label>
            <div class="form-text">@L["setup.database.onlyForAMariadbServer"]</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">@L["setup.database.createDatabaseContinue"]</button>
</form>
<script nonce="@Csp.Value">
    (function () {
        var sql = document.getElementById('sqlServerFields');
        var maria = document.getElementById('mariaDbFields');
        document.querySelectorAll('[data-db-provider]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var isMaria = radio.checked && radio.value === '@DatabaseProvider.MariaDb';
                if (!radio.checked) return;
                sql.hidden = isMaria;
                maria.hidden = !isMaria;
            });
        });
    })();
</script>
