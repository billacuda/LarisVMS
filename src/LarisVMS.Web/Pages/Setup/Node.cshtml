@page
@model LarisVMS.Web.Pages.Setup.NodeModel
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = L["setup.node.recorderNode"].Value;
}
<h2 class="h5 mb-3">@L["setup.node.4RecorderNode"]</h2>
<p class="text-muted small">
    Recording runs in a separate Windows Service ("node"), not inside this IIS-hosted web app, so it
    keeps running through app pool recycles and deploys. Install at least one node with the
    registration key below — this can also be done later from Admin &rarr; Nodes.
</p>
<div class="mb-3">
    <label class="form-label" for="registrationKey">@L["setup.node.registrationKey"]</label>
    <input id="registrationKey" class="form-control" value="@Model.RegistrationKey" readonly />
</div>
<div class="mb-3">
    <label class="form-label" for="installCommand">@L["setup.node.installCommandRunOnThe"]</label>
    <textarea id="installCommand" class="form-control font-monospace" rows="2" readonly>.\install-node.ps1 -ServerUrl "@Model.ServerUrl" -RegistrationKey "@Model.RegistrationKey"</textarea>
</div>
<form method="post">
    <button type="submit" class="btn btn-primary">@L["setup.node.continue"]</button>
</form>
