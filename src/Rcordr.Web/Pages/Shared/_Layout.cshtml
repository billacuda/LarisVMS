@using Microsoft.EntityFrameworkCore
@using Rcordr.Infrastructure.Data
@inject ApplicationDbContext LayoutDb
@inject IConfiguration Configuration
@{
    var appName = Configuration["Branding:AppName"];
    var primaryColor = Configuration["Branding:PrimaryColor"];
    var pageTitle = string.IsNullOrWhiteSpace(appName) ? "Rcordr" : appName;
    string? _version = null;
    try
    {
        var latest = await LayoutDb.AppVersions
            .OrderByDescending(v => v.Major).ThenByDescending(v => v.Minor).ThenByDescending(v => v.Patch)
            .FirstOrDefaultAsync();
        _version = latest?.ToVersionString();
    }
    catch { /* pre-setup: no schema yet */ }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @pageTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(primaryColor))
    {
        <style>
            :root { --bs-primary: @primaryColor; }
            .btn-primary { --bs-btn-bg: @primaryColor; --bs-btn-border-color: @primaryColor; }
        </style>
    }
    <script>
        // Anti-flash: applies the stored theme before first paint.
        (function () {
            var t = localStorage.getItem('rcordr.theme');
            if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">@pageTitle</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Cameras">Cameras</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Nodes">Nodes</a></li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main role="main" class="container-fluid px-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4 py-2">
            &copy; @DateTime.UtcNow.Year Rcordr @(_version is not null ? $"v{_version}" : "")
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
