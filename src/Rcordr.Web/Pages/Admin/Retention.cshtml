@page
@model Rcordr.Web.Pages.Admin.RetentionModel
@{
    ViewData["Title"] = "Retention";
}
<h1>Storage &amp; retention</h1>
<p class="text-muted">
    Global defaults for the M4 storage manager running on every node: how long footage is kept, and
    how full a storage volume is allowed to get before the watermark backstop starts evicting the
    oldest footage regardless of retention settings. Override retention per node on
    <a asp-page="/Admin/Nodes">Admin &rarr; Nodes</a>, or per camera on that camera's edit page —
    a camera-level override wins over its node's, which wins over this global default.
</p>

@if (!string.IsNullOrEmpty(Model.SavedMessage))
{
    <div class="alert alert-success">@Model.SavedMessage</div>
}

<form method="post" class="row g-3" style="max-width: 480px;">
    <div class="col-12">
        <label class="form-label">Global retention (days)</label>
        <input asp-for="RetentionDays" type="number" min="0" class="form-control" required />
        <div class="form-text">0 = keep forever unless a node/camera override says otherwise.</div>
    </div>
    <div class="col-12">
        <label class="form-label">Watermark (% of volume used)</label>
        <input asp-for="WatermarkPercent" type="number" min="1" max="99" class="form-control" required />
        <div class="form-text">
            When a node's storage root passes this usage, its oldest unlocked segments across every
            camera on that node are deleted regardless of retention/quota — a hard backstop against a
            full disk, not a preference.
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
