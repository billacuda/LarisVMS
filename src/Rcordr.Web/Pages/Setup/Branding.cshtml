@page
@model Rcordr.Web.Pages.Setup.BrandingModel
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Branding";
}
<h5 class="mb-3">5. Branding</h5>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Application name</label>
        <input asp-for="AppName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Primary color</label>
        <input asp-for="PrimaryColor" type="color" class="form-control form-control-color" />
    </div>
    <button type="submit" class="btn btn-primary">Continue</button>
</form>
