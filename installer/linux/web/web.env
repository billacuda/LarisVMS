# LarisVMS Web server settings, read by larisvms-web.service. After a change:
#   sudo systemctl restart larisvms-web
# appsettings.Production.json in this folder holds the rest (the setup wizard writes the database
# connection to setup-generated.json here).
#
# HTTPS port (default 8444). Open the new port in the firewall too.
#Kestrel__HttpsPort=8444
