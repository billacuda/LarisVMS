<?xml version="1.0" encoding="utf-8"?>
<!-- Proxy dialog flow: Welcome -> Proxy settings -> Service account -> Ready. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="LarisProxyUI">
      <UIRef Id="LarisCommonUI" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ProxySettingsDlg" Order="1" Condition="NOT Installed AND NOT LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed AND PATCH" />
      <!-- Upgrade: settings are already in place, so skip to the first page that needs input (usually none). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="ResolveUpgradeRoute" Order="3" Condition="NOT Installed AND LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Property="LARIS_ACCOUNT_BACK" Value="WelcomeDlg" Order="4" Condition="NOT Installed AND LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="[LARIS_UPGRADE_DLG]" Order="5" Condition="NOT Installed AND LARIS_UPGRADE" />

      <Dialog Id="ProxySettingsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Proxy settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Where this proxy registers, and the endpoint browsers connect to." />

        <Control Id="ServerUrlLabel" Type="Text" X="20" Y="56" Width="110" Height="15" Text="Server URL:" />
        <Control Id="ServerUrl" Type="Edit" X="135" Y="54" Width="215" Height="17" Property="SERVERURL" DisableCondition="ALREADYREGISTERED=&quot;1&quot;" />
        <Control Id="KeyLabel" Type="Text" X="20" Y="78" Width="110" Height="15" Text="Registration key:" />
        <Control Id="Key" Type="Edit" X="135" Y="76" Width="215" Height="17" Property="REGISTRATIONKEY" Password="yes" DisableCondition="ALREADYREGISTERED=&quot;1&quot;" />
        <Control Id="Insecure" Type="CheckBox" X="135" Y="95" Width="215" Height="12" Property="INSECURETLS" CheckBoxValue="1" Text="Accept the server's self-signed certificate" />
        <Control Id="PortLabel" Type="Text" X="20" Y="116" Width="110" Height="15" Text="Client port:" />
        <Control Id="Port" Type="Edit" X="135" Y="114" Width="60" Height="17" Property="CLIENTPORT" />
        <Control Id="HostLabel" Type="Text" X="20" Y="138" Width="110" Height="15" Text="Host name (FQDN):" />
        <Control Id="Host" Type="Edit" X="135" Y="136" Width="215" Height="17" Property="CLIENTENDPOINTHOST" />
        <Control Id="PfxLabel" Type="Text" X="20" Y="160" Width="110" Height="15" Text="Certificate (.pfx) path:" />
        <Control Id="Pfx" Type="Edit" X="135" Y="158" Width="215" Height="17" Property="CLIENTPFXPATH" />
        <Control Id="PfxPwdLabel" Type="Text" X="20" Y="182" Width="110" Height="15" Text="Certificate password:" />
        <Control Id="PfxPwd" Type="Edit" X="135" Y="180" Width="215" Height="17" Property="CLIENTPFXPASSWORD" Password="yes" />
        <Control Id="AllowInsecure" Type="CheckBox" X="20" Y="206" Width="330" Height="15" Property="CLIENTALLOWINSECURE" CheckBoxValue="1" Text="Allow a self-signed certificate (testing only)" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="LARIS_PAGE" Value="Server" Order="1" />
          <Publish Event="DoAction" Value="ValidateDialog" Order="2" />
          <Publish Property="LARIS_PAGE" Value="Endpoint" Order="3" Condition="SETTINGS_VALID=&quot;1&quot;" />
          <Publish Event="DoAction" Value="ValidateDialog" Order="4" Condition="SETTINGS_VALID=&quot;1&quot;" />
          <Publish Event="SpawnDialog" Value="SettingsErrorDlg" Order="5" Condition="SETTINGS_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Property="LARIS_ACCOUNT_BACK" Value="ProxySettingsDlg" Order="6" />
          <Publish Event="NewDialog" Value="ServiceAccountDlg" Order="7" Condition="SETTINGS_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
