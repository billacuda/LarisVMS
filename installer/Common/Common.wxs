<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the Web, Node and Proxy MSIs: the custom-action DLL, every custom action definition,
     and the dialogs every product uses (service account, settings error). Each Package.wxs schedules
     only the actions it needs; see installer\CustomActions for what each one does. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Binary Id="LarisCA" SourceFile="$(var.LarisVMS.Installer.CustomActions.TargetDir)LarisVMS.Installer.CustomActions.CA.dll" />

    <!-- Immediate: work out settings (UI and execute sequences). -->
    <CustomAction Id="DetectExisting" BinaryRef="LarisCA" DllEntry="DetectExisting" Execute="immediate" Return="check" />
    <CustomAction Id="LoadSettings" BinaryRef="LarisCA" DllEntry="LoadSettings" Execute="immediate" Return="check" />
    <CustomAction Id="FindFfmpeg" BinaryRef="LarisCA" DllEntry="FindFfmpeg" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateDialog" BinaryRef="LarisCA" DllEntry="ValidateDialog" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateInstall" BinaryRef="LarisCA" DllEntry="ValidateInstall" Execute="immediate" Return="check" />
    <CustomAction Id="ResolveUpgradeRoute" BinaryRef="LarisCA" DllEntry="ResolveUpgradeRoute" Execute="immediate" Return="check" />
    <CustomAction Id="BuildServiceArgs" BinaryRef="LarisCA" DllEntry="BuildServiceArgs" Execute="immediate" Return="check" HideTarget="yes" />
    <CustomAction Id="PrepareDeferred" BinaryRef="LarisCA" DllEntry="PrepareDeferred" Execute="immediate" Return="check" HideTarget="yes" />

    <!-- Deferred: run elevated as LocalSystem inside the install transaction. -->
    <CustomAction Id="RemoveLegacyInstall" BinaryRef="LarisCA" DllEntry="RemoveLegacyInstall" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="StopNodeChildren" BinaryRef="LarisCA" DllEntry="StopNodeChildren" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="CopyCudaDeps" BinaryRef="LarisCA" DllEntry="CopyCudaDeps" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveCudaDeps" BinaryRef="LarisCA" DllEntry="RemoveCudaDeps" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="WriteEndpointConfig" BinaryRef="LarisCA" DllEntry="WriteEndpointConfig" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="SeedWebConfig" BinaryRef="LarisCA" DllEntry="SeedWebConfig" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="SeedWebConfigRollback" BinaryRef="LarisCA" DllEntry="SeedWebConfigRollback" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="SeedWebConfigCommit" BinaryRef="LarisCA" DllEntry="SeedWebConfigCommit" Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="SaveSettings" BinaryRef="LarisCA" DllEntry="SaveSettings" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="SetFailureFlag" BinaryRef="LarisCA" DllEntry="SetFailureFlag" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="ForgetSettings" BinaryRef="LarisCA" DllEntry="ForgetSettings" Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Properties every product uses. Secure = may be passed from the UI to the elevated install. -->
    <Property Id="SERVICEACCOUNT" Secure="yes" />
    <Property Id="SERVICEPASSWORD" Secure="yes" Hidden="yes" />
    <Property Id="SERVICEARGS" Secure="yes" Hidden="yes" />
    <Property Id="LEGACYINSTALL" Secure="yes" />
    <Property Id="ALREADYREGISTERED" Secure="yes" />  </Fragment>

  <Fragment>
    <UI Id="LarisCommonUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServiceAccountDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />

      <Property Id="ARPNOMODIFY" Value="1" />

      <!-- Shown when a settings page fails validation; SETTINGS_ERROR is set by ValidateDialog. -->
      <Dialog Id="SettingsErrorDlg" Width="270" Height="105" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="15" Width="240" Height="55" Text="[SETTINGS_ERROR]" />
        <Control Id="OK" Type="PushButton" X="107" Y="78" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Service account, shared by all three products. LARIS_ACCOUNT_BACK is set by the page that
           navigated here, so Back returns to the right product-specific dialog. -->
      <Dialog Id="ServiceAccountDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Service account" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="The Windows account the [ProductName] service runs as." />

        <Control Id="AccountLabel" Type="Text" X="20" Y="60" Width="110" Height="15" Text="Account:" />
        <Control Id="Account" Type="Edit" X="135" Y="58" Width="215" Height="17" Property="SERVICEACCOUNT" />
        <Control Id="AccountHint" Type="Text" X="135" Y="78" Width="215" Height="26" NoPrefix="yes" Text="DOMAIN\user, or blank for LocalSystem. Use an account when storage or SQL needs network credentials." />
        <Control Id="PasswordLabel" Type="Text" X="20" Y="112" Width="110" Height="15" Text="Password:" />
        <Control Id="Password" Type="Edit" X="135" Y="110" Width="215" Height="17" Property="SERVICEPASSWORD" Password="yes" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="[LARIS_ACCOUNT_BACK]" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="LARIS_PAGE" Value="Account" Order="1" />
          <Publish Event="DoAction" Value="ValidateDialog" Order="2" />
          <Publish Event="SpawnDialog" Value="SettingsErrorDlg" Order="3" Condition="SETTINGS_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="SETTINGS_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Upgrade of an existing install whose settings all validate (ResolveUpgradeRoute): nothing to
           ask, so offer the upgrade directly. Stock VerifyReadyDlg's Update mode is for patches — on a
           major upgrade its Install and Update controls would both show. The Upgrade button mirrors
           VerifyReadyDlg's Install publishes. -->
      <Dialog Id="UpgradeReadyDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Ready to upgrade [ProductName]" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="An existing installation was found." />
        <Control Id="Text" Type="Text" X="25" Y="70" Width="320" Height="60" NoPrefix="yes"
                 Text="Click Upgrade to update [ProductName] to version [ProductVersion]. The current settings, certificate and service account are kept. To change a setting, run setup with it on the command line (msiexec /i &lt;msi&gt; PROPERTY=value)." />

        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Upgrade" Type="PushButton" X="212" Y="243" Width="80" Height="17" Default="yes" ElevationShield="yes" Text="&amp;Upgrade">
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" Order="1" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" Order="2" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="3" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" Order="4" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Fragment>
</Wix>
