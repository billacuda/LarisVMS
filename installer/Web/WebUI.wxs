<?xml version="1.0" encoding="utf-8"?>
<!-- Web dialog flow: Welcome -> Web server -> Service account -> Ready -> Finish. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="LarisWebUI">
      <UIRef Id="LarisCommonUI" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="WebSettingsDlg" Order="1" Condition="NOT Installed AND NOT LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed AND PATCH" />
      <!-- Upgrade: settings are already in place, so skip to the first page that needs input (usually none). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="ResolveUpgradeRoute" Order="3" Condition="NOT Installed AND LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Property="LARIS_ACCOUNT_BACK" Value="WelcomeDlg" Order="4" Condition="NOT Installed AND LARIS_UPGRADE" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="[LARIS_UPGRADE_DLG]" Order="5" Condition="NOT Installed AND LARIS_UPGRADE" />

      <Dialog Id="WebSettingsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Web server" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="The HTTPS port and certificate for the LarisVMS site." />

        <Control Id="PortLabel" Type="Text" X="20" Y="56" Width="110" Height="15" Text="HTTPS port:" />
        <Control Id="Port" Type="Edit" X="135" Y="54" Width="60" Height="17" Property="HTTPSPORT" />
        <Control Id="CertLabel" Type="Text" X="20" Y="78" Width="110" Height="15" Text="Certificate (.pfx) path:" />
        <Control Id="Cert" Type="Edit" X="135" Y="76" Width="215" Height="17" Property="CERTPATH" />
        <Control Id="CertPwdLabel" Type="Text" X="20" Y="100" Width="110" Height="15" Text="Certificate password:" />
        <Control Id="CertPwd" Type="Edit" X="135" Y="98" Width="215" Height="17" Property="CERTPASSWORD" Password="yes" />
        <Control Id="CertHint" Type="Text" X="135" Y="120" Width="215" Height="40" NoPrefix="yes"
                 ShowCondition="NOT CERTPASSWORDSTORED" HideCondition="CERTPASSWORDSTORED"
                 Text="Optional. Blank uses a self-signed certificate on a new install. A renewed .pfx at the same path is picked up automatically. A share path must be readable by the service account." />
        <!-- CERTPASSWORDSTORED: LoadSettings found a password in the existing appsettings.Production.json.
             The password itself is never read into a property, so the field stays blank. -->
        <Control Id="CertStoredHint" Type="Text" X="135" Y="120" Width="215" Height="40" NoPrefix="yes"
                 ShowCondition="CERTPASSWORDSTORED" HideCondition="NOT CERTPASSWORDSTORED"
                 Text="A password is already saved for this certificate. Leave the field blank to keep it, or enter a new one. A share path must be readable by the service account." />
        <Control Id="NextSteps" Type="Text" X="20" Y="170" Width="330" Height="40" NoPrefix="yes"
                 Text="After setup, browse to https://localhost:[HTTPSPORT]/ to run the setup wizard (database, first admin account, node registration key)." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="LARIS_PAGE" Value="Web" Order="1" />
          <Publish Event="DoAction" Value="ValidateDialog" Order="2" />
          <Publish Event="SpawnDialog" Value="SettingsErrorDlg" Order="3" Condition="SETTINGS_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Property="LARIS_ACCOUNT_BACK" Value="WebSettingsDlg" Order="4" />
          <Publish Event="NewDialog" Value="ServiceAccountDlg" Order="5" Condition="SETTINGS_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
