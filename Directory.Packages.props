<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- packages.lock.json beside each project pins every transitive package version too, so two
         builds of the same commit restore the same packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Every project restores for win-x64 and linux-x64 too, libraries included. Without this a
         library's lock file depended on how it was last restored: a node publish (-r win-x64) added
         the win-x64 section and a plain build took it out again. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- The node, proxy, updater, and Vision Service publish as single files, which turns this on in
         every project they build and adds the ILLink package to its restore. On for every build, a
         plain restore and a publish restore agree (and single-file problems show up while building). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Release builds (and so every release script) restore exactly what the lock files say and
         fail if a package or its checksum doesn't match. After changing a package version, build
         once in Debug to update the lock files and commit them with the change. -->
    <RestoreLockedMode Condition="'$(Configuration)' == 'Release'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core / Identity / EF Core -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- Home Assistant integration: MQTT client (MIT). -->
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
    <!-- Help pages: renders the Markdown under LarisVMS.Web/Help (BSD-2-Clause). -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <!-- MariaDB provider. A fork of Pomelo.EntityFrameworkCore.MySql that tracks EF Core 10 —
         Pomelo itself only ships for EF Core 9. Same API and namespaces, so swapping back to Pomelo
         once it catches up is a package change only. MIT. -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
    <!-- ICU for the Web server on Linux, shipped with the app (LarisVMS.Web.csproj) so a Linux install
         needs no libicu package. Windows uses the ICU built into Windows. -->
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime.linux-x64" Version="72.1.0.3" />
    <PackageVersion Include="Microsoft.Graph" Version="6.5.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <!-- Not used directly: lifts MailKit/MimeKit's transitive 10.0.0 past GHSA-2fmv-rv2c-59x7 and
         GHSA-846f-f764-76mx. Drop it once MimeKit itself asks for a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Active Directory sign-in and group sync (LDAPS/LDAP, paged and sorted searches). -->
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <!-- LarisVMS.Vision / LarisVMS.Vision.Service — object detection (see the detection plan).
         Versions match what aitest (g:\Projects\aitest) already proved out. -->
    <PackageVersion Include="YoloDotNet" Version="4.2.0" />
    <!-- SkiaSharp's Linux natives. YoloDotNet pulls SkiaSharp in with only the Windows and macOS
         natives; NoDependencies is the build with no fontconfig dependency (LarisVMS draws no text).
         Keep on the SkiaSharp version YoloDotNet resolves (see LarisVMS.Vision's lock file). -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
    <!-- ONNX graph edit (pass 4a): the D-FINE model gets an nv12->normalized-tensor preprocessing
         head merged in at load so colour conversion + normalize run on the accelerator, not the CPU.
         Google.Protobuf (BSD-3-Clause) is the runtime; Grpc.Tools (Apache-2.0, build-only) compiles
         the vendored onnx-ml.proto (Apache-2.0) to C# messages — no gRPC services, just the ONNX IR
         types. -->
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Tools" Version="2.69.0" />
    <!-- ONNX Runtime, multi-backend (see LarisVMS.Vision.csproj / VisionBackendResolver). One managed
         assembly (comes with the base CPU package) is paired with several native builds staged into
         onnxruntime-backends\<name>\ at publish time and chosen at runtime per machine:
           - base package  -> managed assembly + the CPU native onnxruntime at the app root
           - Gpu.Windows / Gpu.Linux -> onnxruntime-backends\cuda\ (CUDA + TensorRT provider natives)
           - DirectML + Microsoft.AI.DirectML -> onnxruntime-backends\directml\ (Windows only)
           - Intel.ML.OnnxRuntime.EP.OpenVINO -> onnxruntime-backends\openvino\ (a plugin execution
             provider with the OpenVINO runtime bundled; loads on top of the CPU build, ORT 1.23+)
         Keep the Microsoft packages on one 1.24.x line; the managed assembly is unified to the highest
         by CPM and must not be newer than any native build it loads.
         1.24.4 is deliberately the ceiling for now: it is the last Microsoft.ML.OnnxRuntime.DirectML
         release (DirectML is in sustained engineering), and it is built on CUDA 12.8. Going to
         1.27+ means CUDA 13 (drops Pascal and older) and a separate DirectML-pinned Vision.Service
         build for AMD on Windows — see the Linux support plan's "later" list. Bump CudaRequirements
         and the README/Help GPU requirements table together with these. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Intel.ML.OnnxRuntime.EP.OpenVINO" Version="1.8.1" />
    <PackageVersion Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- SecurityCodeScan: security analyzer in every project, so the .NET 10 Security Build
         workflow's SARIF carries its findings. A global reference is private and analyzer-only. -->
    <GlobalPackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7" />
  </ItemGroup>
</Project>
