<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- packages.lock.json beside each project pins every transitive package version too, so two
         builds of the same commit restore the same packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Every project restores for win-x64 too, libraries included. Without this a library's lock
         file depended on how it was last restored: a node publish (-r win-x64) added the win-x64
         section and a plain build took it out again. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The node, proxy, updater, and Vision Service publish as single files, which turns this on in
         every project they build and adds the ILLink package to its restore. On for every build, a
         plain restore and a publish restore agree (and single-file problems show up while building). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Release builds (and so every release script) restore exactly what the lock files say and
         fail if a package or its checksum doesn't match. After changing a package version, build
         once in Debug to update the lock files and commit them with the change. -->
    <RestoreLockedMode Condition="'$(Configuration)' == 'Release'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core / Identity / EF Core -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- Help pages: renders the Markdown under LarisVMS.Web/Help (BSD-2-Clause). -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <!-- MariaDB provider. A fork of Pomelo.EntityFrameworkCore.MySql that tracks EF Core 10 —
         Pomelo itself only ships for EF Core 9. Same API and namespaces, so swapping back to Pomelo
         once it catches up is a package change only. MIT. -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Graph" Version="6.5.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Not used directly: lifts MailKit/MimeKit's transitive 10.0.0 past GHSA-2fmv-rv2c-59x7 and
         GHSA-846f-f764-76mx. Drop it once MimeKit itself asks for a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Active Directory sign-in and group sync (LDAPS/LDAP, paged and sorted searches). -->
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.13" />
    <!-- LarisVMS.Vision / LarisVMS.Vision.Service — object detection (see the detection plan).
         Versions match what aitest (g:\Projects\aitest) already proved out. -->
    <PackageVersion Include="YoloDotNet" Version="4.2.0" />
    <!-- ONNX graph edit (pass 4a): the D-FINE model gets an nv12->normalized-tensor preprocessing
         head merged in at load so colour conversion + normalize run on the accelerator, not the CPU.
         Google.Protobuf (BSD-3-Clause) is the runtime; Grpc.Tools (Apache-2.0, build-only) compiles
         the vendored onnx-ml.proto (Apache-2.0) to C# messages — no gRPC services, just the ONNX IR
         types. -->
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Tools" Version="2.69.0" />
    <!-- ONNX Runtime, multi-backend (see LarisVMS.Vision.csproj / VisionBackendResolver). One managed
         assembly (comes with the base CPU package) is paired with several native builds staged into
         onnxruntime-backends\<name>\ at publish time and chosen at runtime per machine:
           - base package  -> managed assembly + the CPU native onnxruntime.dll at the app root
           - Gpu.Windows   -> onnxruntime-backends\cuda\     (CUDA + TensorRT provider natives)
           - DirectML + Microsoft.AI.DirectML -> onnxruntime-backends\directml\
         Keep these on the same 1.23.x line; the managed assembly is unified to the highest by CPM.
         OpenVINO (Intel.ML.OnnxRuntime.OpenVino) is intentionally not bundled — it lags at 1.22 and
         would force a managed/native mismatch; DirectML already covers Intel GPUs.
         Gpu.Windows forces the shared managed assembly to 1.23.2 (its nuspec minimum). base is
         pinned to 1.23.2 to match; DirectML has no 1.23.2 release so it stays at 1.23.0 (its EP ABI
         is stable — 1.23.0 native against the 1.23.2 managed assembly is fine, and pinning it stops
         NuGet from floating it up to 1.24.x and dragging the managed assembly with it). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.23.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />
    <PackageVersion Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <PackageVersion Include="System.Management" Version="10.0.13" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- SecurityCodeScan: security analyzer in every project, so the .NET 10 Security Build
         workflow's SARIF carries its findings. A global reference is private and analyzer-only. -->
    <GlobalPackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7" />
  </ItemGroup>
</Project>
