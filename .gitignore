# .NET build artifacts
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test run outputs — `dotnet test` / VSTest write these, and a hung run drops a
# multi-hundred-MB process crash dump here that GitHub then rejects on push.
[Tt]est[Rr]esults/
*.trx
*.dmp

# Visual Studio
.vs/
*.rsuser
.vscode/

# JetBrains Rider
.idea/

# Published output
publish/
out/
temp/

# Generated / secrets
setup-generated.json
appsettings.*.json
!appsettings.Development.json.example

# Node service local state (DPAPI/AES-encrypted, machine-specific)
node.config

# Recordings and media working directories — never meant to be in source control,
# and deploy.ps1's /MIR must never see them either (see deploy.ps1's -XD list).
recordings/
spool/
exports/
data-protection-keys/

# Object detection: exported models (large binaries, machine/site-specific — see build-node.ps1's
# own doc comment), a TensorRT engine cache if one is ever pointed at a repo-local path
# (VisionServiceOptions.TensorRtEngineCachePath), and tools/export-models/'s own Python virtual
# environment — same patterns aitest already used for all three.
models/
*.onnx
*.pt
*.engine
trt-cache/
tools/*/.venv/
__pycache__/
*.pyc

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# OS
.DS_Store
Thumbs.db
Desktop.ini
.aider*

# Local-only backlog/scratch notes — not meant to be shared or committed
IDEAS.md

# Auto-generated list of this repo's incomplete plan files (source lives in
# ~/.claude/plans/); regenerated by the update-plan-lists PostToolUse hook.
PLANS.local.md
